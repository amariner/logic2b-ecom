---
/**
 * Ficha de un tema — `/temas/<id>`.
 *
 * Lleva la tienda viva del tema a la página comercial: un marco de navegador
 * con la demo embebida, lo que resuelve la dirección, su ficha técnica, qué se
 * adapta a cada marca y otros temas afines. Modelo: camp.logic2b.com/temas/…,
 * reescrito en el lenguaje «plataforma» de `.commercial-page`.
 *
 * RENDIMIENTO. La página es indexable (objetivo Lighthouse 100). El escenario
 * pinta la CAPTURA de la tienda como póster y el `<iframe>` solo se crea cuando
 * el visitante lo pide: pulsar el póster, cambiar a vista móvil o ampliar a
 * pantalla completa. Se probó a cargarlo solo tras `load` + `requestIdleCallback`
 * y Lighthouse (igual que CrUX) contabiliza lo que ocurre dentro de un iframe
 * del mismo origen: los desplazamientos de carga de la tienda y su JS en el
 * hilo principal bajaban la ficha a 84 (Arce) y 67 (Zancada) en escritorio.
 * Sin JS, el póster es un enlace a la tienda.
 *
 * PANTALLA COMPLETA. El escenario es un `<dialog open>` en flujo: para ampliarlo
 * se cierra y se reabre con `showModal()`, sin mover el `<iframe>` en el DOM
 * (moverlo lo recargaría y perdería la navegación). Esc cierra y el foco
 * vuelve al botón que lo abrió.
 *
 * Solo el acento del tema (`--color-brand`) entra en la página, como muestra
 * de color. El resto es el lenguaje comercial común.
 */
import type { CollectionConfig } from '../../collections';
import { storePaths } from '../../collections';
import type { DemoTheme } from '../../lib/demo-themes';
import { THEME_FILTERS, themeCategoryIds } from '../../lib/theme-catalog';
import {
  THEME_LAYOUT_LABELS,
  buttonShapeLabel,
  displayFontLabel,
  gridLabel,
} from '../../lib/theme-labels';
import {
  CATALOG_THEMES,
  themeDisplayName,
  themePagePath,
  type ThemeProfile,
} from '../../lib/theme-profiles';

type RelatedTheme = { theme: DemoTheme; collection: CollectionConfig | null };

interface Props {
  theme: DemoTheme;
  profile: ThemeProfile;
  collection: CollectionConfig;
  related: readonly RelatedTheme[];
  previous: DemoTheme;
  next: DemoTheme;
}

const { theme, profile, collection, related, previous, next } = Astro.props;

const name = themeDisplayName(theme);
const brand = theme.vars['--color-brand'];
const demoHref = storePaths(collection.id).catalog;
const sectors = themeCategoryIds(theme).map(
  (id) => THEME_FILTERS.find((filter) => filter.id === id)?.label ?? id,
);

/** Capturas reales de la tienda (las genera `scripts/capture-screens.mjs`). */
const screenFiles = new Set(
  Object.keys(import.meta.glob('../../../public/images/screens/store-*-catalog*.webp')).map(
    (path) => `/images/screens/${path.split('/').pop()!}`,
  ),
);
const screen = (id: string, suffix: string): string | null => {
  const path = `/images/screens/store-${id}-catalog${suffix}.webp`;
  return screenFiles.has(path) ? path : null;
};
const srcsetFor = (id: string, widths: readonly (readonly [string, number])[]): string =>
  widths
    .map(([suffix, width]) => [screen(id, suffix), width] as const)
    .filter(([path]) => path)
    .map(([path, width]) => `${path} ${width}w`)
    .join(', ');

const poster = screen(collection.id, '-900');
const posterSrcset = srcsetFor(collection.id, [['-560', 560], ['-900', 900], ['', 1440]]);
const posterMobile = screen(collection.id, '-m');

const stageLabel = `Vista previa navegable de ${collection.name}, la tienda de muestra del tema ${name}`;
const layout = theme.layout;
const facts: readonly (readonly [string, string])[] = [
  ['Titulares', displayFontLabel(theme)],
  ['Botones', buttonShapeLabel(theme)],
  ['Rejilla', gridLabel(layout)],
  ['Navegación', THEME_LAYOUT_LABELS.nav[layout.nav]],
  ['Portada', THEME_LAYOUT_LABELS.hero[layout.hero]],
  ['Tarjeta', THEME_LAYOUT_LABELS.card[layout.card]],
  ['Filtros', THEME_LAYOUT_LABELS.filters[layout.filters]],
  ['Densidad', THEME_LAYOUT_LABELS.density[layout.density]],
];
const pad = (value: number): string => String(value).padStart(2, '0');
---

<article class="td">
  <header class="td-head page-shell">
    <nav class="td-crumbs" aria-label="Ruta de navegación">
      <ol>
        <li><a href="/">Inicio</a></li>
        <li><a href="/temas">Temas</a></li>
        <li><span aria-current="page">{name}</span></li>
      </ol>
    </nav>
    <div class="td-heading">
      <div>
        <p class="eyebrow td-kicker">
          <span>Tema</span>
          <i class="td-swatch" style={`--swatch: ${brand}`} aria-hidden="true"></i>
          {sectors.join(' · ')}
        </p>
        <h1>{name}</h1>
      </div>
      <div class="td-heading-copy">
        <p class="td-lead">{theme.hint}</p>
        <p class="td-fit"><span>Encaja en</span> {theme.bestFor.join(' · ')}</p>
      </div>
    </div>
  </header>

  <div class="td-preview page-shell">
    <dialog
      open
      class="td-stage"
      aria-label={stageLabel}
      data-td-stage
      data-td-src={demoHref}
      data-td-title={`Tienda demo ${collection.name} (tema ${name})`}
    >
      <div class="td-browser">
        <div class="td-bar">
          <span class="td-dots" aria-hidden="true"><i></i><i></i><i></i></span>
          <span class="td-address">
            <svg viewBox="0 0 16 16" aria-hidden="true"><rect x="3.5" y="7" width="9" height="6.5" rx="1.5"></rect><path d="M5.5 7V5.2a2.5 2.5 0 0 1 5 0V7"></path></svg>
            <span><span class="sr-only">Dirección de ejemplo: </span>{collection.id}.tudominio.com</span>
          </span>
          <div class="td-tools">
            <div class="td-device" role="group" aria-label="Tamaño de la vista previa" hidden data-td-js>
              <button type="button" aria-pressed="true" data-td-device="desktop">
                <svg viewBox="0 0 20 20" aria-hidden="true"><rect x="2.5" y="4" width="15" height="10" rx="1.5"></rect><path d="M7 17h6"></path></svg>
                <span>Escritorio</span>
              </button>
              <button type="button" aria-pressed="false" data-td-device="mobile">
                <svg viewBox="0 0 20 20" aria-hidden="true"><rect x="6" y="2.5" width="8" height="15" rx="1.5"></rect><path d="M9 14.5h2"></path></svg>
                <span>Móvil</span>
              </button>
            </div>
            <a class="td-tool" href={demoHref} target="_blank" rel="noopener" aria-label="Abrir la tienda demo en una pestaña nueva" title="Abrir en pestaña nueva">
              <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M11 4h5v5M16 4l-7 7M14 12v3.5a.5.5 0 0 1-.5.5h-9a.5.5 0 0 1-.5-.5v-9a.5.5 0 0 1 .5-.5H8"></path></svg>
            </a>
            <button
              type="button"
              class="td-tool"
              aria-expanded="false"
              aria-label="Ver la tienda a pantalla completa"
              data-open-label="Ver la tienda a pantalla completa"
              data-close-label="Cerrar la pantalla completa"
              hidden
              data-td-js
              data-td-expand
            >
              <svg class="td-ico-open" viewBox="0 0 20 20" aria-hidden="true"><path d="M7 3H3v4M13 3h4v4M7 17H3v-4M13 17h4v-4"></path></svg>
              <svg class="td-ico-close" viewBox="0 0 20 20" aria-hidden="true"><path d="M5 5l10 10M15 5 5 15"></path></svg>
            </button>
          </div>
        </div>
        <div class="td-screen">
          <div class="td-viewport" data-td-viewport>
            <a class="td-poster" href={demoHref} data-td-poster>
              {poster ? (
                <picture>
                  {posterMobile && <source media="(max-width: 639px)" srcset={posterMobile} width="780" height="1688" />}
                  <img
                    src={poster}
                    srcset={posterSrcset}
                    sizes="(min-width: 1320px) 830px, (min-width: 1024px) calc(100vw - 30rem), 100vw"
                    width="900"
                    height="563"
                    alt={`Portada de ${collection.name}, la tienda de muestra construida con el tema ${name}`}
                    fetchpriority="high"
                    decoding="async"
                  />
                </picture>
              ) : (
                <span class="td-poster-empty">{collection.name}</span>
              )}
              <span class="td-poster-cta">
                <span data-td-poster-label>Entrar en la tienda demo</span>
                <span aria-hidden="true">→</span>
              </span>
            </a>
          </div>
        </div>
      </div>

      <aside class="td-side" aria-label={`Resumen del tema ${name}`}>
        <p class="td-side-kicker"><i aria-hidden="true"></i>Demo navegable · datos simulados</p>
        <p class="td-side-title">{name}</p>
        <p class="td-side-store">
          Tienda de muestra: <strong>{collection.name}</strong>. {collection.tagline}
        </p>
        <ul class="td-tags" aria-label="Sectores">
          {sectors.map((sector) => <li>{sector}</li>)}
        </ul>
        <ul class="td-checks check-list">
          {profile.highlights.map((highlight) => <li>{highlight}</li>)}
        </ul>
        <div class="td-side-actions">
          <a class="btn btn-primary" href={demoHref}>Abrir la tienda demo <span aria-hidden="true">↗</span></a>
          <a class="btn btn-ghost" href="/#contacto" data-open-project data-td-theme={name}>
            Quiero esta dirección <span class="btn-arrow" aria-hidden="true">→</span>
          </a>
        </div>
        <p class="td-side-note">
          Productos, precios y pedidos de la demo son ficticios y el pago es simulado: no se cobra nada.
        </p>
      </aside>
    </dialog>
    <!-- Sin CLS: los controles que necesitan JS se revelan antes del primer
         pintado (mismo patrón que la barra de filtros de /temas). Sin JS
         siguen ocultos y el póster enlaza a la tienda. -->
    <script is:inline>document.querySelectorAll('[data-td-js]').forEach(function (el) { el.hidden = false; });</script>
  </div>

  <section class="sx td-info page-shell" aria-labelledby="td-resuelve">
    <div class="td-story">
      <p class="eyebrow"><span>01</span>El tema en detalle</p>
      <h2 id="td-resuelve">Qué resuelve esta dirección</h2>
      <p class="td-summary">{profile.summary}</p>
      <p class="td-store-note">
        En la demo la verás aplicada a <strong>{collection.name}</strong>, una tienda ficticia: {collection.description}
      </p>
      <ol class="td-points">
        {profile.highlights.map((highlight, index) => (
          <li><b aria-hidden="true">{pad(index + 1)}</b><span>{highlight}</span></li>
        ))}
      </ol>
    </div>

    <aside class="td-facts" aria-labelledby="td-ficha">
      <h3 id="td-ficha">Ficha técnica</h3>
      <dl>
        <div>
          <dt>Acento</dt>
          <dd><i class="td-swatch" style={`--swatch: ${brand}`} aria-hidden="true"></i><code>{brand}</code></dd>
        </div>
        {facts.map(([term, value]) => (
          <div><dt>{term}</dt><dd>{value}</dd></div>
        ))}
      </dl>
      <a class="btn btn-primary td-facts-cta" href="/#contacto" data-open-project data-td-theme={name}>
        Quiero esta dirección <span class="btn-arrow" aria-hidden="true">→</span>
      </a>
    </aside>
  </section>

  <section class="sx sx-tint td-adapt" aria-labelledby="td-adapta">
    <div class="page-shell">
      <div class="sx-head is-split">
        <div>
          <p class="eyebrow"><span>02</span>Qué cambia y qué no</p>
          <h2 id="td-adapta">Qué se adapta a tu marca</h2>
        </div>
        <p>
          {name} es un punto de partida visual, no un molde. Lo que se ve se ajusta a tu
          negocio; lo que hace funcionar la tienda es el mismo motor en todos los temas.
        </p>
      </div>
      <div class="td-adapt-grid">
        <div class="card">
          <h3>Se adapta a tu negocio</h3>
          <ul class="check-list">
            <li>Logotipo, colores y tipografía de tu marca</li>
            <li>Fotografía de tus productos y de tu espacio</li>
            <li>Textos, tono y secciones de la portada</li>
            <li>Catálogo, categorías y precios</li>
          </ul>
        </div>
        <div class="card">
          <h3>Igual en todos los temas</h3>
          <ul class="check-list">
            <li>Pago seguro con tarjeta</li>
            <li>Pedidos, stock y envíos</li>
            <li>Un panel sencillo para gestionar la tienda</li>
            <li>Mantenimiento técnico a cargo de Logic2B</li>
          </ul>
        </div>
      </div>
      <p class="td-adapt-note">
        La demo usa productos, precios y pedidos ficticios: el pago es simulado y no se envían correos.
      </p>
    </div>
  </section>

  <section class="sx td-related page-shell" aria-labelledby="td-otros">
    <div class="td-related-head">
      <div>
        <p class="eyebrow"><span>03</span>Otros temas</p>
        <h2 id="td-otros">Otras direcciones que te pueden encajar</h2>
      </div>
      <a class="text-link" href="/temas">Ver los {CATALOG_THEMES.length} temas <span aria-hidden="true">→</span></a>
    </div>
    <ul class="td-related-grid">
      {related.map(({ theme: item, collection: itemCollection }) => {
        const image = itemCollection ? screen(itemCollection.id, '-900') : null;
        return (
          <li>
            <a class="td-card" href={themePagePath(item.id)}>
              <span class="td-card-media">
                {image && itemCollection && (
                  <img
                    src={image}
                    srcset={srcsetFor(itemCollection.id, [['-560', 560], ['-900', 900]])}
                    sizes="(min-width: 1024px) 400px, (min-width: 640px) 50vw, 100vw"
                    width="900"
                    height="563"
                    alt=""
                    loading="lazy"
                    decoding="async"
                  />
                )}
              </span>
              <span class="td-card-body">
                <span class="td-card-title">
                  <i class="td-swatch" style={`--swatch: ${item.vars['--color-brand']}`} aria-hidden="true"></i>
                  <strong>{themeDisplayName(item)}</strong>
                </span>
                <span class="td-card-hint">{item.hint}</span>
                <span class="td-card-more">Ver ficha <span aria-hidden="true">→</span></span>
              </span>
            </a>
          </li>
        );
      })}
    </ul>

    <nav class="td-pager" aria-label="Tema anterior y siguiente">
      <a href={themePagePath(previous.id)} rel="prev">
        <small><span aria-hidden="true">←</span> Tema anterior</small>
        <strong>{themeDisplayName(previous)}</strong>
      </a>
      <a href={themePagePath(next.id)} rel="next">
        <small>Tema siguiente <span aria-hidden="true">→</span></small>
        <strong>{themeDisplayName(next)}</strong>
      </a>
    </nav>
  </section>

  <section class="page-shell cta-wrap" aria-labelledby="td-cierre">
    <div class="cta-band">
      <p class="eyebrow"><span>+</span>A tu medida</p>
      <h2 id="td-cierre">¿Te encaja {name}? Lo llevamos a tu marca.</h2>
      <p>
        Cuéntanos qué vendes y te preparamos una propuesta con alcance, plazos e inversión
        a partir de este tema, o combinando lo mejor de varios.
      </p>
      <div class="page-actions">
        <a href="/#contacto" data-open-project data-td-theme={name} class="btn btn-light">
          Quiero esta dirección <span class="btn-arrow" aria-hidden="true">→</span>
        </a>
        <a href="/temas" class="btn btn-outline-light">Ver todos los temas</a>
      </div>
    </div>
  </section>
</article>

<script>
  const stage = document.querySelector<HTMLDialogElement>('[data-td-stage]');
  const viewport = stage?.querySelector<HTMLElement>('[data-td-viewport]');
  const poster = stage?.querySelector<HTMLAnchorElement>('[data-td-poster]');

  if (stage && viewport && poster) {
    const expand = stage.querySelector<HTMLButtonElement>('[data-td-expand]');
    const devices = [...stage.querySelectorAll<HTMLButtonElement>('[data-td-device]')];
    const label = stage.querySelector<HTMLElement>('[data-td-poster-label]');
    let frame: HTMLIFrameElement | null = null;
    let focusFrame = false;

    // Las teclas pulsadas dentro de la demo no llegan a esta página: Esc se
    // escucha también en el documento del iframe (mismo origen).
    const bindEscape = (): void => {
      try {
        frame?.contentDocument?.addEventListener('keydown', (event) => {
          if (event.key === 'Escape' && stage.matches(':modal')) {
            event.preventDefault();
            stage.close();
          }
        });
      } catch { /* sin acceso: queda el botón visible de cerrar */ }
    };

    const activate = (): void => {
      if (frame) return;
      frame = document.createElement('iframe');
      frame.className = 'td-frame';
      frame.title = stage.dataset.tdTitle ?? '';
      frame.src = stage.dataset.tdSrc ?? poster.href;
      frame.addEventListener('load', () => {
        const hadFocus = focusFrame || document.activeElement === poster;
        stage.classList.add('is-live');
        stage.classList.remove('is-loading');
        bindEscape();
        if (hadFocus) frame?.focus();
        focusFrame = false;
      });
      stage.classList.add('is-loading');
      if (label) label.textContent = 'Cargando la tienda…';
      viewport.appendChild(frame);
    };

    poster.addEventListener('click', (event) => {
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.button !== 0) return;
      event.preventDefault();
      focusFrame = true;
      activate();
    });

    devices.forEach((button) => button.addEventListener('click', () => {
      stage.classList.toggle('is-mobile', button.dataset.tdDevice === 'mobile');
      devices.forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
      activate();
    }));

    const setExpanded = (open: boolean): void => {
      document.documentElement.classList.toggle('td-preview-locked', open);
      stage.classList.toggle('is-expanded', open);
      expand?.setAttribute('aria-expanded', String(open));
      expand?.setAttribute('aria-label', (open ? expand.dataset.closeLabel : expand.dataset.openLabel) ?? '');
    };
    expand?.addEventListener('click', () => {
      activate();
      if (stage.matches(':modal')) {
        stage.close();
        return;
      }
      // Cerrar y reabrir el MISMO <dialog> como modal: el iframe no se mueve
      // del DOM, así que conserva la página en la que está el visitante.
      stage.close();
      stage.showModal();
      setExpanded(true);
      expand.focus({ preventScroll: true });
    });
    stage.addEventListener('close', () => {
      if (stage.matches(':modal')) return;
      setExpanded(false);
      stage.show();
      expand?.focus({ preventScroll: true });
    });

    // En escritorio la tienda se incrusta con la primera interacción (mover
    // el ratón, la rueda o el teclado): quien visita la ficha la ve embebida
    // casi al instante y su carga no se suma a la de esta página. En móvil o
    // con ahorro de datos espera al toque: una tienda entera no se descarga
    // sin pedirla.
    const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData === true;
    if (!saveData && matchMedia('(min-width: 1024px) and (pointer: fine)').matches) {
      const events = ['pointermove', 'wheel', 'scroll', 'keydown'] as const;
      const onFirstInteraction = (): void => {
        events.forEach((name) => removeEventListener(name, onFirstInteraction));
        activate();
      };
      events.forEach((name) => addEventListener(name, onFirstInteraction, { passive: true }));
    }
  }

  // «Quiero esta dirección» abre el diálogo de proyecto común y deja escrito el
  // tema de partida, si el visitante aún no ha escrito nada.
  const needs = document.querySelector<HTMLTextAreaElement>('[data-project-dialog] textarea[name=needs]');
  document.querySelectorAll<HTMLElement>('[data-td-theme]').forEach((trigger) => {
    trigger.addEventListener('click', () => {
      if (needs && !needs.value.trim()) needs.value = `Me interesa el tema ${trigger.dataset.tdTheme} como punto de partida para mi tienda.`;
    });
  });
</script>

<style>
  :global(html.td-preview-locked) { overflow: hidden; }

  /* ── Cabecera ─────────────────────────────────────────────────────────── */
  .td-head { padding-top: clamp(1rem, 2.5vw, 1.75rem); padding-bottom: clamp(2rem, 4vw, 3rem); }
  .td-crumbs ol { display: flex; flex-wrap: wrap; align-items: center; color: var(--c-muted); font-size: .84rem; }
  .td-crumbs li { display: inline-flex; align-items: center; }
  .td-crumbs li + li::before { margin-inline: .55rem; color: #b6bdc8; content: '/' / ''; }
  .td-crumbs a { display: inline-flex; min-height: 44px; align-items: center; color: var(--c-body); text-underline-offset: 4px; }
  .td-crumbs a:hover { color: var(--c-ink); text-decoration: underline; }
  .td-crumbs [aria-current] { color: var(--c-ink); font-weight: 500; }

  .td-heading {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, .95fr);
    align-items: end;
    gap: 1.5rem clamp(2rem, 7vw, 6rem);
    margin-top: clamp(1rem, 3vw, 2.25rem);
  }
  .td-kicker { flex-wrap: wrap; }
  .td-heading h1 { margin-top: 1rem; font-size: clamp(2.9rem, 6.4vw, 5.25rem); line-height: .98; letter-spacing: -.05em; overflow-wrap: anywhere; }
  .td-lead { max-width: 34rem; color: var(--c-ink); font-size: clamp(1.08rem, 1.4vw, 1.25rem); line-height: 1.55; letter-spacing: -.01em; }
  .td-fit { max-width: 34rem; margin-top: .9rem; color: var(--c-body); font-size: .92rem; line-height: 1.6; }
  .td-fit span { margin-right: .35rem; color: var(--c-muted); font: 500 .74rem/1.6 var(--font-code); }

  .td-swatch {
    display: inline-block;
    flex: 0 0 auto;
    width: .8rem;
    height: .8rem;
    border-radius: 3px;
    background: var(--swatch);
    box-shadow: inset 0 0 0 1px rgb(12 20 36 / 16%);
  }

  /* ── Escenario ────────────────────────────────────────────────────────── */
  .td-preview { padding-bottom: clamp(3rem, 6vw, 5rem); }
  .td-stage {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) clamp(18rem, 25vw, 21.5rem);
    gap: .75rem;
    width: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: .75rem;
    border: 1px solid var(--c-border);
    border-radius: var(--r-lg);
    background: var(--c-surface);
    color: inherit;
    box-shadow: none;
  }
  .td-browser {
    display: flex;
    min-width: 0;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid rgb(12 20 36 / 10%);
    border-radius: var(--r-md);
    background: #fff;
    box-shadow: var(--shadow-md);
  }
  .td-bar {
    display: flex;
    height: 3.5rem;
    align-items: center;
    gap: .75rem;
