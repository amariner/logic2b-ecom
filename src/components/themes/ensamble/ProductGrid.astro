---
/** ENSAMBLE · retícula asimétrica de fichas de archivo. */
import type { StorePaths } from '../../../collections';
import { formatEurCents } from '../../../lib/format';
type GridProduct = {
  slug: string;
  name: string;
  description: string;
  price_cents: number;
  image: string;
  stock: number;
};

interface Props {
  paths: StorePaths;
  products: GridProduct[];
}

const { paths, products } = Astro.props;
const productNumber = (name: string, index: number): string =>
  name.match(/\b(\d{2})$/)?.[1] ?? String(index + 1).padStart(2, '0');
const productDimensions = (slug: string): string => ({
  'ens-mesa-umbral': 'W107 × D75 × H25 cm',
  'ens-silla-pliegue': 'W49 × D51 × H78 cm',
  'ens-silla-vertical': 'W46 × D53 × H91 cm',
})[slug] ?? 'Consultar ficha';
---

<ul class="ensamble-grid">
  {products.map((product, index) => (
    <li class:list={['ensamble-card', `ensamble-card--${index + 1}`]}>
      <div class="ensamble-card__index" aria-hidden="true"><span>{productNumber(product.name, index)}.</span></div>
      <div class="ensamble-card__media">
        <img src={product.image} alt={product.name} width="1122" height="1402" loading={index === 0 ? 'eager' : 'lazy'} fetchpriority={index === 0 ? 'high' : 'auto'} />
      </div>
      <div class="ensamble-card__copy">
        <span>Nº {productNumber(product.name, index)}</span>
        <h2><a href={paths.product(product.slug)}>{product.name}</a></h2>
        <p>{product.description}</p>
        <div><span>Dimensiones</span><strong>{productDimensions(product.slug)}</strong></div>
        <div><span>Precio</span><strong>{formatEurCents(product.price_cents)}</strong></div>
      </div>
    </li>
  ))}
</ul>

<style>
  .ensamble-grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: clamp(2rem, 5vw, 6rem) var(--grid-gap); margin: 0; padding: clamp(1rem, 2vw, 2rem) clamp(1rem, 2vw, 2rem) clamp(6rem, 10vw, 10rem); border-top: var(--border-width) solid var(--color-border); list-style: none; }
  .ensamble-card { position: relative; display: grid; min-width: 0; grid-template-columns: minmax(0, 1fr); align-content: start; }
  .ensamble-card--1 { grid-column: 1 / -1; grid-template-columns: 3fr 5fr 4fr; }
  .ensamble-card--2 { grid-column: 1 / 8; grid-template-columns: 4fr 3fr; margin-top: 3rem; }
  .ensamble-card--3 { grid-column: 6 / -1; grid-template-columns: 3fr 4fr; margin-top: -1rem; }
  .ensamble-card__index { padding: .2rem .7rem 0 0; font-size: .58rem; }
  .ensamble-card__media { display: block; overflow: hidden; min-height: 20rem; background: var(--surface-product); }
  .ensamble-card--1 .ensamble-card__media { aspect-ratio: 4 / 5; }
  .ensamble-card--2 .ensamble-card__media, .ensamble-card--3 .ensamble-card__media { aspect-ratio: 5 / 6; }
  .ensamble-card__media img { width: 100%; height: 100%; object-fit: cover; filter: saturate(.82) contrast(.93); transition: transform .6s ease, filter .6s ease; }
  .ensamble-card__media:hover img { filter: saturate(.95) contrast(.96); transform: scale(1.012); }
  .ensamble-card__copy { display: flex; min-width: 0; flex-direction: column; padding: .2rem clamp(.75rem, 1.7vw, 1.8rem); font-size: .58rem; line-height: 1.45; }
  .ensamble-card--1 .ensamble-card__copy { justify-content: flex-end; padding-bottom: .2rem; }
  .ensamble-card__copy > span { text-transform: uppercase; }
  .ensamble-card__copy h2 { margin: 1rem 0 .55rem; font: 400 clamp(1.4rem, 2.6vw, 3rem)/.95 var(--font-display); letter-spacing: var(--tracking-display); }
  .ensamble-card__copy h2 a { display: inline-flex; min-height: 2.75rem; align-items: center; }
  .ensamble-card__copy h2 a::after { position: absolute; inset: 0; content: ''; }
  .ensamble-card__copy h2 a:hover, .ensamble-card__copy h2 a:focus-visible { text-decoration: underline; text-underline-offset: .3rem; }
  .ensamble-card__copy > p { max-width: 24rem; margin: 0 0 auto; color: var(--color-muted-foreground); }
  .ensamble-card__copy > div { display: grid; grid-template-columns: 1fr 1.5fr; gap: 1rem; margin-top: 1.4rem; padding-top: .55rem; border-top: var(--border-width) solid var(--color-border); }
  .ensamble-card__copy strong { font-weight: 400; }
  @media (max-width: 760px) {
    .ensamble-grid { display: block; padding-top: 0; }
    .ensamble-card, .ensamble-card--1, .ensamble-card--2, .ensamble-card--3 { display: grid; grid-template-columns: 2rem minmax(0, 1fr); margin: 0 0 5rem; }
    .ensamble-card__media { min-height: 0; aspect-ratio: 4 / 5 !important; }
    .ensamble-card__copy { grid-column: 2; padding: 1rem 0 0; }
    .ensamble-card__copy > p { margin-bottom: 1.5rem; }
  }
  @media (prefers-reduced-motion: reduce) { .ensamble-card__media img { transition: none; } }
</style>
