---
import type { CollectionConfig, StorePaths } from '../../../collections';
import type { ProductRow } from '../../../lib/db';

interface Props {
  paths: StorePaths;
  collection: CollectionConfig;
  products: ProductRow[];
  category?: string | undefined;
  sort: string;
  search?: string | undefined;
}

const { products } = Astro.props;
const productBySlug = new Map(products.map((product) => [product.slug, product]));
const root = '/images/collections/sitega';
const cards = [
  { slug:'sit-basin-soft', image:`${root}/basin-soft.jpg`, alt:'Lavabo cerámico blanco redondeado', kind:'umyvalniki', className:'sitega-card--large' },
  { slug:'sit-basin-oval', image:`${root}/basin-oval.jpg`, alt:'Lavabo ovalado blanco', kind:'umyvalniki', className:'' },
  { slug:'sit-basin-black', image:`${root}/basin-black.jpg`, alt:'Lavabo cerámico negro mate', kind:'umyvalniki', className:'sitega-card--wide' },
  { slug:'sit-basin-table', image:`${root}/basin-table.jpg`, alt:'Lavabo rectangular blanco', kind:'kollekcii', className:'sitega-card--wide' },
  { slug:'sit-basin-pedestal', image:`${root}/basin-pedestal.jpg`, alt:'Lavabo sobre pedestal taupe', kind:'kollekcii', className:'' },
  { slug:'sit-basin-stone', image:`${root}/basin-stone.jpg`, alt:'Lavabo de piedra carbón', kind:'kollekcii', className:'' },
  { slug:'sit-faucet-arc', image:`${root}/faucet-arc.jpg`, alt:'Grifería de arco negro mate', kind:'smesiteli', className:'' },
  { slug:'sit-faucet-wall', image:`${root}/faucet-wall.jpg`, alt:'Grifería mural grafito', kind:'smesiteli', className:'' },
] as const;
const productName = (slug: string) => productBySlug.get(slug)?.name ?? slug;
---

<main class="sitega-shell w-full bg-white text-[#111]">
  <div class="sitega-page w-full bg-white">
    <header class="sitega-header flex items-center justify-between px-5 py-5 sm:px-10">
      <a href="#inicio" class="text-lg font-medium tracking-[-.06em]">Sitēga</a>
      <nav class="hidden gap-5 text-[9px] uppercase tracking-[.08em] sm:flex" aria-label="Navegación de Sitēga">
        <a href="#catalogo">Catálogo</a><a href="#colecciones">Colecciones</a><a href="#detalle">La marca</a><a href="#catalogo">Productos</a><a href="#contacto">Contacto</a>
      </nav>
      <a href="/demo/tiendas/sitega/carrito" class="rounded-full border border-black px-3 py-1.5 text-[9px] uppercase tracking-[.08em]">Carrito</a>
    </header>

    <section id="inicio" class="px-5 pb-6 sm:px-10">
      <div class="flex items-end justify-between border-t border-black pt-2 text-[8px] uppercase tracking-[.08em]"><span>ESCRITORIO</span><span>VERSIÓN ESCRITORIO</span></div>
      <h1 class="mt-8 font-display text-[clamp(5rem,17vw,12rem)] font-light leading-[.7] tracking-[-.1em]">Sitēga</h1>
      <div class="mt-10 flex items-end justify-between gap-6 text-[10px] leading-tight"><a href="#catalogo" class="rounded-full border border-black px-4 py-2 uppercase tracking-[.08em]">Ver catálogo ↗</a><p class="max-w-[230px] text-right">Una solución completa para el baño, con formas arquitectónicas sencillas y serenas.</p></div>
    </section>

    <section id="catalogo" class="grid grid-cols-2 gap-1 px-5 sm:grid-cols-4 sm:px-10">
      {cards.slice(0,3).map((card) => (
        <article data-sitega-card data-kind={card.kind} class:list={['group relative overflow-hidden bg-[#eee]', card.className]}>
          <img src={card.image} alt={card.alt} loading="eager" class="block aspect-square h-full w-full object-cover transition duration-700 group-hover:scale-[1.02]" />
          <a href={`/demo/tiendas/sitega/${card.slug}`} class="absolute inset-0" aria-label={`Ver ${productName(card.slug)}`}></a>
          <span class="absolute bottom-2 left-2 text-[7px] uppercase tracking-[.08em] text-black/60">{productName(card.slug)} ↗</span>
        </article>
      ))}
    </section>

    <section class="px-5 py-20 sm:px-10 sm:py-28"><h2 class="max-w-5xl font-display text-[clamp(2.8rem,6.2vw,6.5rem)] font-light leading-[.88] tracking-[-.065em]">Soluciones<br/>contemporáneas para el baño<sup class="text-sm">®</sup></h2></section>

    <section class="grid grid-cols-2 gap-1 px-5 sm:grid-cols-4 sm:px-10">
      <div class="flex flex-col justify-end p-4 text-[10px] leading-relaxed sm:p-8"><p>Creemos que cada detalle puede abrir una nueva experiencia: formas sencillas, materiales silenciosos y precisión al tacto.</p><a href="#detalle" class="mt-8 self-start rounded-full border border-black px-3 py-1.5 text-[8px] uppercase">Sobre la marca ↗</a></div>
      <article data-sitega-card data-kind="kollekcii" class="group relative col-span-1 overflow-hidden bg-[#eee] sm:col-span-2"><img src={`${root}/basin-table.jpg`} alt="Lavabo rectangular de Sitēga" loading="lazy" class="block aspect-[1.12] h-full w-full object-cover transition duration-700 group-hover:scale-[1.02]" /><a href="/demo/tiendas/sitega/sit-basin-table" class="absolute inset-0" aria-label="Ver Table 05"></a><span class="absolute bottom-2 left-2 text-[7px] uppercase tracking-[.08em] text-black/60">Table 05 ↗</span></article>
      <article data-sitega-card data-kind="kollekcii" class="group relative overflow-hidden bg-[#eee]"><img src={`${root}/basin-pedestal.jpg`} alt="Lavabo sobre pedestal de Sitēga" loading="lazy" class="block aspect-square h-full w-full object-cover transition duration-700 group-hover:scale-[1.02]" /><a href="/demo/tiendas/sitega/sit-basin-pedestal" class="absolute inset-0" aria-label="Ver Pedestal 08"></a><span class="absolute bottom-2 left-2 text-[7px] uppercase tracking-[.08em] text-black/60">Pedestal 08 ↗</span></article>
    </section>

    <section id="colecciones" class="px-5 py-20 sm:px-10 sm:py-28"><h2 class="font-display text-5xl font-light tracking-[-.06em] sm:text-7xl">Colecciones <sup class="text-sm">(03)</sup></h2><div class="mt-8 grid grid-cols-3 gap-2 bg-black p-2">{[['basin-soft','Soft'],['basin-black','Black'],['basin-stone','Stone']].map(([asset,label]) => <a href={`/demo/tiendas/sitega/sit-${asset}`} class="group relative aspect-square overflow-hidden bg-[#333]"><img src={`${root}/${asset}.jpg`} alt={`${label} collection`} loading="lazy" class="h-full w-full object-cover transition duration-700 group-hover:scale-[1.04]" /><span class="absolute bottom-2 left-2 text-[8px] text-white">{label} ↗</span></a>)}</div></section>

    <section class="px-5 sm:px-10"><div class="relative overflow-hidden bg-[#ddd]"><img src={`${root}/hero.jpg`} alt="Sitēga bathroom detail" loading="lazy" class="aspect-[2.1] w-full object-cover" /><span class="absolute inset-0 grid place-items-center"><span class="grid h-12 w-12 place-items-center rounded-full bg-white/90 text-sm">▶</span></span><p class="absolute bottom-2 left-2 text-[8px] uppercase">La marca</p><p class="absolute bottom-2 right-2 text-[8px] uppercase">About</p></div></section>

    <section id="detalle" class="grid gap-8 px-5 py-20 sm:grid-cols-2 sm:px-10 sm:py-28"><h2 class="font-display text-5xl font-light leading-[.88] tracking-[-.06em] sm:text-7xl">Atención a los detalles</h2><div class="flex flex-col justify-end text-[10px] leading-relaxed"><p>Nuestras soluciones ordenan el espacio sin sobrecargarlo. Cada superficie y unión está diseñada para el uso diario.</p><div class="mt-8 grid grid-cols-2 gap-1"><img src={`${root}/basin-oval.jpg`} alt="Detalle de lavabo Sitēga" loading="lazy" class="aspect-square w-full object-cover" /><img src={`${root}/faucet-wall.jpg`} alt="Detalle de grifería Sitēga" loading="lazy" class="aspect-square w-full object-cover" /></div></div></section>

    <section class="px-5 pb-20 sm:px-10"><div class="flex items-end justify-between"><h2 class="font-display text-4xl font-light tracking-[-.06em] sm:text-6xl">Productos destacados <sup class="text-sm">(08)</sup></h2><button type="button" data-sitega-filter="all" class="text-[9px] uppercase underline underline-offset-4">Ver todos ↗</button></div><div class="mt-8 grid grid-cols-2 gap-1 sm:grid-cols-4">{cards.slice(4).map((card) => <article data-sitega-card data-kind={card.kind} class="group relative overflow-hidden bg-[#eee]"><img src={card.image} alt={card.alt} loading="lazy" class="aspect-square w-full object-cover transition duration-700 group-hover:scale-[1.02]" /><a href={`/demo/tiendas/sitega/${card.slug}`} class="absolute inset-0" aria-label={`Ver ${productName(card.slug)}`}></a><span class="absolute bottom-2 left-2 text-[7px] uppercase">{productName(card.slug)} ↗</span></article>)}</div></section>

    <footer id="contacto" class="bg-[#111] px-5 py-14 text-white sm:px-10"><p class="text-center font-display text-3xl font-light">Sitēga</p><nav class="mx-auto mt-6 flex max-w-md justify-center gap-5 text-[8px] uppercase tracking-[.08em] text-white/60"><a href="#catalogo">Catálogo</a><a href="#colecciones">Colecciones</a><a href="#detalle">La marca</a><a href="#contacto">Contacto</a></nav><div class="mt-20 flex justify-between text-[8px] text-white/45"><span>Privacidad</span><span>© 2026 Sitēga</span><span>Condiciones</span></div></footer>
  </div>
</main>

<style>
  .sitega-shell { min-height: 100vh; }
  .sitega-page { box-shadow: 0 0 0 1px rgba(0,0,0,.04); }
  .sitega-card--large { grid-row: span 2; grid-column: span 2; }
  .sitega-card--wide { grid-column: span 2; }
  @media (max-width: 639px) { .sitega-card--large, .sitega-card--wide { grid-row: auto; grid-column: auto; } }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-sitega-filter]').forEach((button) => button.addEventListener('click', () => document.querySelectorAll<HTMLElement>('[data-sitega-card]').forEach((card) => card.classList.remove('hidden'))));
</script>
