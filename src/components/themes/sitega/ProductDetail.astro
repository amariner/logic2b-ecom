---
import type { ProductRow } from '../../../lib/db';
import { parseSpecs } from '../../../lib/db';
import { formatEurCents } from '../../../lib/format';

interface Props { product: ProductRow }
const { product } = Astro.props;
const specs = parseSpecs(product.specs_json);
---

<div class="bg-[#f7f7f5] text-[#111]">
  <article class="grid min-h-[calc(100vh-56px)] bg-white md:grid-cols-[1.2fr_.8fr]">
    <div class="flex min-h-[58vh] items-center justify-center bg-[#ececea] p-5 sm:p-8 md:min-h-0 md:p-14" data-commerce-part="media"><img src={product.image} alt={product.name} width="800" height="800" fetchpriority="high" class="aspect-square max-h-[78vh] w-full object-contain" /></div>
    <div class="flex flex-col justify-between p-7 md:p-14" data-commerce-part="details">
      <div><p class="text-[9px] uppercase tracking-[.18em] text-black/60">{product.category} / SITĒGA</p><h1 class="mt-6 font-display text-6xl font-light leading-[.82] tracking-[-.075em] md:text-8xl">{product.name}</h1>{product.subtitle && <p class="mt-4 text-[10px] uppercase tracking-[.12em] text-black/60">{product.subtitle}</p>}<p class="mt-6 text-xl">{formatEurCents(product.price_cents)}</p><p class="mt-10 max-w-md text-sm leading-relaxed text-black/60">{product.description}</p>{specs.length > 0 && <dl class="mt-10 divide-y divide-black/10 border-y border-black/10 text-sm">{specs.map((spec) => <div class="flex justify-between py-3"><dt class="text-black/60">{spec.label}</dt><dd>{spec.value}</dd></div>)}</dl>}</div>
      <div class="mt-10" data-commerce-part="purchase">{product.stock > 0 ? <button type="button" data-commerce-action="add-to-cart" data-product-slug={product.slug} class="w-full rounded-full bg-black px-6 py-4 text-[10px] uppercase tracking-[.15em] text-white">Añadir al carrito</button> : <p class="text-[10px] uppercase tracking-[.15em] text-black/60">Agotado temporalmente</p>}<p class="mt-4 text-center text-xs text-black/60">Demo visual · no se realizará ningún cobro</p></div>
    </div>
  </article>
</div>
