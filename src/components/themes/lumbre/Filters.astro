---
/** LUMBRE · navegación GET discreta de catálogo. */
import type { CollectionConfig, StorePaths } from '../../../collections';
interface Props { paths: StorePaths; collection: CollectionConfig; count: number; activeCategory?: string | undefined; sort: string; search?: string | undefined; }
const { paths, collection, count, activeCategory, sort, search } = Astro.props;
const hrefFor = (category?: string): string => {
  const params = new URLSearchParams();
  if (category) params.set('categoria', category);
  if (sort !== 'featured') params.set('orden', sort);
  if (search) params.set('q', search);
  const query = params.toString();
  return `${paths.catalog}${query ? `?${query}` : ''}`;
};
---

<div class="lumbre-filters">
  <nav aria-label="Categorías LUMBRE"><span>{count.toString().padStart(2, '0')} piezas</span><a href={hrefFor()} aria-current={!activeCategory ? 'page' : undefined}>Todas</a>{collection.categories.map((item) => <a href={hrefFor(item.id)} aria-current={activeCategory === item.id ? 'page' : undefined}>{item.label}</a>)}</nav>
  <form method="get" action={paths.catalog} role="search">
    {activeCategory && <input type="hidden" name="categoria" value={activeCategory} />}
    <input type="search" name="q" value={search} maxlength="60" placeholder="Buscar" aria-label="Buscar luminarias" />
    <select name="orden" aria-label="Ordenar luminarias" onchange="this.form.submit()"><option value="featured" selected={sort === 'featured'}>Selección</option><option value="price-asc" selected={sort === 'price-asc'}>Precio ↑</option><option value="price-desc" selected={sort === 'price-desc'}>Precio ↓</option><option value="name" selected={sort === 'name'}>Nombre A–Z</option></select>
  </form>
</div>

<style>
  .lumbre-filters { display: flex; align-items: center; justify-content: flex-end; gap: 1.2rem; font-size: .55rem; letter-spacing: .035em; text-transform: uppercase; }
  .lumbre-filters nav, .lumbre-filters form { display: flex; align-items: center; gap: clamp(.7rem, 1.3vw, 1.25rem); }
  .lumbre-filters nav > span { color: var(--lum-muted); }
  .lumbre-filters a { display: inline-flex; min-height: 2.75rem; align-items: center; }
  .lumbre-filters a[aria-current='page'], .lumbre-filters a:hover, .lumbre-filters a:focus-visible { text-decoration: underline; text-underline-offset: .25rem; }
  .lumbre-filters input, .lumbre-filters select { min-height: 2.5rem; border: 0; border-bottom: var(--border-width) solid var(--lum-rule); border-radius: 0; color: var(--lum-ink); background: transparent; font: inherit; letter-spacing: inherit; text-transform: uppercase; }
  .lumbre-filters input { width: 5.5rem; }
  .lumbre-filters input::placeholder { color: var(--lum-muted); }
  @media (max-width: 820px) { .lumbre-filters { align-items: stretch; flex-direction: column; } .lumbre-filters nav { overflow-x: auto; } .lumbre-filters nav > * { flex: 0 0 auto; } .lumbre-filters form { justify-content: space-between; } .lumbre-filters input { width: 7rem; } }
</style>
