---
/** ALVA · home editorial de marroquinería y catálogo filtrable. */
import type { CollectionConfig, StorePaths } from '../../../collections';
import Filters from './Filters.astro';
import ProductGrid from './ProductGrid.astro';

type GridProduct = { slug: string; name: string; price_cents: number; image: string; stock: number; };
interface Props { paths: StorePaths; products: GridProduct[]; collection: CollectionConfig; category?: string | undefined; sort: string; search?: string | undefined; }

const { paths, products, collection, category, sort, search } = Astro.props;
const editorial = !category && !search && sort === 'featured';
const FEATURED = [
  'alv-lina-shoulder-black', 'alv-lina-shoulder-sand', 'alv-clay-clutch-black', 'alv-clay-clutch-chocolate',
  'alv-milda-sandal-black', 'alv-milda-sandal-brown', 'alv-liv-leather-clog', 'alv-simone-leather-sandal',
];
const rank = new Map(FEATURED.map((slug, index) => [slug, index]));
const ordered = products.toSorted((a, b) => (rank.get(a.slug) ?? 99) - (rank.get(b.slug) ?? 99));
---

<div class="alva-stage">
  <div class="alva">
    <header class="alva-header">
      <a class="alva-wordmark" href={paths.catalog}>{collection.name}</a>
      <nav class="alva-nav" aria-label="Colecciones ALVA">
        <a href={`${paths.catalog}?categoria=alv-shoes`}>Calzado</a>
        <a href={`${paths.catalog}?categoria=alv-bags`}>Bolsos</a>
        <a href="#atelier">Atelier</a>
        <a href="#cuidados">Cuidados</a>
      </nav>
      <nav class="alva-actions" aria-label="Acciones de tienda">
        <a href={`${paths.catalog}?orden=name`}>Índice</a>
        <a href={paths.cart}>Bolsa <span data-cart-count>0</span></a>
      </nav>
    </header>

    {editorial ? (
      <main>
        <section class="alva-hero" aria-labelledby="alva-title">
          <article class="alva-hero__panel alva-hero__panel--portrait">
            <img src="/images/collections/alva/hero-studio.webp" alt="Modelo con chaqueta marfil y bolso de piel negra ALVA" width="1200" height="1600" loading="eager" fetchpriority="high" />
            <div class="alva-hero__copy"><h1 id="alva-title">{collection.tagline}</h1><a href="#bolsos">Edición 01 / Explorar</a></div>
          </article>
          <article class="alva-hero__panel">
            <img src="/images/collections/alva/hero-object.webp" alt="Bolso saco negro suspendido sobre una forma de satén marfil" width="1200" height="1600" loading="eager" />
          </article>
        </section>

        <section id="bolsos" aria-labelledby="alva-bags-title">
          <div class="alva-section-heading"><h2 id="alva-bags-title">Bolsos / Edición permanente</h2><a href={`${paths.catalog}?categoria=alv-bags`}>Ver los cuatro</a></div>
          <ProductGrid paths={paths} products={ordered.slice(0, 4)} />
        </section>

        <section class="alva-editorial" id="atelier" aria-label="El atelier ALVA">
          <a href={`${paths.catalog}?categoria=alv-shoes`}>
            <img src="/images/collections/alva/editorial-sandal.webp" alt="Sandalia negra suspendida sobre una forma escultórica marfil" width="1200" height="1600" loading="lazy" />
            <span>Forma / Materia</span>
          </a>
          <a href={`${paths.catalog}?categoria=alv-shoes`}>
            <img src="/images/collections/alva/editorial-walk.webp" alt="Modelo caminando con sandalias negras junto a una pared de piedra" width="1200" height="1600" loading="lazy" />
            <span>Cuaderno de verano</span>
          </a>
        </section>

        <section aria-labelledby="alva-shoes-title">
          <div class="alva-section-heading"><h2 id="alva-shoes-title">Calzado / Verano sereno</h2><a href={`${paths.catalog}?categoria=alv-shoes`}>Ver los cuatro</a></div>
          <ProductGrid paths={paths} products={ordered.slice(4)} />
        </section>
      </main>
    ) : (
      <main class="alva-catalog">
        <div class="alva-catalog__heading"><p>Archivo ALVA / {products.length} piezas</p><h1>{category ? collection.categories.find((item) => item.id === category)?.label : search ? `Resultados para «${search}»` : 'Colección completa'}</h1></div>
        <Filters paths={paths} collection={collection} count={products.length} activeCategory={category} sort={sort} search={search} />
        {ordered.length > 0 ? <ProductGrid paths={paths} products={ordered} /> : <div class="alva-empty"><p>{search ? `Nada por aquí para «${search}»` : 'No hay piezas en esta categoría'}</p><a href={paths.catalog}>Volver a la colección</a></div>}
      </main>
    )}

    <footer class="alva-footer" id="cuidados">
      <div class="alva-footer__top">
        <section><h2>Cartas desde el atelier</h2><p>Notas sobre materiales, cuidados y nuevas ediciones. Sin ruido.</p><a href="mailto:hola@logic2b.com">Suscribirme por email →</a></section>
        <section><h2>Una compra consciente</h2><p>Producimos en series pequeñas y trabajamos con talleres especializados en piel. Cada pieza incluye una guía de cuidado.</p><a href="/">Conocer Logic2B Ecommerce →</a></section>
      </div>
      <div class="alva-footer__bottom"><a class="alva-footer__wordmark" href={paths.catalog}>{collection.name}</a><nav aria-label="Pie de ALVA"><a href={paths.catalog} aria-current={editorial ? 'page' : undefined}>Tienda</a><a href={paths.cart}>Bolsa</a><a href="/">Logic2B</a></nav></div>
    </footer>
  </div>
</div>

<style>
  :global([data-store-theme='alva'] > header), :global([data-store-theme='alva'] > .shop-footer) { display: none; }
  .alva-stage { min-height: 100vh; padding: clamp(0rem, 3vw, 2.5rem) 0; color: var(--color-foreground); background: var(--color-brand-dark); }
  .alva { width: min(100%, 74rem); margin-inline: auto; color: var(--color-foreground); background: var(--color-background); font-family: var(--font-accent); }
  .alva :where(a) { color: inherit; text-decoration: none; }
  .alva-header { position: sticky; top: 0; z-index: 30; display: grid; min-height: 3.45rem; grid-template-columns: 1fr auto 1fr; align-items: center; padding: .65rem .8rem; border-bottom: var(--border-width) solid var(--color-border); background: color-mix(in srgb, var(--color-background) 96%, transparent); backdrop-filter: blur(12px); }
  .alva-wordmark { font: var(--weight-display) 1.5rem/.8 var(--font-display); letter-spacing: var(--tracking-display); }
  .alva-nav, .alva-actions { display: flex; align-items: center; gap: clamp(.75rem, 1.6vw, 1.4rem); font-size: .54rem; }
  .alva-actions { justify-content: flex-end; }
  .alva-header nav a { display: inline-flex; min-height: 2rem; align-items: center; }
  .alva-header nav a:hover, .alva-footer a:hover { text-decoration: underline; text-underline-offset: .22rem; }
  .alva-hero { display: grid; min-height: 43rem; grid-template-columns: 1fr 1fr; background: var(--color-border); gap: var(--grid-gap); }
  .alva-hero__panel { position: relative; min-width: 0; overflow: hidden; background: var(--surface-sunken); }
  .alva-hero__panel img { width: 100%; height: 100%; min-height: 43rem; object-fit: cover; }
  .alva-hero__panel--portrait img { object-position: center 35%; }
  .alva-hero__copy { position: absolute; bottom: 1rem; left: 1rem; max-width: 25rem; padding: .75rem .8rem; color: #fff; background: color-mix(in srgb, var(--color-brand-dark) 92%, transparent); backdrop-filter: blur(8px); }
  .alva-hero__copy h1 { max-width: 23rem; font: var(--weight-display) clamp(1.25rem, 2.3vw, 2.2rem)/.98 var(--font-display); letter-spacing: var(--tracking-display); }
  .alva-hero__copy a { display: inline-flex; min-height: 2rem; align-items: center; margin-top: .4rem; font-size: .53rem; }
  .alva-section-heading { display: flex; min-height: 2.8rem; align-items: center; justify-content: space-between; padding: .65rem .6rem; border-top: var(--border-width) solid var(--color-border); border-bottom: var(--border-width) solid var(--color-border); font-size: .53rem; }
  .alva-section-heading h2 { font: inherit; }
  .alva-section-heading a { display: inline-flex; min-height: 2rem; align-items: center; }
  .alva-editorial { display: grid; grid-template-columns: 1fr 1fr; background: var(--color-border); gap: var(--grid-gap); }
  .alva-editorial a { position: relative; display: block; min-height: 43rem; overflow: hidden; background: var(--surface-sunken); }
  .alva-editorial img { width: 100%; height: 100%; min-height: 43rem; object-fit: cover; transition: transform .45s ease; }
  .alva-editorial a:hover img { transform: scale(1.012); }
  .alva-editorial span { position: absolute; bottom: .65rem; left: .65rem; padding: .3rem .4rem; color: var(--color-foreground); background: color-mix(in srgb, var(--color-background) 90%, transparent); font-size: .52rem; backdrop-filter: blur(8px); }
  .alva-catalog__heading { display: flex; min-height: 13rem; flex-direction: column; justify-content: space-between; padding: .8rem; border-bottom: var(--border-width) solid var(--color-border); background: var(--surface-sunken); }
  .alva-catalog__heading p { color: var(--color-muted-foreground); font-size: .54rem; text-transform: uppercase; }
  .alva-catalog__heading h1 { font: var(--weight-display) clamp(2.5rem, 7vw, 6.5rem)/.82 var(--font-display); letter-spacing: var(--tracking-display); }
  .alva-empty { padding: 7rem 1rem; text-align: center; background: var(--surface-sunken); }
  .alva-empty p { font: var(--weight-display) 1.4rem/1 var(--font-display); }
  .alva-empty a { display: inline-block; margin-top: 1rem; font-size: .6rem; text-decoration: underline; text-underline-offset: .22rem; }
  .alva-footer { border-top: var(--border-width) solid var(--color-border); }
  .alva-footer__top { display: grid; grid-template-columns: 1fr 1fr; background: var(--color-border); gap: var(--grid-gap); }
  .alva-footer__top section { min-height: 10rem; padding: 1rem; background: var(--color-background); }
  .alva-footer__top h2 { font: var(--weight-display) .95rem/1 var(--font-display); }
  .alva-footer__top p { max-width: 26rem; margin-top: 2rem; color: var(--color-muted-foreground); font-size: .55rem; line-height: 1.5; }
  .alva-footer__top a { display: inline-block; margin-top: .8rem; font-size: .55rem; }
  .alva-footer__bottom { display: flex; min-height: 15rem; align-items: flex-end; justify-content: space-between; padding: 1rem; }
  .alva-footer__wordmark { font: var(--weight-display) clamp(5rem, 13vw, 10rem)/.68 var(--font-display); letter-spacing: var(--tracking-display); }
  .alva-footer__bottom nav { display: flex; gap: .8rem; font-size: .52rem; }
  .alva-footer__bottom nav a { display: inline-flex; min-height: 2rem; align-items: center; }
  @media (max-width: 720px) {
    .alva-stage { padding: 0; }
    .alva-header { grid-template-columns: 1fr auto; padding-inline: .65rem; }
    .alva-nav { order: 3; grid-column: 1 / -1; justify-content: space-between; overflow-x: auto; border-top: var(--border-width) solid var(--color-border); }
    .alva-nav a { flex: 0 0 auto; }
    .alva-actions a:first-child { display: none; }
    .alva-hero { min-height: 0; grid-template-columns: 1fr; }
    .alva-hero__panel img { min-height: 0; aspect-ratio: 3 / 4; }
    .alva-editorial { grid-template-columns: 1fr; }
    .alva-editorial a, .alva-editorial img { min-height: 0; aspect-ratio: 3 / 4; }
    .alva-footer__top { grid-template-columns: 1fr; }
    .alva-footer__bottom { min-height: 11rem; align-items: center; flex-direction: column; justify-content: center; gap: 1rem; }
  }
  @media (prefers-reduced-motion: reduce) { .alva-editorial img { transition: none; } }
</style>
