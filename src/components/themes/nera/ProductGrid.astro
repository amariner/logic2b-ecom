---
/** NERA · cuadrícula de prendas aisladas con filetes mínimos. */
import type { StorePaths } from '../../../collections';
import { formatEurCents } from '../../../lib/format';

type GridProduct = { slug: string; name: string; price_cents: number; image: string; stock: number; };
interface Props { paths: StorePaths; products: GridProduct[]; }
const { paths, products } = Astro.props;
---

<ul class="nera-grid">
  {products.map((product, index) => (
    <li class="nera-card">
      <a class="nera-card__link" href={paths.product(product.slug)}>
        <div class="nera-card__media"><img src={product.image} alt={product.name} width="1024" height="1024" loading={index < 4 ? 'eager' : 'lazy'} /></div>
        <div class="nera-card__copy"><h3>{product.name}</h3><p>{formatEurCents(product.price_cents)}</p></div>
      </a>
      <button class="nera-card__add" type="button" data-nera-add={product.slug} disabled={product.stock === 0} aria-label={product.stock === 0 ? `${product.name} agotado` : `Añadir ${product.name} al carrito`}>{product.stock === 0 ? '×' : '+'}</button>
    </li>
  ))}
</ul>

<script>
  import { addToCart } from '../../../lib/cart-client';
  document.querySelectorAll<HTMLButtonElement>('[data-nera-add]').forEach((button) => {
    button.addEventListener('click', () => {
      addToCart(button.dataset.neraAdd ?? '');
      const previous = button.textContent;
      button.textContent = '✓';
      setTimeout(() => (button.textContent = previous), 850);
    });
  });
</script>

<style>
  .nera-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); margin: 0; padding: 0; list-style: none; background: var(--color-border); gap: var(--grid-gap); }
  .nera-card { position: relative; min-width: 0; color: var(--color-foreground); background: var(--color-background); }
  .nera-card__link { display: block; }
  .nera-card__media { display: grid; aspect-ratio: 1 / 1.08; place-items: center; overflow: hidden; background: var(--surface-product); }
  .nera-card__media img { width: 100%; height: 100%; object-fit: contain; padding: 7%; transition: transform .35s ease; }
  .nera-card:hover .nera-card__media img { transform: scale(1.022); }
  .nera-card__copy { min-height: 4.3rem; padding: .75rem .45rem 1rem; text-align: center; text-transform: uppercase; font-size: .56rem; line-height: 1.35; }
  .nera-card__copy h3 { font: inherit; }
  .nera-card__copy p { margin-top: .25rem; color: var(--color-muted-foreground); }
  .nera-card__add { position: absolute; z-index: 2; top: .55rem; right: .55rem; display: grid; width: 2rem; height: 2rem; place-items: center; border: var(--border-width) solid var(--color-border); border-radius: var(--radius-btn); color: var(--color-foreground); background: color-mix(in srgb, var(--color-background) 90%, transparent); font: 500 .9rem/1 var(--font-accent); cursor: pointer; }
  .nera-card__add:hover { color: var(--color-brand-fg); background: var(--color-brand); }
  .nera-card__add:disabled { cursor: not-allowed; opacity: .4; }
  .nera-card__add:focus-visible, .nera-card__link:focus-visible { outline: .16rem solid var(--color-brand); outline-offset: -.16rem; }
  @media (max-width: 720px) {
    .nera-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .nera-card__media { aspect-ratio: 1; }
    .nera-card__copy { min-height: 4rem; padding-inline: .3rem; }
  }
  @media (prefers-reduced-motion: reduce) { .nera-card__media img { transition: none; } }
</style>
