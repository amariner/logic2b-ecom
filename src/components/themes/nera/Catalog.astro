---
/** NERA · home editorial de sastrería y catálogo filtrable. */
import type { CollectionConfig, StorePaths } from '../../../collections';
import Filters from './Filters.astro';
import ProductGrid from './ProductGrid.astro';

type GridProduct = {
  slug: string;
  name: string;
  price_cents: number;
  image: string;
  stock: number;
};

interface Props {
  paths: StorePaths;
  products: GridProduct[];
  collection: CollectionConfig;
  category?: string | undefined;
  sort: string;
  search?: string | undefined;
}

const { paths, products, collection, category, sort, search } = Astro.props;
const editorial = !category && !search && sort === 'featured';
const FEATURED = [
  'ner-blazer-negra',
  'ner-pantalon-palazzo',
  'ner-blazer-azul',
  'ner-chaleco-estructura',
  'ner-vestido-columna',
  'ner-pantalon-arcilla',
  'ner-jersey-gris',
  'ner-top-bandeau',
];
const rank = new Map(FEATURED.map((slug, index) => [slug, index]));
const ordered = products.toSorted((a, b) => (rank.get(a.slug) ?? 99) - (rank.get(b.slug) ?? 99));
---

<div class="nera">
  <header class="nera-header">
    <nav class="nera-header__menu" aria-label="Menú NERA">
      <a href={paths.catalog} aria-label="Ver toda la colección" aria-current={editorial ? 'page' : undefined}><span aria-hidden="true">☰</span><span>Catálogo</span></a>
    </nav>
    <a class="nera-wordmark" href={paths.catalog}>{collection.name}</a>
    <nav class="nera-header__actions" aria-label="Acciones de tienda">
      <a href={`${paths.catalog}?orden=name`}>Índice</a>
      <a href={paths.cart}>Bolsa <span data-cart-count>0</span></a>
    </nav>
  </header>

  {editorial ? (
    <main>
      <section class="nera-hero" aria-labelledby="nera-title">
        <img src="/images/collections/nera/hero-campaign.webp" alt="Dos modelos con sastrería negra y azul acero en un estudio claro" width="2048" height="1152" loading="eager" fetchpriority="high" />
        <h1 id="nera-title" class="nera-hero__title">{collection.tagline}</h1>
        <a class="nera-hero__cta" href="#coleccion">Ver colección</a>
      </section>

      <section class="nera-products" id="coleccion" aria-labelledby="nera-bestsellers">
        <div class="nera-section-label"><h2 id="nera-bestsellers">Selección</h2><span>01 — 04</span></div>
        <ProductGrid paths={paths} products={ordered.slice(0, 4)} />
      </section>

      <section class="nera-mosaic" aria-label="Colecciones NERA">
        <a class="nera-story nera-story--tailoring" href={`${paths.catalog}?categoria=ner-tailoring`}>
          <img src="/images/collections/nera/editorial-tailoring.webp" alt="Modelo con chaleco de sastrería gris y pantalón negro" width="1536" height="2048" loading="lazy" />
          <span>Sastrería</span>
        </a>
        <a class="nera-story nera-story--dress" href={`${paths.catalog}?categoria=ner-tops`}>
          <img src="/images/collections/nera/ner-vestido-columna.webp" alt="Vestido negro de silueta columna" width="1024" height="1024" loading="lazy" />
          <span>Vestidos y tops</span>
        </a>
        <a class="nera-story nera-story--knit" href={`${paths.catalog}?categoria=ner-knit`}>
          <img src="/images/collections/nera/editorial-knit.webp" alt="Modelo sentada con jersey gris de cuello vuelto" width="1536" height="2048" loading="lazy" />
          <span>Punto</span>
        </a>
        <div class="nera-tiles">
          <a href={`${paths.catalog}?categoria=ner-tailoring`}><span>Blazers</span><img src="/images/collections/nera/ner-blazer-azul.webp" alt="Blazer azul acero" width="1024" height="1024" loading="lazy" /></a>
          <a href={`${paths.catalog}?categoria=ner-pants`}><span>Pantalones</span><img src="/images/collections/nera/ner-pantalon-arcilla.webp" alt="Pantalón de sastrería color arcilla" width="1024" height="1024" loading="lazy" /></a>
          <a href={`${paths.catalog}?categoria=ner-tops`}><span>Tops</span><img src="/images/collections/nera/ner-top-bandeau.webp" alt="Top bandeau negro" width="1024" height="1024" loading="lazy" /></a>
        </div>
      </section>

      <section class="nera-products" aria-labelledby="nera-new">
        <div class="nera-section-label"><h2 id="nera-new">Nueva edición</h2><span>05 — 08</span></div>
        <ProductGrid paths={paths} products={ordered.slice(4)} />
      </section>
    </main>
  ) : (
    <main class="nera-catalog">
      <div class="nera-catalog__heading">
        <p>Edición permanente / {products.length} piezas</p>
        <h1>{category ? collection.categories.find((item) => item.id === category)?.label : 'Colección completa'}</h1>
      </div>
      <Filters paths={paths} collection={collection} count={products.length} activeCategory={category} sort={sort} search={search} />
      {search && products.length > 0 && <p class="nera-results">{products.length} {products.length === 1 ? 'resultado' : 'resultados'} para «{search}»</p>}
      {ordered.length > 0 ? <ProductGrid paths={paths} products={ordered} /> : (
        <div class="nera-empty"><p>{search ? `Nada por aquí para «${search}»` : 'No hay piezas en esta categoría'}</p><a href={paths.catalog}>Volver a la colección</a></div>
      )}
    </main>
  )}

  <footer class="nera-footer">
    <a class="nera-footer__wordmark" href={paths.catalog}>{collection.name}</a>
    <p>Siluetas precisas. Series pequeñas. Madrid / 2026.</p>
    <nav aria-label="Pie de NERA"><a href={paths.catalog} aria-current={editorial ? 'page' : undefined}>Colección</a><a href={paths.cart}>Bolsa</a><a href="/">Logic2B Ecommerce</a></nav>
  </footer>
</div>

<style>
  :global([data-store-theme='nera'] > header),
  :global([data-store-theme='nera'] > .shop-footer) { display: none; }
  .nera { min-height: 100vh; color: var(--color-foreground); background: var(--color-background); font-family: var(--font-accent); }
  .nera :where(a) { color: inherit; text-decoration: none; }
  .nera-header { position: sticky; top: 0; z-index: 30; display: grid; min-height: 3.3rem; grid-template-columns: 1fr auto 1fr; align-items: center; padding: .65rem 1rem; border-bottom: var(--border-width) solid var(--color-border); background: color-mix(in srgb, var(--color-background) 96%, transparent); backdrop-filter: blur(12px); font-size: .58rem; text-transform: uppercase; }
  .nera-header__menu a, .nera-header__actions { display: flex; align-items: center; gap: 1rem; }
  .nera-header__menu a { min-height: 2rem; }
  .nera-header__menu a span:first-child { font-size: .8rem; }
  .nera-header__actions { justify-content: flex-end; }
  .nera-header a:hover { text-decoration: underline; text-underline-offset: .22rem; }
  .nera-wordmark { font: var(--weight-display) 1.2rem/1 var(--font-display); letter-spacing: var(--tracking-display); }
  .nera-hero { position: relative; aspect-ratio: 16 / 9; min-height: 30rem; overflow: hidden; border-bottom: var(--border-width) solid var(--color-border); background: var(--surface-product); }
  .nera-hero img { width: 100%; height: 100%; object-fit: cover; }
  .nera-hero__title { position: absolute; bottom: 1rem; left: 1rem; max-width: 18rem; padding: .55rem .7rem; color: var(--color-foreground); background: color-mix(in srgb, var(--color-background) 90%, transparent); font: var(--weight-display) clamp(.8rem, 1.5vw, 1.15rem)/1 var(--font-display); letter-spacing: var(--tracking-display); text-transform: uppercase; backdrop-filter: blur(8px); }
  .nera-hero__cta { position: absolute; left: 50%; top: 60%; display: inline-flex; min-height: 2.75rem; align-items: center; padding: .65rem 1rem; transform: translateX(-50%); border: var(--border-width) solid var(--color-foreground); color: var(--color-foreground); background: color-mix(in srgb, var(--color-background) 88%, transparent); font-size: .58rem; text-transform: uppercase; backdrop-filter: blur(8px); }
  .nera-hero__cta:hover { color: var(--color-brand-fg); background: var(--color-brand); }
  .nera-products { border-bottom: var(--border-width) solid var(--color-border); }
  .nera-section-label { display: flex; align-items: center; justify-content: space-between; min-height: 2.8rem; padding: .7rem 1rem; border-bottom: var(--border-width) solid var(--color-border); font-size: .55rem; text-transform: uppercase; }
  .nera-section-label h2 { font: inherit; }
  .nera-section-label span { color: var(--color-muted-foreground); }
  .nera-mosaic { display: grid; grid-template-columns: 1fr 1fr; border-bottom: var(--border-width) solid var(--color-border); background: var(--color-border); gap: var(--grid-gap); }
  .nera-story { position: relative; display: block; min-height: 48rem; overflow: hidden; background: var(--surface-product); }
  .nera-story img { width: 100%; height: 100%; object-fit: cover; transition: transform .5s ease; }
  .nera-story:hover img { transform: scale(1.012); }
  .nera-story span, .nera-tiles span { position: absolute; z-index: 1; top: .65rem; left: .65rem; font-size: .56rem; text-transform: uppercase; }
  .nera-story--tailoring img { object-position: center 18%; }
  .nera-story--dress img { object-fit: contain; padding: 5%; }
  .nera-story--knit { min-height: 50rem; }
  .nera-tiles { display: grid; min-height: 50rem; grid-template-columns: 1fr 1fr; grid-template-rows: 1fr 1fr; gap: var(--grid-gap); background: var(--color-border); }
  .nera-tiles a { position: relative; overflow: hidden; background: var(--surface-product); }
  .nera-tiles a:first-child { grid-row: 1 / 2; }
  .nera-tiles a:nth-child(2) { grid-row: 2 / 3; }
  .nera-tiles a:nth-child(3) { grid-row: 1 / 3; }
  .nera-tiles img { width: 100%; height: 100%; object-fit: contain; padding: 8%; transition: transform .35s ease; }
  .nera-tiles a:hover img { transform: scale(1.025); }
  .nera-catalog__heading { display: flex; min-height: 13rem; flex-direction: column; justify-content: space-between; padding: 1rem; border-bottom: var(--border-width) solid var(--color-border); background: var(--surface-sunken); }
  .nera-catalog__heading p { color: var(--color-muted-foreground); font-size: .55rem; text-transform: uppercase; }
  .nera-catalog__heading h1 { font: var(--weight-display) clamp(2rem, 4.5vw, 4.8rem)/.9 var(--font-display); letter-spacing: var(--tracking-display); text-transform: uppercase; }
  .nera-results { padding: .8rem 1rem; border-bottom: var(--border-width) solid var(--color-border); color: var(--color-muted-foreground); font-size: .62rem; }
  .nera-empty { padding: 7rem 1rem; text-align: center; background: var(--surface-sunken); }
  .nera-empty p { font: var(--weight-display) 1.3rem/1.1 var(--font-display); text-transform: uppercase; }
  .nera-empty a { display: inline-block; margin-top: 1rem; font-size: .62rem; text-decoration: underline; text-underline-offset: .24rem; }
  .nera-footer { display: grid; min-height: 16rem; place-items: center; align-content: center; gap: 1rem; padding: 3rem 1rem; text-align: center; background: var(--surface-sunken); }
  .nera-footer__wordmark { font: var(--weight-display) clamp(4rem, 10vw, 9rem)/.75 var(--font-display); letter-spacing: var(--tracking-display); }
  .nera-footer p { color: var(--color-muted-foreground); font-size: .58rem; text-transform: uppercase; }
  .nera-footer nav { display: flex; gap: 1rem; font-size: .56rem; text-transform: uppercase; }
  .nera-footer nav a { display: inline-flex; min-height: 2rem; align-items: center; }

  @media (max-width: 720px) {
    .nera-header { grid-template-columns: 1fr auto 1fr; padding-inline: .65rem; }
    .nera-header__menu a span:last-child, .nera-header__actions a:first-child { display: none; }
    .nera-hero { min-height: 0; aspect-ratio: 4 / 5; }
    .nera-hero img { object-position: center; }
    .nera-hero__cta { top: auto; bottom: 12%; }
    .nera-mosaic { grid-template-columns: 1fr; }
    .nera-story, .nera-story--knit { min-height: 118vw; }
    .nera-tiles { min-height: 125vw; }
  }
  @media (prefers-reduced-motion: reduce) {
    .nera-story img, .nera-tiles img { transition: none; }
  }
</style>
