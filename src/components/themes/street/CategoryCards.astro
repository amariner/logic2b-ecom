---
/**
 * STREET · CategoryCards — la fila de 3 tarjetas editoriales de la referencia:
 * foto de campaña con antetítulo pequeño y título superpuesto.
 *
 * CONTRASTE SOBRE FOTO (lo que el auditor NO ve): las tres imágenes tienen
 * zonas claras y oscuras, así que el copy va sobre un degradado oscuro sólido
 * en la mitad inferior — no sobre la foto pelada. Medido sobre píxeles reales,
 * ver docs/temas/street.md.
 *
 * Los destinos son categorías REALES de la colección: la tarjeta filtra el
 * catálogo de verdad, no es un cartel decorativo.
 */
import type { CollectionConfig, StorePaths } from '../../../lib/collections';

interface Props {
  collection: CollectionConfig;
  paths: StorePaths;
}

const { collection, paths } = Astro.props;

/**
 * Las 3 tarjetas editoriales, cada una atada a una categoría real. Si una
 * colección no tiene esa categoría, la tarjeta no se pinta (no se inventa un
 * enlace roto).
 */
const CARDS = [
  { categoryId: 'str-calzado', eyebrow: 'Rueda todos los días', image: '/images/collections/street/cat-calzado.webp' },
  { categoryId: 'str-prendas', eyebrow: 'Para cuando refresca', image: '/images/collections/street/cat-prendas.webp' },
  { categoryId: 'str-complementos', eyebrow: 'Lo que cabe en el bolsillo', image: '/images/collections/street/cat-club.webp' },
];

const cards = CARDS.flatMap((card) => {
  const category = collection.categories.find((cat) => cat.id === card.categoryId);
  return category ? [{ ...card, label: category.label }] : [];
});
---

{cards.length > 0 && (
  <ul class="street-cats">
    {cards.map((card) => (
      <li class="street-cat">
        <img class="street-cat__img" src={card.image} alt="" width="720" height="900" loading="lazy" />
        <div class="street-cat__body">
          <p class="street-cat__eyebrow">{card.eyebrow}</p>
          <h2 class="street-cat__title">
            <a class="street-cat__link" href={`${paths.catalog}?categoria=${card.categoryId}`}>{card.label}</a>
          </h2>
        </div>
      </li>
    ))}
  </ul>
)}

<style>
  .street-cats {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--grid-gap);
  }

  @media (min-width: 768px) {
    .street-cats { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  .street-cat {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border-radius: var(--radius-card);
    background: var(--color-surface-product);
    aspect-ratio: 4 / 5;
  }

  .street-cat__img {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .street-cat:hover .street-cat__img { transform: scale(1.04); }

  @media (prefers-reduced-motion: reduce) {
    .street-cat__img { transition: none; }
    .street-cat:hover .street-cat__img { transform: none; }
  }

  /* PLANCHA DE CONTRASTE — va como `background-color` SÓLIDO del bloque de
     texto, no como degradado sobre un pseudo-elemento del padre.
     El motivo es de auditoría: `scripts/a11y-audit.mjs` calcula el fondo
     efectivo recorriendo el `background-color` computado de los ancestros. Un
     degradado es `background-image` y le resulta invisible, así que veía el
     copy blanco «sobre» el gris claro de la tarjeta y cantaba 1,08:1 cuando en
     pantalla son 13:1. Con la plancha sólida aquí, lo que mide el auditor y lo
     que ve el ojo son lo mismo — que es justo lo que se le pide a un auditor. */
  .street-cat__body {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    padding: clamp(1rem, 2.5vw, 1.75rem);
    background-color: rgb(12 12 12 / 0.88);
  }

  /* Rampa suave de la foto a la plancha, para que no quede una banda cortada
     a cuchillo. No hay texto encima: aquí el degradado sí puede vivir. */
  .street-cat__body::before {
    content: '';
    position: absolute;
    inset-inline: 0;
    bottom: 100%;
    height: clamp(3.5rem, 12vw, 6rem);
    background: linear-gradient(to top, rgb(12 12 12 / 0.88), rgb(12 12 12 / 0));
  }

  .street-cat__eyebrow {
    font-family: var(--font-accent);
    font-size: 0.625rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #e6e6e6;
  }

  .street-cat__title {
    margin-top: 0.375rem;
    font-family: var(--font-display);
    font-weight: var(--weight-display);
    letter-spacing: var(--tracking-display);
    font-size: clamp(1.375rem, 2.4vw, 1.875rem);
    line-height: 1.1;
    color: #ffffff;
  }

  .street-cat__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }
</style>
