---
/**
 * STREET · ClubHouse — la banda editorial tipo revista de la referencia:
 * carteles gráficos grandes mezclados con notas fechadas y producto pequeño.
 *
 * DOS DECISIONES QUE NO SE SALTAN:
 *
 * 1. Los carteles son TIPOGRAFÍA EN CSS, no imágenes generadas. En la
 *    referencia también lo son (letras enormes sobre un plano de color), así
 *    que replicarlo con texto sale más fiel, pesa 0 KB y escala solo. Se marcan
 *    `aria-hidden` las letras de relleno: son textura, no contenido.
 * 2. La referencia remata cada nota con «Read Full Article». Aquí NO hay
 *    artículos: la demo no tiene CMS y no se va a inventar uno (nota de
 *    docs/TEMAS.md § 5). Las notas son autoconclusivas y el único enlace de
 *    cada bloque va a una categoría REAL del catálogo.
 */
import { formatEurCents } from '../../../lib/format';
import type { CollectionConfig, StorePaths } from '../../../collections';

type GridProduct = {
  slug: string;
  name: string;
  price_cents: number;
  image: string;
  stock: number;
};

interface Props {
  collection: CollectionConfig;
  paths: StorePaths;
  /** Producto que acompaña a las notas. Sale del catálogo, no está inventado. */
  products: GridProduct[];
}

const { collection, paths, products } = Astro.props;

const has = (id: string): boolean => collection.categories.some((cat) => cat.id === id);

const notes = [
  {
    date: '12.03',
    title: 'Series de martes, ocho semanas',
    body:
      'Salimos a las 19:30 desde el parque. Ocho semanas de series cortas para bajar el ritmo del kilómetro sin dejarte las rodillas. Se apunta quien quiera; no hay nivel mínimo.',
    cta: has('str-calzado') ? { href: `${paths.catalog}?categoria=str-calzado`, label: 'Ver el calzado' } : null,
  },
  {
    date: '28.02',
    title: 'Correr de noche sin desaparecer',
    body:
      'De noviembre a marzo la mitad de nuestros pedidos llevan algo reflectante. No es estética: a 50 km/h un coche te ve tres segundos antes, y tres segundos son treinta metros.',
    cta: has('str-prendas') ? { href: `${paths.catalog}?categoria=str-prendas`, label: 'Ver las prendas' } : null,
  },
];

const picks = products.slice(0, 2);
---

<section class="street-club" id="club" aria-labelledby="street-club-title">
  <header class="street-club__head">
    <span class="street-club__glyph" aria-hidden="true">❋</span>
    <h2 class="street-club__title" id="street-club-title">Club House</h2>
  </header>

  <div class="street-club__layout">
    {/* Cartel 1 — verde neón, tipografía a sangre. */}
    <a class="street-poster street-poster--brand" href={paths.catalog}>
      <span class="street-poster__line">CORRE</span>
      <span class="street-poster__line street-poster__line--out" aria-hidden="true">CORRE</span>
      <span class="street-poster__line">LA</span>
      <span class="street-poster__line">CIUDAD</span>
      <span class="street-poster__foot">Todo el catálogo →</span>
    </a>

    <div class="street-club__notes">
      {notes.map((note) => (
        <article class="street-note">
          <p class="street-note__date">{note.date}</p>
          <h3 class="street-note__title">{note.title}</h3>
          <p class="street-note__body">{note.body}</p>
          {note.cta && <a class="street-note__cta" href={note.cta.href}>{note.cta.label}</a>}
        </article>
      ))}

      {picks.length > 0 && (
        <ul class="street-club__picks">
          {picks.map((prod) => (
            <li class="street-pick">
              <div class="street-pick__media">
                <img src={prod.image} alt="" width="800" height="800" loading="lazy" class="street-pick__img" />
              </div>
              <p class="street-pick__name">
                <a class="street-pick__link" href={paths.product(prod.slug)}>{prod.name}</a>
              </p>
              <p class="street-pick__price">{formatEurCents(prod.price_cents)}</p>
            </li>
          ))}
        </ul>
      )}
    </div>
  </div>
</section>

<style>
  .street-club {
    margin-top: clamp(3rem, 7vw, 5.5rem);
    /* El header del tema es sticky: sin esto, saltar a #club deja el titular
       debajo de la barra. */
    scroll-margin-top: 4.5rem;
  }

  .street-club__head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.375rem;
  }

  .street-club__glyph {
    font-size: 1.125rem;
    color: var(--color-muted-foreground);
  }

  .street-club__title {
    font-family: var(--font-display);
    font-weight: var(--weight-display);
    letter-spacing: var(--tracking-display);
    font-size: clamp(1.75rem, 3.4vw, 2.5rem);
    color: var(--color-foreground);
  }

  .street-club__layout {
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1.25rem, 3vw, 2.5rem);
  }

  @media (min-width: 900px) {
    .street-club__layout {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: start;
    }
  }

  /* ── Cartel tipográfico ────────────────────────────────────────── */
  .street-poster {
    display: flex;
    flex-direction: column;
    justify-content: center;
    aspect-ratio: 1 / 1;
    padding: clamp(1.25rem, 3vw, 2.25rem);
    border-radius: var(--radius-card);
    overflow: hidden;
  }

  .street-poster--brand {
    background: var(--color-brand);
    color: var(--color-brand-fg);
  }

  .street-poster__line {
    font-family: var(--font-display);
    font-weight: 800;
    letter-spacing: -0.045em;
    line-height: 0.86;
    font-size: clamp(2.75rem, 11vw, 5.5rem);
    text-transform: uppercase;
  }

  /* Repetición «hueca» de la primera palabra: es la textura tipográfica de la
     referencia. Puramente decorativa.
     Gotcha: el color del trazo NO puede ser `currentColor` — `color` es
     `transparent` aquí, así que `currentColor` también lo sería y la línea
     desaparecía. Va el token de tinta explícito. */
  .street-poster__line--out {
    color: transparent;
    -webkit-text-stroke: 2px var(--color-brand-fg);
    opacity: 0.5;
  }

  .street-poster__foot {
    margin-top: auto;
    font-family: var(--font-accent);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  /* ── Notas ─────────────────────────────────────────────────────── */
  .street-club__notes {
    display: flex;
    flex-direction: column;
    gap: clamp(1.25rem, 2.5vw, 2rem);
  }

  .street-note__date {
    font-family: var(--font-accent);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    color: var(--color-muted-foreground);
  }

  .street-note__title {
    margin-top: 0.375rem;
    font-family: var(--font-display);
    font-weight: var(--weight-display);
    letter-spacing: var(--tracking-display);
    font-size: clamp(1.125rem, 2vw, 1.5rem);
    color: var(--color-foreground);
  }

  .street-note__body {
    margin-top: 0.5rem;
    font-size: 0.875rem;
    line-height: 1.65;
    color: var(--color-muted-foreground);
    max-width: 34rem;
  }

  .street-note__cta {
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
    margin-top: 0.625rem;
    padding: 0.375rem 0.875rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-btn);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-foreground);
    transition: border-color 0.15s, background-color 0.15s;
  }

  .street-note__cta:hover {
    border-color: var(--color-foreground);
    background: var(--color-muted);
  }

  /* ── Producto pequeño de la banda ──────────────────────────────── */
  .street-club__picks {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--grid-gap);
  }

  .street-pick { position: relative; min-width: 0; }

  .street-pick__media {
    background: var(--color-surface-product);
    border-radius: var(--radius-card);
    overflow: hidden;
  }

  .street-pick__img {
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
  }

  .street-pick__name {
    margin-top: 0.5rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-foreground);
  }

  .street-pick__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .street-pick__price {
    margin-top: 0.125rem;
    font-size: 0.8125rem;
    color: var(--color-muted-foreground);
  }
</style>
