---
/** MONTE · retícula numerada de producto. */
import type { StorePaths } from '../../../collections';
import { formatEurCents } from '../../../lib/format';
type GridProduct = { slug: string; name: string; description: string; price_cents: number; image: string; stock: number; };
interface Props { paths: StorePaths; products: GridProduct[]; }
const { paths, products } = Astro.props;
---

<ul class="monte-grid">
  {products.map((product, index) => (
    <li class="monte-card">
      <a href={paths.product(product.slug)} aria-label={`Ver ${product.name}`}>
        <div class="monte-card__meta"><span>{String(index + 1).padStart(3, '0')}</span><p>{product.description}</p></div>
        <div class="monte-card__media"><img src={product.image} alt={product.name} width="1168" height="872" loading={index === 0 ? 'eager' : 'lazy'} /></div>
        <div class="monte-card__foot"><h3>{product.name}</h3><span>{formatEurCents(product.price_cents)}</span></div>
      </a>
    </li>
  ))}
</ul>

<style>
  .monte-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--grid-gap); margin: 0; padding: 1px 0 0; background: var(--monte-rule); list-style: none; }
  .monte-card { min-width: 0; background: var(--surface-sunken); }
  .monte-card > a { display: grid; min-height: 100%; grid-template-rows: auto 1fr auto; }
  .monte-card__meta { display: grid; min-height: 8.5rem; grid-template-columns: auto 1fr; gap: 1.2rem; padding: 1rem; border-left: var(--border-width) solid var(--monte-rule); }
  .monte-card__meta > span { font-size: 1.9rem; letter-spacing: -.06em; }
  .monte-card__meta p { max-width: 18rem; margin: 0 0 0 auto; font-size: .68rem; line-height: 1.35; }
  .monte-card__media { overflow: hidden; aspect-ratio: 1 / 1.08; background: var(--surface-product); }
  .monte-card__media img { width: 100%; height: 100%; object-fit: cover; transition: transform .55s ease; }
  .monte-card:hover .monte-card__media img { transform: scale(1.018); }
  .monte-card__foot { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; min-height: 5rem; padding: .9rem 1rem; border-left: var(--border-width) solid var(--monte-rule); }
  .monte-card__foot h3 { margin: 0; font: var(--weight-display) clamp(1.5rem, 2.4vw, 2.8rem)/.9 var(--font-display); letter-spacing: var(--tracking-display); }
  .monte-card__foot span { flex: 0 0 auto; font-size: .7rem; }
  @media (max-width: 900px) { .monte-grid { grid-template-columns: 1fr; } .monte-card__media { aspect-ratio: 1.2; } .monte-card__meta { min-height: 6.5rem; } }
  @media (prefers-reduced-motion: reduce) { .monte-card__media img { transition: none; } }
</style>
