---
/** MONTE · navegación GET, sin estado cliente paralelo. */
import type { CollectionConfig, StorePaths } from '../../../collections';
interface Props { paths: StorePaths; collection: CollectionConfig; count: number; activeCategory?: string | undefined; sort: string; search?: string | undefined; }
const { paths, collection, count, activeCategory, sort, search } = Astro.props;
const hrefFor = (category?: string): string => {
  const params = new URLSearchParams();
  if (category) params.set('categoria', category);
  if (sort !== 'featured') params.set('orden', sort);
  if (search) params.set('q', search);
  const query = params.toString();
  return `${paths.catalog}${query ? `?${query}` : ''}`;
};
---

<div class="monte-filters">
  <nav aria-label="Categorías MONTE"><span>{String(count).padStart(2, '0')} piezas</span><a href={hrefFor()} aria-current={!activeCategory ? 'page' : undefined}>Todo</a>{collection.categories.map((item) => <a href={hrefFor(item.id)} aria-current={activeCategory === item.id ? 'page' : undefined}>{item.label}</a>)}</nav>
  <form method="get" action={paths.catalog} role="search">
    {activeCategory && <input type="hidden" name="categoria" value={activeCategory} />}
    <input type="search" name="q" value={search} maxlength="60" placeholder="Buscar" aria-label="Buscar piezas" />
    <select name="orden" aria-label="Ordenar piezas" onchange="this.form.submit()"><option value="featured" selected={sort === 'featured'}>Edición</option><option value="price-asc" selected={sort === 'price-asc'}>Precio ↑</option><option value="price-desc" selected={sort === 'price-desc'}>Precio ↓</option><option value="name" selected={sort === 'name'}>Nombre A–Z</option></select>
  </form>
</div>

<style>
  .monte-filters { display: flex; align-items: end; flex-direction: column; gap: 1rem; font-size: .63rem; letter-spacing: .07em; text-transform: uppercase; }
  .monte-filters nav, .monte-filters form { display: flex; align-items: center; gap: clamp(.8rem, 1.8vw, 1.7rem); }
  .monte-filters nav > span { opacity: .58; }
  .monte-filters a { display: inline-flex; min-height: 2.75rem; align-items: center; }
  .monte-filters a[aria-current='page'], .monte-filters a:hover, .monte-filters a:focus-visible { border-bottom: var(--border-width) solid currentColor; }
  .monte-filters input, .monte-filters select { min-height: 2.75rem; border: 0; border-bottom: var(--border-width) solid currentColor; border-radius: 0; color: inherit; background: transparent; font: inherit; letter-spacing: inherit; text-transform: uppercase; }
  .monte-filters input { width: 7rem; }
  .monte-filters input::placeholder { color: inherit; opacity: .58; }
  @media (max-width: 760px) { .monte-filters { align-items: stretch; } .monte-filters nav { overflow-x: auto; } .monte-filters nav > * { flex: 0 0 auto; } .monte-filters form { justify-content: space-between; } }
</style>
