  .arce-menu nav { position: absolute; top: 100%; right: 0; left: 0; display: grid; padding: .5rem 1rem 1rem; border-bottom: var(--border-width) solid var(--color-border); background: var(--color-background); }
  .arce-menu nav a { display: flex; min-height: 3rem; align-items: center; border-top: var(--border-width) solid var(--color-border); font-family: var(--font-display); font-size: 1.6rem; letter-spacing: var(--tracking-display); }
  /* Buscador siempre visible: un campo compacto con filete, no un desplegable. */
