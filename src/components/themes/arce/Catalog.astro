</style>

<script>
  import { addToCart, cartCount } from '../../../lib/cart-client';

  const countEls = [...document.querySelectorAll<HTMLElement>('[data-arce-count]')];
  const renderCount = (): void => {
    const count = String(cartCount());
    countEls.forEach((element) => (element.textContent = count));
  };
  renderCount();
  document.addEventListener('cart:changed', renderCount);

  // Newsletter de demostración: confirma en pantalla sin enviar ningún dato.
  const newsletter = document.querySelector<HTMLFormElement>('[data-arce-newsletter]');
  const newsletterStatus = document.querySelector<HTMLElement>('[data-arce-newsletter-status]');
  newsletter?.addEventListener('submit', (event) => {
    event.preventDefault();
    if (newsletterStatus) newsletterStatus.textContent = 'Gracias. En esta demo no se envía ni se guarda ningún email.';
    newsletter.reset();
  });

  document.querySelectorAll<HTMLButtonElement>('[data-arce-add]').forEach((button) => {
    button.addEventListener('click', () => {
      const slug = button.dataset.arceAdd;
      if (!slug) return;
      addToCart(slug);
      const label = button.textContent;
      button.textContent = 'Añadido ✓';
      window.setTimeout(() => (button.textContent = label), 900);
    });
  });
</script>
