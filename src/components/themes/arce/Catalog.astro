  @keyframes arce-marquee { to { transform: translateX(-50%); } }
  @keyframes arce-ping { 0% { transform: scale(.6); opacity: .4; } 80%, 100% { transform: scale(2.4); opacity: 0; } }
  @keyframes arce-drift { to { transform: scale(1.08) translateY(4%); } }
  @keyframes arce-settle { from { transform: scale(1.12); } to { transform: scale(1); } }
  @media (max-width: 639px) {
