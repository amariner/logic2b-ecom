---
import { parseSpecs, type ProductRow } from '../../../lib/db';
import { formatEurCents } from '../../../lib/format';

interface Props {
  product: ProductRow;
  categoryLabel: string;
  catalogPath: string;
  cartPath: string;
}

const { product, categoryLabel, catalogPath, cartPath } = Astro.props;
const specs = parseSpecs(product.specs_json);
---

<header class="flex items-center justify-between border-b border-black/10 bg-[#f7f7f5] px-5 py-5 text-[#111] md:px-10">
  <a href={catalogPath} class="text-xl font-medium tracking-[-.06em]">Forma</a>
  <nav class="flex items-center gap-5 text-[10px] uppercase tracking-[.12em]" aria-label="Compra">
    <a href={catalogPath}>Catálogo</a>
    <a href={cartPath} class="rounded-full border border-black px-4 py-2">Carrito <span data-cart-count>0</span></a>
  </nav>
</header>

<article class="grid min-h-[calc(100vh-80px)] bg-white text-[#111] md:grid-cols-[1.15fr_.85fr]">
  <div class="flex min-h-[58vh] items-center justify-center bg-[#e9e9e5] p-5 sm:p-10 md:min-h-0 md:p-16" data-commerce-part="media">
    <img src={product.image} alt={product.name} width="1200" height="1200" loading="eager" decoding="async" class="aspect-square max-h-[78vh] w-full object-contain" />
  </div>
  <div class="flex flex-col justify-between p-7 md:p-14" data-commerce-part="details">
    <div>
      <p class="text-[9px] uppercase tracking-[.18em] text-black/60">{categoryLabel} / FORMA</p>
      <h1 class="mt-6 font-display text-6xl font-light leading-[.82] tracking-[-.075em] md:text-8xl">{product.name}</h1>
      <p class="mt-6 text-xl">{formatEurCents(product.price_cents)}</p>
      <p class="mt-10 max-w-md text-sm leading-relaxed text-black/60">{product.description}</p>
      {specs.length > 0 && (
        <dl class="mt-10 divide-y divide-black/10 border-y border-black/10 text-sm">
          {specs.map(({ label, value }) => <div class="flex justify-between gap-5 py-3"><dt class="text-black/60">{label}</dt><dd class="text-right">{value}</dd></div>)}
        </dl>
      )}
    </div>
    <div class="mt-10" data-commerce-part="purchase">
      {product.stock > 0 ? (
        <div class="flex items-stretch gap-2">
          <label class="sr-only" for="forma-qty">Cantidad</label>
          <input
            id="forma-qty"
            data-commerce-input="quantity"
            type="number"
            min="1"
            max={Math.min(product.stock, 99)}
            step="1"
            value="1"
            class="w-20 rounded-full border border-black/20 bg-white px-3 text-center text-sm"
          />
          <button
            type="button"
            data-commerce-action="add-to-cart"
            data-product-slug={product.slug}
            class="flex-1 rounded-full bg-black px-6 py-4 text-[10px] uppercase tracking-[.15em] text-white transition hover:bg-black/80"
          >Añadir al carrito</button>
        </div>
      ) : (
        <p class="rounded-full border border-black/20 px-6 py-4 text-center text-[10px] uppercase tracking-[.15em]">Agotado temporalmente</p>
      )}
      <p class="mt-4 text-center text-xs text-black/60">Pago demo seguro · precio y stock validados en servidor</p>
    </div>
  </div>
</article>
