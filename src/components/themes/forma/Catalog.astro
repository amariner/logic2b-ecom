---
import type { CollectionConfig, StorePaths } from '../../../collections';
import type { ProductRow } from '../../../lib/db';
import { formatEurCents } from '../../../lib/format';
interface Props { paths: StorePaths; collection: CollectionConfig; products: ProductRow[]; category?: string | undefined; sort: string; search?: string | undefined; }
const { paths, products } = Astro.props;
const root='/images/collections/forma';
const productBySlug = new Map(products.map((product) => [product.slug, product]));
const cardLayout=[
  {slug:'for-clear-01',alt:'Gafa óptica translúcida'},
  {slug:'for-black-02',alt:'Gafa óptica negra'},
  {slug:'for-wire-03',alt:'Gafa metálica plateada'},
  {slug:'for-tortoise-04',alt:'Gafa de acetato carey'},
  {slug:'for-olive-05',alt:'Gafa solar oliva'},
  {slug:'for-charcoal-06',alt:'Gafa solar carbón'},
] as const;
const cards = cardLayout.flatMap((card) => {
  const product = productBySlug.get(card.slug);
  return product ? [{ ...card, image: product.image }] : [];
});
const name=(slug:string)=>productBySlug.get(slug)?.name ?? slug;
const price=(slug:string)=>productBySlug.has(slug) ? formatEurCents(productBySlug.get(slug)!.price_cents) : '';
const solarCards=[...cards.slice(4),...cards.slice(4)];
---
<main class="forma-shell w-full bg-[#f7f7f4] text-[#171717]"><div class="forma-page w-full bg-[#f7f7f4]">
  <header class="flex items-center justify-between px-4 py-3 text-[9px] uppercase tracking-[.1em] sm:px-8 lg:px-10"><a href="#inicio" class="font-semibold tracking-[-.08em]">FORMA</a><nav class="hidden gap-5 sm:flex"><a href="#catalogo">Catálogo</a><a href="#historia">Historias</a><a href="#taller">Taller</a><a href="#contacto">Contacto</a></nav><a href={paths.cart}>Carrito · <span data-cart-count>0</span></a></header>

  <section id="inicio" class="grid grid-cols-2 gap-[2px] px-1 sm:px-2"><figure><img src={`${root}/portrait-woman.jpg`} alt="Retrato editorial con montura Forma" class="aspect-[4/3] w-full object-cover object-top" loading="eager"/><figcaption class="flex justify-between px-1 py-1 text-[8px] sm:text-[9px]"><span>Clear 01</span><span>Diseñada pensando en tu rostro</span></figcaption></figure><figure><img src={`${root}/portrait-man.jpg`} alt="Retrato editorial con gafas Forma" class="aspect-[4/3] w-full object-cover object-top" loading="eager"/><figcaption class="flex justify-between px-1 py-1 text-[8px] sm:text-[9px]"><span>Wire 03</span><span>Barcelona · 2026</span></figcaption></figure></section>

  <section id="catalogo" class="grid gap-6 px-2 py-14 sm:grid-cols-[.68fr_1.32fr] sm:gap-1 sm:py-20"><div class="flex flex-col justify-between pb-3"><h1 class="max-w-[360px] font-display text-[clamp(2.35rem,3.4vw,4.25rem)] font-light leading-[.9] tracking-[-.06em]">La belleza está en el ojo de quien mira.</h1><p class="mt-6 max-w-[320px] text-[11px] sm:text-xs leading-relaxed text-black/55">Nuestra manera de ver cambia el mundo alrededor. Una montura no tapa el rostro: lo enmarca.</p></div><div class="grid grid-cols-2 gap-[2px]">{cards.slice(0,4).map((card)=><article class="group relative bg-[#ededeb]"><img src={card.image} alt={card.alt} class="aspect-[1.2] w-full object-cover transition duration-700 group-hover:scale-[1.02]" loading="lazy"/><a href={paths.product(card.slug)} class="absolute inset-0" aria-label={`Ver ${name(card.slug)}`}></a><p class="flex justify-between px-1 py-1 text-[8px] sm:text-[9px]"><span>{name(card.slug)}</span><span>↗</span></p></article>)}</div></section>

  <section id="historia" class="border-y border-black/5 px-2 py-20 sm:py-28"><h2 class="max-w-[1100px] font-display text-[clamp(3rem,5.2vw,6rem)] font-light leading-[.9] tracking-[-.07em]">Aquí tienes un dato hermoso. Tus ojos tienen diez capas. Ves a través de muchísimo.</h2></section>

  <section class="grid gap-6 px-2 py-16 sm:grid-cols-[1.3fr_.7fr] sm:gap-1 sm:py-20"><div class="grid grid-cols-2 gap-[2px]">{cards.slice(0,4).map((card)=><article class="group relative bg-[#ededeb]"><img src={card.image} alt={card.alt} class="aspect-[1.3] w-full object-cover" loading="lazy"/><a href={paths.product(card.slug)} class="absolute inset-0" aria-label={`Ver ${name(card.slug)}`}></a><p class="flex justify-between px-1 py-1 text-[8px] sm:text-[9px]"><span>{name(card.slug)}</span><span>{price(card.slug)}</span></p></article>)}</div><div class="sm:pl-3"><h2 class="font-display text-[clamp(2.5rem,4vw,5rem)] font-light leading-[.9] tracking-[-.055em]">Gafas duraderas, hechas para resistir el paso del tiempo.</h2><p class="mt-4 text-[9px] text-black/60">Forma eyewear · Barcelona</p></div></section>

  <section class="grid grid-cols-2 gap-[2px] px-2"><figure><img src={`${root}/hero-generated.jpg`} alt="Detalle escultórico de una montura Forma" class="aspect-square w-full object-cover" loading="lazy"/><figcaption class="px-1 py-1 text-[8px] sm:text-[9px]">Acetato italiano · detalle</figcaption></figure><div class="flex aspect-square flex-col justify-between bg-[#e9e3d7] p-4 sm:p-8"><span class="h-7 w-7 rounded-full bg-[#d82f16]"></span><p class="max-w-[360px] self-end text-right text-[11px] sm:text-sm leading-relaxed">Crear algo verdaderamente único: una referencia silenciosa que permanece durante años.</p></div></section>

  <section class="grid px-2 py-16 sm:grid-cols-2 sm:py-24"><div class="flex items-end"><p class="max-w-[520px] font-display text-[clamp(2rem,3.6vw,4.5rem)] font-light leading-[.95] tracking-[-.04em]">Algunas marcas describen el diseño como “un toque”. Nosotros diseñamos todo lo demás.</p></div><figure class="mt-8 sm:mt-0"><img src={`${root}/workshop-generated.jpg`} alt="Trabajo artesanal sobre una montura" class="aspect-square w-full object-cover" loading="lazy"/><figcaption class="px-1 py-1 text-[8px] sm:text-[9px]">Manos, materia y precisión</figcaption></figure></section>

  <section class="grid gap-4 px-2 py-10 sm:grid-cols-[1.35fr_.65fr] sm:gap-1"><div class="grid grid-cols-2 gap-[2px]">{solarCards.map((card)=><article class="group relative bg-[#ededeb]"><img src={card.image} alt={card.alt} class="aspect-[1.3] w-full object-cover" loading="lazy"/><a href={paths.product(card.slug)} class="absolute inset-0" aria-label={`Ver ${name(card.slug)}`}></a><p class="flex justify-between px-1 py-1 text-[8px] sm:text-[9px]"><span>{name(card.slug)}</span><span>↗</span></p></article>)}</div><h2 class="font-display text-[clamp(2.5rem,4vw,5rem)] font-light leading-[.9] tracking-[-.055em] sm:pl-3">Preparadas para que brille el sol.</h2></section>

  <section class="grid grid-cols-2 gap-[2px] px-2 py-12"><figure><img src={`${root}/campaign-woman.jpg`} alt="Retrato de campaña Forma con montura negra" class="aspect-[4/3] w-full object-cover object-top" loading="lazy"/><figcaption class="px-1 py-1 text-[8px] sm:text-[9px]">Forma presenta · Black 02</figcaption></figure><figure><img src={`${root}/hero-generated.jpg`} alt="Campaña colectiva de Forma" class="aspect-[4/3] w-full object-cover grayscale" loading="lazy"/><figcaption class="px-1 py-1 text-[8px] sm:text-[9px]">Una mirada para cada historia</figcaption></figure></section>

  <section class="grid gap-6 px-2 py-14 sm:grid-cols-[1.35fr_.65fr] sm:gap-1"><div class="grid grid-cols-2 gap-[2px]">{cards.slice(0,4).map((card)=><article class="relative bg-[#ededeb]"><img src={card.image} alt={card.alt} class="aspect-[1.4] w-full object-cover" loading="lazy"/><a href={paths.product(card.slug)} class="absolute inset-0" aria-label={`Ver ${name(card.slug)}`}></a><p class="px-1 py-1 text-[8px] sm:text-[9px]">{name(card.slug)} · ajuste incluido</p></article>)}</div><h2 class="font-display text-[clamp(2.5rem,4vw,5rem)] font-light leading-[.9] tracking-[-.055em] sm:pl-3">Nuestras promesas para ti</h2></section>

  <section id="taller" class="px-2 py-12"><figure><img src={`${root}/craft-detail.jpg`} alt="Artesano ajustando una montura Forma" class="aspect-[2.05] w-full object-cover" loading="lazy"/><figcaption class="flex justify-between px-1 py-1 text-[8px] sm:text-[9px]"><span>Monturas para toda la vida</span><span>Hechas a mano</span></figcaption></figure></section>

  <section class="grid grid-cols-2 gap-[2px] px-2 pb-16"><figure><img src={`${root}/workshop-generated.jpg`} alt="Interior del taller Forma" class="aspect-square w-full object-cover" loading="lazy"/><figcaption class="px-1 py-1 text-[8px] sm:text-[9px]">Nuestro taller · Barcelona</figcaption></figure><div class="flex aspect-square flex-col justify-between bg-[#c9878c] p-5 sm:p-8"><span class="text-[8px] uppercase tracking-[.1em]">Desde 2018</span><p class="max-w-[460px] self-end text-right font-display text-[clamp(2rem,3.4vw,4.25rem)] font-light leading-[.95] tracking-[-.04em]">Una marca construida alrededor de una mirada.</p></div></section>

  <footer id="contacto" class="border-t border-black px-4 py-10 sm:px-6"><div class="grid gap-8 text-[8px] uppercase tracking-[.08em] sm:grid-cols-4"><div><p class="font-semibold">FORMA</p><p class="mt-8 normal-case text-black/60">Gafas diseñadas y ajustadas en Barcelona.</p></div><nav class="space-y-1"><a href="#catalogo" class="block min-h-6 py-1">Catálogo</a><a href="#historia" class="block min-h-6 py-1">Historias</a><a href="#taller" class="block min-h-6 py-1">Taller</a></nav><div><p>Visítanos</p><p class="mt-3 normal-case text-black/60">Carrer de la Mirada, 18<br/>Barcelona</p></div><div class="sm:text-right"><a href={paths.cart}>Carrito</a><p class="mt-8 normal-case text-black/60">© 2026 Forma · Privacidad</p></div></div></footer>
</div></main>
<style>.forma-shell{min-height:100vh}.forma-page{box-shadow:0 0 0 1px rgba(0,0,0,.06)}@media(max-width:639px){.forma-page{width:100%}}</style>
