---
/** DINTEL · catálogo monolítico: tipo, vacío y escala de objeto. */
import type { CollectionConfig, StorePaths } from '../../../collections';
import Filters from './Filters.astro';
import ProductGrid from './ProductGrid.astro';

type GridProduct = {
  slug: string;
  name: string;
  description: string;
  price_cents: number;
  image: string;
  stock: number;
};

interface Props {
  paths: StorePaths;
  products: GridProduct[];
  collection: CollectionConfig;
  category?: string | undefined;
  sort: string;
  search?: string | undefined;
}

const { paths, products, collection, category, sort, search } = Astro.props;
const activeLabel = collection.categories.find((item) => item.id === category)?.label;
const title = search ? `Resultados para «${search}»` : activeLabel ?? 'Todos los objetos';
const featuredOrder = [
  'din-silla-arco',
  'din-mesa-traves',
  'din-banco-basalto',
  'din-sillon-plinto',
  'din-lampara-brasa',
  'din-mesa-lateral-canto',
  'din-espejo-umbral',
  'din-aparador-linde',
];
const displayProducts = sort === 'featured'
  ? products.toSorted((a, b) => featuredOrder.indexOf(a.slug) - featuredOrder.indexOf(b.slug))
  : products;
---

<div class="dintel">
  <header class="dintel-header">
    <a class="dintel-header__wordmark" href={paths.catalog}>{collection.name}</a>
    <p>39°59′ N · 0°02′ O<br />Castellón, ES</p>
    <nav aria-label="Acciones de DINTEL">
      <a href="#dintel-filtros">Índice</a>
      <a href={paths.cart}>Cesta <span data-cart-count>0</span></a>
    </nav>
  </header>

  <main>
    <section class="dintel-hero" aria-labelledby="dintel-title">
      <p>Objetos / 01–08</p>
      <h1 id="dintel-title">DINTEL</h1>
      <div>
        <p>{collection.tagline}</p>
        <a href="#dintel-objetos">Ver la colección <span aria-hidden="true">↓</span></a>
      </div>
    </section>

    <Filters paths={paths} collection={collection} count={products.length} activeCategory={category} sort={sort} search={search} />

    <section class="dintel-objects" id="dintel-objetos" aria-labelledby="dintel-objects-title">
      <h2 class="sr-only" id="dintel-objects-title">{title}</h2>
      {search && products.length > 0 && <p class="dintel-results">{products.length} {products.length === 1 ? 'resultado' : 'resultados'} para «{search}»</p>}
      {displayProducts.length > 0 ? <ProductGrid paths={paths} products={displayProducts} /> : <div class="dintel-empty"><p>{search ? `Nada por aquí para «${search}»` : 'No hay objetos en esta selección'}</p><a href={paths.catalog}>Volver a la colección</a></div>}
    </section>

    <section class="dintel-statement" aria-label="Manifiesto DINTEL">
      <p>Materia que ocupa su sitio.</p>
      <span>Diseñamos volúmenes lentos en madera, piedra, metal y luz. Piezas pensadas para vivir muchos años.</span>
    </section>
  </main>

  <footer class="dintel-footer">
    <a href={paths.catalog}>DINTEL</a>
    <p>Objetos que sostienen el espacio.</p>
    <a href={paths.catalog}>Volver arriba ↑</a>
  </footer>
</div>

<style>
  .dintel { --dintel-ink: var(--surface-product); --dintel-muted: color-mix(in srgb, var(--surface-product) 68%, var(--surface-sunken)); --dintel-rule: color-mix(in srgb, var(--surface-product) 19%, var(--surface-sunken)); min-height: 100vh; color: var(--dintel-ink); background: var(--surface-sunken); font-family: var(--font-accent); }
  .dintel :where(a) { color: inherit; text-decoration: none; }
  .dintel-header { display: grid; grid-template-columns: 1fr auto 1fr; align-items: start; gap: 1rem; min-height: 4.8rem; padding: .85rem clamp(.8rem, 1.8vw, 1.8rem); color: var(--dintel-muted); font-size: .55rem; line-height: 1.35; letter-spacing: .035em; text-transform: uppercase; }
  .dintel-header__wordmark { color: var(--dintel-ink); font-weight: 800; letter-spacing: -.03em; }
  .dintel-header p { margin: 0; text-align: center; }
  .dintel-header nav { display: flex; justify-content: flex-end; gap: clamp(1rem, 2vw, 2rem); }
  .dintel-header a { display: inline-flex; min-height: 2.75rem; align-items: center; }
  .dintel-header a:hover, .dintel-header a:focus-visible { text-decoration: underline; text-underline-offset: .25rem; }
  .dintel-hero { display: grid; min-height: clamp(20rem, 43vw, 39rem); grid-template-columns: 1fr auto; grid-template-rows: auto 1fr auto; padding: clamp(.8rem, 1.8vw, 1.8rem); }
  .dintel-hero > p { margin: 0; color: var(--dintel-muted); font-size: .55rem; letter-spacing: .035em; text-transform: uppercase; }
  .dintel-hero h1 { grid-column: 1 / -1; align-self: center; margin: 0; color: var(--dintel-ink); font: var(--weight-display) clamp(5.8rem, 22.6vw, 24rem)/.68 var(--font-display); letter-spacing: var(--tracking-display); }
  .dintel-hero > div { display: contents; }
  .dintel-hero > div p { grid-column: 1; align-self: end; max-width: 19rem; margin: 0; color: var(--dintel-muted); font-size: clamp(.7rem, .9vw, .88rem); line-height: 1.35; }
  .dintel-hero > div a { grid-column: 2; align-self: end; min-height: 2.75rem; color: var(--dintel-ink); font-size: .58rem; letter-spacing: .04em; text-transform: uppercase; }
  .dintel-hero > div a:hover, .dintel-hero > div a:focus-visible { text-decoration: underline; text-underline-offset: .25rem; }
  .dintel-objects { padding: 0 clamp(.8rem, 1.8vw, 1.8rem) clamp(5rem, 10vw, 10rem); }
  .dintel-results { margin: 0 0 1.4rem; color: var(--dintel-muted); font-size: .7rem; }
  .dintel-empty { display: grid; min-height: 26rem; place-content: center; gap: 1rem; text-align: center; }
  .dintel-empty p { font: var(--weight-display) clamp(2rem, 5vw, 4rem)/.9 var(--font-display); letter-spacing: var(--tracking-display); text-transform: uppercase; }
  .dintel-empty a { min-height: 2.75rem; text-decoration: underline; text-underline-offset: .25rem; }
  .dintel-statement { display: grid; grid-template-columns: 1fr minmax(14rem, 34rem); gap: 2rem; padding: clamp(4rem, 11vw, 11rem) clamp(.8rem, 1.8vw, 1.8rem); border-top: 1px solid var(--dintel-rule); }
  .dintel-statement p { margin: 0; color: var(--dintel-muted); font-size: .58rem; letter-spacing: .04em; text-transform: uppercase; }
  .dintel-statement span { font: var(--weight-display) clamp(1.8rem, 3.8vw, 4.1rem)/.93 var(--font-display); letter-spacing: var(--tracking-display); }
  .dintel-footer { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1rem; padding: 1rem clamp(.8rem, 1.8vw, 1.8rem); color: var(--dintel-muted); border-top: 1px solid var(--dintel-rule); font-size: .55rem; letter-spacing: .035em; text-transform: uppercase; }
  .dintel-footer > a:last-child { justify-self: end; }
  .dintel-footer p { margin: 0; text-align: center; }
  .dintel-footer a { min-height: 2.75rem; }
  .dintel-footer a:hover, .dintel-footer a:focus-visible { color: var(--dintel-ink); text-decoration: underline; text-underline-offset: .25rem; }
  @media (max-width: 720px) {
    .dintel-header { grid-template-columns: 1fr auto; min-height: 3.7rem; padding-inline: .8rem; }
    .dintel-header p, .dintel-header nav a:first-child { display: none; }
    .dintel-hero { min-height: 28rem; padding: .8rem; }
    .dintel-hero h1 { font-size: clamp(4.65rem, 26vw, 8.5rem); line-height: .73; }
    .dintel-hero > div p { max-width: 13rem; font-size: .68rem; }
    .dintel-objects { padding-inline: .8rem; }
    .dintel-statement { grid-template-columns: 1fr; padding: 5rem .8rem; }
    .dintel-footer { grid-template-columns: 1fr auto; padding-inline: .8rem; }
    .dintel-footer p { display: none; }
  }
</style>
