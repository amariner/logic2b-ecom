---
/** ORBE · filtros GET compactos que conservan el contrato compartido. */
import type { CollectionConfig, StorePaths } from '../../../collections';
interface Props { paths: StorePaths; collection: CollectionConfig; count: number; activeCategory?: string | undefined; sort: string; search?: string | undefined; }
const { paths, collection, count, activeCategory, sort, search } = Astro.props;
const hrefFor = (category?: string) => {
  const params = new URLSearchParams();
  if (category) params.set('categoria', category);
  if (sort !== 'featured') params.set('orden', sort);
  if (search) params.set('q', search);
  const query = params.toString();
  return `${paths.catalog}${query ? `?${query}` : ''}`;
};
---

<div class="orbe-filters">
  <nav aria-label="Categorías ORBE"><span>Catálogo / {count}</span><a href={hrefFor()} aria-current={!activeCategory ? 'page' : undefined}>Todo</a>{collection.categories.map((item) => <a href={hrefFor(item.id)} aria-current={activeCategory === item.id ? 'page' : undefined}>{item.label}</a>)}</nav>
  <form method="get" action={paths.catalog} role="search">
    {activeCategory && <input type="hidden" name="categoria" value={activeCategory} />}
    <input type="search" name="q" value={search} maxlength="60" placeholder="Buscar" aria-label="Buscar productos" />
    <select name="orden" aria-label="Ordenar catálogo" onchange="this.form.submit()"><option value="featured" selected={sort === 'featured'}>Destacados</option><option value="price-asc" selected={sort === 'price-asc'}>Precio ↑</option><option value="price-desc" selected={sort === 'price-desc'}>Precio ↓</option><option value="name" selected={sort === 'name'}>Nombre A–Z</option></select>
  </form>
</div>

<style>
  .orbe-filters { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: .7rem 1rem; border-bottom: var(--border-width) solid var(--color-border); background: var(--color-background); font-size: .57rem; text-transform: uppercase; }
  .orbe-filters nav, .orbe-filters form { display: flex; align-items: center; gap: 1rem; }
  .orbe-filters nav > span { color: var(--color-muted-foreground); }
  .orbe-filters a { display: inline-flex; min-height: 2.2rem; align-items: center; }
  .orbe-filters a[aria-current='page'] { text-decoration: underline; text-underline-offset: .24rem; }
  .orbe-filters input, .orbe-filters select { min-height: 2.75rem; border: 0; border-bottom: var(--border-width) solid var(--color-border); border-radius: 0; color: var(--color-foreground); background: transparent; font: inherit; text-transform: uppercase; }
  .orbe-filters input { width: 8rem; }
  @media (max-width: 720px) { .orbe-filters { align-items: stretch; flex-direction: column; } .orbe-filters nav { overflow-x: auto; } .orbe-filters nav > * { flex: 0 0 auto; } .orbe-filters form { justify-content: space-between; } }
</style>
