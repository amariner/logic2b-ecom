---
/**
 * ARGENT · Home/catálogo.
 * Réplica estructural de la referencia 04c4…: hero cinematográfico, chrome
 * superpuesto, cinco productos sobre blanco y díptico de campaña.
 */
import type { CollectionConfig, StorePaths } from '../../../collections';
import Filters from './Filters.astro';
import ProductGrid from './ProductGrid.astro';

type GridProduct = {
  slug: string;
  name: string;
  price_cents: number;
  compare_at_price_cents?: number | null;
  image: string;
  stock: number;
};

interface Props {
  paths: StorePaths;
  products: GridProduct[];
  collection: CollectionConfig;
  category?: string | undefined;
  sort: string;
  search?: string | undefined;
}

const { paths, products, collection, category, sort, search } = Astro.props;
const editorial = !category && !search && sort === 'featured';

const FEATURED = [
  'arg-checked-sarong-skirt',
  'arg-black-sleeveless-top',
  'arg-grey-flannel-hood',
  'arg-denim-utility-shirt',
  'arg-denim-sarong-skirt',
];
const rank = new Map(FEATURED.map((slug, index) => [slug, index]));
const shownProducts = editorial
  ? products.toSorted((a, b) => (rank.get(a.slug) ?? 99) - (rank.get(b.slug) ?? 99))
  : products;
---

<div class="argent">
  {editorial ? (
    <section class="argent-hero" aria-labelledby="argent-home-title">
      <img
        class="argent-hero__image"
        src="/images/collections/argent/hero-car-mirror.webp"
        alt="Modelo reflejada en el retrovisor de un coche"
        width="1920"
        height="1080"
        loading="eager"
        fetchpriority="high"
      />
      <div class="argent-hero__veil" aria-hidden="true"></div>
      <header class="argent-header argent-header--overlay">
        <nav class="argent-header__nav" aria-label="Colecciones principales">
          <a href={`${paths.catalog}?categoria=arg-mujer`}>Mujer</a>
          <a href={`${paths.catalog}?categoria=arg-unisex`}>Unisex</a>
          <a href={`${paths.catalog}?categoria=arg-archivo`}>Archivo</a>
        </nav>
        <a class="argent-wordmark" href={paths.catalog}>{collection.name}</a>
        <nav class="argent-header__actions" aria-label="Acciones de tienda">
          <a href={paths.catalog} aria-label="Buscar productos" aria-current="page">⌕</a>
          <a href={paths.cart} aria-label="Abrir carrito">▱ <span data-cart-count>0</span></a>
        </nav>
      </header>
      <h1 id="argent-home-title" class="argent-hero__edition">
        <span>{collection.name}</span> Campaña 01 / movimiento
      </h1>
    </section>
  ) : (
    <header class="argent-header argent-header--solid">
      <nav class="argent-header__nav" aria-label="Colecciones principales">
        <a href={`${paths.catalog}?categoria=arg-mujer`}>Mujer</a>
        <a href={`${paths.catalog}?categoria=arg-unisex`}>Unisex</a>
        <a href={`${paths.catalog}?categoria=arg-archivo`}>Archivo</a>
      </nav>
      <a class="argent-wordmark" href={paths.catalog}>{collection.name}</a>
      <nav class="argent-header__actions" aria-label="Acciones de tienda">
        <a href={paths.catalog} aria-label="Buscar productos" aria-current="page">⌕</a>
        <a href={paths.cart} aria-label="Abrir carrito">▱ <span data-cart-count>0</span></a>
      </nav>
    </header>
  )}

  <main>
    <section class="argent-products" aria-labelledby="argent-products-title">
      <div class="argent-products__head">
        {editorial
          ? <h2 id="argent-products-title">Más vendidos</h2>
          : <h1 id="argent-products-title">Colección</h1>}
        <a href={paths.catalog}>Todas las colecciones <span aria-hidden="true">↗</span></a>
      </div>

      {!editorial && (
        <Filters
          paths={paths}
          collection={collection}
          count={products.length}
          activeCategory={category}
          sort={sort}
          search={search}
        />
      )}

      {search && products.length > 0 && (
        <p class="argent-results">
          {products.length} {products.length === 1 ? 'resultado' : 'resultados'} para «{search}»
        </p>
      )}

      {shownProducts.length > 0 ? (
        <ProductGrid paths={paths} products={shownProducts} />
      ) : (
        <div class="argent-empty">
          <p>{search ? `Nada por aquí para «${search}»` : 'No hay productos en esta colección'}</p>
          <a href={paths.catalog}>Volver a todas las colecciones</a>
        </div>
      )}
    </section>

    {editorial && (
      <section class="argent-campaigns" aria-label="Campañas ARGENT">
        <a class="argent-campaign" href={`${paths.catalog}?categoria=arg-unisex`}>
          <img
            src="/images/collections/argent/campaign-creators.webp"
            alt="Sudadera de la campaña From creators to creators"
            width="1200"
            height="1500"
            loading="lazy"
          />
          <span>De creadores para creadores</span>
        </a>
        <a class="argent-campaign" href={`${paths.catalog}?categoria=arg-archivo`}>
          <img
            src="/images/collections/argent/campaign-uniform.webp"
            alt="Dos modelos con prendas negras frente a un cielo azul"
            width="1200"
            height="1500"
            loading="lazy"
          />
          <span>Nuevo uniforme / 2026</span>
        </a>
      </section>
    )}
  </main>

  <footer class="argent-footer">
    <a class="argent-wordmark argent-wordmark--footer" href={paths.catalog}>{collection.name}</a>
    <p>Construido para el movimiento. Diseñado en pequeñas series.</p>
    <nav aria-label="Pie de tienda">
      <a href={paths.catalog} aria-current="page">Colecciones</a>
      <a href={paths.cart}>Carrito</a>
      <a href="/">Logic2B Ecommerce</a>
    </nav>
  </footer>
</div>

<style>
  .argent { background: #fff; color: #171715; min-height: 100vh; }
  .argent a { color: inherit; text-decoration: none; }

  .argent-hero { position: relative; min-height: min(68vw, 52rem); overflow: hidden; background: #33342e; }
  .argent-hero__image { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 48%; }
  .argent-hero__veil { position: absolute; inset: 0; background: linear-gradient(to bottom, rgb(0 0 0 / .24), transparent 26%, transparent 78%, rgb(0 0 0 / .12)); }
  .argent-hero__edition { position: absolute; left: clamp(.75rem, 1.5vw, 1.5rem); bottom: 4rem; margin: 0; color: #fff; font: 600 .58rem/1 var(--font-accent); letter-spacing: .12em; text-transform: uppercase; }
  .argent-hero__edition span { font-weight: 800; }

  .argent-header { z-index: 2; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; min-height: 4rem; padding: .8rem clamp(.75rem, 1.5vw, 1.5rem); font: 650 .62rem/1 var(--font-accent); letter-spacing: .08em; text-transform: uppercase; }
  .argent-header--overlay { position: absolute; inset: 0 0 auto; color: #fff; }
  .argent-header--solid { position: sticky; top: 0; z-index: 20; color: #171715; background: rgb(255 255 255 / .94); border-bottom: 1px solid #ececea; backdrop-filter: blur(12px); }
  .argent-header__nav, .argent-header__actions { display: flex; align-items: center; gap: clamp(.7rem, 1.6vw, 1.6rem); }
  .argent-header__actions { justify-content: flex-end; font-size: .8rem; }
  .argent-header a { transition: opacity .2s ease; }
  .argent-header a:hover { opacity: .58; }
  .argent-wordmark { font-family: Impact, Haettenschweiler, 'Arial Narrow Bold', sans-serif; font-size: clamp(1.65rem, 3vw, 2.65rem); font-weight: 900; line-height: .8; letter-spacing: -.055em; text-transform: uppercase; }

  .argent-products { padding: clamp(1.3rem, 2.8vw, 2.7rem) clamp(.75rem, 1.2vw, 1.25rem) clamp(2rem, 4vw, 4rem); }
  .argent-products__head { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: clamp(1.4rem, 3vw, 2.8rem); font: 700 .66rem/1 var(--font-accent); letter-spacing: -.02em; text-transform: uppercase; }
  .argent-products__head h1, .argent-products__head h2 { font: inherit; }
  .argent-products__head a { font-size: .56rem; letter-spacing: .04em; }
  .argent-results { margin: 1rem 0 0; font-size: .7rem; color: #74746f; }
  .argent-empty { padding: 5rem 1rem; text-align: center; background: var(--surface-sunken); }
  .argent-empty p { font: 700 .8rem/1.3 var(--font-accent); text-transform: uppercase; }
  .argent-empty a { display: inline-block; margin-top: 1rem; font-size: .75rem; text-decoration: underline; text-underline-offset: 3px; }

  .argent-campaigns { display: grid; grid-template-columns: 1fr 1fr; }
  .argent-campaign { position: relative; min-height: 60vw; overflow: hidden; background: #deded9; }
  .argent-campaign img { width: 100%; height: 100%; object-fit: cover; transition: transform .65s cubic-bezier(.2,.7,.2,1); }
  .argent-campaign:hover img { transform: scale(1.018); }
  .argent-campaign span { position: absolute; left: 1rem; bottom: 1rem; padding: .45rem .55rem; color: #fff; background: #171715; font: 750 clamp(.72rem, 1vw, .95rem)/1 var(--font-accent); letter-spacing: .025em; text-transform: uppercase; }

  .argent-footer { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 2rem; align-items: start; padding: clamp(2rem, 5vw, 5rem) clamp(1rem, 2vw, 2rem); color: #efefeb; background: #171715; font: 600 .66rem/1.5 var(--font-accent); text-transform: uppercase; }
  .argent-wordmark--footer { font-size: clamp(2rem, 4vw, 4rem); }
  .argent-footer p { max-width: 20rem; color: #aaa9a2; }
  .argent-footer nav { display: flex; justify-content: flex-end; gap: 1.25rem; }

  @media (max-width: 700px) {
    .argent-hero { min-height: 86svh; }
    .argent-hero__image { object-position: 58% center; }
    .argent-header { grid-template-columns: 1fr auto; min-height: 3.5rem; }
    .argent-header__nav { display: none; }
    .argent-wordmark { justify-self: start; font-size: 1.75rem; }
    .argent-header__actions { justify-self: end; }
    .argent-products { padding-inline: .65rem; }
    .argent-campaigns { grid-template-columns: 1fr; }
    .argent-campaign { min-height: 120vw; }
    .argent-footer { grid-template-columns: 1fr; }
    .argent-footer nav { justify-content: flex-start; flex-wrap: wrap; }
  }

  @media (prefers-reduced-motion: reduce) {
    .argent-campaign img { transition: none; }
  }
</style>
