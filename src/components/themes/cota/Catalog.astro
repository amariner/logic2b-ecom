---
/** COTA · portfolio inmobiliario convertido en catálogo transaccional. */
import type { CollectionConfig, StorePaths } from '../../../collections';
import Filters from './Filters.astro';
import ProductGrid from './ProductGrid.astro';

type GridProduct = { slug: string; name: string; description: string; price_cents: number; image: string; stock: number; };
interface Props { paths: StorePaths; products: GridProduct[]; collection: CollectionConfig; category?: string | undefined; sort: string; search?: string | undefined; }
const { paths, products, collection, category, sort, search } = Astro.props;
---

<div class="cota-frame">
  <div class="cota-page">
    <header class="cota-header">
      <a class="cota-brand" href={paths.catalog} aria-current="page">{collection.name}<i></i></a>
      <nav aria-label="Navegación COTA"><a href="#proyectos">Proyectos</a><a href="#vision">Visión</a><a href={paths.cart}>Selección <span data-cart-count>0</span></a></nav>
    </header>

    <main>
      <section class="cota-hero" aria-labelledby="cota-title">
        <img src="/images/collections/cota/cot-cero-lago.webp" alt="Residencia contemporánea entre una montaña y un lago" width="2016" height="1344" fetchpriority="high" />
        <div class="cota-hero__line" aria-hidden="true"></div>
        <div class="cota-hero__cards">
          <a href={paths.product('cot-niebla-bosque')}><img src="/images/collections/cota/cot-niebla-bosque.webp" alt="" width="2016" height="1344" /><span>Niebla Bosque</span></a>
          <a href={paths.product('cot-atrio-mar')}><img src="/images/collections/cota/cot-atrio-mar.webp" alt="" width="2016" height="1344" /><span>Atrio Mar</span></a>
        </div>
        <h1 id="cota-title">Arquitectura donde empieza el paisaje.</h1>
      </section>

      <section class="cota-vision" id="vision" aria-labelledby="cota-vision-title">
        <p class="cota-kicker">Esa es la visión<br />detrás de cada cota.</p>
        <div><h2 id="cota-vision-title">Horizonte es más que una línea.</h2><p>Cada residencia nace de una relación irrepetible entre materia, clima y distancia. Seleccionamos lugares que piden menos gesto y más precisión.</p><a href="#proyectos">Explorar proyectos <span aria-hidden="true">→</span></a></div>
      </section>

      <section class="cota-shop" id="proyectos" aria-labelledby="cota-shop-title">
        <div class="cota-shop__head"><div><p>Proyectos disponibles</p><h2 id="cota-shop-title">Ediciones de lugar.</h2></div><Filters paths={paths} collection={collection} count={products.length} activeCategory={category} sort={sort} search={search} /></div>
        {search && products.length > 0 && <p class="cota-results">{products.length} {products.length === 1 ? 'resultado' : 'resultados'} para «{search}»</p>}
        {products.length > 0 ? <ProductGrid paths={paths} products={products} /> : <div class="cota-empty"><p>{search ? `No hay una cota para «${search}»` : 'No hay proyectos en esta selección'}</p><a href={paths.catalog}>Ver todos los proyectos</a></div>}
      </section>

      <a class="cota-feature" href={paths.product('cot-luz-altura')}><img src="/images/collections/cota/cot-luz-altura.webp" alt="Ático contemporáneo sobre una ciudad en hora azul" width="2016" height="1344" loading="lazy" /><span><b>La ciudad termina aquí</b><i>Luz Altura →</i></span></a>
    </main>

    <footer class="cota-footer"><strong>COTA</strong><p>Arquitectura donde empieza el paisaje.</p><nav aria-label="Enlaces COTA"><a href={paths.catalog} aria-current="page">Proyectos</a><a href="#vision">Estudio</a><a href={paths.cart}>Selección</a></nav></footer>
  </div>
</div>

<style>
  .cota-frame { padding: clamp(2rem, 7vw, 7rem) clamp(0rem, 10vw, 10rem); color: var(--color-foreground); background: #2c2c2c; font-family: var(--font-accent); }
  .cota-page { max-width: 76rem; margin: auto; background: var(--surface-sunken); }
  .cota-page :where(a) { color: inherit; text-decoration: none; }
  .cota-header { display: flex; min-height: 4.5rem; align-items: center; justify-content: space-between; padding: 0 1rem; border-bottom: var(--border-width) solid var(--color-border); }
  .cota-brand { display: flex; align-items: center; gap: .35rem; font-size: 1.3rem; font-weight: 800; letter-spacing: -.08em; }
  .cota-brand i { width: .55rem; aspect-ratio: 1; border: .12rem solid currentColor; transform: rotate(45deg); }
  .cota-header nav { display: flex; gap: 1.5rem; font-size: .55rem; text-transform: uppercase; }
  .cota-header nav a { display: inline-flex; min-height: 2.75rem; align-items: center; }
  .cota-header a:hover, .cota-header a:focus-visible { text-decoration: underline; text-underline-offset: .25rem; }
  .cota-hero { position: relative; margin: 0 .65rem; }
  .cota-hero > img { width: 100%; height: clamp(29rem, 55vw, 48rem); object-fit: cover; }
  .cota-hero::after { position: absolute; inset: 0; background: linear-gradient(180deg, transparent 52%, rgb(10 12 14 / .42)); content: ''; }
  .cota-hero__line { position: absolute; z-index: 1; top: 14%; right: 4%; width: 70%; height: 45%; border-top: 1px solid rgb(255 255 255 / .7); border-right: 1px solid rgb(255 255 255 / .7); transform: skewY(-8deg); }
  .cota-hero__cards { position: absolute; z-index: 2; right: 3%; bottom: 3%; display: grid; width: min(38%, 26rem); grid-template-columns: 1fr 1fr; gap: .5rem; }
  .cota-hero__cards a { position: relative; display: block; aspect-ratio: 1.15; overflow: hidden; border: .28rem solid #f3f3f1; }
  .cota-hero__cards img { width: 100%; height: 100%; object-fit: cover; }
  .cota-hero__cards span { position: absolute; right: .25rem; bottom: .25rem; left: .25rem; padding: .25rem; color: #fff; background: rgb(15 17 17 / .8); font-size: .5rem; text-transform: uppercase; }
  .cota-hero h1 { position: absolute; z-index: 2; bottom: 4%; left: 2%; max-width: 27%; margin: 0; padding: .45rem; color: #fff; background: rgb(15 17 17 / .82); font: 600 clamp(1.1rem, 2vw, 2rem)/1 var(--font-display); letter-spacing: -.045em; text-transform: uppercase; }
  .cota-vision { display: grid; grid-template-columns: 1fr 1.35fr; gap: 3rem; padding: 1rem .65rem clamp(4rem, 8vw, 7rem); }
  .cota-kicker { margin: 0; font: 700 .55rem/1.2 var(--font-accent); text-transform: uppercase; }
  .cota-vision > div { padding-right: 1rem; }
  .cota-vision h2 { margin: 0 0 .7rem; font: 700 .63rem/1.2 var(--font-accent); text-transform: uppercase; }
  .cota-vision > div p { max-width: 35rem; margin: 0; color: var(--color-muted-foreground); font-size: .65rem; line-height: 1.5; }
  .cota-vision a { display: flex; min-height: 3rem; align-items: center; justify-content: space-between; margin-top: 1rem; border-bottom: var(--border-width) solid var(--color-border); font-size: .55rem; text-transform: uppercase; }
  .cota-shop { padding: 0 .65rem clamp(4rem, 7vw, 6rem); }
  .cota-shop__head { display: grid; grid-template-columns: 1fr auto; align-items: end; gap: 2rem; margin-bottom: 1rem; }
  .cota-shop__head p { margin: 0 0 .2rem; font-size: .52rem; text-transform: uppercase; }
  .cota-shop__head h2 { margin: 0; font: 600 clamp(1.4rem, 2.5vw, 2.5rem)/1 var(--font-display); letter-spacing: -.045em; text-transform: uppercase; }
  .cota-results { font-size: .6rem; }
  .cota-empty { display: grid; min-height: 20rem; place-content: center; gap: 1rem; text-align: center; }
  .cota-empty p { margin: 0; font: 600 clamp(1.2rem, 3vw, 2.5rem)/1 var(--font-display); text-transform: uppercase; }
  .cota-empty a { text-decoration: underline; text-underline-offset: .25rem; }
  .cota-feature { position: relative; display: block; margin: 0 .65rem; overflow: hidden; }
  .cota-feature img { width: 100%; height: clamp(23rem, 42vw, 39rem); object-fit: cover; transition: transform .7s ease; }
  .cota-feature:hover img { transform: scale(1.012); }
  .cota-feature > span { position: absolute; right: .75rem; bottom: .65rem; left: .75rem; display: flex; justify-content: space-between; padding: .35rem .45rem; color: #fff; background: rgb(15 17 17 / .82); font-size: .55rem; font-style: normal; text-transform: uppercase; }
  .cota-feature i { font-style: normal; }
  .cota-footer { display: grid; min-height: 15rem; grid-template-columns: 1fr 1fr auto; gap: 2rem; padding: 3rem 1rem; color: #f4f4f2; background: #171817; }
  .cota-footer strong { font-size: clamp(3rem, 8vw, 7rem); line-height: .8; letter-spacing: -.09em; }
  .cota-footer p { max-width: 14rem; margin: 0; font-size: .65rem; text-transform: uppercase; }
  .cota-footer nav { display: flex; flex-direction: column; font-size: .55rem; text-transform: uppercase; }
  .cota-footer nav a { display: inline-flex; min-height: 2.75rem; align-items: center; }
  @media (max-width: 760px) {
    .cota-frame { padding: 0; }
    .cota-header nav a:not(:last-child) { display: none; }
    .cota-hero > img { height: 34rem; }
    .cota-hero__cards { width: 58%; }
    .cota-hero h1 { bottom: 22%; max-width: 62%; }
    .cota-vision, .cota-shop__head { grid-template-columns: 1fr; }
    .cota-vision { gap: 1.5rem; }
    .cota-footer { grid-template-columns: 1fr 1fr; }
    .cota-footer strong { grid-column: 1 / -1; }
  }
  @media (prefers-reduced-motion: reduce) { .cota-feature img { transition: none; } }
</style>
