---
import type { CollectionConfig, StorePaths } from '../../../collections';
interface Props { paths: StorePaths; collection: CollectionConfig; count: number; activeCategory?: string | undefined; sort: string; search?: string | undefined; }
const { paths, collection, count, activeCategory, sort, search } = Astro.props;
const hrefFor = (category?: string) => { const p = new URLSearchParams(); if (category) p.set('categoria', category); if (sort !== 'featured') p.set('orden', sort); if (search) p.set('q', search); return `${paths.catalog}${p.size ? `?${p}` : ''}`; };
---
<div class="cota-filters"><nav aria-label="Localización"><span>{count} proyectos</span><a href={hrefFor()} aria-current={!activeCategory ? 'page' : undefined}>Todos</a>{collection.categories.map((cat) => <a href={hrefFor(cat.id)} aria-current={activeCategory === cat.id ? 'page' : undefined}>{cat.label}</a>)}</nav><form method="get" action={paths.catalog} role="search">{activeCategory && <input type="hidden" name="categoria" value={activeCategory} />}<input type="search" name="q" value={search} maxlength="60" placeholder="Buscar" aria-label="Buscar proyectos" /><select name="orden" aria-label="Ordenar proyectos" onchange="this.form.submit()"><option value="featured" selected={sort === 'featured'}>Selección</option><option value="price-asc" selected={sort === 'price-asc'}>Precio ↑</option><option value="price-desc" selected={sort === 'price-desc'}>Precio ↓</option><option value="name" selected={sort === 'name'}>Nombre A–Z</option></select></form></div>
<style>
  .cota-filters, .cota-filters nav, .cota-filters form { display: flex; align-items: center; gap: .85rem; }
  .cota-filters { justify-content: flex-end; font-size: .52rem; text-transform: uppercase; }
  .cota-filters nav > span { color: var(--color-muted-foreground); }
  .cota-filters a { display: inline-flex; min-height: 2.75rem; align-items: center; color: inherit; text-decoration: none; }
  .cota-filters a[aria-current='page'], .cota-filters a:hover { text-decoration: underline; text-underline-offset: .25rem; }
  .cota-filters :is(input, select) { min-height: 2.75rem; max-width: 6.5rem; border: 0; border-bottom: var(--border-width) solid var(--color-border); border-radius: 0; color: inherit; background: transparent; font: inherit; text-transform: uppercase; }
  @media (max-width: 900px) { .cota-filters { align-items: stretch; flex-direction: column; } .cota-filters nav { overflow-x: auto; } .cota-filters nav > * { flex: 0 0 auto; } }
</style>
