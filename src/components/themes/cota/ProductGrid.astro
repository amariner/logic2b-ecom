---
import type { StorePaths } from '../../../collections';
import { formatEurCents } from '../../../lib/format';
type GridProduct = { slug: string; name: string; description: string; price_cents: number; image: string; stock: number; };
interface Props { paths: StorePaths; products: GridProduct[]; }
const { paths, products } = Astro.props;
---
<ul class="cota-grid">
  {products.map((product, index) => <li class="cota-card"><a href={paths.product(product.slug)}><div><img src={product.image} alt={product.name} width="2016" height="1344" loading={index < 3 ? 'eager' : 'lazy'} /></div><h3>{product.name}</h3></a><p>{product.description}</p><span>{formatEurCents(product.price_cents)}</span><button type="button" data-cota-add={product.slug} disabled={product.stock === 0}>{product.stock === 0 ? 'No disponible' : 'Añadir a selección +'}</button></li>)}
</ul>
<script>
  import { addToCart } from '../../../lib/cart-client';
  document.querySelectorAll<HTMLButtonElement>('[data-cota-add]').forEach((button) => button.addEventListener('click', () => { addToCart(button.dataset.cotaAdd ?? ''); const before = button.textContent; button.textContent = 'Seleccionado ✓'; setTimeout(() => (button.textContent = before), 850); }));
</script>
<style>
  .cota-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .3rem; margin: 0; padding: 0; list-style: none; }
  .cota-card { position: relative; min-width: 0; padding-bottom: 4rem; }
  .cota-card a { color: inherit; text-decoration: none; }
  .cota-card a > div { overflow: hidden; aspect-ratio: .93; background: var(--surface-product); }
  .cota-card img { width: 100%; height: 100%; object-fit: cover; transition: transform .55s ease; }
  .cota-card:hover img { transform: scale(1.018); }
  .cota-card h3 { margin: .55rem 0 0; font: 700 .63rem/1.1 var(--font-display); text-transform: uppercase; }
  .cota-card p { margin: .22rem 0 0; color: var(--color-muted-foreground); font-size: .52rem; line-height: 1.35; }
  .cota-card > span { display: block; margin-top: .35rem; font-size: .54rem; }
  .cota-card button { position: absolute; right: 0; bottom: .65rem; min-height: 2.75rem; padding: .55rem .8rem; border: var(--border-width) solid var(--color-border); border-radius: var(--radius-btn); color: var(--color-brand-fg); background: var(--color-brand); font: 700 .5rem/1 var(--font-accent); text-transform: uppercase; cursor: pointer; }
  @media (max-width: 700px) { .cota-grid { grid-template-columns: 1fr 1fr; } .cota-card p { font-size: .58rem; } }
  @media (prefers-reduced-motion: reduce) { .cota-card img { transition: none; } }
</style>
