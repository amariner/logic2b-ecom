---
/** ARISTA · mosaico de perfiles con orden visual explícito por breakpoint. */
import type { StorePaths } from '../../../collections';
import { formatEurCents } from '../../../lib/format';

type GridProduct = {
  slug: string;
  name: string;
  subtitle?: string | null | undefined;
  price_cents: number;
  image: string;
  stock: number;
};

interface Props { products: GridProduct[]; paths: StorePaths; }
const { products, paths } = Astro.props;
---

<div class="arista-stage">
  <span class="arista-stage__count" aria-hidden="true">{String(products.length).padStart(2, '0')}</span>
  <ul class="arista-grid">
    {products.map((product, index) => (
      <li class="arista-card">
        <a href={paths.product(product.slug)}>
          <div class="arista-card__media">
            <img src={product.image} alt={product.name} width="1536" height="1024" loading={index < 2 ? 'eager' : 'lazy'} />
          </div>
          <div class="arista-card__meta">
            <div><h2>{product.name}</h2><p>{product.subtitle}</p></div>
            <span>{formatEurCents(product.price_cents)}</span>
          </div>
        </a>
      </li>
    ))}
  </ul>
</div>

<style>
  .arista-stage { position: relative; min-height: 70rem; padding-top: clamp(2rem, 5vw, 5rem); }
  .arista-stage__count { position: absolute; top: clamp(13rem, 24vw, 24rem); left: 1vw; font: 500 clamp(8rem, 21vw, 22rem)/.7 var(--font-display); letter-spacing: -.08em; }
  .arista-grid { position: relative; display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: clamp(4.5rem, 9vw, 10rem) var(--grid-gap); margin: 0; padding: 0; list-style: none; }
  .arista-card { grid-column: span 4; min-width: 0; }
  .arista-card:nth-child(1) { grid-column: 5 / 9; }
  .arista-card:nth-child(2) { grid-column: 9 / 13; margin-top: clamp(6rem, 12vw, 12rem); }
  .arista-card:nth-child(3) { grid-column: 1 / 8; margin-top: clamp(2rem, 4vw, 4rem); }
  .arista-card:nth-child(4) { grid-column: 9 / 13; align-self: end; }
  .arista-card > a { display: block; }
  .arista-card__media { overflow: hidden; aspect-ratio: 1.35; background: var(--surface-product); }
  .arista-card:nth-child(2) .arista-card__media { aspect-ratio: .83; }
  .arista-card:nth-child(3) .arista-card__media { aspect-ratio: 1.6; }
  .arista-card:nth-child(4) .arista-card__media { aspect-ratio: 1.8; }
  .arista-card__media img { width: 100%; height: 100%; object-fit: cover; transition: transform .45s ease; }
  .arista-card:hover .arista-card__media img { transform: scale(1.018); }
  .arista-card__meta { display: flex; justify-content: space-between; gap: 1rem; padding-top: .55rem; font-size: .54rem; }
  .arista-card__meta h2 { margin: 0; font: 500 .64rem/1.15 var(--font-display); }
  .arista-card__meta p { margin: .2rem 0 0; color: var(--color-muted-foreground); text-transform: uppercase; }
  .arista-card__meta > span { flex: 0 0 auto; color: var(--color-muted-foreground); }
  .arista-card a:focus-visible { outline: .16rem solid var(--color-brand); outline-offset: .18rem; }
  @media (max-width: 720px) {
    .arista-stage { min-height: 0; }
    .arista-stage__count { position: static; display: block; margin: 4rem 0 2rem; font-size: 9rem; }
    .arista-grid { grid-template-columns: 1fr 1fr; gap: 4rem .6rem; }
    .arista-card:nth-child(n) { grid-column: auto; margin-top: 0; }
    .arista-card:nth-child(1), .arista-card:nth-child(3) { grid-column: 1 / -1; }
    .arista-card:nth-child(n) .arista-card__media { aspect-ratio: 1.22; }
    .arista-card:nth-child(2) .arista-card__media, .arista-card:nth-child(4) .arista-card__media { aspect-ratio: .83; }
    .arista-card__meta { flex-direction: column; }
  }
  @media (prefers-reduced-motion: reduce) { .arista-card__media img { transition: none; } }
</style>
