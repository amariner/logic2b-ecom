---
import './tokens.css';
import './original.css';
import './commerce.css';
import Filters from './Filters.astro';
import ProductGrid from './ProductGrid.astro';
import { parseSpecs, type ProductRow } from '../../../lib/db';
import { getDemoProduct } from '../../../composition/demo-catalog';
import { zancadaCollection } from '../../../collections/zancada';
import { storePaths, categoryLabel } from '../../../collections';
import { formatEurCents } from '../../../lib/format';
import { shopConfig } from '../../../../shop.config';
import { zancadaModels, zancadaSizeSlug } from '../../../collections/zancada';

interface Props { current?: ProductRow; rows?: ProductRow[]; category?: string | undefined; sort?: string | undefined; search?: string | undefined }
const { current, rows = [], category, sort = 'featured', search = '' } = Astro.props;
const product = Boolean(current);
const base = storePaths('zancada').catalog;
const paths = storePaths('zancada');
const assets = '/images/collections/zancada';
const model = zancadaModels.find(m => current?.slug === m.slug || current?.slug.startsWith(m.slug + '-t')) ?? zancadaModels[0];
const products = zancadaModels.slice(0,4);
const socks = zancadaModels.slice(4,10);
const equipment = zancadaModels.slice(10);
const filtered = Boolean(category || search || sort !== 'featured');
const visibleRows = rows.filter(row => zancadaModels.some(m => m.slug === row.slug));
const featured = getDemoProduct('zancada', zancadaModels[0].slug)!;
const selectedSize = current ? parseSpecs(current.specs_json).find(s => s.label === 'Talla')?.value ?? '' : '';
const gallery = model.slug === 'zan-xt-wings-2' ? ['model-detail.webp', 'hero-model.webp', 'model-back.webp', 'hero-trail.webp'] : [model.asset];
const MainTag = product ? 'div' : 'main';
const events = [
  {date:'20 SEP — VALÈNCIA',title:'UN NUEVO PUNTO\nDE ENCUENTRO.',image:'event-store',cta:'CONOCE LA TIENDA',body:'Nuestra concept store de muestra reúne calzado, prendas técnicas y cultura del running. Madera, luz natural y una selección hecha con calma. Esta apertura es un contenido editorial ficticio de la demo.'},
  {date:'JOURNAL — Nº 01',title:'CORRER TAMBIÉN\nES ESCUCHAR.',image:'editorial',cta:'ABRIR JOURNAL',body:'Hay días para mirar el reloj y otros para olvidarlo. Una conversación sobre el ritmo propio, los pequeños rituales y lo que descubrimos cuando salimos a correr. Artículo editorial de demostración.'},
  {date:'27 SEP — 08:00 H',title:'DOMINGO.\nMISMO PUNTO DE SALIDA.',image:'event-run',cta:'DESCUBRE EL ENCUENTRO',body:'Un recorrido suave junto al mar, abierto a todos los ritmos. Punto de encuentro ilustrativo: la tienda Zancada. Distancia: 8 km. Después, café. Es una actividad ficticia de esta demo; no requiere ni registra inscripciones.'},
];

---
<div class="zancada" data-page={product ? 'product' : 'home'}>
  {!product && <header class="ds-header">
    <div class="ds-navline">
      <a class="ds-symbol" href={`${base}`} aria-label="Zancada, inicio"><svg viewBox="0 0 60 42" fill="none" aria-hidden="true"><path d="M47 8a20 20 0 1 0 0 26" stroke="currentColor" stroke-width="2.5"/><path d="M24 13h22L28 29h22" stroke="currentColor" stroke-width="3.5" stroke-linejoin="bevel"/><path d="M8 21H1M11 27H5" stroke="currentColor" stroke-width="2"/></svg></a>
      <nav class="ds-nav" aria-label="Navegación principal"><a href={`${base}#novedades`}>Novedades</a><a href={`${base}#novedades`}>Hombre</a><a href={`${base}#novedades`}>Mujer</a><a href={`${base}#accesorios`}>Objetos</a><a href={`${base}#marcas`}>Marcas</a><a href={`${base}#club`}>Journal</a><a href={`${base}#encuentros`}>Tiendas</a><a href={`${base}#encuentros`}>Runs</a><a class="ds-sale" href={`${base}?orden=name#novedades`}>Catálogo</a></nav>
      <div class="ds-tools"><a class="ds-account" href="/demo/admin">Gestor tienda</a><span class="ds-language">ES</span><a href={paths.cart}>Bolsa (<span data-cart-count>0</span>)</a><button data-search-open aria-label="Buscar productos"><svg width="13" height="13" viewBox="0 0 20 20" fill="none"><circle cx="8" cy="8" r="5.5" stroke="currentColor" stroke-width="1.5"/><path d="m12 12 5 5" stroke="currentColor" stroke-width="1.5"/></svg></button><button class="ds-menu-toggle" aria-label="Abrir menú" aria-expanded="false">Menú +</button></div>
    </div>
    <a class="ds-wordmark" href={`${base}`} aria-label="Zancada, inicio">zancada<span aria-hidden="true">↗</span></a>
  </header>}
  <MainTag>
    {product ? <>
      <div class="ds-breadcrumb"><a href={`${base}`}>Inicio</a><span>/</span><a href={`${base}#novedades`}>{categoryLabel(zancadaCollection, model.category)}</a><span>/</span><span>{model.brand} {model.name}</span></div>
      <section class="ds-product-layout" aria-label={`${model.brand} ${model.name}`}>
        <div class="ds-gallery" data-commerce-part="media">
          <div class="ds-gallery-stage" tabindex="0" aria-label="Galería de producto. Usa las flechas para cambiar de imagen.">
            {gallery.map((img,i) => <img width="1000" height="1200" class:list={['ds-gallery-image', { active: i === 0 }]} aria-hidden={i !== 0} src={`${assets}/${img}`} alt={`${model.brand} ${model.name} — fotografía ${i+1}`} loading={i === 0 ? 'eager' : 'lazy'} />)}
            <span class="ds-gallery-label">{model.brand} — EN MOVIMIENTO</span>
            <button class="ds-zoom" aria-label="Ampliar fotografía">↗</button>
            <div class="ds-gallery-controls"><button data-prev aria-label="Fotografía anterior">←</button><span><span data-slide-number>01</span> / {String(gallery.length).padStart(2,'0')}</span><button data-next aria-label="Fotografía siguiente">→</button></div>
          </div>
          <div class="ds-thumbnails">{gallery.map((img,i)=><button data-slide={i} aria-label={`Ver fotografía ${i+1}`} aria-current={i===0?'true':'false'}><img width="1000" height="1200" src={`${assets}/${img}`} alt="" loading="lazy"/></button>)}</div>
        </div>
        <div class="ds-product-info" data-commerce-part="details">
          {model.slug === 'zan-xt-wings-2' && <div class="ds-spin"><video aria-hidden="true" data-motion muted loop playsinline preload="none" poster={`${assets}/shoe-360-poster.webp`}><source src={`${assets}/shoe-360.mp4`} type="video/mp4"/></video><div class="ds-spin-caption"><span>EL PRODUCTO, DESDE TODOS LOS ÁNGULOS</span><span>360° ↻</span></div><button class="ds-video-toggle" aria-label="Pausar vídeo de producto">Ⅱ</button></div>}
          <div class="ds-product-heading"><span><i style="--dot:#d9ff43"></i> {model.brand}</span><span>COLECCIÓN RUNNING</span></div>
          <div class="ds-title-price"><h1>{model.slug === 'zan-xt-wings-2' ? <>XT-WINGS 2<br/>ADVANCED</> : model.name}</h1><span>{formatEurCents(current!.price_cents)}</span></div>
          <p class="ds-product-color">{model.color}</p>
          <p class="ds-product-description">{model.description}</p>
          <div class="ds-color-options"><span>COLOR — {model.color}</span><img src={`${assets}/${model.asset}`} alt={model.color} width="64" height="64"/></div>
          <div data-commerce-part="purchase">
            <div class="ds-size-label"><span>SELECCIONA TU TALLA</span><button data-size-guide>Guía de tallas ↗</button></div>
            <div class="ds-sizes" role="group" aria-label="Talla">{model.sizes.map(size => {
              const item = getDemoProduct('zancada', zancadaSizeSlug(model, size))!;
              return <button data-size={size} data-size-slug={item.slug} aria-pressed={size === selectedSize ? 'true' : 'false'} disabled={item.stock === 0}>{size}</button>;
            })}</div>
            <p class="ds-size-status" aria-live="polite">{current!.stock > 0 ? `Talla ${selectedSize} · Disponible` : `Talla ${selectedSize} · Agotada. Elige otra talla.`}</p>
            <button class="ds-buy" data-commerce-action="add-to-cart" data-product-slug={current!.slug} disabled={current!.stock === 0}>AÑADIR A LA BOLSA <span>↗</span></button>
            <a class="ds-bag-link" href={paths.cart}>VER MI BOLSA ↗</a>
          </div>
          <p class="ds-shipping">{shopConfig.legal.shippingNote}</p>
<div class="ds-product-details"><details open><summary>DETALLES DEL PRODUCTO <span>+</span></summary><p>{model.description}</p><dl><div><dt>Referencia</dt><dd>{model.slug}</dd></div><div><dt>Marca</dt><dd>{model.brand}</dd></div><div><dt>Color</dt><dd>{model.color}</dd></div></dl></details><details><summary>ENVÍOS Y DEVOLUCIONES <span>+</span></summary><p>{shopConfig.legal.shippingNote} {shopConfig.legal.returnsNote} Recorrido de demostración: no se genera un pedido real.</p></details><details><summary>CUIDADO Y MATERIALES <span>+</span></summary><p>Consulta la etiqueta de cada artículo antes de limpiarlo. Las imágenes y descripciones son ilustrativas de esta colección.</p></details></div>
        </div>
      </section>
    </> : !filtered && <>
      <section class="ds-hero" aria-label="Colecciones destacadas">
        <article class="ds-hero-trail"><a href={paths.product('zan-xt-wings-2')} class="ds-hero-link" aria-label="Descubrir Salomon XT-Wings"><video aria-hidden="true" data-motion muted loop playsinline preload="none" poster={`${assets}/hero-trail.webp`}><source src={`${assets}/hero-trail.mp4`} type="video/mp4"/></video><h1>SALOMON<br/>XT-WINGS</h1><div class="ds-hero-caption"><i></i><p>SALOMON<br/>XT-WINGS 2 ADVANCED<br/>WHITE / SILVER / BLACK<br/>{formatEurCents(featured.price_cents)}</p></div><span class="ds-hero-arrow">↗</span></a><button class="ds-video-toggle" aria-label="Pausar vídeo de trail">Ⅱ</button></article>
        <article class="ds-hero-model"><a href={paths.product('zan-xt-wings-2')} class="ds-hero-link" aria-label="Explorar la selección de running"><video aria-hidden="true" data-motion muted loop playsinline preload="none" poster={`${assets}/hero-model-video.webp`}><source src={`${assets}/hero-model.mp4`} type="video/mp4"/></video><h2>BUENA<br/>ZANCADA.</h2><span class="ds-model-sub">EL RITMO LO PONES TÚ.</span></a><button class="ds-video-toggle" aria-label="Pausar vídeo del modelo">Ⅱ</button></article>
      </section>
      <div class="ds-hero-under"><span>PARA LOS QUE NO SE QUEDAN QUIETOS.</span><a href="#novedades">EXPLORA LA SELECCIÓN ↗</a></div>
    </>}
    <section class="ds-arrivals" id="novedades">
      {filtered && <h1 class="ds-catalog-title">LA SELECCIÓN ZANCADA</h1>}
      <div class="ds-section-heading"><h2>{product ? 'SIGUE EXPLORANDO' : filtered ? 'TU SELECCIÓN' : 'RECIÉN LLEGADOS'}</h2><div class="ds-catalog-arrows"><button data-catalog-prev aria-label="Productos anteriores">←</button><button data-catalog-next aria-label="Más productos">→</button></div></div>
      {!product && <Filters collection={zancadaCollection} count={filtered ? visibleRows.length : zancadaModels.length} activeCategory={category} sort={sort} search={search} />}
      <ProductGrid products={filtered ? visibleRows : products.map(m => getDemoProduct('zancada', m.slug)!)} grid={filtered}/>
    </section>
    {!product && !filtered && <>
      <section class="ds-campaigns" id="club" aria-label="Historias fuera del asfalto">
        <article class="ds-mountain-campaign">
          <img width="1000" height="1200" src={`${assets}/campaign-mountain.webp`} alt="Cumbres rocosas y bosques del Pirineo" loading="lazy" />
          <div class="ds-mountain-poster"><div class="ds-poster-top"><span>ZANCADA FIELD NOTES</span><span>001 / PIRINEOS</span></div><p>FUERA<br/>DE RUTA.</p><div class="ds-poster-bottom"><span>42° 38′ N<br/>00° 39′ E</span><span>MENOS RELOJ.<br/>MÁS MONTAÑA.</span><span aria-hidden="true">↗</span></div></div>
          <div class="ds-campaign-copy"><h2>EL CAMINO SE HACE<br/>FUERA DEL CAMINO.</h2><button data-fixture="FUERA DE RUTA — PIRINEOS" data-fixture-body="Un fin de semana de senderos, refugios y kilómetros sin prisa. Nuestra selección de trail se inspira en las rutas del Pirineo y en quienes prefieren descubrir su propio camino. Campaña editorial ficticia de Zancada.">DESCUBRIR <span>↗</span></button></div>
        </article>
        <article class="ds-runner-campaign"><img width="1000" height="1200" src={`${assets}/campaign-runner.webp`} alt="Corredora ajustando su cinturón de trail en la montaña" loading="lazy"/><div class="ds-campaign-copy"><h2>LLEVA SOLO<br/>LO QUE IMPORTA.</h2><p>TRAIL ESSENTIALS</p><a href="#equipamiento">EXPLORAR <span>↗</span></a></div></article>
      </section>
      <section class="ds-sock-section" id="accesorios" aria-labelledby="ds-sock-title">
        <div class="ds-section-heading"><div><h2 id="ds-sock-title">PACE CREW</h2><p class="ds-section-subtitle">UNA ROTACIÓN PARA TODOS TUS KILÓMETROS. 16 € / PAR.</p></div><span class="ds-small-label">ZANCADA PACE CREW / 01—06</span></div>
        <div class="ds-sock-track" data-strip="socks">{socks.map(p=><a class="ds-sock-card" href={paths.product(p.slug)} aria-label={`Ver calcetín ${p.color}`}><img width="1000" height="1200" src={`${assets}/${p.asset}`} alt={`Calcetín técnico ${p.color}`} loading="lazy"/><span>{p.color}</span></a>)}</div>
        <div class="ds-strip-footer"><div><button data-strip-prev="socks" aria-label="Calcetines anteriores">←</button><button data-strip-next="socks" aria-label="Más calcetines">→</button></div><a href={`${base}?categoria=zan-calcetines#novedades`}>VER LA COLECCIÓN <span>↗</span></a></div>
      </section>
      <section class="ds-equipment" id="equipamiento" aria-labelledby="ds-equipment-title"><div class="ds-section-heading"><h2 id="ds-equipment-title">EQUIPADOS PARA SALIR</h2><span class="ds-small-label">POCO PESO. MUCHO RECORRIDO.</span></div><div class="ds-equipment-grid">{equipment.map(p=><a class="ds-equipment-card" href={paths.product(p.slug)}><img width="1000" height="1200" src={`${assets}/${p.asset}`} alt={`${p.name} — ${p.color}`} loading="lazy"/><div><span>{p.brand}</span><span>{p.name} ↗</span></div></a>)}</div></section>
      <section class="ds-brand-block" aria-label="Zancada Running Goods"><div class="ds-brand-top"><span class="ds-brand-signature">zancada↗</span><span>RUNNING GOODS<br/>PARA SEGUIR ADELANTE.</span></div><h2>EL SIGUIENTE<br/><span>PASO ES TUYO.</span></h2><div class="ds-brand-bottom"><span>DEL PRIMER KILÓMETRO<br/>AL QUE TODAVÍA NO CONOCES.</span><a href="#equipamiento">DESCUBRE ZANCADA <span>↗</span></a><span class="ds-brand-stamp" aria-hidden="true">Z↗</span></div></section>
      <section class="ds-events" id="encuentros" aria-labelledby="ds-events-title"><div class="ds-section-heading"><h2 id="ds-events-title">NOS VEMOS FUERA</h2><span class="ds-small-label">TIENDAS, HISTORIAS Y KILÓMETROS COMPARTIDOS.</span></div><div class="ds-event-track" data-strip="events">{events.map(event=><button class="ds-event-card" data-fixture={event.title.replace('\n',' ')} data-fixture-body={event.body}><img width="1000" height="1200" src={`${assets}/${event.image}.webp`} alt={event.title.replace('\n',' ')} loading="lazy"/><div class="ds-event-title"><span>{event.date}</span><h3>{event.title.split('\n').map(line=><span>{line}<br/></span>)}</h3></div><span class="ds-event-cta">{event.cta} ↗</span></button>)}</div><div class="ds-strip-footer"><div><button data-strip-prev="events" aria-label="Historias anteriores">←</button><button data-strip-next="events" aria-label="Más historias">→</button></div><button data-fixture="AGENDA ZANCADA" data-fixture-body="Encuentra inspiración en nuestras salidas, conversaciones y espacios. Esta agenda utiliza encuentros y fechas de demostración; no anuncia actividades reales.">TODOS LOS ENCUENTROS ↗</button></div></section>
      <section class="ds-brands" id="marcas" aria-label="Marcas de nuestra selección"><div class="ds-section-heading"><h2>BUENA COMPAÑÍA.</h2><span class="ds-small-label">NUESTRA SELECCIÓN DE MARCAS</span></div><div class="ds-brand-track" data-strip="brands">{['SALOMON','SATISFY','VEJA','ZANCADA'].map(brand=><a href={`${base}?q=${brand}#novedades`}>{brand}</a>)}</div><div class="ds-strip-footer"><div><button data-strip-prev="brands" aria-label="Marcas anteriores">←</button><button data-strip-next="brands" aria-label="Más marcas">→</button></div><span>RUNNING, EN TODAS SUS FORMAS.</span></div></section>
    </>}
    <section class="ds-newsletter"><div><span>MANTÉN EL RITMO</span><h2>Lo próximo,<br/>antes que nadie.</h2></div><form data-newsletter><label for="ds-email">Novedades, lanzamientos y kilómetros compartidos.</label><div><input id="ds-email" type="email" placeholder="Tu dirección de email" required autocomplete="email"/><button type="submit" aria-label="Suscribirse">↗</button></div><p data-newsletter-status aria-live="polite">Demostración: no se guarda ni se envía tu email.</p></form></section>
  </MainTag>
  {!product && <footer class="ds-footer"><div class="ds-footer-top"><a class="ds-symbol" href={`${base}`} aria-label="Zancada, inicio"><svg viewBox="0 0 60 42" fill="none" aria-hidden="true"><path d="M47 8a20 20 0 1 0 0 26" stroke="currentColor" stroke-width="2.5"/><path d="M24 13h22L28 29h22" stroke="currentColor" stroke-width="3.5" stroke-linejoin="bevel"/><path d="M8 21H1M11 27H5" stroke="currentColor" stroke-width="2"/></svg></a><div class="ds-footer-links"><div><span>TE AYUDAMOS</span><button data-fixture="Contacto">Contacto</button><button data-fixture="Envíos y devoluciones">Envíos y devoluciones</button><button data-fixture="Preguntas frecuentes">Preguntas frecuentes</button></div><div><span>EL UNIVERSO ZANCADA</span><a href={`${base}#encuentros`}>Nuestros encuentros</a><a href={`${base}#marcas`}>Nuestras marcas</a><button data-fixture="Instagram">Instagram ↗</button></div><div><span>LO ESENCIAL</span><button data-fixture="Privacidad">Privacidad</button><button data-fixture="Condiciones de compra">Condiciones de compra</button><span>ESPAÑA / EUR €</span></div></div><span>© ZANCADA 2026</span></div><a class="ds-footer-wordmark" href={`${base}`}>zancada<span aria-hidden="true">↗</span></a><p class="ds-demo-note">Concept store de demostración. Productos, precios y condiciones ilustrativos.</p></footer>}
  <dialog class="ds-dialog ds-info-dialog" aria-labelledby="ds-info-title"><div class="ds-dialog-head"><h2 id="ds-info-title" data-info-title></h2><button data-close aria-label="Cerrar">×</button></div><div data-info-body></div></dialog>
  <dialog class="ds-dialog ds-search" aria-label="Buscar productos"><div class="ds-dialog-head"><h2>ENCUENTRA TU PRÓXIMO PAR</h2><button data-close aria-label="Cerrar búsqueda">×</button></div><input type="search" aria-label="Buscar zapatillas" placeholder="Buscar marca, modelo, color…"/><div class="ds-search-results">{zancadaModels.map(p=><a href={paths.product(p.slug)} data-search-term={`${p.brand} ${p.name} ${p.color}`}><img src={`${assets}/${p.asset}`} alt="" width="100" height="100" loading="lazy"/><span>{p.brand}<br/>{p.name}<br/>{formatEurCents(p.price_cents)}</span><span>↗</span></a>)}<p data-search-empty hidden>No encontramos ese modelo. Prueba con «Salomon» o «XT».</p></div></dialog>
  <dialog class="ds-lightbox" aria-label="Fotografía ampliada"><button data-close aria-label="Cerrar fotografía ampliada">×</button><img width="1000" height="1200" src={`${assets}/model-detail.webp`} alt="Fotografía de producto ampliada"/></dialog>
  <div class="ds-toast" role="status" aria-live="polite"></div>
</div>
<script>
  const root = document.querySelector<HTMLElement>('.zancada');
  if(root){
    const q = <T extends Element=HTMLElement>(s:string) => root.querySelector<T>(s)!;
    const qa = <T extends Element=HTMLElement>(s:string) => [...root.querySelectorAll<T>(s)];
    const reduced=matchMedia('(prefers-reduced-motion: reduce)');
    qa<HTMLDialogElement>('dialog').forEach(d=>{d.querySelector('[data-close]')?.addEventListener('click',()=>d.close());d.addEventListener('click',e=>{if(e.target===d)d.close()})});
    const info=(title:string,body:string)=>{q('[data-info-title]').textContent=title;q('[data-info-body]').textContent=body;q<HTMLDialogElement>('.ds-info-dialog').showModal()};
    qa<HTMLButtonElement>('[data-fixture]').forEach(b=>b.addEventListener('click',()=>info(b.dataset.fixture!,b.dataset.fixtureBody||'Contenido ilustrativo de Zancada. Puedes explorar el catálogo, añadir artículos a tu bolsa y recorrer la entrega y confirmación sin enviar datos ni realizar cobros.')));
    const menu=q<HTMLButtonElement>('.ds-menu-toggle');menu?.addEventListener('click',()=>{const expanded=menu.getAttribute('aria-expanded')!=='true';menu.setAttribute('aria-expanded',String(expanded));menu.setAttribute('aria-label',expanded?'Cerrar menú':'Abrir menú');root.classList.toggle('menu-open',expanded);menu.textContent=expanded?'Cerrar −':'Menú +'});
    const videos=qa<HTMLVideoElement>('video[data-motion]');
    const observer=new IntersectionObserver(entries=>entries.forEach(e=>{const v=e.target as HTMLVideoElement;if(e.isIntersecting&&!reduced.matches&&v.dataset.paused!=='true')v.play().catch(()=>{});else v.pause()}),{threshold:.05});
    videos.forEach(v=>{observer.observe(v);const b=v.parentElement?.querySelector<HTMLButtonElement>('.ds-video-toggle')||v.parentElement?.parentElement?.querySelector<HTMLButtonElement>('.ds-video-toggle');if(b){const label=b.getAttribute('aria-label')||'Pausar vídeo';const sync=()=>{b.textContent=v.paused?'▷':'Ⅱ';b.setAttribute('aria-label',v.paused?label.replace('Pausar','Reproducir'):label)};v.addEventListener('play',sync);v.addEventListener('pause',sync);sync();b.addEventListener('click',()=>{if(v.paused){v.dataset.paused='false';v.play().catch(()=>{})}else{v.dataset.paused='true';v.pause()}})}});
    reduced.addEventListener('change',()=>{videos.forEach(v=>{if(reduced.matches)v.pause();else {observer.unobserve(v);observer.observe(v)}})});
    const track=q('.ds-product-track');q('[data-catalog-next]').addEventListener('click',()=>track.scrollBy({left:track.clientWidth*.7,behavior:reduced.matches?'instant':'smooth'}));q('[data-catalog-prev]').addEventListener('click',()=>track.scrollBy({left:-track.clientWidth*.7,behavior:reduced.matches?'instant':'smooth'}));
    qa<HTMLButtonElement>('[data-filter]').forEach(b=>b.addEventListener('click',()=>{qa('[data-filter]').forEach(x=>x.setAttribute('aria-pressed',String(x===b)));qa<HTMLElement>('.ds-card').forEach(c=>c.hidden=b.dataset.filter!=='all'&&c.dataset.type!==b.dataset.filter);track.scrollLeft=0}));
    qa<HTMLElement>('[data-strip-prev],[data-strip-next]').forEach(b=>b.addEventListener('click',()=>{const name=b.dataset.stripNext||b.dataset.stripPrev;const strip=q<HTMLElement>('[data-strip="'+name+'"]');strip.scrollBy({left:strip.clientWidth*.8*(b.dataset.stripNext?1:-1),behavior:reduced.matches?'instant':'smooth'})}));
