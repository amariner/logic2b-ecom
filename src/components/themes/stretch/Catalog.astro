---
import type { CollectionConfig, StorePaths } from '../../../lib/collections';
import { stretchProducts } from '../../../collections/stretch-products';
interface Props { paths:StorePaths; collection:CollectionConfig; products:unknown[]; category?:string|undefined; sort:string; search?:string|undefined; }
const heroVideos=[
  'https://d8j0ntlcm91z4.cloudfront.net/user_38xzZboKViGWJOttwIXH07lWA1P/hf_20260516_112022_cddf2487-4ffe-45b6-ba4c-99ab79003cc5.mp4',
  'https://d8j0ntlcm91z4.cloudfront.net/user_38xzZboKViGWJOttwIXH07lWA1P/hf_20260518_175400_b46d1cd2-2050-45e2-9d13-b9c0bacb16b3.mp4',
  'https://d8j0ntlcm91z4.cloudfront.net/user_38xzZboKViGWJOttwIXH07lWA1P/hf_20260518_182440_671605c8-2ed8-4507-a4cb-a62a8f61316f.mp4',
];
const heroPosters=[
  '/images/collections/stretch/glow-set.jpg',
  '/images/collections/stretch/serum.jpg',
  '/images/collections/stretch/day-oil.jpg',
];
const categories=[
  {name:'rostro',slug:'face',poster:'/images/collections/stretch/cleanser.jpg',video:'https://d8j0ntlcm91z4.cloudfront.net/user_38xzZboKViGWJOttwIXH07lWA1P/hf_20260518_203023_87a26602-2898-4acc-a396-c7a2b5ad84fd.mp4'},
  {name:'herramientas',slug:'tools',poster:'/images/collections/stretch/serum.jpg',video:'https://d8j0ntlcm91z4.cloudfront.net/user_38xzZboKViGWJOttwIXH07lWA1P/hf_20260518_203415_b86e3f19-2aec-46cd-9a86-b64c40118e38.mp4'},
  {name:'cuerpo',slug:'body',poster:'/images/collections/stretch/day-oil.jpg',video:'https://d8j0ntlcm91z4.cloudfront.net/user_38xzZboKViGWJOttwIXH07lWA1P/hf_20260518_203051_85fee398-ea01-4aa0-972b-137a74213be5.mp4'},
];
---
<main class="stretch-shell bg-[#F9F4F0] text-black">
  <section id="inicio" class="relative min-h-screen overflow-hidden bg-black text-white">
    <div class="absolute inset-x-0 top-0 z-30 flex items-center justify-center gap-5 bg-[#F9F4F0] px-4 py-2.5 text-[11px] uppercase tracking-[.09em] text-black md:py-3"><span aria-hidden="true">‹</span><span>Envío gratis en pedidos superiores a 50 €</span><span aria-hidden="true">›</span></div>
    <header class="absolute inset-x-0 top-[38px] z-30 flex items-center justify-between px-5 py-5 md:top-[42px] md:px-10">
      <a href="#inicio" class="text-lg font-bold uppercase tracking-[.2em] sm:text-xl">STRETCH</a>
      <nav class="hidden gap-8 text-sm md:flex" aria-label="Navegación principal">
        {[['#productos','tienda'],['#categorias','descubre'],['#productos','journal'],['/temas','temas']].map(([href,label]) => <a href={href} class="group relative py-1">{label}<span class="absolute inset-x-0 bottom-0 h-px w-0 bg-white transition-all duration-300 group-hover:w-full"></span></a>)}
      </nav>
      <div class="flex items-center gap-4">
        <span class="hidden items-center gap-2 text-xs uppercase sm:flex"><span class="flex h-4 w-6 overflow-hidden"><i class="w-1/3 bg-blue-700"></i><i class="w-1/3 bg-white"></i><i class="w-1/3 bg-red-600"></i></span>EUR €</span>
        <span class="mx-1 hidden h-5 w-px bg-white/30 sm:block"></span>
        <a href="#productos" class="hidden sm:block" aria-label="Buscar productos"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="11" cy="11" r="6.5"></circle><path d="m16 16 4 4"></path></svg></a>
        <a href="/demo/tiendas/stretch/carrito" aria-label="Carrito"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M6.5 8.5h11l1 12h-13l1-12Z"></path><path d="M9 9V6a3 3 0 0 1 6 0v3"></path></svg></a>
        <button type="button" data-stretch-menu-open class="md:hidden" aria-label="Abrir menú"><svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M3 7h18M3 12h18M3 17h18"></path></svg></button>
      </div>
    </header>
    <div data-stretch-menu class="pointer-events-none fixed inset-0 z-40 grid place-items-center bg-black/95 opacity-0 backdrop-blur-sm transition duration-500"><button type="button" data-stretch-menu-close class="absolute right-6 top-6 text-3xl" aria-label="Cerrar menú">×</button><nav class="flex flex-col items-center gap-6 text-3xl font-light">{[['#productos','tienda'],['#categorias','descubre'],['#productos','journal'],['/temas','temas']].map(([href,label])=><a href={href} data-stretch-menu-link>{label}</a>)}</nav></div>
    <div class="flex min-h-screen flex-col lg:flex-row">
      <div class="relative flex min-h-[62vh] w-full items-end overflow-hidden lg:min-h-screen lg:w-1/2"><img src="/images/collections/stretch/hero.jpg" alt="Belleza sostenible STRETCH" class="absolute inset-0 h-full w-full object-cover" loading="eager"/><div class="absolute inset-0 bg-black/25"></div><div data-stretch-reveal class="relative z-10 max-w-2xl translate-y-8 px-6 pb-14 opacity-0 transition duration-1000 sm:px-10 sm:pb-20"><h1 class="text-4xl font-light leading-[1.05] sm:text-5xl md:text-6xl lg:text-[clamp(3.5rem,5vw,6rem)]">Belleza ética,<br/><span class="relative">impacto sostenible.<svg class="absolute -bottom-3 left-0 h-5 w-full" viewBox="0 0 300 20" fill="none" aria-hidden="true"><path d="M2 8C45 1 75 17 116 9s72-8 109 0 55 2 73-4" stroke="#C8A45C" stroke-width="2"/><path d="M2 13c46-6 77 8 118 2s73-5 108 0 53 0 70-3" stroke="#C8A45C" stroke-width="1.4"/></svg></span></h1><p class="mb-10 mt-8 max-w-md text-sm text-white/80 md:text-base">Comprometidos con una belleza sostenible y con reducir nuestro impacto sobre el planeta.</p><a href="#categorias" class="stretch-button inline-block rounded-full bg-white px-10 py-4 text-sm text-black">Sobre nosotros</a></div></div>
      <div class="relative min-h-[42vh] w-full overflow-hidden bg-black lg:min-h-screen lg:w-1/2">{heroVideos.map((video,index)=><video src={video} poster={heroPosters[index]} data-stretch-slide={index} aria-hidden="true" autoplay loop muted playsinline preload={index===0?'auto':'metadata'} class:list={['absolute inset-0 h-full w-full object-cover transition-opacity duration-700',index===0?'opacity-100':'opacity-0']}></video>)}<div class="absolute bottom-6 right-6 z-20 flex items-center gap-3">{heroVideos.map((_,index)=><button type="button" data-stretch-dot={index} aria-label={`Ver vídeo ${index+1}`} class:list={['grid h-6 w-6 place-items-center rounded-full transition',index===0?'scale-125':'opacity-50']}><span aria-hidden="true" class="h-2 w-2 rounded-full bg-white"></span></button>)}<button type="button" data-stretch-pause class="grid h-8 w-8 place-items-center rounded-full border border-white/50 text-xs" aria-label="Pausar vídeo">Ⅱ</button></div></div>
    </div>
  </section>

  <section id="productos" data-stretch-reveal class="translate-y-6 px-4 py-12 opacity-0 transition duration-1000 sm:px-6 sm:py-16 lg:px-10">
    <div class="mb-9 flex items-center gap-6"><button type="button" data-stretch-tab="all" aria-pressed="true" class="flex items-center gap-3 text-2xl font-medium sm:text-4xl md:text-5xl"><span>Más vendidos</span><i class="inline-block h-5 w-5 rounded-full bg-[#1a1a1a] sm:h-6 sm:w-6"></i></button><button type="button" data-stretch-tab="sets" aria-pressed="false" class="flex items-center gap-3 text-2xl font-medium text-gray-700 transition hover:text-gray-900 sm:text-4xl md:text-5xl">Sets</button></div>
    <div data-stretch-products class="stretch-scroll flex overflow-x-auto pb-2">{stretchProducts.map((product,index)=><article data-stretch-product data-set={product.oldPrice?'true':'false'} class="group -ml-px flex w-[260px] shrink-0 flex-col border border-gray-200 bg-[#F9F4F0] opacity-0 transition duration-500 first:ml-0 sm:w-[280px] md:w-[300px] lg:w-[calc(25%+1px)]" style={`transition-delay:${200+index*80}ms`}><div class="flex h-14 flex-col justify-center px-4 text-xs uppercase tracking-wider"><strong>{product.category}</strong>{product.subcategory&&<span class="mt-0.5 text-gray-600">{product.subcategory}</span>}</div><a href={`/demo/tiendas/stretch/${product.slug}`} class="mx-4 overflow-hidden rounded-lg bg-[#F9F4F0]"><img src={product.image} alt={product.name} loading="lazy" class="aspect-[3/4] w-full object-cover transition-transform duration-500 group-hover:scale-105"/></a><div class="px-4 pb-6 pt-5 text-center"><h2 class="text-sm">{product.name}</h2><p class="mt-2 text-sm">{product.oldPrice&&<del class="mr-2 text-gray-600">{product.oldPrice}</del>}{product.price}</p></div></article>)}</div>
    <div class="mx-auto mt-8 max-w-[280px] sm:mt-10"><div class="h-0.5 overflow-hidden rounded-full bg-gray-300"><span data-stretch-progress class="block h-full w-[30%] bg-[#1a1a1a] transition-transform"></span></div></div>
  </section>

  <section id="categorias" data-stretch-reveal class="grid translate-y-12 grid-cols-1 bg-black text-white opacity-0 transition duration-1000 md:grid-cols-3">{categories.map((category)=><article class="group relative min-h-[400px] overflow-hidden p-6 sm:min-h-[500px] sm:p-8 md:min-h-[750px] md:p-12"><video src={category.video} poster={category.poster} aria-hidden="true" autoplay loop muted playsinline preload="metadata" class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"></video><div class="absolute inset-0 bg-black/20 transition group-hover:bg-black/30"></div><div class="relative z-10 flex h-full min-h-[352px] items-end justify-between sm:min-h-[436px] md:min-h-[654px]"><h2 class="text-5xl font-medium transition group-hover:-translate-y-0.5 sm:text-6xl md:text-7xl lg:text-8xl" style="writing-mode:vertical-lr;transform:rotate(180deg)">{category.name}</h2><a href="#productos" class="stretch-button rounded-full bg-white px-8 py-3 text-sm text-black">Comprar {category.name}</a></div></article>)}</section>
</main>

<style>
  .stretch-scroll{scrollbar-width:none}.stretch-scroll::-webkit-scrollbar{display:none}.stretch-button{position:relative;overflow:hidden;transition:transform .3s ease,box-shadow .3s ease}.stretch-button:before{content:'';position:absolute;inset:0;background:linear-gradient(120deg,transparent,rgba(0,0,0,.07),transparent);transform:translateX(-100%);transition:transform .5s ease}.stretch-button:hover{transform:translateY(-2px);box-shadow:0 6px 20px rgba(0,0,0,.15)}.stretch-button:hover:before{transform:translateX(100%)}[data-stretch-reveal].is-visible{transform:translateY(0);opacity:1}[data-stretch-product].is-visible{opacity:1;transform:translateY(0)}
</style>

<script>
  const menu=document.querySelector<HTMLElement>('[data-stretch-menu]');const setMenu=(open:boolean)=>{menu?.classList.toggle('opacity-0',!open);menu?.classList.toggle('pointer-events-none',!open);document.body.classList.toggle('overflow-hidden',open)};document.querySelector('[data-stretch-menu-open]')?.addEventListener('click',()=>setMenu(true));document.querySelectorAll('[data-stretch-menu-close],[data-stretch-menu-link]').forEach(el=>el.addEventListener('click',()=>setMenu(false)));
  const reveals=document.querySelectorAll<HTMLElement>('[data-stretch-reveal]');const observer=new IntersectionObserver(entries=>entries.forEach(entry=>{if(entry.isIntersecting){entry.target.classList.add('is-visible');entry.target.querySelectorAll<HTMLElement>('[data-stretch-product]').forEach(card=>card.classList.add('is-visible'));observer.unobserve(entry.target)}}),{threshold:.15});reveals.forEach(el=>observer.observe(el));
  const slides=[...document.querySelectorAll<HTMLVideoElement>('[data-stretch-slide]')];const dots=[...document.querySelectorAll<HTMLButtonElement>('[data-stretch-dot]')];let active=0;let paused=false;const activate=(index:number)=>{active=index;slides.forEach((video,i)=>video.classList.toggle('opacity-0',i!==index));dots.forEach((dot,i)=>{dot.classList.toggle('opacity-50',i!==index);dot.classList.toggle('scale-125',i===index)});if(!paused)slides[index]?.play().catch(()=>{})};const show=(index:number)=>{const next=slides[index];if(!next)return;if(next.readyState<2){next.load();next.addEventListener('canplay',()=>activate(index),{once:true});return}activate(index)};dots.forEach((dot,index)=>dot.addEventListener('click',()=>show(index)));const timer=window.setInterval(()=>{if(!paused)show((active+1)%slides.length)},5000);const pauseButton=document.querySelector<HTMLButtonElement>('[data-stretch-pause]');pauseButton?.addEventListener('click',()=>{paused=!paused;pauseButton.textContent=paused?'▶':'Ⅱ';paused?slides[active]?.pause():slides[active]?.play().catch(()=>{})});if(window.matchMedia('(prefers-reduced-motion: reduce)').matches){paused=true;clearInterval(timer);document.querySelectorAll<HTMLVideoElement>('video').forEach(video=>{video.pause();video.removeAttribute('autoplay')})}window.addEventListener('pagehide',()=>clearInterval(timer),{once:true});
  const rail=document.querySelector<HTMLElement>('[data-stretch-products]');const progress=document.querySelector<HTMLElement>('[data-stretch-progress]');const updateProgress=()=>{if(!rail||!progress)return;const max=rail.scrollWidth-rail.clientWidth;const ratio=max>0?rail.scrollLeft/max:0;progress.style.transform=`translateX(${ratio*233}%)`};rail?.addEventListener('scroll',updateProgress,{passive:true});rail?.addEventListener('wheel',event=>{if(Math.abs(event.deltaY)>Math.abs(event.deltaX)){event.preventDefault();rail.scrollLeft+=event.deltaY}},{passive:false});
  const tabs=[...document.querySelectorAll<HTMLButtonElement>('[data-stretch-tab]')];tabs.forEach(tab=>tab.addEventListener('click',()=>{const mode=tab.dataset.stretchTab;document.querySelectorAll<HTMLElement>('[data-stretch-product]').forEach(card=>card.classList.toggle('hidden',mode==='sets'&&card.dataset.set!=='true'));tabs.forEach(item=>{item.classList.toggle('text-gray-400',item!==tab);item.setAttribute('aria-pressed',String(item===tab));item.querySelector('i')?.remove()});const activeDot=document.createElement('i');activeDot.className='inline-block h-5 w-5 rounded-full bg-[#1a1a1a] sm:h-6 sm:w-6';tab.appendChild(activeDot);updateProgress()}));
</script>
