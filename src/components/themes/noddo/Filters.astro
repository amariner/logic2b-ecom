---
import type { CollectionConfig, StorePaths } from '../../../collections';
interface Props { paths:StorePaths; collection:CollectionConfig; count:number; activeCategory?:string | undefined; sort:string; search?:string | undefined; }
const { paths, collection, count, activeCategory } = Astro.props;
---
<nav aria-label="Categorías" class="flex max-w-2xl flex-wrap items-center gap-2">
  <span class="mr-2 font-accent text-[10px] uppercase tracking-widest text-muted-foreground">{count} objetos</span>
  <a href={paths.catalog} aria-current={!activeCategory?'page':undefined} class="rounded-btn border border-border px-4 py-2 text-xs text-foreground aria-[current=page]:bg-foreground aria-[current=page]:text-background">Todo</a>
  {collection.categories.map(cat=><a href={`${paths.catalog}?categoria=${cat.id}#coleccion`} aria-current={activeCategory===cat.id?'page':undefined} class="rounded-btn border border-border px-4 py-2 text-xs text-foreground transition hover:border-foreground aria-[current=page]:bg-foreground aria-[current=page]:text-background">{cat.label}</a>)}
</nav>
