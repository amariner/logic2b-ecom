---
import type { StorePaths } from '../../../collections';
import { formatEurCents } from '../../../lib/format';
type GridProduct={slug:string;name:string;price_cents:number;image:string;stock:number};
interface Props{paths:StorePaths;products:GridProduct[]}
const {paths,products}=Astro.props;
---
<ul class="grid grid-cols-1 gap-[var(--grid-gap)] sm:grid-cols-2 lg:grid-cols-3 lg:auto-rows-[18rem]">
  {products.map((product,index)=><li class:list={['group relative flex min-h-[22rem] flex-col overflow-hidden bg-surface-product',index===0&&'lg:row-span-2',index===4&&'lg:col-span-3 lg:row-span-2',index===5&&'lg:col-span-1',index===6&&'lg:col-span-2',index>7&&index%4===0&&'lg:col-span-2']}>
    <div class="flex items-start justify-between p-5 text-xs"><div><h3><a href={paths.product(product.slug)} class="font-medium text-foreground after:absolute after:inset-0">{product.name}</a></h3><p class="mt-1 text-muted-foreground">{formatEurCents(product.price_cents)}</p></div><span class="font-accent text-muted-foreground">{String(index+1).padStart(2,'0')}</span></div>
    <div class="mt-auto flex min-h-0 flex-1 items-center justify-center overflow-hidden"><img src={product.image} alt={product.name} width="800" height="800" loading="lazy" class="h-full w-full object-contain p-4 transition duration-700 group-hover:scale-[1.035]"/></div>
    <button type="button" data-noddo-add={product.slug} disabled={product.stock===0} class="relative z-10 m-3 rounded-btn border border-foreground px-4 py-3 text-xs uppercase tracking-wider text-foreground transition hover:bg-foreground hover:text-background disabled:opacity-30">{product.stock?'Añadir a la cesta':'Agotado'}</button>
  </li>)}
</ul>
<script>import{addToCart}from'../../../lib/cart-client';for(const button of document.querySelectorAll<HTMLButtonElement>('[data-noddo-add]'))button.addEventListener('click',()=>{addToCart(button.dataset.noddoAdd??'');button.textContent='AÑADIDO ✓';window.setTimeout(()=>button.textContent='AÑADIR A LA CESTA',900)})</script>
