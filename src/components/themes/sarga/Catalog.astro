---
/** SARGA · campaña, carrusel de producto y mosaico de sastrería. */
import type { CollectionConfig, StorePaths } from '../../../collections';
import Filters from './Filters.astro';
import ProductGrid from './ProductGrid.astro';

type GridProduct = {
  slug: string;
  name: string;
  price_cents: number;
  image: string;
  stock: number;
};

interface Props {
  paths: StorePaths;
  products: GridProduct[];
  collection: CollectionConfig;
  category?: string | undefined;
  sort: string;
  search?: string | undefined;
}

const { paths, products, collection, category, sort, search } = Astro.props;
const editorial = !category && !search && sort === 'featured';
const FEATURED = ['sar-blazer-negro', 'sar-pantalon-palazzo', 'sar-blazer-azul', 'sar-chaleco-negro'];
const rank = new Map(FEATURED.map((slug, index) => [slug, index]));
const orderedProducts = products.toSorted((a, b) => (rank.get(a.slug) ?? 99) - (rank.get(b.slug) ?? 99));
---

<div class="sarga">
  <header class:list={['sarga-header', !editorial && 'sarga-header--solid']}>
    <nav class="sarga-header__nav" aria-label="Navegación SARGA">
      <a class="sarga-menu" href={paths.catalog} aria-label="Abrir catálogo" aria-current={editorial ? 'page' : undefined}><span aria-hidden="true"></span></a>
      <a class="sarga-desktop" href={`${paths.catalog}?categoria=sar-chaquetas`}>Chaquetas</a>
      <a class="sarga-desktop" href={`${paths.catalog}?categoria=sar-pantalones`}>Pantalones</a>
    </nav>
    <a class="sarga-wordmark" href={paths.catalog}>{collection.name}</a>
    <nav class="sarga-header__actions" aria-label="Acciones de tienda">
      <a class="sarga-desktop" href={`${paths.catalog}?orden=name`}>Índice</a>
      <a href={paths.cart}>Bolsa <span data-cart-count>0</span></a>
    </nav>
  </header>

  {editorial ? (
    <main>
      <section class="sarga-hero" aria-labelledby="sarga-title">
        <img src="/images/collections/sarga/hero-tailoring.webp" alt="Dos modelos con sastrería negra y azul hielo" width="2688" height="1520" loading="eager" fetchpriority="high" />
        <div class="sarga-hero__copy">
          <h1 id="sarga-title">{collection.name}</h1>
          <a href="#coleccion">Ver colección</a>
        </div>
      </section>

      <section class="sarga-products" id="coleccion" aria-labelledby="sarga-products-title">
        <h2 id="sarga-products-title" class="sr-only">Colección destacada</h2>
        <ProductGrid paths={paths} products={orderedProducts} />
      </section>

      <section class="sarga-campaign" aria-label="Selección editorial">
        <a class="sarga-story" href={`${paths.catalog}?categoria=sar-chalecos`}>
          <span>Esencial / Chalecos</span>
          <img src="/images/collections/sarga/editorial-chaleco.webp" alt="Modelo con chaleco y pantalón de sastrería gris" width="1744" height="2336" loading="lazy" />
        </a>
        <a class="sarga-story" href={paths.catalog}>
          <span>Nueva edición</span>
          <img src="/images/collections/sarga/editorial-vestido.webp" alt="Modelo con vestido negro de largo completo" width="1744" height="2336" loading="lazy" />
        </a>
      </section>

      <section class="sarga-mosaic" aria-label="Categorías SARGA">
        <a class="sarga-mosaic__feature" href={`${paths.catalog}?categoria=sar-chaquetas`}>
          <span>Chaquetas</span>
          <img src="/images/collections/sarga/editorial-sastreria-azul.webp" alt="Modelo con blazer azul hielo" width="1744" height="2336" loading="lazy" />
        </a>
        <a class="sarga-mosaic__product" href={`${paths.catalog}?categoria=sar-chaquetas`}>
          <span>Edición hielo</span>
          <img src="/images/collections/sarga/sar-blazer-azul.webp" alt="Blazer azul hielo" width="2048" height="2048" loading="lazy" />
        </a>
        <a class="sarga-mosaic__product" href={`${paths.catalog}?categoria=sar-pantalones`}>
          <span>Pantalones</span>
          <img src="/images/collections/sarga/sar-pantalon-palazzo.webp" alt="Pantalón palazzo negro" width="2048" height="2048" loading="lazy" />
        </a>
      </section>
    </main>
  ) : (
    <main class="sarga-catalog" id="catalogo">
      <div class="sarga-catalog__heading">
        <p>Colección / {products.length}</p>
        <h1>{category ? collection.categories.find((item) => item.id === category)?.label : 'Todas las piezas'}</h1>
      </div>
      <Filters paths={paths} collection={collection} count={products.length} activeCategory={category} sort={sort} search={search} />
      {search && products.length > 0 && <p class="sarga-results">{products.length} {products.length === 1 ? 'resultado' : 'resultados'} para «{search}»</p>}
      {orderedProducts.length > 0 ? (
        <section class="sarga-products" aria-label="Resultados"><ProductGrid paths={paths} products={orderedProducts} /></section>
      ) : (
        <div class="sarga-empty">
          <p>{search ? `Nada por aquí para «${search}»` : 'No hay piezas en esta categoría'}</p>
          <a href={paths.catalog}>Volver a la colección</a>
        </div>
      )}
    </main>
  )}

  <footer class="sarga-footer">
    <a href={paths.catalog} class="sarga-footer__wordmark">{collection.name}</a>
    <p>Proporción, materia y piezas construidas para combinarse.</p>
    <nav aria-label="Pie SARGA">
      <a href={paths.catalog} aria-current={editorial ? 'page' : undefined}>Colección</a>
      <a href={paths.cart}>Bolsa</a>
      <a href="/">Logic2B Ecommerce</a>
    </nav>
  </footer>
</div>

<style>
  .sarga { min-height: 100vh; color: var(--color-foreground); background: var(--color-background); font-family: var(--font-accent); }
  .sarga :where(a) { color: inherit; text-decoration: none; }
  .sarga-header { position: absolute; inset: 0 0 auto; z-index: 30; display: grid; min-height: 3.45rem; grid-template-columns: 1fr auto 1fr; align-items: center; padding: .65rem 1rem; border-bottom: var(--border-width) solid var(--color-border); background: var(--color-background); font: 500 .56rem/1 var(--font-accent); text-transform: uppercase; }
  .sarga-header--solid { position: sticky; top: 0; }
  .sarga-header__nav, .sarga-header__actions { display: flex; align-items: center; gap: clamp(.75rem, 1.35vw, 1.35rem); }
  .sarga-header__actions { justify-content: flex-end; }
  .sarga-header a { display: inline-flex; min-height: 1.8rem; align-items: center; }
  .sarga-header a:hover { text-decoration: underline; text-underline-offset: .2rem; }
  .sarga-wordmark { font: var(--weight-display) 1.2rem/1 var(--font-display); letter-spacing: var(--tracking-display); }
  .sarga-menu { width: 1.55rem; }
  .sarga-menu span, .sarga-menu span::after { display: block; width: 1.05rem; height: var(--border-width); background: var(--color-foreground); content: ''; }
  .sarga-menu span::after { transform: translateY(.28rem); }
  .sarga-hero { position: relative; min-height: min(51rem, 62vw); overflow: hidden; border-bottom: var(--border-width) solid var(--color-border); background: var(--surface-product); }
  .sarga-hero > img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center; }
  .sarga-hero__copy { position: absolute; inset: 0; display: grid; place-content: center; justify-items: center; gap: .85rem; color: var(--color-brand); }
  .sarga-hero__copy h1 { font: var(--weight-display) clamp(1.45rem, 2.2vw, 2.2rem)/1 var(--font-display); letter-spacing: var(--tracking-display); }
  .sarga-hero__copy a { min-width: 7.4rem; padding: .6rem .8rem; border: var(--border-width) solid currentColor; background: var(--surface-product); font-size: .52rem; text-align: center; text-transform: uppercase; }
  .sarga-products { border-bottom: var(--border-width) solid var(--color-border); }
  .sarga-campaign { display: grid; grid-template-columns: 1fr 1fr; border-bottom: var(--border-width) solid var(--color-border); }
  .sarga-story { position: relative; min-height: min(49rem, 58vw); overflow: hidden; background: var(--surface-product); }
  .sarga-story + .sarga-story { border-left: var(--border-width) solid var(--color-border); }
  .sarga-story img { width: 100%; height: 100%; object-fit: cover; }
  .sarga-story span, .sarga-mosaic span { position: absolute; z-index: 2; top: .55rem; left: .6rem; padding: .24rem .32rem; color: var(--color-foreground); background: var(--color-background); font-size: .52rem; text-transform: uppercase; }
  .sarga-mosaic { display: grid; grid-template-columns: 2fr 1fr; grid-template-rows: 1fr 1fr; border-bottom: var(--border-width) solid var(--color-border); }
  .sarga-mosaic a { position: relative; min-height: 20rem; overflow: hidden; background: var(--surface-product); }
  .sarga-mosaic__feature { grid-row: 1 / 3; border-right: var(--border-width) solid var(--color-border); }
  .sarga-mosaic__product + .sarga-mosaic__product { border-top: var(--border-width) solid var(--color-border); }
  .sarga-mosaic img { width: 100%; height: 100%; object-fit: cover; }
  .sarga-mosaic__product img { object-fit: contain; }
  .sarga-catalog { padding-top: 3.45rem; }
  .sarga-catalog__heading { display: flex; min-height: 13rem; flex-direction: column; justify-content: space-between; padding: 1rem; border-bottom: var(--border-width) solid var(--color-border); }
  .sarga-catalog__heading p { color: var(--color-muted-foreground); font-size: .55rem; text-transform: uppercase; }
  .sarga-catalog__heading h1 { font: var(--weight-display) clamp(2.1rem, 5vw, 5.2rem)/.85 var(--font-display); letter-spacing: var(--tracking-display); text-transform: uppercase; }
  .sarga-results { padding: .8rem 1rem; border-bottom: var(--border-width) solid var(--color-border); color: var(--color-muted-foreground); font-size: .6rem; }
  .sarga-empty { padding: 8rem 1rem; text-align: center; background: var(--surface-sunken); }
  .sarga-empty p { font: var(--weight-display) 1.25rem/1.1 var(--font-display); text-transform: uppercase; }
  .sarga-empty a { display: inline-block; margin-top: 1rem; font-size: .62rem; text-decoration: underline; text-underline-offset: .22rem; }
  .sarga-footer { display: grid; min-height: 17rem; place-content: center; justify-items: center; gap: 1rem; padding: 3rem 1rem; text-align: center; background: var(--surface-sunken); }
  .sarga-footer__wordmark { font: var(--weight-display) clamp(4rem, 10vw, 9rem)/.75 var(--font-display); letter-spacing: var(--tracking-display); }
  .sarga-footer p { color: var(--color-muted-foreground); font-size: .62rem; }
  .sarga-footer nav { display: flex; flex-wrap: wrap; justify-content: center; gap: 1rem; font-size: .55rem; text-transform: uppercase; }

  @media (max-width: 720px) {
    .sarga-header { padding-inline: .75rem; }
    .sarga-desktop { display: none !important; }
    .sarga-hero { min-height: 0; aspect-ratio: 16 / 10; }
    .sarga-hero > img { object-position: center; }
    .sarga-hero__copy { align-content: center; }
    .sarga-campaign { grid-template-columns: 1fr; }
    .sarga-story { min-height: 36rem; }
    .sarga-story + .sarga-story { border-top: var(--border-width) solid var(--color-border); border-left: 0; }
    .sarga-mosaic { grid-template-columns: 1fr 1fr; grid-template-rows: auto auto; }
    .sarga-mosaic a { min-height: 16rem; }
    .sarga-mosaic__feature { grid-row: auto; grid-column: 1 / 3; min-height: 34rem !important; border-right: 0; border-bottom: var(--border-width) solid var(--color-border); }
    .sarga-mosaic__product + .sarga-mosaic__product { border-top: 0; border-left: var(--border-width) solid var(--color-border); }
  }
</style>
