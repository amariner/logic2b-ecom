---
/**
 * Header de marca compartido (landing, tienda, admin) — estructura Logic2B UI:
 * sticky h-14, border-b, bg-background/80 backdrop-blur; isotipo+wordmark a la
 * izquierda, nav text-muted-foreground en medio, acciones (slot) a la derecha.
 * El theming de la demo se hace con el selector de temas (no un toggle aquí).
 */
import Logo from './Logo.astro';

interface NavLink {
  href: string;
  label: string;
}
interface Props {
  homeHref?: string;
  wordmark?: string | null;
  nav?: readonly NavLink[];
  /**
   * Mostrar el isotipo junto al wordmark. Por defecto NO: el producto se
   * presenta como wordmark tipográfico "Logic2B Ecommerce" (decisión 2026-07-20).
   */
  showMark?: boolean;
  /** href del enlace de nav activo (se resalta en foreground). */
  activeHref?: string | undefined;
  /**
   * Marca partida (solo para el wordmark del producto): «Logic2B» enlaza a la
   * agencia y «Ecommerce» a la home del producto. Es el nombre contando lo que
   * significa — producto y agencia bajo el mismo techo— y de paso lleva
   * tráfico a logic2b.com. Las tiendas de la demo NO lo usan: ahí el wordmark
   * es el nombre del comercio y enlaza a su catálogo.
   */
  splitBrand?: boolean;
}

const {
  homeHref = '/',
  wordmark = 'Logic2B Ecommerce',
  nav = [],
  showMark = false,
  activeHref,
  splitBrand = false,
} = Astro.props;

/** La agencia. Enlace externo real, no una ruta de este sitio. */
const AGENCY_HREF = 'https://logic2b.com';

/**
 * Con la marca partida hay DOS enlaces hermanos, nunca uno dentro de otro
 * (ancla anidada = HTML inválido y error del auditor). El de home se
 * autoseñala con `aria-current` cuando ya estamos en ella. El lockup es fijo
 * —«Logic2B» + «Ecommerce»—: no es un wordmark cualquiera, es LA marca.
 */
const onHome = Astro.url.pathname === homeHref;
---

{/* view-transition-name: el header persiste (no se funde) al navegar entre
    páginas que lo comparten (/ ↔ /temas ↔ /arquitectura) — continuidad sin JS. */}
<header class="sticky top-0 z-50 w-full border-b border-border bg-background/80 backdrop-blur [view-transition-name:site-header]">
  {/* Anchos del contenedor = logic2b.com (logic2b-norte): --maxw 1440px y
      gutter clamp(24px,4vw,32px). El header es la pieza que más se compara
      entre los dos sitios: mismo carril, misma respiración lateral. */}
  <div class="mx-auto flex h-14 w-full max-w-[1440px] items-center gap-6 px-[clamp(24px,4vw,32px)]">
    {
      splitBrand ? (
        <Logo size={20} wordmark={null} mark={showMark} class="wordmark text-foreground">
          <Fragment slot="wordmark">
            <a href={AGENCY_HREF} class="wm-agency">
              Logic<span class="wm-2b">2B</span>
            </a>{' '}
            <a href={homeHref} class="wm-product" aria-current={onHome ? 'page' : undefined}>
              Ecommerce
            </a>
          </Fragment>
        </Logo>
      ) : (
        <a href={homeHref} class="flex items-center gap-2 text-foreground" aria-label={wordmark ?? 'Inicio'}>
          <Logo size={20} wordmark={wordmark} mark={showMark} />
        </a>
      )
    }

    {/* `lg` y no `md`: el menú comercial son cinco entradas más dos acciones;
        en tablet no caben en la línea de 56 px y se partían en dos. */}
    {
      nav.length > 0 && (
        <nav class="hidden flex-1 items-center gap-5 whitespace-nowrap text-sm text-muted-foreground lg:flex">
          {nav.map((link) => (
            <a
              href={link.href}
              class:list={[
                'transition-colors hover:text-foreground',
                link.href === activeHref && 'font-medium text-foreground',
              ]}
              aria-current={link.href === activeHref ? 'page' : undefined}
            >
              {link.label}
            </a>
          ))}
        </nav>
      )
    }

    <div class="ml-auto flex items-center gap-1">
      <slot name="actions" />
      {nav.length > 0 && (
        <button
          type="button"
          class="mobile-menu-toggle"
          data-mobile-menu-toggle
          aria-expanded="false"
          aria-controls="mobile-site-menu"
          aria-label="Abrir menú"
        >
          <span aria-hidden="true"></span>
          <span aria-hidden="true"></span>
          <span aria-hidden="true"></span>
        </button>
      )}
    </div>
  </div>
  {nav.length > 0 && (
    <div id="mobile-site-menu" class="mobile-site-menu" data-mobile-menu hidden>
      <nav aria-label="Menú móvil">
        {nav.map((link) => (
          <a href={link.href} class:list={[link.href === activeHref && 'is-active']} aria-current={link.href === activeHref ? 'page' : undefined}>
            <span>{link.label}</span><span aria-hidden="true">→</span>
          </a>
        ))}
      </nav>
      <div class="mobile-menu-actions"><slot name="actions" /></div>
    </div>
  )}
</header>

<script is:inline>
  const toggle = document.querySelector('[data-mobile-menu-toggle]');
  const menu = document.querySelector('[data-mobile-menu]');
  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!open));
      toggle.setAttribute('aria-label', open ? 'Abrir menú' : 'Cerrar menú');
      menu.hidden = open;
      document.documentElement.classList.toggle('mobile-menu-open', !open);
    });
    menu.addEventListener('click', (event) => {
      if (event.target.closest('a')) {
        toggle.setAttribute('aria-expanded', 'false');
        menu.hidden = true;
        document.documentElement.classList.remove('mobile-menu-open');
      }
    });
  }
</script>

<style>
  .mobile-menu-toggle,
  .mobile-site-menu { display: none; }

  @media (max-width: 1023px) {
    .mobile-menu-toggle {
      display: inline-flex;
      width: 2.75rem;
      height: 2.75rem;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 4px;
      border: 1px solid var(--border);
      border-radius: 999px;
      background: var(--background);
      color: var(--foreground);
      transition: background 150ms ease, border-color 150ms ease;
    }
    .mobile-menu-toggle:hover { background: var(--muted); }
    .mobile-menu-toggle span { width: 15px; height: 1.5px; background: currentColor; transition: transform 150ms ease, opacity 150ms ease; }
    .mobile-menu-toggle[aria-expanded='true'] span:nth-child(1) { transform: translateY(5.5px) rotate(45deg); }
    .mobile-menu-toggle[aria-expanded='true'] span:nth-child(2) { opacity: 0; }
    .mobile-menu-toggle[aria-expanded='true'] span:nth-child(3) { transform: translateY(-5.5px) rotate(-45deg); }
    .mobile-site-menu {
      display: block;
      position: absolute;
      inset: 100% 0 auto;
      z-index: 49;
      padding: .75rem 1rem 1.25rem;
      border-bottom: 1px solid var(--border);
      background: color-mix(in srgb, var(--background) 96%, transparent);
      box-shadow: 0 18px 30px rgba(15, 48, 106, .1);
      backdrop-filter: blur(16px);
    }
    .mobile-site-menu[hidden] { display: none; }
    .mobile-site-menu nav { display: grid; gap: .25rem; }
    .mobile-site-menu nav a {
      display: flex;
      align-items: center;
      justify-content: space-between;
      min-height: 3.25rem;
      padding: .75rem .85rem;
      border-radius: .75rem;
      color: var(--muted-foreground);
      font-size: .98rem;
      font-weight: 600;
    }
    .mobile-site-menu nav a:hover,
    .mobile-site-menu nav a.is-active { background: var(--muted); color: var(--foreground); }
    .mobile-site-menu nav a.is-active span:last-child { color: var(--primary); }
    .mobile-menu-actions { display: grid; gap: .5rem; margin-top: .75rem; padding-top: .75rem; border-top: 1px solid var(--border); }
    .mobile-menu-actions a { display: block !important; text-align: center; }
  }

  @media (min-width: 1024px) { .mobile-menu-actions { display: none; } }
</style>
