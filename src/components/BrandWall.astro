---
/**
 * Fila de logotipos oficiales (sin texto): cada marca es una baldosa con su
 * icono en color. El nombre queda en `aria-label`/tooltip. Sirve igual para la
 * franja de la portada que para las chips de las tarjetas: `size` decide.
 *
 * Honestidad (product): mostrar un logo no implica acuerdo con la marca; son
 * las herramientas con las que el motor conecta o puede conectar bajo alcance.
 */
import BrandIcon from './BrandIcon.astro';
import type { AnyBrandSlug } from '../lib/brands';

interface Props {
  brands: readonly AnyBrandSlug[];
  /** Lado del icono en px; la baldosa crece en proporción. */
  size?: number;
  label: string;
  align?: 'start' | 'center';
  class?: string;
}
const { brands, size = 26, label, align = 'start', class: className = '' } = Astro.props;
---

<ul class:list={['brand-wall', `is-${align}`, className]} style={`--brand-size:${size}px`} aria-label={label}>
  {brands.map((brand) => <li class="brand-tile"><BrandIcon brand={brand} size={size} /></li>)}
</ul>
