---
/**
 * Pie compartido de las páginas comerciales — el MISMO en todas, incluida la
 * portada (donde continúa el bloque oscuro de contacto: mismo fondo tinta).
 * La lista de enlaces vive en lib/nav.ts (footerNav): un solo menú, un solo
 * sitio donde tocarlo.
 */
import { footerNav } from '../lib/nav';

// Con build.format='file', Astro prerenderiza esta página como /ruta.html aunque
// su URL canónica pública sea /ruta. Normalizar evita perder aria-current.
const currentPath = Astro.url.pathname.replace(/\.html$/, '') || '/';
---

<footer class="site-footer">
  <div class="site-footer-top"><div><a href="/" class="footer-brand">Logic2B <span>Ecommerce</span></a><p>Tu tienda, la compra y la gestión.<br />Un mismo proyecto, un equipo detrás.</p></div><nav aria-label="Mapa del sitio">{footerNav.map((link) => <a href={link.href} aria-current={link.href === currentPath ? 'page' : undefined}>{link.label}</a>)}</nav><div class="footer-contact"><p>Hablemos de tu negocio.</p><a href="/#contacto" data-open-project>Preparar una propuesta ↗</a><a href="mailto:hola@logic2b.com">hola@logic2b.com</a></div></div>
  <div class="site-footer-bottom"><p>© 2026 Logic2B · Castellón</p><a href="https://logic2b.com">Diseño y tecnología por Logic2B ↗</a></div>
</footer>
<style>
.site-footer{background:var(--c-green,#203f22);color:#d1dfcd;border-top:1px solid #ffffff26}.site-footer-top{display:grid;grid-template-columns:1fr 1fr .8fr;gap:3rem;max-width:1280px;margin:auto;padding:3rem clamp(20px,5vw,64px)}.footer-brand{color:white;font-size:1.15rem;font-weight:700;letter-spacing:-.04em}.footer-brand span{font-weight:400}.site-footer-top p{font-size:.85rem;line-height:1.8;margin-top:1rem}.site-footer nav{display:grid;grid-template-columns:1fr 1fr;gap:.35rem 1rem;align-content:start}.site-footer nav a{font-size:.78rem;min-height:32px;display:flex;align-items:center}.site-footer a:hover{color:white;text-decoration:underline;text-underline-offset:4px}.footer-contact{display:grid;align-content:start;gap:.8rem;font-size:.83rem}.footer-contact p{margin:0}.site-footer-bottom{border-top:1px solid #ffffff26;max-width:1152px;margin:auto;display:flex;justify-content:space-between;gap:1rem;padding:1.5rem 0;font-size:.7rem}@media(max-width:700px){.site-footer-top{grid-template-columns:1fr;gap:2rem;padding-block:2.5rem}.site-footer-bottom{flex-wrap:wrap;margin-inline:20px}.site-footer nav a{min-height:40px}}@media print{.site-footer{display:none}}
</style>
