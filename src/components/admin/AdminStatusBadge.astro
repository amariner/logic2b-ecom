---
interface Props { status: string; label?: string; }
const { status, label = status } = Astro.props;
const styles: Record<string, string> = {
  pending: 'bg-zinc-100 text-zinc-700 ring-zinc-200',
  paid: 'bg-amber-50 text-amber-800 ring-amber-200',
  shipped: 'bg-sky-50 text-sky-800 ring-sky-200',
  delivered: 'bg-emerald-50 text-emerald-800 ring-emerald-200',
  cancelled: 'bg-red-50 text-red-800 ring-red-200',
  active: 'bg-emerald-50 text-emerald-800 ring-emerald-200',
  hidden: 'bg-zinc-100 text-zinc-700 ring-zinc-200',
  draft: 'bg-amber-50 text-amber-800 ring-amber-200',
  archived: 'bg-zinc-100 text-zinc-700 ring-zinc-200',
};
---

<span class:list={['inline-flex min-h-7 items-center rounded-full px-2.5 text-xs font-semibold ring-1 ring-inset', styles[status] ?? styles.hidden]}>{label}</span>
