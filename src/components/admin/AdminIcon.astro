---
export type AdminIconName = 'orders' | 'products' | 'shipping' | 'email' | 'store' | 'help' | 'logout' | 'menu' | 'search' | 'download' | 'arrow-left' | 'external' | 'chevron';

interface Props {
  name: AdminIconName;
  class?: string;
}

const { name, class: className = 'size-5' } = Astro.props;
---

<svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'orders' && <><path d="M6 3h12v18l-3-2-3 2-3-2-3 2V3Z"/><path d="M9 8h6M9 12h6"/></>}
  {name === 'products' && <><path d="m12 3 8 4.5v9L12 21l-8-4.5v-9L12 3Z"/><path d="m4.5 7.7 7.5 4.2 7.5-4.2M12 12v9"/></>}
  {name === 'shipping' && <><path d="M3 6h11v11H3zM14 10h4l3 3v4h-7z"/><circle cx="7" cy="18" r="2"/><circle cx="18" cy="18" r="2"/></>}
  {name === 'email' && <><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m4 7 8 6 8-6"/></>}
  {name === 'store' && <><path d="M4 10v10h16V10M3 5h18l-1 5H4L3 5Z"/><path d="M9 20v-6h6v6"/></>}
  {name === 'help' && <><circle cx="12" cy="12" r="9"/><path d="M9.8 9a2.4 2.4 0 1 1 3.4 2.2c-.8.4-1.2.9-1.2 1.8M12 17h.01"/></>}
  {name === 'logout' && <><path d="M10 4H5v16h5M14 8l4 4-4 4M8 12h10"/></>}
  {name === 'menu' && <path d="M4 7h16M4 12h16M4 17h16"/>}
  {name === 'search' && <><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></>}
  {name === 'download' && <><path d="M12 3v12m0 0 4-4m-4 4-4-4M5 21h14"/></>}
  {name === 'arrow-left' && <path d="m15 18-6-6 6-6"/>}
  {name === 'external' && <><path d="M14 4h6v6M20 4l-9 9"/><path d="M18 13v6H5V6h6"/></>}
  {name === 'chevron' && <path d="m9 18 6-6-6-6"/>}
</svg>
