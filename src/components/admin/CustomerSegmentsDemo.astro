---
import AdminNotice from './AdminNotice.astro';
import { formatEurCents } from '../../lib/format';
import {
  CUSTOMER_SEGMENT_DEMO_FACT_LABELS,
  CUSTOMER_SEGMENT_DEMO_PROFILES,
  CUSTOMER_SEGMENT_DEMO_TEMPLATES,
  createCustomerSegmentDemo,
} from '../../modules/customers';

const initial = createCustomerSegmentDemo();
const template = CUSTOMER_SEGMENT_DEMO_TEMPLATES.find((item) => item.id === initial.templateId)!;
const factNames = [
  'customer.age_days', 'orders.count', 'orders.days_since_last', 'orders.total_spent_cents',
] as const;
const factValue = (fact: typeof factNames[number], value: number | null): string => {
  if (value === null) return 'Sin dato';
  if (fact === 'orders.total_spent_cents') return formatEurCents(value);
  return fact === 'orders.count' ? String(value) : `${value} días`;
};
const parameterValue = (name: string, unit: string) => (initial.parameters?.[name] ?? 0) / (unit === 'eur_cents' ? 100 : 1);
---

<div data-customer-segments-demo data-segment-state="draft" class="mt-6 space-y-6">
  <AdminNotice tone="info">Perfiles y cifras ficticios. Esta simulación no guarda resultados ni inicia campañas; al recargar, vuelve al ejemplo inicial.</AdminNotice>

  <section aria-labelledby="segment-template-title">
    <div class="mb-3 flex flex-wrap items-end justify-between gap-2">
      <h2 id="segment-template-title" class="font-display text-xl text-foreground">1. Elige un punto de partida</h2>
      <p class="text-xs text-muted-foreground">Tres ejemplos, sin criterios comerciales recomendados</p>
    </div>
    <div class="grid gap-3 xl:grid-cols-3">
      {CUSTOMER_SEGMENT_DEMO_TEMPLATES.map((item, index) => <button
        type="button"
        data-segment-template={item.id}
        aria-pressed={item.id === initial.templateId ? 'true' : 'false'}
        disabled
        class="segment-template min-h-32 rounded-2xl border border-border bg-card p-5 text-left shadow-sm transition-colors disabled:cursor-default"
      >
        <span class="flex items-center justify-between gap-3"><span class="text-xs font-semibold uppercase tracking-[0.12em] text-muted-foreground">Ejemplo {String(index + 1).padStart(2, '0')}</span><span data-template-selected aria-hidden="true" class="segment-template-mark flex size-6 items-center justify-center rounded-full border border-border text-sm">✓</span></span>
        <span class="mt-3 block text-base font-semibold text-foreground">{item.title}</span>
        <span class="mt-1 block text-sm leading-6 text-muted-foreground">{item.description}</span>
      </button>)}
    </div>
  </section>

  <div class="grid items-start gap-6 xl:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)]">
    <section class="rounded-2xl border border-border bg-card p-5 shadow-sm sm:p-6" aria-labelledby="segment-rules-title">
      <h2 id="segment-rules-title" class="font-display text-xl">2. Ajusta las reglas</h2>
      <p class="mt-2 text-sm leading-6 text-muted-foreground">Deben cumplirse todas. Un dato ausente se muestra como «Sin dato» y nunca se convierte en cero.</p>
      <fieldset class="mt-5 grid gap-4 sm:grid-cols-2" data-segment-parameters>
        <legend class="sr-only">Parámetros de la plantilla</legend>
        {template.parameters.map((parameter) => <label class="text-sm font-semibold" for={`segment-${parameter.name}`}>
          {parameter.label}
          <input id={`segment-${parameter.name}`} data-segment-parameter={parameter.name} data-segment-unit={parameter.unit}
            type="number" inputmode="numeric" required disabled step="1"
            min={parameter.min / (parameter.unit === 'eur_cents' ? 100 : 1)}
            max={parameter.max / (parameter.unit === 'eur_cents' ? 100 : 1)}
            value={parameterValue(parameter.name, parameter.unit)}
            class="mt-2 min-h-12 w-full rounded-xl border border-input bg-background px-3 text-base font-normal tabular-nums text-foreground disabled:opacity-100" />
          <span class="mt-1.5 block text-xs font-normal text-muted-foreground">De {parameter.min / (parameter.unit === 'eur_cents' ? 100 : 1)} a {parameter.max / (parameter.unit === 'eur_cents' ? 100 : 1)} {parameter.unit === 'eur_cents' ? '€ enteros' : parameter.unit === 'days' ? 'días completos' : 'pedidos'}.</span>
        </label>)}
      </fieldset>
      <p data-segment-error role="alert" class="mt-4 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm leading-6 text-red-950" hidden></p>
      <div class="mt-5 border-t border-border pt-4">
        <p class="text-xs font-semibold uppercase tracking-[0.12em] text-muted-foreground">Reglas actuales</p>
        <p data-segment-definition class="mt-2 text-sm leading-6 text-foreground">{template.description}</p>
      </div>
    </section>

    <section class="rounded-2xl border border-border bg-card p-5 shadow-sm sm:p-6" aria-labelledby="segment-run-title">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <h2 id="segment-run-title" class="font-display text-xl">3. Revisa la simulación</h2>
        <span data-segment-state-label class="rounded-full bg-muted px-3 py-1.5 text-xs font-semibold text-muted-foreground">Sin iniciar</span>
      </div>
      <p data-segment-status role="status" aria-live="polite" aria-atomic="true" class="mt-3 min-h-12 text-sm leading-6 text-muted-foreground">Los perfiles están preparados. Simula el recálculo y avanza a tu ritmo.</p>
      <div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-4" aria-label="Progreso del ejemplo">
        <div class="rounded-xl bg-muted/60 p-3"><p class="text-xs text-muted-foreground">Perfiles</p><p data-segment-total class="mt-1 text-2xl font-semibold tabular-nums">{CUSTOMER_SEGMENT_DEMO_PROFILES.length}</p></div>
        <div class="rounded-xl bg-muted/60 p-3"><p class="text-xs text-muted-foreground">Revisados</p><p data-segment-processed class="mt-1 text-2xl font-semibold tabular-nums">0</p></div>
        <div class="rounded-xl bg-muted/60 p-3"><p class="text-xs text-muted-foreground">Coinciden</p><p data-segment-matched class="mt-1 text-2xl font-semibold tabular-nums">0</p></div>
        <div class="rounded-xl bg-muted/60 p-3"><p class="text-xs text-muted-foreground">Incompletos</p><p data-segment-unknown class="mt-1 text-2xl font-semibold tabular-nums">0</p></div>
      </div>
      <label for="segment-progress" class="sr-only">Perfiles revisados</label>
      <progress id="segment-progress" data-segment-progress max={CUSTOMER_SEGMENT_DEMO_PROFILES.length} value="0" class="mt-5 h-2 w-full overflow-hidden rounded-full"></progress>
      <div class="mt-5 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
        <button data-segment-simulate type="button" disabled class="min-h-12 rounded-xl bg-foreground px-5 text-sm font-semibold text-background hover:bg-foreground/85 disabled:cursor-not-allowed disabled:bg-muted disabled:text-foreground disabled:opacity-100">Simular recálculo</button>
        <button data-segment-advance type="button" disabled class="min-h-12 rounded-xl border border-border bg-background px-5 text-sm font-semibold text-foreground hover:bg-muted disabled:cursor-not-allowed disabled:bg-muted disabled:text-foreground disabled:opacity-100">Avanzar lote</button>
        <button data-segment-reset type="button" disabled class="min-h-12 rounded-xl px-3 text-sm font-semibold text-muted-foreground hover:bg-muted hover:text-foreground disabled:cursor-not-allowed disabled:bg-muted disabled:text-foreground disabled:opacity-100">Restablecer ejemplo</button>
      </div>
      <p class="mt-3 text-xs leading-5 text-muted-foreground">Cada avance es manual. Cambiar una regla borra el resultado anterior.</p>
    </section>
  </div>

  <noscript data-segment-nojs><div class="rounded-xl border border-amber-200 bg-amber-50 p-4 text-sm leading-6 text-amber-950">Puedes consultar estos perfiles ficticios sin JavaScript. La simulación necesita JavaScript y todos sus controles permanecen desactivados; no se envía ni guarda ningún dato.</div></noscript>

  <section class="overflow-hidden rounded-2xl border border-border bg-card shadow-sm" aria-labelledby="segment-profiles-title">
    <div class="flex flex-wrap items-end justify-between gap-3 border-b border-border p-5 sm:p-6">
      <div><h2 id="segment-profiles-title" class="font-display text-xl">Perfiles de ejemplo</h2><p class="mt-1 text-sm leading-6 text-muted-foreground">Mismos datos para comparar las tres plantillas. Los perfiles sin revisar siguen pendientes.</p></div>
      <span class="rounded-full bg-muted px-3 py-1.5 text-xs font-semibold text-muted-foreground">Sin datos personales</span>
    </div>
    <table class="segment-table w-full text-sm">
      <caption class="sr-only">Datos ficticios y resultado de la simulación de segmentación</caption>
      <thead class="bg-muted/60 text-left text-xs text-muted-foreground"><tr><th scope="col" class="px-5 py-3 font-semibold">Perfil</th>{factNames.map((fact) => <th scope="col" class="px-3 py-3 font-semibold">{CUSTOMER_SEGMENT_DEMO_FACT_LABELS[fact]}</th>)}<th scope="col" class="px-5 py-3 font-semibold">Resultado</th></tr></thead>
      <tbody class="divide-y divide-border">
        {initial.rows.map((row) => <tr data-segment-row={row.id} data-result="pending">
          <th scope="row" class="px-5 py-4 text-left font-semibold">{row.label}</th>
          {factNames.map((fact) => <td data-label={CUSTOMER_SEGMENT_DEMO_FACT_LABELS[fact]} class:list={['px-3 py-4 tabular-nums', row.facts[fact] === null && 'text-muted-foreground']}><span>{factValue(fact, row.facts[fact])}</span></td>)}
          <td data-segment-result class="px-5 py-4"><span data-segment-result-label class="inline-flex rounded-full bg-muted px-2.5 py-1 text-xs font-semibold text-muted-foreground">Pendiente</span><p data-segment-result-detail class="mt-1.5 max-w-64 text-xs leading-5 text-muted-foreground">Todavía no se ha revisado.</p></td>
        </tr>)}
      </tbody>
    </table>
  </section>
</div>

<style>
  .segment-template[aria-pressed='true'] { border-color: var(--color-foreground); box-shadow: 0 0 0 1px var(--color-foreground); }
  .segment-template[aria-pressed='true'] .segment-template-mark { background: var(--color-foreground); border-color: var(--color-foreground); color: var(--color-background); }
  .segment-template[aria-pressed='false'] .segment-template-mark { color: transparent; }
  [data-customer-segments-demo] :is(button, input):focus-visible { outline: 2px solid var(--color-foreground); outline-offset: 3px; }
  progress { appearance: none; border: none; background: var(--color-muted); }
  progress::-webkit-progress-bar { background: var(--color-muted); }
  progress::-webkit-progress-value { background: var(--color-foreground); }
  progress::-moz-progress-bar { background: var(--color-foreground); }
  @media (max-width: 767px) {
    .segment-table, .segment-table tbody { display: block; }
    .segment-table thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
    .segment-table tr { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .75rem; padding: 1.25rem; }
    .segment-table th[scope='row'], .segment-table [data-segment-result] { grid-column: 1 / -1; }
    .segment-table th, .segment-table td { padding: 0; }
    .segment-table td[data-label]::before { content: attr(data-label); display: block; margin-bottom: .25rem; font-size: .7rem; line-height: 1rem; color: var(--color-muted-foreground); }
    .segment-table [data-segment-result] { border-top: 1px solid var(--color-border); padding-top: .75rem; }
  }
  @media (prefers-reduced-motion: reduce) { .segment-template { transition: none; } }
</style>

<script>
  import {
    CUSTOMER_SEGMENT_DEMO_FACT_LABELS,
    CUSTOMER_SEGMENT_DEMO_PROFILES,
    CUSTOMER_SEGMENT_DEMO_TEMPLATES,
    advanceCustomerSegmentDemo,
    configureCustomerSegmentDemo,
    createCustomerSegmentDemo,
    simulateCustomerSegmentDemo,
    type CustomerSegmentDemoState,
  } from '../../modules/customers';
  import { formatEurCents } from '../../lib/format';

  const root = document.querySelector<HTMLElement>('[data-customer-segments-demo]');
  if (root) {
    const find = <T extends HTMLElement>(selector: string): T => root.querySelector<T>(selector)!;
    const controls = find<HTMLFieldSetElement>('[data-segment-parameters]');
    const simulate = find<HTMLButtonElement>('[data-segment-simulate]');
    const advance = find<HTMLButtonElement>('[data-segment-advance]');
    const reset = find<HTMLButtonElement>('[data-segment-reset]');
    const progress = find<HTMLProgressElement>('[data-segment-progress]');
    const status = find<HTMLElement>('[data-segment-status]');
    const error = find<HTMLElement>('[data-segment-error]');
    let state: CustomerSegmentDemoState = createCustomerSegmentDemo();
    let changed = false;

    const selectedTemplate = () => CUSTOMER_SEGMENT_DEMO_TEMPLATES.find((item) => item.id === state.templateId)!;
    const parameterInputs = () => [...controls.querySelectorAll<HTMLInputElement>('[data-segment-parameter]')];

    const rebuildParameters = () => {
      const legend = document.createElement('legend');
      legend.className = 'sr-only'; legend.textContent = 'Parámetros de la plantilla';
      controls.replaceChildren(legend);
      for (const parameter of selectedTemplate().parameters) {
        const divisor = parameter.unit === 'eur_cents' ? 100 : 1;
        const label = document.createElement('label');
        label.className = 'text-sm font-semibold'; label.htmlFor = `segment-${parameter.name}`;
        label.appendChild(document.createTextNode(parameter.label));
        const input = document.createElement('input');
        input.id = label.htmlFor; input.type = 'number'; input.inputMode = 'numeric';
        input.required = true; input.step = '1';
        input.min = String(parameter.min / divisor); input.max = String(parameter.max / divisor);
        input.value = String((state.parameters?.[parameter.name] ?? 0) / divisor);
        input.dataset.segmentParameter = parameter.name; input.dataset.segmentUnit = parameter.unit;
        input.className = 'mt-2 min-h-12 w-full rounded-xl border border-input bg-background px-3 text-base font-normal tabular-nums text-foreground disabled:opacity-100';
        const hint = document.createElement('span');
        hint.className = 'mt-1.5 block text-xs font-normal text-muted-foreground';
        hint.textContent = `De ${parameter.min / divisor} a ${parameter.max / divisor} ${parameter.unit === 'eur_cents' ? '€ enteros' : parameter.unit === 'days' ? 'días completos' : 'pedidos'}.`;
        label.appendChild(input); label.appendChild(hint); controls.appendChild(label);
      }
    };

    const render = () => {
      const run = state.run;
      const current = state.validationError ? 'invalid' : run?.state ?? 'draft';
      root.dataset.segmentState = current;
      const labels = { draft: 'Sin iniciar', invalid: 'Revisa las reglas', requested: 'Solicitado', running: 'En curso', completed: 'Completado', failed: 'No completado' };
      find('[data-segment-state-label]').textContent = labels[current];
      error.hidden = state.validationError === null;
      error.textContent = state.validationError ?? '';
      simulate.disabled = state.validationError !== null || current === 'requested' || current === 'running';
      reset.disabled = false;
      advance.disabled = current !== 'requested' && current !== 'running';
      advance.textContent = run?.state === 'running' && run.processedCandidates === run.totalCandidates ? 'Completar simulación' : 'Avanzar lote';
      find('[data-segment-processed]').textContent = String(run?.processedCandidates ?? 0);
      find('[data-segment-matched]').textContent = String(run?.matchedCustomers ?? 0);
      find('[data-segment-unknown]').textContent = String(state.rows.filter((row) => row.status === 'unknown').length);
      progress.value = run?.processedCandidates ?? 0;
      status.textContent = current === 'invalid' ? 'Corrige las reglas para iniciar una nueva simulación.'
        : current === 'draft' ? changed ? 'Las reglas han cambiado. Los resultados anteriores se han borrado; simula un recálculo nuevo.' : 'Los perfiles están preparados. Simula el recálculo y avanza a tu ritmo.'
        : current === 'requested' ? 'Simulación solicitada. Pulsa «Avanzar lote» para preparar la revisión de los perfiles de ejemplo.'
        : current === 'completed' ? `Simulación completada: ${run!.matchedCustomers} de ${CUSTOMER_SEGMENT_DEMO_PROFILES.length} perfiles coinciden. No se ha guardado ni enviado nada.`
        : current === 'running' ? run!.processedCandidates === run!.totalCandidates ? 'Todos los perfiles están revisados. Completa la simulación para cerrar este ejemplo.' : `${run!.processedCandidates} de ${run!.totalCandidates} perfiles revisados. El siguiente avance revisa hasta tres perfiles más.`
        : 'No se pudo completar este ejemplo. Inicia una nueva simulación.';

      const template = selectedTemplate();
      root.querySelectorAll<HTMLButtonElement>('[data-segment-template]').forEach((button) => {
        button.disabled = false;
        button.setAttribute('aria-pressed', String(button.dataset.segmentTemplate === state.templateId));
      });
      find('[data-segment-definition]').textContent = state.parameters === null ? 'Completa todos los valores dentro de los límites indicados.' : template.parameters.map((parameter) => {
        const value = state.parameters![parameter.name]!;
        return `${parameter.label}: ${parameter.unit === 'eur_cents' ? formatEurCents(value) : value}`;
      }).join(' · ');
      for (const row of state.rows) {
        const element = [...root.querySelectorAll<HTMLElement>('[data-segment-row]')].find((node) => node.dataset.segmentRow === row.id)!;
        element.dataset.result = row.status;
        const label = element.querySelector<HTMLElement>('[data-segment-result-label]')!;
        label.textContent = { pending: 'Pendiente', match: 'Coincide', no_match: 'No coincide', unknown: 'Datos incompletos' }[row.status];
        const tones = { pending: 'bg-muted text-muted-foreground', match: 'bg-emerald-50 text-emerald-900', no_match: 'bg-muted text-foreground', unknown: 'bg-amber-50 text-amber-950' };
        label.className = `inline-flex rounded-full px-2.5 py-1 text-xs font-semibold ${tones[row.status]}`;
        element.querySelector<HTMLElement>('[data-segment-result-detail]')!.textContent = row.status === 'pending' ? 'Todavía no se ha revisado.' : row.status === 'match' ? 'Cumple todas las reglas del ejemplo.' : row.status === 'no_match' ? 'No cumple todas las reglas del ejemplo.' : `Sin dato: ${row.missingFacts.map((fact) => CUSTOMER_SEGMENT_DEMO_FACT_LABELS[fact]).join(', ')}.`;
      }
    };

    controls.addEventListener('input', () => {
      const parameters = Object.fromEntries(parameterInputs().map((input) => [input.dataset.segmentParameter!, input.checkValidity() ? input.valueAsNumber * (input.dataset.segmentUnit === 'eur_cents' ? 100 : 1) : Number.NaN]));
      state = configureCustomerSegmentDemo(state, { templateId: state.templateId, parameters });
      changed = true;
      render();
    });
    root.querySelectorAll<HTMLButtonElement>('[data-segment-template]').forEach((button) => button.addEventListener('click', () => {
      const template = CUSTOMER_SEGMENT_DEMO_TEMPLATES.find((item) => item.id === button.dataset.segmentTemplate)!;
      state = configureCustomerSegmentDemo(state, { templateId: template.id, parameters: template.defaults });
      changed = true;
      rebuildParameters(); render();
    }));
    simulate.addEventListener('click', () => { state = simulateCustomerSegmentDemo(state); render(); });
    advance.addEventListener('click', () => { state = advanceCustomerSegmentDemo(state); render(); });
    reset.addEventListener('click', () => { state = createCustomerSegmentDemo(); changed = false; rebuildParameters(); render(); });
    parameterInputs().forEach((input) => { input.disabled = false; });
    render();
  }
</script>
