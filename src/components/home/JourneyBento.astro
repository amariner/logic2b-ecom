---
/**
 * «Qué incluye» en tres tarjetas, una por fase del ciclo de venta, cada una con
 * una ilustración de producto hecha en HTML y CSS (nítida a cualquier tamaño,
 * cero peticiones salvo tres miniaturas de 1–3 KB). Los nombres, precios y
 * stock son los de la tienda demo ARCE; los estados, los del motor.
 *
 * Las ilustraciones son decorativas (aria-hidden): el título, la frase y las
 * etiquetas de cada tarjeta dicen lo mismo en texto.
 */
type Phase = { n: string; label: string; title: string; body: string; tags: string[] };

const phases: Phase[] = [
  { n: '01', label: 'Atrae y vende', title: 'Tu marca, tu catálogo y una compra sin rodeos.', body: 'Categorías, búsqueda y fichas que ayudan a elegir. El carrito pide solo lo necesario.', tags: ['Web con tu marca', 'Búsqueda y fichas', 'Carrito claro'] },
  { n: '02', label: 'Cobra y prepara', title: 'Cobros verificados, pedidos en orden.', body: 'El pago se completa en la pasarela y el pedido llega a tu panel listo para preparar.', tags: ['Pago en pasarela', 'Stock al día', 'Lista de trabajo'] },
  { n: '03', label: 'Fideliza y crece', title: 'Clientes informados. Módulos cuando los necesites.', body: 'Confirmación y seguimiento automáticos. Nuevas funciones sobre el mismo motor.', tags: ['Emails automáticos', 'Seguimiento', 'Módulos activables'] },
];

const products = [
  { name: 'Butaca Alba', price: '680 €', img: '/images/home/chair-oak-200.webp' },
  { name: 'Silla Luna', price: '420 €', img: '/images/home/chair-walnut-200.webp' },
  { name: 'Lámpara Vela', price: '312 €', img: '/images/home/lamp-floor-200.webp' },
];
---

<div class="jb">
  {phases.map((phase, i) => (
    <article class="jb-card reveal">
      <div class:list={['jb-art', `jb-art-${i + 1}`]} aria-hidden="true">
        {i === 0 && (
          <div class="jg-store">
            <div class="jg-bar">
              <span class="jg-search"><svg viewBox="0 0 24 24" width="12" height="12"><path d="M11 18a7 7 0 1 0 0-14 7 7 0 0 0 0 14ZM20 20l-3.8-3.8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg><em>sillas</em><i class="jg-caret"></i></span>
              <span class="jg-chip is-on">Sillas</span><span class="jg-chip">Mesas</span>
              <span class="jg-bag"><svg viewBox="0 0 24 24" width="13" height="13"><path d="M5 8h14l-1.2 12H6.2L5 8Zm4 0a3 3 0 0 1 6 0" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" /></svg><b>1</b></span>
            </div>
            <div class="jg-grid">
              {products.map((product, p) => (
                <div class:list={['jg-prod', p === 0 && 'is-hit']}>
                  <img src={product.img} alt="" width="200" height="200" loading="lazy" decoding="async" />
                  <b>{product.name}</b>
                  <small>{product.price}</small>
                  {p === 0 && <span class="jg-add">Añadir</span>}
                </div>
              ))}
            </div>
            <span class="jg-pointer"><svg viewBox="0 0 24 24" width="18" height="18"><path d="M5 3.5 18.5 11l-6 1.6L9.8 18.5 5 3.5Z" fill="#0c1424" stroke="#fff" stroke-width="1.4" stroke-linejoin="round" /></svg></span>
          </div>
        )}
        {i === 1 && (
          <div class="jg-pay">
            <div class="jg-checkout">
              <span class="jg-lock"><svg viewBox="0 0 24 24" width="12" height="12"><path d="M7 11V8a5 5 0 0 1 10 0v3M6 11h12v9H6v-9Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" /></svg>Pasarela de pago</span>
              <span class="jg-card-num">•••• 4242</span>
              <span class="jg-total"><small>Total</small><b>680,00 €</b></span>
            </div>
            <span class="jg-flow"><i></i></span>
            <div class="jg-order">
              <div class="jg-order-head"><span>AR-1042</span><span class="jg-pill is-paid">Pagado</span></div>
              <ul>
                <li class="is-done"><span></span>Butaca Alba ×1</li>
                <li class="is-done"><span></span>Stock 8 → 7</li>
                <li><span></span>Preparar envío</li>
              </ul>
            </div>
          </div>
        )}
        {i === 2 && (
          <div class="jg-grow">
            <div class="jg-mail">
              <span class="jg-mail-ico"><svg viewBox="0 0 24 24" width="13" height="13"><path d="M3.5 6.5h17v11h-17v-11ZM3.5 7l8.5 6 8.5-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" /></svg></span>
              <span><b>Tu pedido va en camino</b><small>Seguimiento PK-7Y2-18455</small></span>
            </div>
            <ol class="jg-track">
              <li class="is-done">Pagado</li><li class="is-done">Enviado</li><li>Entregado</li>
            </ol>
            <ul class="jg-mods">
              <li><span>Cupones</span><i class="jg-switch is-on"></i></li>
              <li><span>Packs</span><i class="jg-switch is-anim"></i></li>
              <li><span>Listas de precios</span><i class="jg-switch"></i></li>
            </ul>
          </div>
        )}
      </div>
      <div class="jb-copy">
        <p class="jb-label"><span>{phase.n}</span>{phase.label}</p>
        <h3>{phase.title}</h3>
        <p>{phase.body}</p>
        <ul class="jb-tags">{phase.tags.map((tag) => <li>{tag}</li>)}</ul>
      </div>
    </article>
  ))}
</div>

<style>
  .jb { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
  .jb-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--c-border);
    border-radius: var(--r-lg);
    background: #fff;
    transition: border-color .3s var(--ease), box-shadow .3s var(--ease), transform .3s var(--ease);
  }
  .jb-card:hover { border-color: #cdd3dc; box-shadow: var(--shadow-md); transform: translateY(-2px); }
  .jb-art {
    position: relative;
    display: grid;
    height: 13.5rem;
    place-items: center;
    overflow: hidden;
    padding: 1.1rem;
    border-bottom: 1px solid var(--c-line);
    background:
      radial-gradient(circle at 1px 1px, rgb(12 20 36 / 9%) 1px, transparent 0) 0 0 / 14px 14px,
      linear-gradient(180deg, var(--c-surface), #fff);
  }
  .jb-copy { display: flex; flex: 1; flex-direction: column; padding: 1.3rem 1.35rem 1.4rem; }
  .jb-label { display: inline-flex; align-items: center; gap: .55rem; color: var(--c-accent); font: 500 .72rem/1.4 var(--font-code); }
  .jb-label span { padding-right: .55rem; border-right: 1px solid color-mix(in srgb, currentColor 35%, transparent); color: var(--c-muted); }
  .jb-copy h3 { margin: .7rem 0 .45rem; font-size: 1.08rem; line-height: 1.3; }
  .jb-copy > p:not(.jb-label) { color: var(--c-muted); font-size: .88rem; line-height: 1.55; }
  .jb-tags { display: flex; flex-wrap: wrap; gap: .35rem; margin-top: auto; padding-top: 1.1rem; }
  .jb-tags li { padding: .22rem .5rem; border: 1px solid var(--c-line); border-radius: var(--r-sm); background: var(--c-surface); color: var(--c-ink); font-size: .72rem; }

  /* ── Ilustración 1: escaparate ─────────────────────────────────────────── */
  .jg-store { position: relative; width: 100%; max-width: 19rem; padding: .6rem; border: 1px solid var(--c-border); border-radius: var(--r-md); background: #fff; box-shadow: var(--shadow-md); }
  .jg-bar { display: flex; align-items: center; gap: .3rem; margin-bottom: .55rem; }
  .jg-search { display: inline-flex; flex: 1; align-items: center; gap: .3rem; min-width: 0; padding: .25rem .4rem; border: 1px solid var(--c-border); border-radius: 5px; color: var(--c-muted); font-size: .6rem; }
  .jg-search em { color: var(--c-ink); font-style: normal; }
  .jg-caret { width: 1px; height: .7rem; margin-left: -.15rem; background: var(--c-ink); }
  .jg-chip { padding: .2rem .38rem; border: 1px solid var(--c-line); border-radius: 4px; color: var(--c-muted); font-size: .55rem; }
  .jg-chip.is-on { border-color: var(--c-ink); background: var(--c-ink); color: #fff; }
  .jg-bag { position: relative; display: grid; width: 1.35rem; height: 1.35rem; place-items: center; color: var(--c-ink); }
  .jg-bag b { position: absolute; top: -.2rem; right: -.25rem; display: grid; width: .8rem; height: .8rem; place-items: center; border-radius: 50%; background: var(--c-accent); color: #fff; font-size: .45rem; }
  .jg-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .4rem; }
  .jg-prod { position: relative; display: flex; flex-direction: column; min-width: 0; }
  .jg-prod img { width: 100%; height: auto; aspect-ratio: 1; border-radius: 4px; background: #f3efe9; object-fit: cover; }
  .jg-prod b { overflow: hidden; margin-top: .3rem; color: var(--c-ink); font-size: .56rem; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
  .jg-prod small { color: var(--c-muted); font-size: .52rem; }
  .jg-add { position: absolute; right: .2rem; bottom: 1.75rem; left: .2rem; padding: .18rem 0; border-radius: 3px; background: var(--c-ink); color: #fff; font-size: .5rem; font-weight: 600; text-align: center; }
  .jg-prod.is-hit img { box-shadow: 0 0 0 1.5px var(--c-accent); }
  .jg-pointer { position: absolute; left: 22%; top: 62%; filter: drop-shadow(0 2px 3px rgb(0 0 0 / 25%)); }

  /* ── Ilustración 2: pago → pedido ──────────────────────────────────────── */
  .jg-pay { display: grid; justify-items: center; gap: 0; width: 100%; max-width: 17.5rem; }
  .jg-checkout { display: grid; grid-template-columns: 1fr auto; gap: .35rem .6rem; width: 100%; padding: .65rem .75rem; border: 1px solid var(--c-border); border-radius: var(--r-md); background: #fff; box-shadow: var(--shadow-sm); }
  .jg-lock { display: inline-flex; grid-column: 1 / -1; align-items: center; gap: .35rem; color: var(--c-accent-strong); font: 500 .58rem/1 var(--font-code); }
  .jg-card-num { align-self: end; padding: .3rem .45rem; border: 1px solid var(--c-line); border-radius: 4px; color: var(--c-ink); font: 500 .62rem/1 var(--font-code); letter-spacing: .08em; }
  .jg-total { display: grid; justify-items: end; }
  .jg-total small { color: var(--c-muted); font-size: .52rem; }
  .jg-total b { color: var(--c-ink); font-size: .9rem; font-weight: 600; letter-spacing: -.02em; }
  .jg-flow { position: relative; display: block; width: 1px; height: 1.6rem; background: repeating-linear-gradient(180deg, var(--c-border) 0 3px, transparent 3px 6px); }
  .jg-flow i { position: absolute; left: -2.5px; top: 0; width: 6px; height: 6px; border-radius: 50%; background: var(--c-accent); box-shadow: 0 0 0 3px rgb(4 120 87 / 15%); }
  .jg-order { width: 100%; padding: .6rem .75rem .7rem; border: 1px solid var(--c-border); border-radius: var(--r-md); background: #fff; box-shadow: var(--shadow-md); }
  .jg-order-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: .45rem; color: var(--c-ink); font: 600 .66rem/1 var(--font-code); }
  .jg-pill { display: inline-flex; align-items: center; gap: .25rem; padding: .16rem .38rem; border-radius: 4px; font: 600 .55rem/1 var(--font-sans); }
  .jg-pill::before { width: .3rem; height: .3rem; border-radius: 50%; background: currentColor; content: ''; }
  .jg-pill.is-paid { background: var(--c-accent-soft); color: var(--c-accent-strong); }
  .jg-order ul { display: grid; gap: .3rem; }
  .jg-order li { display: flex; align-items: center; gap: .4rem; color: var(--c-muted); font-size: .6rem; }
  .jg-order li span { display: grid; width: .7rem; height: .7rem; place-items: center; border: 1px solid var(--c-border); border-radius: 3px; }
  .jg-order li.is-done { color: var(--c-ink); }
  .jg-order li.is-done span { border-color: var(--c-accent); background: var(--c-accent); }
  .jg-order li.is-done span::after { width: .3rem; height: .18rem; margin-top: -.08rem; border-bottom: 1.3px solid #fff; border-left: 1.3px solid #fff; content: ''; transform: rotate(-45deg); }

  /* ── Ilustración 3: aviso + módulos ────────────────────────────────────── */
  .jg-grow { display: grid; gap: .5rem; width: 100%; max-width: 17.5rem; }
  .jg-mail { display: flex; align-items: center; gap: .55rem; padding: .55rem .65rem; border: 1px solid var(--c-border); border-radius: var(--r-md); background: #fff; box-shadow: var(--shadow-md); }
  .jg-mail-ico { display: grid; flex: 0 0 auto; width: 1.6rem; height: 1.6rem; place-items: center; border-radius: 5px; background: var(--c-accent-soft); color: var(--c-accent-strong); }
  .jg-mail b { display: block; color: var(--c-ink); font-size: .64rem; font-weight: 600; }
  .jg-mail small { display: block; color: var(--c-muted); font: 400 .55rem/1.5 var(--font-code); }
  .jg-track { display: grid; grid-template-columns: repeat(3, 1fr); padding: .1rem .2rem 0; }
  .jg-track li { position: relative; display: grid; justify-items: center; gap: .3rem; color: var(--c-muted); font-size: .54rem; }
  .jg-track li::before { position: relative; z-index: 1; width: .55rem; height: .55rem; border: 1.5px solid var(--c-border); border-radius: 50%; background: #fff; content: ''; }
  .jg-track li::after { position: absolute; top: .24rem; left: 50%; width: 100%; height: 1.5px; background: var(--c-border); content: ''; }
  .jg-track li:last-child::after { display: none; }
  .jg-track li.is-done { color: var(--c-ink); }
  .jg-track li.is-done::before { border-color: var(--c-accent); background: var(--c-accent); }
  .jg-track li.is-done:not(:nth-child(2))::after { background: var(--c-accent); }
  .jg-mods { display: grid; gap: 0; overflow: hidden; border: 1px solid var(--c-border); border-radius: var(--r-md); background: #fff; }
  .jg-mods li { display: flex; align-items: center; justify-content: space-between; padding: .38rem .65rem; color: var(--c-ink); font-size: .6rem; }
  .jg-mods li + li { border-top: 1px solid var(--c-line); }
  .jg-switch { position: relative; width: 1.35rem; height: .78rem; border-radius: 1rem; background: #dfe3e9; transition: background-color .3s var(--ease); }
  .jg-switch::after { position: absolute; top: .1rem; left: .1rem; width: .58rem; height: .58rem; border-radius: 50%; background: #fff; box-shadow: 0 1px 2px rgb(0 0 0 / 20%); content: ''; transition: transform .3s var(--ease); }
  .jg-switch.is-on { background: var(--c-accent); }
  .jg-switch.is-on::after { transform: translateX(.57rem); }

  /* Movimiento: solo cuando se permite y en bucles lentos, nunca parpadeos. */
  @media (prefers-reduced-motion: no-preference) {
    .jg-caret { animation: jg-blink 1.1s steps(1) infinite; }
    .jg-pointer { animation: jg-point 4.8s var(--ease) infinite; }
    .jg-add { animation: jg-press 4.8s var(--ease) infinite; }
    .jg-bag b { animation: jg-pop 4.8s var(--ease) infinite; }
    .jg-flow i { animation: jg-drop 2.6s var(--ease) infinite; }
    .jg-switch.is-anim { animation: jg-toggle 5s var(--ease) infinite; }
    .jg-switch.is-anim::after { animation: jg-knob 5s var(--ease) infinite; }
  }
  @keyframes jg-blink { 50% { opacity: 0; } }
  @keyframes jg-point { 0%, 12% { transform: translate(90%, 60%); } 38%, 62% { transform: translate(0, 0); } 88%, 100% { transform: translate(90%, 60%); } }
  @keyframes jg-press { 0%, 40% { transform: none; } 45% { transform: scale(.92); } 52%, 100% { transform: none; } }
  @keyframes jg-pop { 0%, 44% { transform: scale(1); } 50% { transform: scale(1.45); } 58%, 100% { transform: scale(1); } }
  @keyframes jg-drop { 0% { top: 0; opacity: 0; } 15% { opacity: 1; } 85% { opacity: 1; } 100% { top: calc(100% - 6px); opacity: 0; } }
  @keyframes jg-toggle { 0%, 35% { background: #dfe3e9; } 45%, 85% { background: var(--c-accent); } 95%, 100% { background: #dfe3e9; } }
  @keyframes jg-knob { 0%, 35% { transform: none; } 45%, 85% { transform: translateX(.57rem); } 95%, 100% { transform: none; } }

  @media (max-width: 1000px) {
    .jb { grid-template-columns: 1fr; }
    .jb-card { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
    .jb-art { height: auto; min-height: 13rem; border-right: 1px solid var(--c-line); border-bottom: 0; }
  }
  @media (max-width: 640px) {
    .jb-card { display: flex; }
    .jb-art { min-height: 0; height: 12.5rem; border-right: 0; border-bottom: 1px solid var(--c-line); }
  }
</style>
