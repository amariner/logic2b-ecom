---
/**
 * El gestor bajo la lupa: la captura real del panel de pedidos con cuatro
 * ampliaciones ×2 unidas a su zona por líneas de cota. Cada lupa es la misma
 * imagen de 1440 px recortada en un círculo (sin rasterizar nada aparte), así
 * que lo que se amplía es exactamente lo que hay en el panel de la demo.
 *
 * Coordenadas en píxeles de `panel-orders.webp` (1440 × 1355): si se regenera
 * la captura con `scripts/capture-screens.mjs`, revisar los cuatro puntos.
 * En pantallas estrechas las lupas pasan a una rejilla numerada bajo la
 * captura y las líneas desaparecen.
 */
const SRC_W = 1440;
const SRC_H = 1355;

type Lens = { n: number; x: number; y: number; side: 'l' | 'r'; at: number; title: string; body: string };
const lenses: Lens[] = [
  { n: 1, x: 150, y: 352, side: 'l', at: 18, title: 'Solo lo que usas', body: 'Pedidos, envíos, devoluciones, emails y catálogo.' },
  { n: 2, x: 694, y: 312, side: 'l', at: 63, title: 'Lo urgente, arriba', body: 'Qué preparar hoy, sin buscarlo.' },
  { n: 3, x: 1328, y: 168, side: 'r', at: 14, title: 'Envíos en un clic', body: 'Exporta para Packlink o SendCloud.' },
  { n: 4, x: 1236, y: 962, side: 'r', at: 60, title: 'Estados a la vista', body: 'Y avisos cuando un pedido se retrasa.' },
];
const pct = (value: number, total: number) => Number(((value / total) * 100).toFixed(2));
/* Centro de cada lupa en coordenadas de la captura (%): fuera de la imagen. */
const lensX = (lens: Lens) => (lens.side === 'l' ? -19 : 119);
---

<figure class="pi" aria-labelledby="pi-caption">
  <div class="pi-stage">
    <div class="pi-canvas">
      <div class="pi-shotwrap">
      <img class="pi-shot" src="/images/screens/panel-orders-900.webp" srcset="/images/screens/panel-orders-560.webp 560w, /images/screens/panel-orders-900.webp 900w, /images/screens/panel-orders.webp 1440w" sizes="(min-width: 1100px) 720px, 100vw" alt="Panel de pedidos de la demo: menú lateral, resumen de pedidos por preparar, en tránsito y completados, y la lista de pedidos con su estado" width={SRC_W} height={SRC_H} loading="lazy" decoding="async" />
      <svg class="pi-lines" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
        {lenses.map((lens) => <line x1={lensX(lens)} y1={lens.at} x2={pct(lens.x, SRC_W)} y2={pct(lens.y, SRC_H)} />)}
      </svg>
      {lenses.map((lens) => (
        <span class="pi-target" style={`left:${pct(lens.x, SRC_W)}%;top:${pct(lens.y, SRC_H)}%`} aria-hidden="true"><b>{lens.n}</b></span>
      ))}
      </div>
      <ol class="pi-lenses">
        {lenses.map((lens) => (
          <li class:list={['pi-lens', `is-${lens.side}`]} style={`--lx:${lensX(lens)}%;--ly:${lens.at}%`}>
            <span class="pi-glass" aria-hidden="true">
              <img src="/images/screens/panel-orders.webp" alt="" width={SRC_W} height={SRC_H} loading="lazy" decoding="async" style={`--px:${lens.x}px;--py:${lens.y}px`} />
              <i>×2</i>
            </span>
            <span class="pi-text"><b><span aria-hidden="true">{lens.n}</span>{lens.title}</b><small>{lens.body}</small></span>
          </li>
        ))}
      </ol>
    </div>
  </div>
  <figcaption id="pi-caption" class="sr-only">Captura del panel de pedidos de la demo con cuatro detalles ampliados: el menú con solo las secciones que se usan, el resumen de lo que hay que preparar hoy, el botón para exportar envíos a Packlink o SendCloud y los estados de cada pedido con avisos de retraso.</figcaption>
</figure>

<style>
  .pi { --lens: 196px; margin: 0; }
  .pi-stage { padding-inline: calc(var(--lens) * .5 + 5.5rem); }
  .pi-canvas { position: relative; max-width: 46rem; margin-inline: auto; }
  .pi-shotwrap { position: relative; }
  .pi-shot { display: block; width: 100%; height: auto; border: 1px solid rgb(12 20 36 / 10%); border-radius: var(--r-lg); background: #fff; box-shadow: var(--shadow-lg); }
  .pi-lines { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; pointer-events: none; }
  .pi-lines line { stroke: var(--c-accent); stroke-width: 1.2; stroke-dasharray: 4 4; vector-effect: non-scaling-stroke; }
  .pi-target { position: absolute; display: grid; width: 2.1rem; height: 2.1rem; place-items: center; border: 1.5px solid var(--c-accent); border-radius: 50%; background: rgb(4 120 87 / 8%); box-shadow: 0 0 0 .35rem rgb(4 120 87 / 10%); transform: translate(-50%, -50%); }
  .pi-target b { display: none; width: 1.25rem; height: 1.25rem; place-items: center; border-radius: 50%; background: var(--c-accent); color: #fff; font-size: .68rem; }
  .pi-lenses { margin: 0; padding: 0; list-style: none; }
  .pi-lens { position: absolute; left: var(--lx); top: var(--ly); display: grid; align-content: start; justify-items: center; gap: .7rem; width: var(--lens); transform: translate(-50%, calc(var(--lens) * -.5)); }
  .pi-glass {
    position: relative;
    display: block;
    width: var(--lens);
    height: var(--lens);
    overflow: hidden;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 0 0 1px var(--c-border), 0 0 0 7px #fff, 0 0 0 8px var(--c-border), var(--shadow-lg);
  }
  /* La imagen ocupa la lupa y se muestra a tamaño natural (object-fit: none):
     así la carga perezosa ve una caja dentro del viewport. */
  .pi-glass img { display: block; width: 100%; height: 100%; object-fit: none; object-position: calc(var(--lens) / 2 - var(--px)) calc(var(--lens) / 2 - var(--py)); }
  /* Reflejo del cristal y marca de aumento. */
  .pi-glass::after { position: absolute; inset: 0; border-radius: 50%; background: radial-gradient(90% 70% at 28% 18%, rgb(255 255 255 / 45%), transparent 45%); content: ''; pointer-events: none; }
  .pi-glass i { position: absolute; bottom: .75rem; left: 50%; z-index: 1; transform: translateX(-50%); padding: .15rem .38rem; border-radius: var(--r-sm); background: var(--c-ink); color: #fff; font: 500 .62rem/1.3 var(--font-code); font-style: normal; }
  .pi-text { display: grid; gap: .15rem; text-align: center; }
  .pi-text b { display: inline-flex; align-items: center; justify-content: center; gap: .4rem; color: var(--c-ink); font-size: .9rem; font-weight: 600; }
  .pi-text b span { display: grid; width: 1.15rem; height: 1.15rem; place-items: center; border-radius: 50%; background: var(--c-accent); color: #fff; font-size: .62rem; }
  .pi-text small { color: var(--c-muted); font-size: .8rem; line-height: 1.45; }

  @media (prefers-reduced-motion: no-preference) {
    .pi-target { animation: pi-pulse 2.8s ease-out infinite; }
    .pi-lens:hover .pi-glass { box-shadow: 0 0 0 1px var(--c-accent), 0 0 0 7px #fff, 0 0 0 8px var(--c-accent), var(--shadow-lg); }
  }
  @keyframes pi-pulse { 0% { box-shadow: 0 0 0 0 rgb(4 120 87 / 25%); } 70%, 100% { box-shadow: 0 0 0 .8rem rgb(4 120 87 / 0%); } }

  /* Estrecho: lupas en rejilla numerada bajo la captura. */
  @media (max-width: 1100px) {
    .pi { --lens: 150px; }
    .pi-stage { padding-inline: 0; }
    .pi-lines { display: none; }
    .pi-target { width: 1.6rem; height: 1.6rem; }
    .pi-target b { display: grid; }
    .pi-lenses { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1.5rem 1rem; margin-top: 2rem; }
    .pi-lens { position: static; width: auto; transform: none; }
  }
  @media (max-width: 700px) {
    .pi-lenses { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
