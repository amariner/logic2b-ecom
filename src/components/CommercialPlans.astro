---
import { plans, euro } from '../commercial/plans';
const previews = { lite: 'bruma', kit: 'arce', custom: 'nera' } as const;
---
<div class="commercial-plans">
  {plans.map((plan) => <article class:list={['commercial-plan', plan.featured && 'is-featured']}>
    <div class="plan-top">
      <p class="plan-audience">{plan.audience}</p>
      {plan.featured && <p class="plan-badge">Recomendado</p>}
    </div>
    <h3>{plan.name}</h3>
    <p class="plan-description">{plan.description}</p>
    <p class="plan-price"><small>Desde</small> {euro(plan.setup)} €</p>
    <p class="plan-monthly">{plan.monthly ? `+ desde ${plan.monthly} €/mes de mantenimiento` : 'Puesta en marcha · sin panel de gestión'}</p>
    <a href="/#contacto" data-open-project data-project-pack={plan.name} class="plan-cta">Consultar este pack <span aria-hidden="true">→</span></a>
    <ul>{plan.points.map((point) => <li><span aria-hidden="true"><svg viewBox="0 0 16 16" width="14" height="14"><path d="m3.5 8.5 3 3 6-6.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg></span>{point}</li>)}</ul>
    <a class="plan-preview" href="/temas"><img src={`/images/screens/store-${previews[plan.id]}-catalog-560.webp`} alt={`Referencia de diseño para ${plan.name}`} width="560" height="360" loading="lazy" /><span>Explorar diseños <b aria-hidden="true">→</b></span></a>
  </article>)}
</div>
<p class="plans-note">Precios orientativos sin IVA. El presupuesto concreta catálogo, contenidos, integraciones y mantenimiento. Pasarela de pago, publicidad y servicios de terceros se presupuestan aparte. Kit Lite se prepara bajo propuesta; la demo muestra la tienda completa.</p>
<style>
/* Acabado único de los packs (portada, /precios y dossier). Los tokens
   (--c-*, --r-*, --shadow-*, --ease) los define el shell comercial. */
.commercial-plans{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem;align-items:stretch}
.commercial-plan{position:relative;display:flex;flex-direction:column;padding:1.75rem;border:1px solid var(--border);border-radius:var(--r-lg,14px);background:var(--card);box-shadow:var(--shadow-sm);transition:box-shadow .3s var(--ease),border-color .3s var(--ease)}
.commercial-plan:hover{border-color:#cdd3dc;box-shadow:var(--shadow-md)}
.plan-top{display:flex;align-items:center;justify-content:space-between;gap:1rem;min-height:1.6rem}
.plan-audience{color:var(--c-muted);font:500 .74rem/1.4 var(--font-code,monospace)}
.plan-badge{padding:.2rem .55rem;border-radius:var(--r-sm,6px);background:var(--c-accent-soft,#e8f5ef);color:var(--c-accent-strong,#065f46);font-size:.7rem;font-weight:600}
.commercial-plan h3{margin:.8rem 0 .5rem;font-size:1.35rem;letter-spacing:-.025em}
.plan-description{min-height:3em;color:var(--c-body,#414b5c);font-size:.93rem;line-height:1.5}
.plan-price{margin-top:1.4rem;color:var(--c-ink,#0c1424);font-size:2.6rem;font-weight:600;line-height:1;letter-spacing:-.045em;font-variant-numeric:tabular-nums}
.plan-price small{margin-right:.25rem;color:var(--c-muted);font-size:.8rem;font-weight:400;letter-spacing:0;vertical-align:.95em}
.plan-monthly{min-height:1.5em;margin:.6rem 0 1.4rem;color:var(--c-muted);font-size:.82rem}
.plan-cta{display:flex;align-items:center;justify-content:center;gap:.5rem;min-height:2.85rem;padding:.65rem 1rem;border:1px solid var(--c-border,#e2e6ec);border-radius:var(--r-btn,8px);background:#fff;color:var(--c-ink,#0c1424);font-size:.9rem;font-weight:500;box-shadow:var(--shadow-sm);transition:background-color .2s var(--ease),border-color .2s var(--ease)}
.plan-cta:hover{border-color:var(--c-ink,#0c1424)}
.commercial-plan ul{display:grid;gap:.7rem;margin-top:1.5rem;padding-top:1.4rem;border-top:1px solid var(--c-line,#edf0f4);color:var(--c-body,#414b5c);font-size:.88rem}
.commercial-plan li{display:flex;gap:.6rem;line-height:1.45}
.commercial-plan li span{display:grid;flex:0 0 auto;place-items:center;width:1.25rem;height:1.25rem;margin-top:.05rem;border-radius:var(--r-sm,6px);background:var(--c-accent-soft,#e8f5ef);color:var(--c-accent-strong,#065f46)}
.plan-preview{display:block;overflow:hidden;margin-top:auto;border:1px solid var(--c-line,#edf0f4);border-radius:var(--r-md,10px);background:#fff}
.commercial-plan ul + .plan-preview{margin-top:1.5rem}
.plan-preview img{width:100%;height:132px;object-fit:cover;object-position:top;transition:transform .6s var(--ease)}
.plan-preview:hover img{transform:scale(1.03)}
.plan-preview>span{display:flex;justify-content:space-between;padding:.6rem .8rem;border-top:1px solid var(--c-line,#edf0f4);color:var(--c-muted);font-size:.74rem}
.commercial-plan.is-featured{border-color:var(--c-ink,#0c1424);box-shadow:0 0 0 1px var(--c-ink,#0c1424),var(--shadow-lg)}
.commercial-plan.is-featured .plan-cta{border-color:var(--c-ink,#0c1424);background:var(--c-ink,#0c1424);color:#fff}
.commercial-plan.is-featured .plan-cta:hover{background:#1d2940}
.plans-note{max-width:62rem;margin:1.5rem auto 0;color:var(--c-muted);font-size:.8rem;line-height:1.7;text-align:center}
@media(max-width:860px){.commercial-plans{grid-template-columns:1fr}.commercial-plan{padding:1.5rem}.plan-description,.plan-monthly{min-height:0}.plan-price{font-size:2.4rem}}
@media print{.commercial-plan,.commercial-plan.is-featured{box-shadow:none;background:#fff;color:#000;border-color:#999}.plan-badge{display:none}}
</style>
