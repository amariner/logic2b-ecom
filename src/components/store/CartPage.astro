---
/**
 * Carrito de UNA tienda — página compartida (9B.4). El contenido vive en
 * localStorage (namespaceado por colección). Precios, stock y envío se simulan
 * en el navegador desde un catálogo inmutable embebido: no hay llamadas API.
 */
import Shop from '../../layouts/Shop.astro';
import { storePaths, type CollectionConfig } from '../../collections';
import { demoJson, getDemoProductSummaries } from '../../lib/demo-catalog';
import { shopConfig } from '../../../shop.config';

interface Props {
  collection: CollectionConfig;
}

const { collection } = Astro.props;
const paths = storePaths(collection.id);
const demoCommerceJson = demoJson({
  products: getDemoProductSummaries(collection.id),
  shipping: {
    zones: shopConfig.shipping.zones,
    rates: shopConfig.shipping.seedRates,
  },
});
---

<Shop title="Carrito" description="Tu carrito de la compra" collection={collection}>
  <main class="mx-auto max-w-3xl px-4 py-10" data-commerce-surface="cart">
    <div data-commerce-part="heading">
      <slot name="heading"><h1 class="font-display text-3xl text-foreground sm:text-4xl">Tu carrito</h1></slot>
    </div>

    <div data-cart-empty data-commerce-part="empty" class="hidden py-16 text-center text-muted-foreground">
      <slot name="empty"><p>El carrito está vacío.</p></slot>
      <a href={paths.catalog} class="mt-5 inline-block rounded-btn bg-brand px-7 py-3 font-semibold text-brand-fg transition hover:bg-brand-dark">Ir a la tienda</a>
    </div>

    <div data-cart-loading data-commerce-part="loading" class="py-16 text-center text-muted-foreground">Calculando precios…</div>

    <div data-cart-content class="hidden">
      <ul data-cart-lines data-commerce-part="lines" class="mt-6 divide-y divide-border"></ul>

      <div class="mt-6 rounded-2xl bg-muted p-5 sm:p-6" data-commerce-part="shipping">
        <label class="block text-sm font-medium text-muted-foreground" for="cp">Código postal de entrega</label>
        <div class="mt-2 flex gap-2">
          <input
            id="cp"
            inputmode="numeric"
            maxlength="5"
            placeholder="12001"
            class="w-32 rounded-btn border border-border bg-card px-4 py-2"
          />
          <button type="button" data-apply-cp class="rounded-btn border border-border bg-card px-5 py-2 text-sm font-medium transition hover:border-foreground">Calcular envío</button>
        </div>
        <p data-cp-feedback class="mt-2 hidden text-sm"></p>

        <dl class="mt-5 space-y-2 border-t border-border pt-4 text-sm">
          <div class="flex justify-between"><dt class="text-muted-foreground">Subtotal</dt><dd data-subtotal class="font-medium"></dd></div>
          <div class="flex justify-between"><dt class="text-muted-foreground">Envío <span data-shipping-label class="text-muted-foreground"></span></dt><dd data-shipping></dd></div>
          <div class="flex justify-between border-t border-border pt-3 text-base font-bold"><dt>Total</dt><dd data-total></dd></div>
        </dl>
      </div>

      <p data-cart-problems data-commerce-part="problems" class="mt-4 hidden rounded-2xl border border-red-200 bg-red-50 p-4 text-sm text-destructive"></p>

      {/* El color del texto se conmuta junto al fondo (ver el script): con
          `text-brand-fg` fijo el rótulo era blanco sobre `bg-muted` gris claro
          — 1.1:1, invisible mientras el carrito no fuese tramitable, que es
          justo el estado en el que aterriza un carrito recién llenado. */}
      <div class="mt-6 flex justify-end" data-commerce-part="actions">
        <a
          href={paths.checkout}
          data-checkout-link
          aria-disabled="true"
          tabindex="-1"
          class="pointer-events-none w-full rounded-btn bg-muted px-8 py-3.5 text-center font-semibold text-muted-foreground transition sm:w-auto"
        >Tramitar pedido</a>
      </div>
    </div>
  </main>

  <script is:inline type="application/json" data-demo-commerce set:html={demoCommerceJson}></script>

  <script>
    import { readCart, setQty } from '../../lib/cart-client';
    import {
      buildDemoQuote,
      DEMO_POSTAL_STORAGE_KEY,
      type DemoQuoteLine,
      type DemoShippingConfig,
    } from '../../lib/demo-commerce';
    import type { DemoProductSummary } from '../../lib/demo-catalog';
    import { formatEurCents as eur } from '../../lib/format';

    const $ = <T extends HTMLElement>(sel: string): T => document.querySelector<T>(sel)!;
    const payload = JSON.parse($<HTMLScriptElement>('[data-demo-commerce]').textContent ?? '{}') as {
      products: DemoProductSummary[];
      shipping: DemoShippingConfig;
    };

    const problemText: Record<Exclude<DemoQuoteLine['status'], 'ok'>, (line: DemoQuoteLine) => string> = {
      'not-found': (l) => `«${l.slug}» ya no está disponible; elimínalo para continuar.`,
      'out-of-stock': (l) => `«${l.name}» está agotado; elimínalo para continuar.`,
      'insufficient-stock': (l) => `De «${l.name}» solo quedan ${l.stock} unidades; ajusta la cantidad.`,
    };

    function refresh(): void {
      const lines = readCart();
      const empty = $('[data-cart-empty]');
      const loading = $('[data-cart-loading]');
      const content = $('[data-cart-content]');

      if (lines.length === 0) {
        empty.classList.remove('hidden');
        loading.classList.add('hidden');
        content.classList.add('hidden');
        return;
      }

      const postal = (localStorage.getItem(DEMO_POSTAL_STORAGE_KEY) ?? '').trim();
      const quote = buildDemoQuote(payload.products, lines, postal, payload.shipping);

      loading.classList.add('hidden');
      empty.classList.add('hidden');
      content.classList.remove('hidden');

      const list = $('[data-cart-lines]');
      list.innerHTML = '';
      for (const line of quote.lines) {
        const li = document.createElement('li');
        li.className = 'flex items-center gap-4 py-4';
        const bad = line.status !== 'ok';

        const img = document.createElement('img');
        img.src = line.image;
        img.alt = '';
        img.width = 64;
        img.height = 64;
        img.className = 'h-16 w-16 rounded-xl bg-muted object-cover';

        const info = document.createElement('div');
        info.className = 'flex-1';
        const nameEl = document.createElement('p');
        nameEl.className = `text-sm font-medium ${bad ? 'text-destructive line-through' : ''}`;
        nameEl.textContent = line.name;
        const priceEl = document.createElement('p');
        priceEl.className = 'text-sm text-muted-foreground';
        priceEl.textContent = bad ? '' : eur(line.price_cents);
        info.appendChild(nameEl);
        info.appendChild(priceEl);

        const qtyInput = document.createElement('input');
        qtyInput.type = 'number';
        qtyInput.min = '0';
        qtyInput.max = '99';
        qtyInput.step = '1';
        qtyInput.value = String(line.qty);
        qtyInput.dataset.qty = line.slug;
        qtyInput.className = 'w-16 rounded-btn border border-border px-2 py-1 text-sm';
        qtyInput.setAttribute('aria-label', `Cantidad de ${line.name}`);

        const totalEl = document.createElement('p');
        totalEl.className = 'w-20 text-right text-sm font-medium';
        totalEl.textContent = bad ? '—' : eur(line.line_total_cents);

        const removeBtn = document.createElement('button');
        removeBtn.type = 'button';
        removeBtn.dataset.remove = line.slug;
        removeBtn.setAttribute('aria-label', `Eliminar ${line.name}`);
        // -m-2 p-2: agranda el área táctil a ≥24px (WCAG 2.5.8) sin mover el layout.
        removeBtn.className = '-m-2 p-2 text-muted-foreground hover:text-destructive';
        removeBtn.textContent = '✕';

        li.appendChild(img);
        li.appendChild(info);
        li.appendChild(qtyInput);
        li.appendChild(totalEl);
        li.appendChild(removeBtn);
        list.appendChild(li);
      }

      list.querySelectorAll<HTMLInputElement>('[data-qty]').forEach((input) => {
        input.addEventListener('change', () => {
          // Redondear hacia abajo: un valor no entero se colaría en localStorage
          // y luego readCart() lo descartaría en silencio (línea "perdida").
          setQty(input.dataset.qty ?? '', Math.max(0, Math.floor(Number(input.value)) || 0));
          refresh();
        });
      });
      list.querySelectorAll<HTMLButtonElement>('[data-remove]').forEach((btn) => {
        btn.addEventListener('click', () => {
          setQty(btn.dataset.remove ?? '', 0);
          refresh();
        });
      });

      $('[data-subtotal]').textContent = eur(quote.subtotal_cents);
      const shippingEl = $('[data-shipping]');
      const shippingLabel = $('[data-shipping-label]');
      const cpFeedback = $('[data-cp-feedback]');
      if (quote.shipping_cents === null) {
        shippingEl.textContent = 'introduce tu CP';
        shippingLabel.textContent = '';
        if (postal) {
          cpFeedback.textContent = 'No hay cobertura de envío para ese código postal.';
          cpFeedback.className = 'mt-2 text-sm text-destructive';
        }
      } else {
        shippingEl.textContent = quote.shipping_cents === 0 ? 'Gratis' : eur(quote.shipping_cents);
        shippingLabel.textContent = quote.shipping_label ? `(${quote.shipping_label})` : '';
        const freeOver = quote.free_over_cents;
        if (typeof freeOver === 'number' && quote.shipping_cents > 0) {
          cpFeedback.textContent = `Envío gratis a partir de ${eur(freeOver)}.`;
          cpFeedback.className = 'mt-2 text-sm text-muted-foreground';
        } else {
          cpFeedback.classList.add('hidden');
        }
      }
      $('[data-total]').textContent = quote.total_cents === null ? '—' : eur(quote.total_cents);

      const problems = quote.lines.filter((line) => line.status !== 'ok');
      const problemsEl = $('[data-cart-problems]');
      if (problems.length > 0) {
        problemsEl.textContent = problems
          .map((line) => problemText[line.status as keyof typeof problemText](line))
          .join(' ');
        problemsEl.classList.remove('hidden');
      } else {
        problemsEl.classList.add('hidden');
      }

      const checkout = $('[data-checkout-link]');
      const ready = quote.purchasable && quote.total_cents !== null;
      checkout.classList.toggle('pointer-events-none', !ready);
      checkout.classList.toggle('bg-muted', !ready);
      checkout.classList.toggle('text-muted-foreground', !ready);
      checkout.classList.toggle('bg-brand', ready);
      checkout.classList.toggle('text-brand-fg', ready);
      checkout.classList.toggle('hover:bg-brand-dark', ready);
      checkout.setAttribute('aria-disabled', String(!ready));
      checkout.tabIndex = ready ? 0 : -1;
    }

    $('[data-checkout-link]').addEventListener('click', (ev) => {
      if ($('[data-checkout-link]').getAttribute('aria-disabled') === 'true') ev.preventDefault();
    });

    const cpInput = $('#cp') as unknown as HTMLInputElement;
    cpInput.value = localStorage.getItem(DEMO_POSTAL_STORAGE_KEY) ?? '';
    $('[data-apply-cp]').addEventListener('click', () => {
      localStorage.setItem(DEMO_POSTAL_STORAGE_KEY, cpInput.value.trim());
      refresh();
    });
    cpInput.addEventListener('keydown', (ev) => {
      if (ev.key === 'Enter') {
        localStorage.setItem(DEMO_POSTAL_STORAGE_KEY, cpInput.value.trim());
        refresh();
      }
    });

    refresh();
  </script>
</Shop>
