---
/**
 * Cierre visual de la compra simulada. Lee una referencia efímera de
 * sessionStorage; no consulta pedidos ni persiste datos en el backend.
 */
import Shop from '../../layouts/Shop.astro';
import { storePaths, type CollectionConfig } from '../../lib/collections';

interface Props {
  collection: CollectionConfig;
}

const { collection } = Astro.props;
const paths = storePaths(collection.id);
---

<Shop title="Gracias" description="Confirmación de pedido" collection={collection}>
  <main class="mx-auto max-w-xl px-4 py-16 text-center" data-commerce-surface="thanks" data-collection-id={collection.id}>
      <div data-commerce-part="success" data-demo-success class="hidden">
        <slot name="success">
        <p class="text-5xl" aria-hidden="true">🧺</p>
        <h1 class="mt-4 font-display text-3xl text-foreground sm:text-4xl">Simulación completada, <span data-demo-customer></span></h1>
        <p class="mt-3 text-muted-foreground">
          Referencia local <strong data-demo-order-number></strong> · <span data-demo-total></span>.
        </p>
        <p class="mt-2 text-sm text-muted-foreground">
          Es una demostración visual: no se ha creado ningún pedido, no se ha descontado stock y no se ha enviado nada a <span data-demo-email></span>.
        </p>
        </slot>
      </div>
      <div data-commerce-part="missing" data-demo-missing class="hidden">
        <slot name="missing">
          <h1 class="font-display text-3xl text-foreground">No hay una simulación activa</h1>
          <p class="mt-3 text-muted-foreground">Añade un producto y completa el recorrido para ver este estado.</p>
        </slot>
      </div>
    <div data-commerce-part="actions">
      <a href={paths.catalog} class="mt-8 inline-block rounded-btn bg-brand px-7 py-3 font-semibold text-brand-fg transition hover:bg-brand-dark"><slot name="back-label">Volver a la tienda</slot></a>
    </div>
  </main>

  <script>
    import { demoOrderStorageKey, type DemoOrder } from '../../lib/demo-commerce';
    import { formatEurCents as eur } from '../../lib/format';

    const surface = document.querySelector<HTMLElement>('[data-commerce-surface="thanks"]')!;
    const collectionId = surface.dataset.collectionId ?? 'demo';
    let order: DemoOrder | null = null;
    try {
      const raw = sessionStorage.getItem(demoOrderStorageKey(collectionId));
      const parsed = raw ? JSON.parse(raw) as Partial<DemoOrder> : null;
      if (
        parsed &&
        typeof parsed.order_number === 'string' &&
        typeof parsed.customer_name === 'string' &&
        typeof parsed.email === 'string' &&
        typeof parsed.total_cents === 'number'
      ) order = parsed as DemoOrder;
    } catch {
      order = null;
    }

    if (order) {
      surface.querySelector<HTMLElement>('[data-demo-success]')?.classList.remove('hidden');
      surface.querySelectorAll<HTMLElement>('[data-demo-order-number]').forEach((el) => (el.textContent = order!.order_number));
      surface.querySelectorAll<HTMLElement>('[data-demo-customer]').forEach((el) => (el.textContent = order!.customer_name.split(' ')[0] ?? ''));
      surface.querySelectorAll<HTMLElement>('[data-demo-total]').forEach((el) => (el.textContent = eur(order!.total_cents)));
      surface.querySelectorAll<HTMLElement>('[data-demo-email]').forEach((el) => (el.textContent = order!.email));
    } else {
      surface.querySelector<HTMLElement>('[data-demo-missing]')?.classList.remove('hidden');
    }
  </script>
</Shop>
