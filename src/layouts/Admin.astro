---
/**
 * Layout del backoffice demo. Deliberadamente sobrio: el argumento de venta
 * es "esto se aprende en 5 minutos". En producción va tras Cloudflare Access.
 */
import Base from './Base.astro';
import CloudflarePageview from '../components/CloudflarePageview.astro';
import DemoAssistant from '../components/store/DemoAssistant.astro';
import { shopConfig } from '../../shop.config';
import { MAIN_DEMO_HREF, MAIN_DEMO_NAME } from '../lib/nav';
import { runtimePlatform } from '../composition/runtime-platform';
import { canShowCustomerSegmentDemo } from '../composition/customer-segment-demo';
import { canShowMarketContentDemo } from '../composition/market-content-demo';
import { canShowMarketPublicationDemo } from '../composition/market-publication-demo';
import { canShowTaxDemo } from '../composition/tax-demo';
import { canShowCurrencyMethodsDemo } from '../composition/currency-methods-demo';
import { canShowCompanyDirectoryDemo } from '../composition/company-directory-demo';
import { canShowCompanyCatalogDemo } from '../composition/company-catalog-demo';
import { adminNavigationFor, type AdminNavigationId } from '../platform/configuration';
import AdminIcon, { type AdminIconName } from '../components/admin/AdminIcon.astro';

interface Props {
  title: string;
  active: AdminNavigationId | 'segmentos' | 'empresas' | 'catalogos-empresa' | 'mercados' | 'publicacion' | 'impuestos' | 'divisas';
}

const { title, active } = Astro.props;
const readOnly = runtimePlatform.manifest.deployment.mode === 'demo' || Astro.locals.runtime?.env.DEMO_MODE === 'true';

const nav = [
  ...adminNavigationFor(runtimePlatform),
  ...(canShowCustomerSegmentDemo(Astro.locals.runtime?.env)
    ? [{ id: 'segmentos' as const, href: '/demo/admin/segmentos', label: 'Segmentos · demo' }]
    : []),
  ...(canShowCompanyDirectoryDemo(Astro.locals.runtime?.env, runtimePlatform)
    ? [{ id: 'empresas' as const, href: '/demo/admin/empresas', label: 'Empresas y sedes · demo' }]
    : []),
  ...(canShowCompanyCatalogDemo(Astro.locals.runtime?.env, runtimePlatform)
    ? [{ id: 'catalogos-empresa' as const, href: '/demo/admin/catalogos-empresa', label: 'Catálogo por empresa · demo' }]
    : []),
  ...(canShowMarketContentDemo(Astro.locals.runtime?.env, runtimePlatform)
    ? [{ id: 'mercados' as const, href: '/demo/admin/mercados', label: 'Mercados e idiomas · demo' }]
    : []),
  ...(canShowMarketPublicationDemo(Astro.locals.runtime?.env, runtimePlatform)
    ? [{ id: 'publicacion' as const, href: '/demo/admin/publicacion', label: 'Publicación del catálogo · demo' }]
    : []),
  ...(canShowTaxDemo(Astro.locals.runtime?.env, runtimePlatform)
    ? [{ id: 'impuestos' as const, href: '/demo/admin/impuestos', label: 'Impuestos y totales · demo' }]
    : []),
  ...(canShowCurrencyMethodsDemo(Astro.locals.runtime?.env, runtimePlatform)
    ? [{ id: 'divisas' as const, href: '/demo/admin/divisas', label: 'Monedas y métodos · demo' }]
    : []),
];
/* Agrupación de presentación: primero lo que el comercio hace cada día y
   después el inventario avanzado. Un módulo desactivado no aparece y un grupo
   sin entradas tampoco; lo que no esté listado cae en «Más». */
const NAV_GROUPS: { label: string; ids: string[] }[] = [
  { label: 'Día a día', ids: ['pedidos', 'envios', 'devoluciones', 'emails'] },
  { label: 'Clientes', ids: ['segmentos', 'empresas', 'catalogos-empresa'] },
  { label: 'Internacional', ids: ['mercados', 'publicacion', 'impuestos', 'divisas'] },
  { label: 'Catálogo e inventario', ids: ['productos', 'ubicaciones', 'transferencias', 'conteos', 'asignacion'] },
  { label: 'Administración', ids: ['documentos'] },
];
const grouped = new Set(NAV_GROUPS.flatMap((group) => group.ids));
const navGroups = [
  ...NAV_GROUPS.map((group) => ({ label: group.label, items: group.ids.flatMap((id) => nav.filter((item) => item.id === id)) })),
  { label: 'Más', items: nav.filter((item) => !grouped.has(item.id)) },
].filter((group) => group.items.length > 0);
const orderedNav = navGroups.flatMap((group) => group.items);
const iconFor: Record<string, AdminIconName> = {
  pedidos: 'orders', documentos: 'orders', productos: 'products', ubicaciones: 'store', transferencias: 'shipping', conteos: 'products', envios: 'shipping', devoluciones: 'shipping', emails: 'email', segmentos: 'search', empresas: 'store', 'catalogos-empresa': 'products', mercados: 'globe', publicacion: 'products', impuestos: 'orders', divisas: 'globe',
};
---

<Base title={`${title} — ${shopConfig.backofficeName}`} noindex>
  <div class="admin-shell min-h-screen bg-[#f7f7f8] text-foreground" data-admin-shell data-demo-read-only={readOnly ? 'true' : undefined}>
    <aside class="fixed inset-y-0 left-0 z-30 hidden w-72 flex-col border-r border-border bg-card lg:flex">
      <div class="border-b border-border px-6 py-6">
        <a href="/demo/admin" class="inline-flex min-h-11 items-center font-display text-lg" aria-label={`${shopConfig.backofficeName}, inicio`}>
          Logic2B <span class="ml-1 text-muted-foreground">Gestión</span>
        </a>
        <p class="mt-1 text-xs text-muted-foreground">Centro de operaciones</p>
      </div>
      <div class="px-4 py-4">
        <div class="rounded-xl border border-border bg-muted/60 p-3">
          <p class="text-[0.68rem] font-semibold uppercase tracking-[0.14em] text-muted-foreground">Espacio activo</p>
          <div class="mt-2 flex items-center gap-3">
            <span class="flex size-9 items-center justify-center rounded-lg bg-foreground text-xs font-bold text-background">L2B</span>
            <div class="min-w-0"><p class="truncate text-sm font-semibold">Demo central</p><p class="truncate text-xs text-muted-foreground">Todos los escaparates</p></div>
          </div>
        </div>
      </div>
      <nav class="flex-1 space-y-5 overflow-y-auto px-4 pb-4" aria-label="Navegación del panel">
        {navGroups.map((group) => (
          <div>
            <p class="px-3 pb-1.5 text-[0.68rem] font-semibold uppercase tracking-[0.14em] text-muted-foreground">{group.label}</p>
            <div class="space-y-0.5">
              {group.items.map((item) => (
                <a href={item.href} aria-current={active === item.id ? 'page' : undefined} class:list={[
                  'flex items-center gap-3 rounded-lg px-3 text-sm font-medium transition',
                  item.id === 'segmentos' || item.id === 'empresas' || item.id === 'catalogos-empresa' || item.id === 'mercados' || item.id === 'publicacion' || item.id === 'impuestos' || item.id === 'divisas' ? 'min-h-11' : 'min-h-10',
                  active === item.id ? 'bg-foreground text-background shadow-sm' : 'text-muted-foreground hover:bg-muted hover:text-foreground',
                ]}>
                  <AdminIcon name={iconFor[item.id] ?? 'orders'} class="size-[1.1rem]" />
                  <span>{item.label}</span>
                </a>
              ))}
            </div>
          </div>
        ))}
      </nav>
      <div class="space-y-1 border-t border-border p-4 text-sm">
        <a href={MAIN_DEMO_HREF} class="flex min-h-11 items-center gap-3 rounded-xl px-3 text-muted-foreground hover:bg-muted hover:text-foreground"><AdminIcon name="store" />Ver tienda {MAIN_DEMO_NAME}<AdminIcon name="external" class="ml-auto size-4" /></a>
        <a href="/ayuda" class="flex min-h-11 items-center gap-3 rounded-xl px-3 text-muted-foreground hover:bg-muted hover:text-foreground"><AdminIcon name="help" />Ayuda</a>
        <a href="/demo/admin/login?salir=1" class="flex min-h-11 items-center gap-3 rounded-xl px-3 text-muted-foreground hover:bg-muted hover:text-foreground"><AdminIcon name="logout" />Cerrar sesión</a>
        <div class="mt-3 flex items-center gap-2 px-3 pt-3 text-xs text-muted-foreground"><span class="size-2 rounded-full bg-emerald-500"></span>Sistema operativo</div>
      </div>
    </aside>

    <header class="sticky top-0 z-20 border-b border-border bg-card/95 backdrop-blur lg:hidden">
      <div class="flex min-h-16 items-center justify-between gap-3 px-4">
        <a href="/demo/admin" class="min-w-0 font-display text-base">Logic2B <span class="hidden text-muted-foreground min-[375px]:inline">Gestión</span></a>
        <div class="flex shrink-0 items-center gap-1">
          <button type="button" data-admin-guide-launch hidden disabled class="flex size-11 items-center justify-center rounded-xl text-muted-foreground hover:bg-muted hover:text-foreground" aria-label="Guía de la demo" title="Guía de la demo" aria-controls="demo-assistant-card" aria-expanded="false"><span aria-hidden="true" class="text-xl">✦</span></button>
          <a href={MAIN_DEMO_HREF} class="flex size-11 items-center justify-center rounded-xl text-muted-foreground hover:bg-muted hover:text-foreground" aria-label={`Ver tienda ${MAIN_DEMO_NAME}`}><AdminIcon name="store" /></a>
          <a href="/ayuda" class="flex size-11 items-center justify-center rounded-xl text-muted-foreground hover:bg-muted hover:text-foreground" aria-label="Ayuda"><AdminIcon name="help" /></a>
          <a href="/demo/admin/login?salir=1" class="flex size-11 items-center justify-center rounded-xl text-muted-foreground hover:bg-muted hover:text-foreground" aria-label="Cerrar sesión"><AdminIcon name="logout" /></a>
        </div>
      </div>
      <nav data-admin-mobile-nav class="flex gap-1 overflow-x-auto border-t border-border px-3 py-2" aria-label="Navegación móvil del panel">
        {orderedNav.map((item) => <a href={item.href} aria-current={active === item.id ? 'page' : undefined} class:list={['flex min-h-11 shrink-0 items-center gap-2 rounded-xl px-3 text-sm font-medium', active === item.id ? 'bg-foreground text-background' : 'text-muted-foreground hover:bg-muted hover:text-foreground']}><AdminIcon name={iconFor[item.id] ?? 'orders'} class="size-4" />{item.label}</a>)}
      </nav>
      <div class="border-t border-sky-200 bg-sky-50 px-4 py-2 text-center text-[0.7rem] font-medium text-sky-950">Demo de solo lectura · datos ficticios independientes</div>
    </header>

    <div class="lg:pl-72">
      <div class="hidden border-b border-sky-200 bg-sky-50 px-6 py-2 text-center text-xs font-medium text-sky-950 lg:block">Panel ficticio de solo lectura (acceso demo). Sus datos de ejemplo son independientes de los escaparates.</div>
      <main data-guide-surface class="mx-auto w-full max-w-[100rem] px-4 py-7 sm:px-7 sm:py-9 xl:px-10">
        <slot />
      </main>
    </div>
  </div>

  <DemoAssistant admin />

  <CloudflarePageview />
  <style is:global>
    /* Titulares en Inter, como el sitio comercial («plataforma», 2026-09-29):
       el panel es sobrio y no necesita la fuente de marca. */
    .admin-shell { --font-display: var(--font-sans); --tracking-display: -0.025em; }
    [data-admin-guide-launch][hidden] { display: none !important; }
    [data-admin-guide-launch]:focus-visible { outline: 2px solid var(--color-foreground); outline-offset: 3px; }
  </style>
  <script>
    // Los formularios ilustrativos no activan handlers operativos ni con Enter.
    // Las vistas previas marcadas como locales gestionan su propia simulación.
    document.querySelector<HTMLElement>('[data-demo-read-only="true"]')
      ?.addEventListener('submit', (event) => {
        const form = event.target;
        if (form instanceof HTMLFormElement && form.method !== 'get' && !form.hasAttribute('data-demo-local')) {
          event.preventDefault();
          event.stopImmediatePropagation();
        }
      }, true);
    document.querySelector<HTMLElement>('[data-admin-mobile-nav] [aria-current="page"]')
      ?.scrollIntoView({ block: 'nearest', inline: 'center' });
  </script>
</Base>
