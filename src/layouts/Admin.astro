---
/**
 * Layout del backoffice demo. Deliberadamente sobrio: el argumento de venta
 * es "esto se aprende en 5 minutos". En producción va tras Cloudflare Access.
 */
import Base from './Base.astro';
import { shopConfig } from '../../shop.config';
import { MAIN_DEMO_HREF } from '../lib/nav';
import { runtimePlatform } from '../composition/runtime-platform';
import { adminNavigationFor, type AdminNavigationId } from '../platform/configuration';

interface Props {
  title: string;
  active: AdminNavigationId;
}

const { title, active } = Astro.props;

const nav = adminNavigationFor(runtimePlatform);
---

<Base title={`${title} — Panel · ${shopConfig.backofficeName}`} noindex>
  <div class="border-b border-sky-200 bg-sky-50 px-4 py-1.5 text-center text-xs text-sky-900">
    Panel ficticio de solo lectura (contraseña «demo»). Sus datos de ejemplo son independientes de los escaparates.
  </div>

  <div class="min-h-screen bg-stone-100">
    <header class="border-b border-stone-300 bg-white">
      <div class="mx-auto max-w-6xl px-4 py-3">
        <div class="flex items-center justify-between gap-4">
          <span class="truncate font-bold">{shopConfig.backofficeName} <span class="hidden font-normal text-stone-500 sm:inline">· panel</span></span>
          <div class="flex shrink-0 items-center gap-4 text-sm">
            <a href={MAIN_DEMO_HREF} class="text-stone-500 hover:text-stone-900">← Ver ARCE</a>
            <a href="/ayuda" class="text-stone-500 hover:text-stone-900">Ayuda</a>
            <a href="/demo/admin/login?salir=1" class="text-stone-500 hover:text-stone-900">Salir</a>
          </div>
        </div>
        <nav class="-mx-4 mt-3 flex gap-1 overflow-x-auto px-4 text-sm sm:mx-0 sm:mt-2 sm:px-0">
          {nav.map((item) => (
            <a
              href={item.href}
              aria-current={active === item.id ? 'page' : undefined}
              class:list={[
                'shrink-0 rounded px-3 py-1.5',
                active === item.id ? 'bg-stone-900 text-white' : 'text-stone-600 hover:bg-stone-100',
              ]}
            >{item.label}</a>
          ))}
        </nav>
      </div>
    </header>

    <main class="mx-auto max-w-6xl px-4 py-6">
      <slot />
    </main>
  </div>

  {shopConfig.analytics.cfBeaconToken && (
    <script
      defer
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon={JSON.stringify({ token: shopConfig.analytics.cfBeaconToken })}
      is:inline
    ></script>
  )}
</Base>
