---
/** Shell y lenguaje visual único para portada y páginas comerciales. */
import Base from './Base.astro';
import '../styles/commercial.css';
import SiteHeader from '../components/SiteHeader.astro';
import HeaderActions from '../components/HeaderActions.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ProjectDialog from '../components/ProjectDialog.astro';
import { landingNav } from '../lib/nav';

interface Props {
  title: string;
  description?: string | undefined;
  noindex?: boolean | undefined;
  canonicalPath?: string | undefined;
  jsonLd?: object[] | undefined;
  ogImagePath?: string | undefined;
  ogImageAlt?: string | undefined;
  /** href del enlace activo del menú (se resalta en la cabecera). */
  activeHref?: string | undefined;
}

const { title, description, noindex, canonicalPath, jsonLd, ogImagePath, ogImageAlt, activeHref } = Astro.props;
---

<Base
  title={title}
  description={description}
  noindex={noindex}
  canonicalPath={canonicalPath}
  jsonLd={jsonLd}
  ogImagePath={ogImagePath}
  ogImageAlt={ogImageAlt}
  preloadDisplayFont
>
  <div class="commercial-page">
    <SiteHeader homeHref="/" wordmark="Logic2B Ecommerce" splitBrand nav={landingNav} activeHref={activeHref}>
      <Fragment slot="actions"><HeaderActions /></Fragment>
    </SiteHeader>
    <slot />
    <SiteFooter />
    <ProjectDialog />
  </div>
</Base>
