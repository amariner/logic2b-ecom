---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string | undefined;
}

const {
  title,
  description = 'Acceso seguro a tu cuenta de cliente.',
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex,nofollow,noarchive" />
    <meta name="referrer" content="no-referrer" />
    <title>{title}</title>
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body class="min-h-screen bg-muted/45 text-foreground antialiased">
    <a
      href="#contenido"
      class="sr-only fixed left-4 top-4 z-50 rounded-lg bg-foreground px-4 py-3 font-semibold text-background focus:not-sr-only"
    >Saltar al contenido</a>

    <div class="flex min-h-screen flex-col">
      <header class="border-b border-border bg-background">
        <div class="mx-auto flex min-h-16 w-full max-w-5xl items-center justify-between px-5 sm:px-8">
          <a href="/cuenta/sesiones" class="inline-flex min-h-11 items-center font-display text-lg">
            Logic<span class="font-extrabold">2B</span>
          </a>
          <span class="text-sm font-medium text-muted-foreground">Cuenta de cliente</span>
        </div>
      </header>

      <main id="contenido" class="mx-auto flex w-full max-w-lg flex-1 items-center px-5 py-10 sm:px-8 sm:py-16">
        <div class="w-full">
          <slot />
        </div>
      </main>

      <footer class="border-t border-border bg-background px-5 py-5 text-center text-xs text-muted-foreground">
        Acceso protegido · Logic2B Ecommerce
      </footer>
    </div>
  </body>
</html>
