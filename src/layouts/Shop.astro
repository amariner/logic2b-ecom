---
/**
 * Layout de tienda: noindex, banner de demo y CHROME del tema.
 *
 * 9B.4 — CADA TIENDA ES SU URL. El tema ya no sale de una cookie ni de un
 * selector: sale de la COLECCIÓN (prop), que a su vez sale del segmento de URL
 * validado contra el registro. Los tokens del tema se aplican en SSR como
 * variables CSS inline en el wrapper — sin localStorage, sin anti-flash, sin
 * recarga estructural. Las demos no consultan el backend.
 */
import Base from './Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import DemoJourneyBanner from '../components/store/DemoJourneyBanner.astro';
import MinimalHeader from '../components/themes/minimal/Header.astro';
import MinimalFooter from '../components/themes/minimal/Footer.astro';
import { shopConfig } from '../../shop.config';
import {
  DEFAULT_COLLECTION_ID,
  defaultCollection,
  storePaths,
  type CollectionConfig,
} from '../collections';
import { defaultTheme, getTheme, type DemoTheme } from '../lib/demo-themes';

interface Props {
  title: string;
  description?: string;
  /** Tienda activa. Sin prop: la genérica (rutas históricas /demo/tienda…). */
  collection?: CollectionConfig;
}

const { title, description, collection = defaultCollection() } = Astro.props;

const theme: DemoTheme = getTheme(collection.themeId) ?? defaultTheme;
const paths = storePaths(collection.id);
const isDefaultStore = collection.id === DEFAULT_COLLECTION_ID;
const useSidebar = theme.layout.nav === 'sidebar';
const immersive = theme.layout.nav === 'immersive';

// Pie oscuro a sangre. Lo pide el DESCRIPTOR del tema (`layout.darkFooter`), que
// estaba declarado y documentado desde 2026-07-20 y el motor IGNORABA. Se paga
// aquí, una vez y para los 9 temas: es el MISMO pie y el mismo contenido, solo
// cambia la superficie. Decidido al cerrar Industrial (2026-07-25) — la
// alternativa era irse a `immersive` y dejar carrito, checkout y ficha sin
// cabecera, como Iris y Street, y habría sido la tercera tienda pagando ese
// peaje. Los colores van explícitos (no tokens): un pie negro es negro también
// en modo oscuro, igual que el de Street.
const darkFooter = theme.layout.darkFooter;

// Tokens del tema aplicados en el wrapper (heredan por cascada). También para
// Base: desde que :root lleva el canto corporativo (10px, logic2b.com), el
// fallback de global.css ya NO equivale al tema Base — su pill (9999px) solo
// vive en sus propias vars, así que se inyectan siempre.
const themeStyle = Object.entries(theme.vars)
  .map(([k, v]) => `${k}: ${v}`)
  .join('; ');

const nav = isDefaultStore
  ? ([
      { href: paths.catalog, label: 'Tienda' },
      { href: '/demo/admin', label: 'Panel del comercio' },
    ] as const)
  : ([{ href: paths.catalog, label: 'Tienda' }] as const);

// `aria-current="page"` en el enlace de nav que apunta a la página actual: sin
// esto el lector no distingue el destino en el que ya estás. Se compara solo la
// ruta (los filtros de catálogo viajan en query string y no cambian la página).
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const activeHref = nav.find((link) => (link.href.replace(/\/+$/, '') || '/') === currentPath)?.href;
---

<Base title={`${title} — ${collection.name}`} description={description} noindex>
  <div
    data-store-theme={theme.id}
    data-store-collection={collection.id}
    style={themeStyle}
    class:list={[useSidebar && 'bg-surface-sunken']}
  >
    {/* relative z-30: los temas inmersivos ponen un vídeo fijo por debajo. */}
    <DemoJourneyBanner themeName={collection.name} />

    {/* Tema inmersivo (Iris): pinta su propio header sobre el hero; sin
        SiteHeader ni footer estándar. El banner de demo de arriba se queda. */}
    {immersive ? (
      <slot />
    ) : useSidebar ? (
      <Fragment>
        {/* Hoja blanca insertada sobre gris claro, con nav lateral a la izquierda. */}
        <div class="mx-auto max-w-[1400px] bg-background">
          <div class="md:grid md:grid-cols-[13rem_minmax(0,1fr)]">
            <MinimalHeader collection={collection} paths={paths} />
            <div class="min-w-0"><slot /></div>
          </div>
        </div>
        <MinimalFooter collection={collection} paths={paths} />
      </Fragment>
    ) : (
      <Fragment>
        <SiteHeader homeHref={paths.catalog} wordmark={collection.name} showMark={false} nav={nav} activeHref={activeHref}>
          <a
            slot="actions"
            href={paths.cart}
            aria-label="Carrito"
            class="relative inline-flex items-center gap-1.5 rounded-btn bg-muted px-4 py-2 text-sm font-medium text-foreground transition hover:bg-secondary"
          >
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 0 0-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 0 0-16.536-1.84M7.5 14.25 5.106 5.272M6 20.25a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Zm12.75 0a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Z" />
            </svg>
            <span class="hidden sm:inline">Carrito</span>
            <span data-cart-badge class="hidden rounded-full bg-brand px-1.5 py-0.5 text-xs font-bold text-brand-fg">0</span>
          </a>
        </SiteHeader>

        <slot />

        {/* Color y superficie del pie van en el <style> de abajo, no en
            utilidades: así la variante oscura no tiene que pisar clases de
            Tailwind (la trampa de especificidad de docs/CHECKLIST_TEMA.md § 3). */}
        <footer class:list={['shop-footer', darkFooter && 'shop-footer--dark']}>
          <div class="shop-footer__body mx-auto max-w-6xl px-4 py-10 text-sm">
            <p class="shop-footer__name font-display text-base">{collection.name}</p>
            <p class="mt-3 max-w-2xl leading-relaxed">{shopConfig.legalName}. {shopConfig.legal.shippingNote} {shopConfig.legal.returnsNote}</p>
            <p class="mt-4">Demo de <a href="/" class="shop-footer__link underline underline-offset-2">Logic2B Ecommerce</a> · <a href="/demo/reset" class="shop-footer__link underline underline-offset-2">Reiniciar recorrido local</a></p>
          </div>
        </footer>
      </Fragment>
    )}

    {/* Acceso corto al catálogo completo de temas; la lista vive en /temas. */}
    <a href="/temas" data-store-switcher class="fixed bottom-4 left-4 z-50 flex items-center gap-2 rounded-full border border-border bg-popover px-4 py-2.5 text-sm font-semibold text-foreground shadow-lg shadow-black/10 transition hover:border-foreground">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 21v-7.5a.75.75 0 0 1 .75-.75h3a.75.75 0 0 1 .75.75V21m-4.5 0H2.36m11.14 0H18m0 0h3.64m-1.39 0V9.349M3.75 21V9.349m0 0a3.001 3.001 0 0 0 3.75-.615A2.993 2.993 0 0 0 9.75 9.75c.896 0 1.7-.393 2.25-1.016a2.993 2.993 0 0 0 2.25 1.016c.896 0 1.7-.393 2.25-1.015a3.001 3.001 0 0 0 3.75.614m-16.5 0a3.004 3.004 0 0 1-.621-4.72l1.189-1.19A1.5 1.5 0 0 1 5.378 3h13.243a1.5 1.5 0 0 1 1.06.44l1.19 1.189a3 3 0 0 1-.621 4.72M6.75 18h3.75a.75.75 0 0 0 .75-.75V13.5a.75.75 0 0 0-.75-.75H6.75a.75.75 0 0 0-.75.75v3.75c0 .414.336.75.75.75Z" />
        </svg>
        Otros temas
    </a>
  </div>

  <style>
    /* Pie estándar (claro con filete). Lo que antes eran utilidades. */
    .shop-footer {
      margin-top: 5rem;
      border-top: 1px solid var(--color-border);
      background: var(--color-muted);
    }
    .shop-footer__body { color: var(--color-muted-foreground); }
    .shop-footer__name { color: var(--color-foreground); }
    .shop-footer__link:hover { color: var(--color-foreground); }

    /* Variante oscura (`layout.darkFooter`). Colores explícitos y verificados:
       #d4d4d4 sobre #111111 = 11,3:1 y #ffffff sobre #111111 = 18,9:1. Se
       declara con `background` (no con un degradado en un ::before) para que el
       auditor de a11y pueda LEER el fondo efectivo. */
    .shop-footer--dark {
      background: #111111;
      border-top-color: #2e2e2e;
    }
    .shop-footer--dark .shop-footer__body { color: #d4d4d4; }
    .shop-footer--dark .shop-footer__name,
    .shop-footer--dark .shop-footer__link:hover { color: #ffffff; }
  </style>

  <script>
    import { bindCartBadge, cartCount } from '../lib/cart-client';

    const badge = document.querySelector<HTMLElement>('[data-cart-badge]');
    if (badge) bindCartBadge(badge);

    // CART (n) del sidebar Minimal: el número se muestra SIEMPRE (incluido 0),
    // a diferencia del badge de Base (que se oculta cuando el carrito va vacío).
    const countEls = [...document.querySelectorAll<HTMLElement>('[data-cart-count]')];
    if (countEls.length > 0) {
      const renderCount = (): void => {
        const n = String(cartCount());
        for (const el of countEls) el.textContent = n;
      };
      renderCount();
      document.addEventListener('cart:changed', renderCount);
    }
  </script>

  {shopConfig.analytics.cfBeaconToken && (
    <script
      defer
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon={JSON.stringify({ token: shopConfig.analytics.cfBeaconToken })}
      is:inline
    ></script>
  )}
</Base>
