---
import ThanksPage from '../../../../components/store/ThanksPage.astro';
import { inlogemStoreExperience } from '../../../../proposals/inlogem/config';
import { proposalForPage } from '../../../../proposals/http';

export const prerender = false;
const proposal = await proposalForPage({ publicId: Astro.params.publicId, headers: Astro.response.headers, env: Astro.locals.runtime.env, url: Astro.url });
if (proposal instanceof Response) return proposal;
---

<ThanksPage collection={proposal.collection} experience={inlogemStoreExperience}>
  <Fragment slot="success">
    <div class="mx-auto grid size-16 place-items-center rounded-full bg-[#E4F6EB] text-[#11643B]" aria-hidden="true">
      <svg viewBox="0 0 24 24" class="size-8" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m6 12 4 4 8-9" /></svg>
    </div>
    <p class="mt-5 text-xs font-bold uppercase tracking-[.17em] text-brand">Recorrido completado</p>
    <h1 class="mt-2 font-display text-3xl text-foreground sm:text-5xl">Todo listo, <span data-demo-customer></span>.</h1>
    <p class="mt-4 text-muted-foreground">Referencia local <strong data-demo-order-number></strong> · <span data-demo-total></span>.</p>
    <p class="mx-auto mt-3 max-w-md text-sm leading-6 text-muted-foreground">Esta ha sido una demostración visual: no se ha creado ningún pedido, no se ha descontado stock y no se ha enviado nada a <span data-demo-email></span>.</p>
  </Fragment>
  <Fragment slot="missing">
    <h1 class="font-display text-3xl text-foreground sm:text-4xl">Aún no hay un pedido de muestra</h1>
    <p class="mt-3 text-muted-foreground">Añade un producto y completa el recorrido para ver esta confirmación.</p>
  </Fragment>
  <Fragment slot="back-label">Seguir comprando</Fragment>
</ThanksPage>
