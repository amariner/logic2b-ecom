---
import InlogemCatalog from '../../../../proposals/inlogem/InlogemCatalog.astro';
import { inlogemStoreExperience } from '../../../../proposals/inlogem/config';
import { proposalForPage } from '../../../../proposals/http';

export const prerender = false;

const proposal = await proposalForPage({
  publicId: Astro.params.publicId,
  headers: Astro.response.headers,
  env: Astro.locals.runtime.env,
  url: Astro.url,
});
if (proposal instanceof Response) return proposal;
---

<InlogemCatalog proposal={proposal} experience={inlogemStoreExperience} url={Astro.url} />
