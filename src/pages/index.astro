---
import Landing from '../layouts/Landing.astro';
import ThemeRail from '../components/ThemeRail.astro';
import CommercialPlans from '../components/CommercialPlans.astro';
import ProjectForm from '../components/ProjectForm.astro';
import Icon, { type IconName } from '../components/Icon.astro';
import { collections, storePaths } from '../collections';
import { getTheme } from '../lib/demo-themes';
import { MAIN_DEMO_HREF, DEMO_ADMIN_HREF } from '../lib/nav';
import { planOffers } from '../commercial/plans';
const galleryOrder = [
  'zancada',
  // new-theme:gallery — no borrar: `pnpm new:theme <id>` añade aquí la tienda.
  'arce', 'nera', 'forma', 'lumbre', 'traza', 'bruma', 'brio', 'argent',
  'arista', 'eje', 'ensamble', 'sarga', 'monte', 'mixta', 'dintel', 'alva', 'orbe',
  'viso', 'litica', 'summit', 'sillage', 'stretch', 'sitega', 'noddo', 'demo',
  'launch', 'editorial', 'iris', 'street', 'industrial', 'natural', 'specs', 'minimal', 'guide',
];
const gallery = galleryOrder.map((id) => {
  const col = collections.find((c) => c.id === id)!;
  const theme = getTheme(col.themeId)!;
  return { id, name: col.name, tagline: col.tagline, style: theme.label, accent: theme.vars['--color-brand'], href: storePaths(id).catalog, img: `/images/screens/store-${id}-catalog-560.webp`, img900: `/images/screens/store-${id}-catalog-900.webp`, video: null, poster: null, poster900: null };
});
const workflow: { icon: IconName; title: string; body: string }[] = [
  { icon: 'store', title: 'Una web con tu marca', body: 'Tu catálogo, tus imágenes y una forma de comprar que encaja con tu negocio.' },
  { icon: 'search', title: 'Productos fáciles de encontrar', body: 'Categorías, búsqueda y fichas que ayudan a elegir con confianza.' },
  { icon: 'cart', title: 'Compra sin rodeos', body: 'Un carrito claro y los datos de entrega en el momento adecuado.' },
  { icon: 'card', title: 'Pagos controlados', body: 'Importes y confirmaciones conectados al pedido.' },
  { icon: 'clipboard', title: 'Pedidos en orden', body: 'Tu equipo sabe qué preparar, qué enviar y qué revisar.' },
  { icon: 'mail', title: 'Cliente informado', body: 'Confirmación y seguimiento con la información de su compra.' },
  { icon: 'growth', title: 'Espacio para crecer', body: 'Añadimos capacidad cuando la operación lo necesita.' },
];
const moments = [
  { label: 'Tienda', title: 'Una tienda que invita a quedarse.', body: 'El diseño presenta tus productos y acompaña la decisión de compra, desde el móvil hasta el escritorio.', points: ['Categorías con sentido para tu catálogo', 'Fotografía y contenido con una misma identidad', 'Fichas que responden antes de añadir al carrito'], img: '/images/screens/store-arce-catalog-900.webp', href: MAIN_DEMO_HREF, link: 'Explorar la tienda', crop: true },
  { label: 'Compra', title: 'De encontrarlo a tenerlo en el carrito.', body: 'Cantidad, precio y entrega visibles. Cada paso pide solo lo que hace falta para continuar.', points: ['Carrito fácil de revisar', 'Compra como invitado', 'Costes de envío antes de confirmar'], img: '/images/screens/store-demo-cart.webp', href: '/demo/carrito', link: 'Ver el carrito', crop: false },
  { label: 'Pedidos', title: 'Lo que necesita atención, a la vista.', body: 'Una lista de trabajo comprensible para el comercio. Sin menús que no necesitas ni hojas sueltas.', points: ['Pedidos ordenados por estado', 'Productos, dirección y total reunidos', 'Historial de cada pedido'], img: '/images/screens/panel-orders.webp', href: DEMO_ADMIN_HREF, link: 'Probar el gestor', crop: false },
  { label: 'Envíos', title: 'Prepara, envía y sigue el pedido.', body: 'La gestión del envío forma parte del mismo recorrido, con tarifas y seguimiento en contexto.', points: ['Tarifas por zona y tramo', 'Exportación para preparar etiquetas', 'Transportista y seguimiento junto al pedido'], img: '/images/screens/panel-shipping.webp', href: '/demo/admin/envios', link: 'Ver los envíos', crop: false },
  { label: 'Comunicación', title: 'Cada mensaje, cuando toca.', body: 'El cliente recibe información útil y el equipo puede revisar lo que se ha comunicado.', points: ['Confirmación de compra', 'Aviso de envío con seguimiento', 'Bandeja de ejemplo sin enviar emails reales'], img: '/images/screens/panel-emails.webp', href: '/demo/admin/emails', link: 'Ver los emails', crop: false },
];
const faqs = [
  { q: '¿Qué estoy contratando?', a: 'Un proyecto de ecommerce adaptado a tu negocio y un servicio de mantenimiento. Logic2B construye sobre su infraestructura tecnológica propia; no es una suscripción a un SaaS ni una plantilla cerrada.' },
  { q: '¿Qué incluye el precio?', a: 'Cada pack indica su inversión inicial y, cuando corresponde, el mantenimiento mensual. El presupuesto concreta productos, contenidos y funciones. Los precios son sin IVA; publicidad, tarifas de pago e integraciones externas se detallan aparte.' },
  { q: '¿Puedo conservar mi dominio y mis productos?', a: 'Sí. Revisamos el dominio, el catálogo y los datos que ya tienes para acordar qué se migra y cómo se comprueba antes del lanzamiento.' },
  { q: '¿Es difícil gestionar la tienda?', a: 'El panel se adapta a las tareas del comercio: productos, pedidos y envíos. Puedes recorrer la demo y consultar la guía antes de decidir.' },
  { q: '¿Cómo funcionan los pagos?', a: 'El pago se realiza en una pasarela externa. Los datos de tarjeta no pasan por nuestros servidores. Las demos son simulaciones y no realizan cobros.' },
  { q: '¿Y si necesito más adelante otras funciones?', a: 'Revisamos la necesidad y acordamos su alcance. El motor común permite ampliar el proyecto con módulos, conexiones o desarrollo específico sin empezar de cero.' },
];
const jsonLd = [{ '@context': 'https://schema.org', '@type': 'Service', name: 'Logic2B Ecommerce', description: 'Diseño y desarrollo de tiendas online a medida, con panel sencillo y mantenimiento técnico de Logic2B.', provider: { '@type': 'Organization', name: 'Logic2B', url: 'https://logic2b.com' }, areaServed: 'ES', offers: planOffers }, { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(faq => ({ '@type': 'Question', name: faq.q, acceptedAnswer: { '@type': 'Answer', text: faq.a } })) }];
---
<Landing title="Logic2B Ecommerce — tienda online, pedidos y gestión a medida" description="Tu tienda online con tu marca y un panel sencillo. Diseño, catálogo, compra y gestión conectados. Descubre las demos y los packs de Logic2B Ecommerce." canonicalPath="/" jsonLd={jsonLd}>
<main class="commerce-home">
  <section class="commerce-hero page-shell" aria-labelledby="hero-title">
    <div class="commerce-hero-copy">
      <p class="page-kicker">Ecommerce a medida para tu negocio</p>
      <h1 id="hero-title">Tu tienda.<br /><em>Tu forma</em> de vender.<br />Todo conectado.</h1>
      <p class="hero-lead">Web, compra y gestión en un mismo proyecto. Tú llevas el negocio. Nosotros, la tecnología.</p>
      <a class="hero-contact" href="#contacto"><span>Cuéntanos qué vendes</span><strong>Hablemos <span aria-hidden="true">→</span></strong></a>
      <ul class="hero-shortcuts"><li><a href={MAIN_DEMO_HREF}>✓ Ver una tienda</a></li><li><a href="#plataforma">✓ Ver recorrido</a></li><li><a href={DEMO_ADMIN_HREF ?? '/arquitectura'}>✓ Probar el gestor</a></li></ul>
      <p class="hero-note">Proyecto propio. Panel sencillo. Acompañamiento de Logic2B.</p>
    </div>
    <div class="hero-portfolio"><label class="rail-pause"><input type="checkbox" aria-label="Pausar movimiento de las tiendas" /> Pausar</label><ThemeRail stores={gallery.slice(0, 8)} /></div>
  </section>
  <section class="integration-strip page-shell" aria-label="Herramientas del ecosistema"><p>Un proyecto conectado a tu operativa</p><ul><li>Stripe</li><li>Cloudflare</li><li>Resend</li><li>Packlink</li><li>Sendcloud</li><li>WhatsApp</li></ul><small>Pasarela, correo, exportaciones y contacto según el alcance acordado.</small></section>
  <section id="flujo" class="home-section page-shell">
    <div class="home-heading"><p class="page-kicker">Tu operativa, conectada</p><h2>De la primera visita<br />al último paquete.</h2><p>Diseñamos el recorrido alrededor de lo que vendes y de cómo trabaja tu equipo.</p></div>
    <ol class="workflow" tabindex="0" aria-label="Los siete pasos de tu ecommerce">{workflow.map((step) => <li><span class="workflow-icon" aria-hidden="true"><Icon name={step.icon} size={22} /></span><h3>{step.title}</h3><p>{step.body}</p></li>)}</ol>
  </section>
  <section id="plataforma" class="home-section platform-section">
    <div class="page-shell"><div class="home-heading centered"><p class="page-kicker">Una tienda. Cinco momentos clave</p><h2>Bonita por fuera.<br />Bien resuelta por dentro.</h2></div>
    <div class="platform-explorer" data-platform-explorer>
      <div class="platform-tabs" aria-label="Recorrido de la tienda">{moments.map((moment, i) => <a href={`#moment-${i}`} data-moment-tab={i}>{moment.label}</a>)}</div>
      {moments.map((moment, i) => <article id={`moment-${i}`} class="platform-moment" data-moment-panel={i}><div><span class="moment-number">0{i + 1}</span><h3>{moment.title}</h3><p>{moment.body}</p><ul>{moment.points.map(point => <li><span aria-hidden="true">↗</span>{point}</li>)}</ul><a class="text-link" href={moment.href ?? '/arquitectura'}>{moment.link} →</a></div><figure class:list={['moment-screen', moment.crop && 'crop']}><img src={moment.img} alt={`Vista de demostración: ${moment.label}`} width="1200" height="800" loading="lazy" /><figcaption>Demo navegable · datos simulados</figcaption></figure></article>)}
    </div></div>
  </section>
  <section id="integraciones" class="home-section page-shell"><div class="home-heading"><p class="page-kicker">Conecta sin rehacer</p><h2>Tus herramientas.<br />En el mismo recorrido.</h2><p>Definimos las conexiones que necesita tu negocio, con un alcance concreto para cada proyecto.</p></div><div class="integration-grid"><article><span class="integration-symbol" aria-hidden="true">↗</span><h3>Operación conectada</h3><p>Catálogo, correo y preparación de envíos comparten información útil.</p><small>Resend · exportación Packlink / Sendcloud</small></article><article><span class="integration-symbol" aria-hidden="true">◎</span><h3>Pagos en su sitio</h3><p>La pasarela procesa la tarjeta y el pedido conserva su importe y estado.</p><small>Stripe · otras pasarelas según proyecto</small></article><article><span class="integration-symbol" aria-hidden="true">✳</span><h3>Preparada para evolucionar</h3><p>Datos estructurados y una base ampliable para nuevas conexiones y automatizaciones.</p><small>Integraciones y asistencia IA bajo alcance</small></article></div></section>
  <section id="precios" class="home-section pricing-section"><div class="page-shell"><div class="home-heading centered"><p class="page-kicker">Diseño + tecnología + acompañamiento</p><h2>Empieza con lo que necesitas.<br />Crece sobre la misma base.</h2><p>Una inversión inicial para construir tu tienda y un mantenimiento claro para cuidarla.</p></div><CommercialPlans /><a class="section-more" href="/precios">Ver los packs y sus condiciones <span aria-hidden="true">↗</span></a></div></section>
  <section id="demos" class="home-section page-shell"><div class="home-heading heading-row"><div><p class="page-kicker">Direcciones visuales</p><h2>Tu marca merece<br />su propia tienda.</h2><p>Explora identidades distintas sobre el mismo motor ecommerce.</p></div><a class="text-link" href="/temas">Ver todos los diseños ↗</a></div><div class="portfolio-grid">{gallery.slice(0, 6).map(store => <a class="portfolio-card" href={store.href}><img src={store.img900} alt={`Escaparate de ${store.name}`} width="900" height="700" loading="lazy" /><div><span><strong>{store.name}</strong><small>{store.style} · Demo navegable</small></span><b aria-hidden="true">↗</b></div></a>)}</div></section>
  <section id="paneles" class="home-section page-shell"><div class="home-heading"><p class="page-kicker">Un panel para trabajar</p><h2>Menos buscar.<br />Más tenerlo a mano.</h2><p>Las vistas que necesita el comercio, sin añadir complejidad a su día a día.</p></div><div class="manager-grid">{[ ['Pedidos', 'Estado, importe y siguiente paso.', '/images/screens/panel-orders.webp', DEMO_ADMIN_HREF ?? '/arquitectura'], ['Productos', 'Tu catálogo, precios y existencias.', '/images/screens/panel-products.webp', '/demo/admin/productos'], ['Comunicaciones', 'Cada mensaje junto a su pedido.', '/images/screens/panel-emails.webp', '/demo/admin/emails'] ].map(([name, body, img, href]) => <a href={href}><img src={img} alt={`Panel de ${name?.toLowerCase()}`} width="1200" height="800" loading="lazy" /><h3>{name} <span aria-hidden="true">↗</span></h3><p>{body}</p></a>)}</div></section>
  <section class="implementation page-shell"><img src="/images/commercial/order-preparation.webp" alt="Preparación de un pedido con embalaje de papel y productos de un pequeño comercio" width="1536" height="1024" loading="lazy" /><div><p class="page-kicker">De tu negocio a tu tienda</p><h2>Te acompañamos<br />hasta ponerlo en marcha.</h2><p>Reunimos catálogo, contenidos e identidad. Diseñamos, configuramos y revisamos contigo la compra completa antes de publicar.</p><ol><li><b>01</b> Entendemos tu operación</li><li><b>02</b> Acordamos diseño y alcance</li><li><b>03</b> Probamos y preparamos la entrega</li></ol><small>El calendario depende del alcance y del estado de los contenidos.</small></div></section>
  <section class="home-section page-shell"><div class="home-heading"><p class="page-kicker">Guías para decidir y trabajar</p><h2>Cada duda, en su sitio.</h2></div><div class="guide-grid">{[['/ayuda', 'Para el comercio', 'Cómo gestionar pedidos y productos'], ['/dossier', 'Para quien decide', 'La propuesta completa de Logic2B'], ['/arquitectura', 'Para tu equipo técnico', 'Cómo funciona la infraestructura'], ['/agencias', 'Para agencias', 'Un equipo de ecommerce en marca blanca']].map(([href, title, body]) => <a href={href}><span>{title}</span><h3>{body}</h3><b aria-hidden="true">↗</b></a>)}</div></section>
  <section class="home-section home-faq page-shell"><div class="home-heading"><p class="page-kicker">Preguntas frecuentes</p><h2>Hablemos claro.</h2></div><div>{faqs.map(faq => <details><summary>{faq.q}<span aria-hidden="true">+</span></summary><p>{faq.a}</p></details>)}</div></section>
  <section id="contacto" class="home-contact"><div class="page-shell contact-layout"><div><p class="page-kicker">Logic2B Ecommerce · Hablemos de tu proyecto</p><h2>Tu próxima tienda<br />empieza aquí.</h2><p>Cuéntanos qué vendes, qué tienes ya y qué necesitas mejorar. Prepararemos el siguiente paso alrededor de tu negocio.</p><ul><li>✓ Diseño con tu marca</li><li>✓ Gestión sencilla</li><li>✓ Acompañamiento real</li></ul></div><div class="contact-form"><ProjectForm idPrefix="home" source="landing" /></div></div></section>
</main>
</Landing>
<script>
const explorer = document.querySelector<HTMLElement>('[data-platform-explorer]');
if (explorer) {
  const tabs = Array.from(explorer.querySelectorAll<HTMLAnchorElement>('[data-moment-tab]'));
  const panels = Array.from(explorer.querySelectorAll<HTMLElement>('[data-moment-panel]'));
  tabs[0]?.parentElement?.setAttribute('role', 'tablist');
  const activate = (index: number, focus = false) => {
    tabs.forEach((tab, i) => { tab.setAttribute('aria-selected', String(i === index)); tab.tabIndex = i === index ? 0 : -1; });
    panels.forEach((panel, i) => { panel.hidden = i !== index; });
    if (focus) tabs[index]?.focus();
  };
  tabs.forEach((tab, i) => {
    tab.id = `moment-tab-${i}`; tab.setAttribute('role', 'tab'); tab.setAttribute('aria-controls', `moment-${i}`);
    panels[i]?.setAttribute('role', 'tabpanel'); panels[i]?.setAttribute('aria-labelledby', tab.id);
    tab.addEventListener('click', event => { event.preventDefault(); activate(i); });
    tab.addEventListener('keydown', event => {
      let index = i;
      if (event.key === 'ArrowRight') index = (i + 1) % tabs.length;
      else if (event.key === 'ArrowLeft') index = (i + tabs.length - 1) % tabs.length;
      else if (event.key === 'Home') index = 0;
      else if (event.key === 'End') index = tabs.length - 1;
      else return;
      event.preventDefault(); activate(index, true);
    });
  });
  activate(0);
}
</script>
