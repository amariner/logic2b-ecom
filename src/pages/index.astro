      <nav class="guides" aria-label="Guías">{guides.map((guide) => <a href={guide.href}><span class="guide-ico" aria-hidden="true"><Icon name={guide.icon} size={16} /></span><span><small>{guide.title}</small>{guide.body}</span><b aria-hidden="true">→</b></a>)}</nav>
    </div>
