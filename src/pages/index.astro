---
// Landing comercial de Logic2B Ecommerce — página de CONVERSIÓN.
//
// F13: el acento de la landing es el verde de marca y NO muta (antes cambiaba
// al de la tienda que pasaba por el centro de la galería: bonito, pero la
// página cambiaba de color mientras se lee y la marca se diluía). Cada tarjeta
// conserva el acento de SU tienda, que es donde el color significa algo.
//
// F13.2 — cambio de ARGUMENTO, no solo de copy:
//   · Fuera el «0 €/mes de infraestructura». El modelo pasa a ser una cuota que
//     ARRANCA BAJA Y CRECE CON EL TRÁFICO: cobramos poco mientras el tráfico es
//     poco, cobramos por traerlo (SEO, GEO y campañas) y subimos cuando el
//     tráfico —y las ventas— suben. Ganamos a la vez que el cliente.
//   · Fuera la comparativa de coste con Shopify (cuota de plataforma, comisión
//     por venta y calculadora a 3 años): nosotros también podemos cobrar
//     comisión, así que ese argumento ya no es honesto.
//   · Stripe deja de ser «la» pasarela: es una de las que se integran.
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import HeaderActions from '../components/HeaderActions.astro';
import ProjectDialog from '../components/ProjectDialog.astro';
import ProjectForm from '../components/ProjectForm.astro';
import LogoMarquee from '../components/LogoMarquee.astro';
import { collections, storePaths } from '../lib/collections';
import { demoThemes, defaultTheme, getTheme } from '../lib/demo-themes';
import { landingNav, MAIN_DEMO_HREF, DEMO_ADMIN_HREF } from '../lib/nav';
import { AGENCY_EMAIL, AGENCY_WHATSAPP } from '../lib/contact';

// ── Galería del hero — derivada del registro de tiendas (clonable) ──────────
// NODDO abre la fila como dirección visual destacada. Sitēga ocupa la segunda
// posición; la demo genérica continúa disponible dentro del resto de la fila.
const galleryOrder = ['arce', 'stretch', 'forma', 'sitega', 'noddo', 'demo', 'launch', 'editorial', 'iris', 'street', 'industrial', 'natural', 'specs', 'minimal', 'guide'];
const gallery = galleryOrder.map((id) => {
  const col = collections.find((c) => c.id === id)!;
  const theme = getTheme(col.themeId)!;
  return {
    id,
    name: col.name,
    tagline: col.tagline,
    style: theme.label,
    accent: theme.vars['--color-brand'],
    href: storePaths(id).catalog,
    // Dos anchos con `srcset`: la tarjeta pinta a 280 CSS px en móvil y 360 en
    // escritorio, así que 560 es lo que se lleva casi siempre y 900 queda para
    // pantallas de alta densidad. Servir solo 900 costaba ~200 KB de galería.
    img: `/images/screens/store-${id}-catalog-560.webp`,
    img900: `/images/screens/store-${id}-catalog-900.webp`,
    video: id === 'iris' ? '/images/screens/iris-scrub.mp4' : null,
    poster: id === 'iris' ? '/images/screens/iris-scrub-poster-560.webp' : null,
    poster900: id === 'iris' ? '/images/screens/iris-scrub-poster.webp' : null,
  };
});

// ── Contacto ────────────────────────────────────────────────────────────────
// El canal principal es el formulario; WhatsApp y email quedan de alternativa
// para quien prefiere escribir directamente.
const whatsappHref = AGENCY_WHATSAPP
  ? `https://wa.me/${AGENCY_WHATSAPP}?text=${encodeURIComponent('Hola, me interesa una tienda online con Logic2B Ecommerce.')}`
  : null;
const emailHref = `mailto:${AGENCY_EMAIL}?subject=${encodeURIComponent('Mi tienda online con Logic2B Ecommerce')}`;

// Recuento del catálogo de temas, derivado del registro (igual que hace
// /temas): un tema nuevo actualiza este copy solo.
const themeCount = demoThemes.filter((t) => t.id !== defaultTheme.id).length;

// ── Flujo del pedido, con capturas reales del producto ──────────────────────
const flow = [
  {
    n: '01',
    title: 'El cliente compra',
    body: 'Sin crear cuenta. El porte se calcula por código postal y el pago va a la pasarela: la tarjeta nunca toca la tienda.',
    img: '/images/screens/flow-checkout-900.webp',
    alt: 'Checkout de la demo con el porte calculado y el total',
  },
  {
    n: '02',
    title: 'Te llega el email',
    body: 'Confirmación al cliente y aviso a ti, con tu marca y tu dominio.',
    img: '/images/screens/panel-email-open-900.webp',
    alt: 'Email de confirmación de pedido renderizado en la bandeja',
  },
  {
    n: '03',
    title: 'Lo gestionas en el panel',
    body: 'Un pedido, su dirección, sus líneas y su historial. Marcas «enviado» y pegas el seguimiento.',
    img: '/images/screens/panel-order-detail-900.webp',
    alt: 'Detalle de un pedido con dirección, tracking y línea de tiempo',
  },
  {
    n: '04',
    title: 'Etiqueta y en camino',
    body: 'Exportas la dirección a Packlink o SendCloud, imprimes la etiqueta y el cliente recibe el aviso solo.',
    img: '/images/screens/panel-orders-900.webp',
    alt: 'Listado de pedidos con los estados y la exportación a Packlink',
  },
];

// ── Comparativa ─────────────────────────────────────────────────────────────
// Sin filas de dinero (cuota de plataforma, comisión por venta): nuestro modelo
// también puede llevar comisión, así que comparar por ahí sería vender humo.
// Lo que sí se compara es lo que de verdad nos separa: el producto y quién
// responde por él.
const comparison = [
  { concept: 'El diseño de tu tienda', shopify: 'Plantilla que también usan otros', woo: 'Plantilla más plugins', kit: 'A medida, solo tuyo' },
  { concept: 'Velocidad de carga', shopify: 'Tema genérico, 2–4 s', woo: 'Depende de 20 plugins', kit: '< 0,5 s, CDN global' },
  { concept: 'El código es tuyo', shopify: 'No, alquilas', woo: 'Sí, pero frágil', kit: 'Sí, a medida' },
  { concept: 'Mantenimiento técnico', shopify: 'Incluido en la cuota', woo: 'Tú (o sustos)', kit: 'Nosotros' },
  { concept: 'Quién trae las visitas', shopify: 'Tú, o una agencia aparte', woo: 'Tú, o una agencia aparte', kit: 'Nosotros: SEO, GEO y campañas' },
];

const notForYou = [
  'Necesitas la tienda en varios idiomas desde el día uno.',
  'Tu catálogo cambia a diario y necesita sincronización automática con un ERP.',
  'Quieres un marketplace con varios vendedores.',
  'Vendes por suscripción recurrente (cuotas mensuales al cliente).',
];

// ── La escalera de evolución — se VENDE, no se construye (§14) ──────────────
const ladder = [
  {
    k: 'Hoy',
    title: 'El MVP que vende',
    body: 'Catálogo, carrito, pagos, panel de pedidos y envíos. Lo esencial, bien hecho: tu tienda se entrega rápido y funciona desde el primer día.',
  },
  {
    k: 'Cuando lo pida',
    title: 'Se le añade, sin migrar',
    body: 'Cuentas de cliente, promociones, multiidioma, más pasarelas de pago, transportistas integrados, feeds para Google y Meta… Cada pieza se activa de nuestro lado cuando el negocio la justifica.',
  },
  {
    k: 'A cualquier escala',
    title: '10 referencias o un millón',
    body: 'La misma arquitectura sirve un expositor de barrio y un catálogo industrial. Nunca llega el día de «esta plataforma se nos ha quedado pequeña»: no hay migración, hay evolución.',
  },
];

// ── Precios ─────────────────────────────────────────────────────────────────
// El pago de puesta en marcha es cerrado; la cuota ARRANCA en el mínimo y sube
// por tramos de tráfico. Los tramos concretos se cierran en la propuesta, no
// aquí: publicar una tabla de tramos sin haberla validado sería inventarse
// precios (§14).
const tiers = [
  {
    name: 'Kit',
    featured: true,
    price: '1.900 €',
    unit: 'puesta en marcha',
    monthly: 'desde 39 €/mes, según el tráfico de tu tienda',
    points: [
      'Uno de los temas del catálogo, adaptado a tu marca (color, tipografía, fotos)',
      'Catálogo cargado, pagos y envíos configurados',
      'Tu dominio y emails con tu marca',
      'Tu equipo cada mes: copias, actualizaciones, asistencia y hasta 2 h de cambios',
    ],
  },
  {
    name: 'Kit a medida',
    featured: false,
    price: 'desde 3.400 €',
    unit: 'puesta en marcha',
    monthly: 'desde 59 €/mes, con prioridad',
    points: [
      'Dirección visual propia, nivel Iris o Módulo Audio',
      'Sesión de arte e imaginería generada para tu tienda',
      'Tema exclusivo, no compartido con nadie',
      'Todo lo del Kit, con soporte prioritario',
    ],
  },
];
const lite = {
  name: 'Kit Lite',
  price: 'desde 590 €',
  body: 'Hasta 10 productos con enlaces de pago, sin panel. Para empezar a vender online con lo justo.',
};

// ── FAQ ─────────────────────────────────────────────────────────────────────
const faqs = [
  {
    q: '¿Cómo funciona eso de que la cuota crece con el tráfico?',
    a: 'La cuota arranca en el mínimo mientras tu tienda tiene poco tráfico, y sube por tramos a medida que ese tráfico crece. No es una penalización: traer visitas es precisamente nuestro trabajo (SEO, GEO y campañas), así que solo cobramos más cuando lo hemos hecho bien y tu tienda vende más. El tramo exacto se cierra en la propuesta, con tus números delante.',
  },
  {
    q: '¿Qué pasa con los pagos? ¿Es seguro?',
    a: 'El pago ocurre en la página de la pasarela —Stripe, PayPal o la que mejor encaje con tu negocio—, nunca en tu tienda. El número de tarjeta no pasa por ella: cero superficie de ataque, cero papeleo PCI. En las demos de este sitio el pago está simulado: puedes recorrer el proceso entero, pero no se cobra nada.',
  },
  {
    q: '¿Y si un día dejamos de trabajar juntos?',
    a: 'No hay secuestro: el dominio y las cuentas de pago están a tu nombre, y el código es tuyo. Te lo entregamos con la documentación para que cualquier desarrollador pueda continuar. Sin permanencia.',
  },
  {
    q: '¿Por qué no Shopify o WooCommerce?',
    a: 'Porque con ellos tu tienda se parece a las demás y el marketing lo tienes que buscar aparte. Aquí el diseño es a medida y tuyo, la tienda carga en menos de medio segundo, y quien la construye es quien la posiciona: una sola conversación en lugar de tres proveedores señalándose entre ellos.',
  },
  {
    q: '¿Y si mañana necesito algo que la tienda no hace?',
    a: 'Nos lo pides y lo resolvemos de nuestro lado, sobre tu misma tienda: cuentas de cliente, promociones, multiidioma, otra pasarela de pago, integraciones… Tu tienda arranca como un MVP a propósito y crece cuando el negocio lo pide — sin plugins que adaptar y sin migrar de plataforma.',
  },
  {
    q: '¿Qué incluye exactamente la mensualidad?',
    a: 'Mantenimiento (copias, actualizaciones, vigilancia), asistencia personalizada de las personas que hicieron tu tienda, seguimiento del proyecto y el trabajo de posicionamiento. En el Kit incluye además hasta 2 h de cambios al mes. Es una sola cuota: si tu tienda sube de tramo, la cuota se sustituye por la nueva — nunca se apila una suscripción encima de otra.',
  },
  {
    q: '¿Trabajáis con agencias?',
    a: 'Sí, también en marca blanca: nosotros ponemos el motor, la construcción y el mantenimiento técnico; tu agencia lleva al cliente, el diseño si quiere y el marketing. Escríbenos y te contamos el modelo de colaboración.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Logic2B Ecommerce',
    description:
      'Tienda online a medida que arranca como MVP y escala de 10 referencias a un millón sin cambiar de plataforma: ultrarrápida, con diseño propio y con el posicionamiento (SEO, GEO y campañas) del mismo equipo que la construye.',
    provider: { '@type': 'Organization', name: 'Logic2B', url: 'https://logic2b.com' },
    areaServed: 'ES',
    serviceType: 'Desarrollo de comercio electrónico',
    offers: [
      { '@type': 'Offer', name: 'Kit Lite', price: '590', priceCurrency: 'EUR' },
      { '@type': 'Offer', name: 'Kit', price: '1900', priceCurrency: 'EUR' },
      { '@type': 'Offer', name: 'Kit a medida', price: '3400', priceCurrency: 'EUR' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: { '@type': 'Answer', text: faq.a },
    })),
  },
];
---

<Base
  title="Logic2B Ecommerce — tiendas online a medida, con el marketing incluido"
  description="Tu tienda online a medida: 10 productos o un millón. Arranca como MVP, crece sin cambiar de plataforma y la cuota crece contigo: cobramos más cuando tu tráfico y tus ventas suben. Hecha en Castellón por Logic2B."
  canonicalPath="/"
  preloadDisplayFont
  jsonLd={jsonLd}
>
  <div class="bg-background text-foreground">
    <SiteHeader homeHref="/" wordmark="Logic2B Ecommerce" splitBrand nav={landingNav}>
      <Fragment slot="actions"><HeaderActions /></Fragment>
    </SiteHeader>

    <main>
    <!-- ── Héroe: galería de tiendas ─────────────────────────────────────── -->
    <section class="mx-auto max-w-6xl px-5 pt-14 sm:pt-20">
      <p class="mb-5 inline-block rounded-full border border-border bg-muted px-4 py-1.5 text-xs font-medium text-muted-foreground">
        Un servicio de Logic2B · Hecho en Castellón
      </p>
      <h1 class="hero-title max-w-4xl font-display text-4xl leading-[1.05] sm:text-6xl md:text-7xl">
        Tu tienda online a medida.<br />
        <span class="text-brand">10 productos o un millón.</span>
      </h1>
      <p class="hero-fade mt-6 max-w-2xl text-base leading-relaxed text-muted-foreground sm:text-lg" style="--d:.12s">
        Nunca había sido tan fácil —ni tan asequible— un ecommerce a medida:
        arrancas con un MVP sencillo y funcional, y tu tienda crece sin cambiar
        de plataforma. Abajo tienes las
        <strong class="text-foreground">demos navegables</strong>: recorre el
        catálogo, el carrito y el panel del comercio.
      </p>
      <div class="hero-fade mt-8 flex flex-col gap-3 sm:flex-row sm:gap-4" style="--d:.24s">
        <a
          href="/#contacto"
          data-open-project
          class="rounded-btn bg-brand px-8 py-3.5 text-center text-base font-semibold text-brand-fg shadow-lg shadow-brand/20 transition hover:bg-brand-dark"
        >Iniciar proyecto</a>
        <a
          href={`${MAIN_DEMO_HREF}?tour=1`}
          class="rounded-btn border border-border px-8 py-3.5 text-center text-base font-semibold text-foreground transition hover:border-foreground"
        >Haz la demo en 3 minutos</a>
      </div>
    </section>

    <!-- Tira de tiendas: scroll horizontal nativo con snap, accesible. -->
    <section aria-labelledby="galeria-h" class="mt-10 sm:mt-14">
      <h2 id="galeria-h" class="sr-only">Tiendas de demostración hechas con Logic2B Ecommerce</h2>
      <ul
        class="flex snap-x snap-mandatory gap-5 overflow-x-auto px-5 pb-4 [scrollbar-color:var(--color-brand)_transparent] [scrollbar-width:thin] sm:gap-6"
      >
        {gallery.map((store) => (
          <li class="relative shrink-0 snap-start">
            <a href={store.href} style={`--accent:${store.accent}`} class="group block w-[280px] sm:w-[360px]">
              <div class="overflow-hidden rounded-2xl border border-border bg-card shadow-sm transition duration-300 group-hover:-translate-y-1 group-hover:shadow-xl group-hover:[border-color:var(--accent)]">
                <!-- Chrome de navegador: da contexto de «tienda real». -->
                <div class="flex items-center gap-2 border-b border-border px-4 py-2.5">
                  <span class="h-2.5 w-2.5 rounded-full" style="background:var(--accent)"></span>
                  <span class="h-2.5 w-2.5 rounded-full bg-border"></span>
                  <span class="h-2.5 w-2.5 rounded-full bg-border"></span>
                  <span class="ml-2 truncate font-accent text-xs text-muted-foreground">ecom.logic2b.com{store.href}</span>
                </div>
                <div class="aspect-[4/5] overflow-hidden bg-muted">
                  {/* Iris se sirve como IMAGEN (el póster, lazy) y el script la
                      asciende a <video> con autoplay-on-scroll. Sin JS, con
                      reduced-motion o con ahorro de datos queda la imagen: más
                      ligera que un <video poster> (el póster no es lazy) y con
                      alt real. El clip solo baja cuando la tarjeta se ve.
                      Las tarjetas van `eager` pero en prioridad BAJA. Sin
                      `eager`, al ser un carrusel horizontal quedan fuera de
                      pantalla por el lado y el navegador las bajaba tarde y a
                      trompicones — medido, una llegaba a los 19 s y hundía el
                      Speed Index móvil. Y sin `fetchpriority="low"` compiten
                      con la fuente del H1, que es el LCP: escritorio 100 → 99. */}
                  <img
                    src={store.video ? store.poster : store.img}
                    srcset={`${store.video ? store.poster : store.img} 560w, ${store.video ? store.poster900 : store.img900} 900w`}
                    sizes="(min-width: 640px) 360px, 280px"
                    alt={`Tienda ${store.name} — tema ${store.style}`}
                    width={store.video ? 1280 : 720}
                    height={store.video ? 720 : 900}
                    loading="eager"
                    fetchpriority="low"
                    class="h-full w-full object-cover object-top"
                    data-video-src={store.video ?? undefined}
                    data-video-poster={store.video ? store.poster : undefined}
                  />
                </div>
              </div>
              <div class="mt-3 flex items-baseline gap-2 px-1">
                <span class="h-2.5 w-2.5 shrink-0 rounded-full" style="background:var(--accent)"></span>
                <p class="font-semibold">{store.name}</p>
                <span class="font-accent text-xs uppercase tracking-wide text-muted-foreground">{store.style}</span>
              </div>
              <p class="mt-1 px-1 text-sm text-muted-foreground">
                {store.tagline}
                <span class="text-foreground transition group-hover:[color:var(--accent)]"> →</span>
              </p>
            </a>
            {store.video && (
              // Pausa del clip (WCAG 2.2.2). Vive FUERA del enlace (interactivos
              // no se anidan) y nace oculto: el script lo activa solo si asciende
              // la imagen a vídeo (con reduced-motion o ahorro de datos no hay
              // ni vídeo ni botón).
              <button
                type="button"
                hidden
                data-video-toggle
                aria-pressed="false"
                aria-label="Pausar la animación"
                class="absolute right-3 top-14 z-10 flex h-8 w-8 items-center justify-center rounded-full bg-black/60 text-white transition hover:bg-black/80"
              >
                <svg data-glyph-pause viewBox="0 0 16 16" width="14" height="14" fill="currentColor" aria-hidden="true"><rect x="3" y="2" width="4" height="12" rx="1" /><rect x="9" y="2" width="4" height="12" rx="1" /></svg>
                {/* hidden va como CLASE: el atributo hidden es HTML y en SVG no es fiable. */}
                <svg data-glyph-play class="hidden" viewBox="0 0 16 16" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M4.5 2.5v11a.7.7 0 0 0 1.07.6l8.6-5.5a.7.7 0 0 0 0-1.2l-8.6-5.5a.7.7 0 0 0-1.07.6z" /></svg>
              </button>
            )}
          </li>
        ))}
      </ul>
      <p class="mx-auto max-w-6xl px-5 pt-1 text-sm text-muted-foreground">
        Cada tienda parte de un tema distinto y el motor es el mismo.
        <a href="/temas" class="font-medium text-brand underline underline-offset-2 hover:text-brand-dark">Mira los {themeCount} temas y elige el punto de partida del tuyo →</a>
      </p>
    </section>

    <!-- ── Tecnología e integraciones ────────────────────────────────────── -->
    <LogoMarquee />

    <!-- ── El flujo del pedido, con capturas reales ──────────────────────── -->
    <section class="border-y border-border bg-muted">
      <div class="mx-auto max-w-6xl px-5 py-14 sm:py-20">
        <h2 class="max-w-2xl font-display text-3xl sm:text-4xl">Así funciona un pedido, de principio a fin</h2>
        <p class="mt-3 max-w-2xl text-muted-foreground">
          No es un vídeo ni un mockup: son capturas del sistema real. Esto es lo
          que verás tú y lo que verá tu cliente.
        </p>
        <div class="mt-10 grid gap-5 sm:grid-cols-2">
          {flow.map((step) => (
            <div class="rise overflow-hidden rounded-2xl border border-border bg-card shadow-sm">
              <figure class="aspect-[16/10] overflow-hidden border-b border-border bg-muted">
                <img src={step.img} alt={step.alt} width="1440" height="900" loading="lazy" class="h-full w-full object-cover object-top" />
              </figure>
              <div class="p-5 sm:p-6">
                <p class="font-accent text-sm text-brand">{step.n}</p>
                <h3 class="mt-1 font-display text-xl">{step.title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{step.body}</p>
              </div>
            </div>
          ))}
        </div>
        {/* El panel salió del menú: este es su sitio, justo donde se acaba de
            explicar para qué sirve. */}
        <div class="mt-8 flex flex-col items-center gap-3 text-center sm:flex-row sm:justify-between sm:text-left">
          <p class="text-muted-foreground">
            Los pasos 02, 03 y 04 pasan en tu panel. Ábrelo y trastéalo: es la
            demo real, sin registro.
          </p>
          <a
            href={DEMO_ADMIN_HREF}
            class="shrink-0 rounded-btn bg-foreground px-7 py-3 text-sm font-semibold text-background transition hover:bg-foreground/90"
          >Entrar en el panel de la demo →</a>
        </div>
      </div>
    </section>

    <!-- ── Comparativa + Cuándo NO ───────────────────────────────────────── -->
    <section class="mx-auto max-w-6xl px-5 py-14 sm:py-20">
      <h2 class="font-display text-3xl sm:text-4xl">Las cuentas claras</h2>
      <p class="mt-3 max-w-2xl text-muted-foreground">
        La pregunta no es «¿cuánto pago?», es <strong class="text-foreground">«¿qué
        me llevo y quién responde?»</strong>. Esto es lo que cambia frente a
        montar la tienda en una plataforma de alquiler.
      </p>
      <div class="mt-8 overflow-x-auto rounded-2xl border border-border bg-card shadow-sm">
        <table class="w-full min-w-[640px] text-left text-sm">
          <thead>
            <tr class="border-b border-border text-muted-foreground">
              <th scope="col" class="px-5 py-4 font-normal"><span class="sr-only">Concepto</span></th>
              <th scope="col" class="px-5 py-4 font-normal">Shopify</th>
              <th scope="col" class="px-5 py-4 font-normal">WooCommerce</th>
              <th scope="col" class="px-5 py-4 font-semibold text-brand">Logic2B Ecommerce</th>
            </tr>
          </thead>
          <tbody>
            {comparison.map((row) => (
              <tr class="border-b border-border last:border-0">
                <th scope="row" class="px-5 py-4 text-left font-medium">{row.concept}</th>
                <td class="px-5 py-4 text-muted-foreground">{row.shopify}</td>
                <td class="px-5 py-4 text-muted-foreground">{row.woo}</td>
                <td class="px-5 py-4 font-semibold text-brand-dark">{row.kit}</td>
