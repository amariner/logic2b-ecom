      padding-right: clamp(24px, 4vw, 32px) !important;
      padding-left: clamp(24px, 4vw, 32px) !important;
    }
  }
</style>

<script>
  // Script de la landing (decisión D1: vanilla, sin dependencias, ≤15 KB).
  // Una sola pieza: el autoplay del vídeo de Iris. El formulario lo gobierna
  // ProjectDialog.astro y la franja de logos es CSS puro.
  const emailGate = document.querySelector<HTMLFormElement>('[data-email-gate]');
  const emailInput = emailGate?.querySelector<HTMLInputElement>('input[name=email]');
  const emailTrigger = document.querySelector<HTMLElement>('[data-email-trigger]');
  emailGate?.addEventListener('submit', (event) => {
    event.preventDefault();
    if (!emailInput?.reportValidity()) return;
    emailTrigger?.setAttribute('data-prefill-email', emailInput.value.trim());
    emailTrigger?.click();
  });

  const flowTabs = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-flow-tab]'));
  const flowPanels = Array.from(document.querySelectorAll<HTMLElement>('[data-flow-panel]'));
  const activateFlowStep = (step: string) => {
    for (const tab of flowTabs) {
      const active = tab.dataset.flowTab === step;
      tab.classList.toggle('is-active', active);
      if (active) tab.setAttribute('aria-current', 'step');
      else tab.removeAttribute('aria-current');
    }
  };
  for (const tab of flowTabs) {
    tab.addEventListener('click', () => activateFlowStep(tab.dataset.flowTab ?? '01'));
  }
  if ('IntersectionObserver' in window) {
    const flowObserver = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
        const step = (visible?.target as HTMLElement | undefined)?.dataset.flowPanel;
        if (step) activateFlowStep(step);
      },
      { rootMargin: '-18% 0px -58% 0px', threshold: [0.05, 0.2, 0.45] },
    );
    for (const panel of flowPanels) flowObserver.observe(panel);
  }

  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Iris: la tarjeta se sirve como imagen (póster) y aquí se asciende a
  // <video preload="none"> que reproduce solo mientras se ve. Nunca con
  // reduced-motion ni con ahorro de datos: esos visitantes se quedan la imagen.
  // El clip no baja ni un byte hasta que la tarjeta es visible. WCAG 2.2.2:
  // todo lo que se mueve >5 s necesita pausa — el botón está en el template
  // (oculto, fuera del enlace) y aquí solo se activa cuando el vídeo existe.
  // Una pausa del visitante manda sobre el observer.
  const saveData =
    (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData === true;
  if (!reduced && !saveData) {
    for (const img of document.querySelectorAll<HTMLImageElement>('img[data-video-src]')) {
      const video = document.createElement('video');
      video.className = img.className;
      video.poster = img.dataset.videoPoster ?? '';
      video.width = img.width;
      video.height = img.height;
      video.muted = true;
      video.loop = true;
      video.playsInline = true;
      video.preload = 'none';
      video.setAttribute('aria-label', img.alt);
      const source = document.createElement('source');
      source.src = img.dataset.videoSrc ?? '';
      source.type = 'video/mp4';
      video.appendChild(source);
      img.replaceWith(video);

      let userPaused = false;
      const toggle = video.closest('li')?.querySelector<HTMLButtonElement>('[data-video-toggle]');
      if (toggle) {
        const glyphPause = toggle.querySelector<SVGElement>('[data-glyph-pause]');
        const glyphPlay = toggle.querySelector<SVGElement>('[data-glyph-play]');
        toggle.addEventListener('click', () => {
          userPaused = !userPaused;
          if (userPaused) video.pause();
          else video.play().catch(() => {});
          glyphPause?.classList.toggle('hidden', userPaused);
          glyphPlay?.classList.toggle('hidden', !userPaused);
          toggle.setAttribute('aria-label', userPaused ? 'Reproducir la animación' : 'Pausar la animación');
          toggle.setAttribute('aria-pressed', String(userPaused));
        });
        toggle.hidden = false;
      }

      new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            const v = entry.target as HTMLVideoElement;
            if (entry.isIntersecting && !userPaused) v.play().catch(() => {});
            else v.pause();
          }
        },
        { threshold: 0.4 },
      ).observe(video);
    }
  }
</script>
