---
import Landing from '../layouts/Landing.astro';
import CommercialPlans from '../components/CommercialPlans.astro';
import ProjectForm from '../components/ProjectForm.astro';
import Icon, { type IconName } from '../components/Icon.astro';
import PlatformMarquee from '../components/home/PlatformMarquee.astro';
import JourneyBento from '../components/home/JourneyBento.astro';
import EngineBlueprint from '../components/home/EngineBlueprint.astro';
import PanelInspector from '../components/home/PanelInspector.astro';
import { collections, storePaths } from '../collections';
import { getTheme } from '../lib/demo-themes';
import { MAIN_DEMO_HREF, DEMO_ADMIN_HREF } from '../lib/nav';
import { plans, planOffers, euro } from '../commercial/plans';
import '../styles/home.css';
const galleryOrder = [
  'zancada',
  // new-theme:gallery — no borrar: `pnpm new:theme <id>` añade aquí la tienda.
  'arce', 'nera', 'forma', 'lumbre', 'traza', 'bruma', 'brio', 'argent',
  'arista', 'eje', 'ensamble', 'sarga', 'monte', 'mixta', 'dintel', 'alva', 'orbe',
  'viso', 'litica', 'summit', 'sillage', 'stretch', 'sitega', 'noddo', 'demo',
  'launch', 'editorial', 'iris', 'street', 'industrial', 'natural', 'specs', 'minimal', 'guide',
];
const gallery = galleryOrder.map((id) => {
  const col = collections.find((c) => c.id === id)!;
  const theme = getTheme(col.themeId)!;
  return { id, name: col.name, tagline: col.tagline, style: theme.label, accent: theme.vars['--color-brand'], href: `/temas/${id}`, demo: storePaths(id).catalog, img: `/images/screens/store-${id}-catalog-560.webp`, img900: `/images/screens/store-${id}-catalog-900.webp` };
});
// Vídeos de previsualización que ya existen en /public (los mismos de /temas):
// la tarjeta los carga solo cuando alguien pasa el ratón o el foco por encima.
const previewVideos = new Set(
  Object.keys(import.meta.glob('../../public/images/screens/theme-*-preview.mp4')).map((path) => path.match(/theme-(.+)-preview\.mp4$/)?.[1]),
);
const featured = gallery.slice(0, 4).map((store) => ({ ...store, preview: previewVideos.has(store.id) ? `/images/screens/theme-${store.id}-preview.mp4` : null }));
const moreStores = gallery.length - featured.length;
/** Precio de entrada real (el pack más bajo): ancla el héroe sin inventar cifras. */
const entryPrice = euro(Math.min(...plans.map((plan) => plan.setup)));

const proof = [
  { value: String(gallery.length), label: 'tiendas demo navegables' },
  { value: '1', label: 'panel para pedidos, productos y envíos' },
  { value: '0', label: 'datos de tarjeta en nuestros servidores' },
];
/* Ilustración del héroe: pedidos ficticios de la tienda demo ARCE (sus
   productos y precios reales de catálogo) y el rastro que deja uno de ellos. */
const heroOrders = [
  { n: 'AR-1042', who: 'Lucía Ferrer', item: 'Butaca Alba', total: '680,00 €', state: 'Pagado', tone: 'is-paid' },
  { n: 'AR-1041', who: 'Marc Soler', item: 'Mesa Horizonte', total: '1.240,00 €', state: 'Enviado', tone: 'is-shipped' },
  { n: 'AR-1040', who: 'Nuria Pla', item: 'Lámpara Vela ×2', total: '624,00 €', state: 'Preparando', tone: 'is-pending' },
];
const heroEvents = [
  { t: '10:42:07', label: 'Pago confirmado', meta: 'AR-1042 · 680,00 €' },
  { t: '10:42:07', label: 'Stock actualizado', meta: 'Butaca Alba · 8 → 7' },
  { t: '10:42:08', label: 'Email al cliente', meta: 'Confirmación del pedido' },
  { t: '11:05:31', label: 'Listo para enviar', meta: 'Exportado a Packlink' },
];

/* Comparativa por modelo de responsabilidad, no por marca: quién diseña,
   quién mantiene y quién responde. Sin cifras de terceros que caduquen. */
const compareCols = ['Plataforma de suscripción', 'Web con plugins', 'Logic2B Ecommerce'];
const compareRows: { label: string; cells: [string, string, string] }[] = [
  { label: 'Diseño', cells: ['Tema adaptado', 'Tema y constructor visual', 'A medida de tu marca'] },
  { label: 'Puesta en marcha', cells: ['Por tu cuenta', 'Por tu cuenta', 'Contigo, de principio a fin'] },
  { label: 'Mantenimiento', cells: ['La plataforma y cada app', 'Plugins y actualizaciones, a tu cargo', 'Incluido'] },
  { label: 'Nuevas funciones', cells: ['Apps, a menudo con cuota', 'Plugins de varios proveedores', 'Módulos del mismo motor'] },
  { label: 'Gestión diaria', cells: ['Panel completo y genérico', 'Escritorio de WordPress', 'Panel con lo que usas'] },
  { label: 'Quién responde', cells: ['Soporte general', 'Cada proveedor por separado', 'Quien construyó tu tienda'] },
];

const moments: { label: string; icon: IconName; title: string; points: string[]; img: string; href: string; link: string; crop: boolean; url: string }[] = [
  { label: 'Tienda', icon: 'store', title: 'Una tienda que invita a quedarse.', points: ['Categorías con sentido para tu catálogo', 'Fotografía y contenido con una misma identidad', 'Fichas que responden antes de añadir al carrito'], img: '/images/screens/store-arce-catalog-900.webp', href: MAIN_DEMO_HREF, link: 'Explorar la tienda', crop: true, url: 'arce / catálogo' },
  { label: 'Compra', icon: 'cart', title: 'De encontrarlo a tenerlo en el carrito.', points: ['Carrito fácil de revisar', 'Compra como invitado', 'Costes de envío antes de confirmar'], img: '/images/screens/store-demo-cart.webp', href: '/demo/carrito', link: 'Ver el carrito', crop: false, url: 'tienda / carrito' },
  { label: 'Pedidos', icon: 'clipboard', title: 'Cada pedido, completo en una pantalla.', points: ['Productos, pago y entrega reunidos', 'Incidencias y notas del equipo', 'Historial de cada cambio'], img: '/images/screens/panel-order-detail.webp', href: DEMO_ADMIN_HREF ?? '/arquitectura', link: 'Probar el gestor', crop: false, url: 'panel / pedido' },
  { label: 'Envíos', icon: 'truck', title: 'Prepara, envía y sigue el pedido.', points: ['Tarifas por zona y tramo', 'Exportación para preparar etiquetas', 'Transportista y seguimiento junto al pedido'], img: '/images/screens/panel-shipping.webp', href: '/demo/admin/envios', link: 'Ver los envíos', crop: false, url: 'panel / envíos' },
  { label: 'Comunicación', icon: 'mail', title: 'Cada mensaje, cuando toca.', points: ['Confirmación de compra', 'Aviso de envío con seguimiento', 'Bandeja de ejemplo sin enviar emails reales'], img: '/images/screens/panel-emails.webp', href: '/demo/admin/emails', link: 'Ver los emails', crop: false, url: 'panel / emails' },
];
const panelViews: { key: string; icon: IconName; name: string; body: string; href: string }[] = [
  { key: 'orders', icon: 'clipboard', name: 'Pedidos', body: 'Estado, importe y siguiente paso.', href: DEMO_ADMIN_HREF ?? '/arquitectura' },
  { key: 'products', icon: 'tag', name: 'Productos', body: 'Tu catálogo, precios y existencias.', href: '/demo/admin/productos' },
  { key: 'emails', icon: 'mail', name: 'Comunicaciones', body: 'Cada mensaje junto a su pedido.', href: '/demo/admin/emails' },
];
/* Lo que el diagrama no dibuja: dónde vive y cómo crece. Reglas del
   repositorio (CLAUDE.md §2), no eslóganes. */
const engineNotes: { icon: IconName; title: string; body: string }[] = [
  { icon: 'route', title: 'Servida desde el edge', body: 'Páginas estáticas en la red de Cloudflare; el servidor despierta solo para carrito, pago y panel.' },
  { icon: 'box', title: 'Un despliegue por cliente', body: 'Tu tienda, tu base de datos y tus claves. Nada se comparte con otras tiendas.' },
  { icon: 'plug', title: 'Crece sin migrar', body: 'Cupones, packs o listas de precios se activan como módulos del mismo motor.' },
];
const steps = [
  { title: 'Entendemos tu operación', body: 'Qué vendes y cómo preparas los pedidos.' },
  { title: 'Acordamos diseño y alcance', body: 'Dirección visual, catálogo y conexiones.' },
  { title: 'Probamos y publicamos', body: 'Revisamos contigo la compra completa.' },
];
const nextSteps = [
  { title: 'Te respondemos en 24 h laborables', body: 'Una persona del equipo lee tu mensaje y te escribe.' },
  { title: 'Revisamos tu caso contigo', body: 'Catálogo, operación y lo que necesitas mejorar.' },
  { title: 'Recibes una propuesta clara', body: 'Alcance, plazos e inversión, por escrito.' },
];
const guides: { href: string; icon: IconName; title: string; body: string }[] = [
  { href: '/ayuda', icon: 'store', title: 'Para el comercio', body: 'Cómo gestionar pedidos y productos' },
  { href: '/dossier', icon: 'clipboard', title: 'Para quien decide', body: 'La propuesta completa de Logic2B' },
  { href: '/arquitectura', icon: 'plug', title: 'Para tu equipo técnico', body: 'Cómo funciona la infraestructura' },
  { href: '/agencias', icon: 'user', title: 'Para agencias', body: 'Un equipo de ecommerce en marca blanca' },
];
const faqs = [
  { q: '¿Qué estoy contratando?', a: 'Un proyecto de ecommerce adaptado a tu negocio y un servicio de mantenimiento. Logic2B construye sobre su infraestructura tecnológica propia; no es una suscripción a un SaaS ni una plantilla cerrada.' },
  { q: '¿Qué incluye el precio?', a: 'Cada pack indica su inversión inicial y, cuando corresponde, el mantenimiento mensual. El presupuesto concreta productos, contenidos y funciones. Los precios son sin IVA; publicidad, tarifas de pago e integraciones externas se detallan aparte.' },
  { q: '¿Puedo conservar mi dominio y mis productos?', a: 'Sí. Revisamos el dominio, el catálogo y los datos que ya tienes para acordar qué se migra y cómo se comprueba antes del lanzamiento.' },
  { q: '¿Es difícil gestionar la tienda?', a: 'El panel se adapta a las tareas del comercio: productos, pedidos y envíos. Puedes recorrer la demo y consultar la guía antes de decidir.' },
  { q: '¿Cómo funcionan los pagos?', a: 'El pago se realiza en una pasarela externa. Los datos de tarjeta no pasan por nuestros servidores. Las demos son simulaciones y no realizan cobros.' },
  { q: '¿Y si necesito más adelante otras funciones?', a: 'Revisamos la necesidad y acordamos su alcance. El motor común permite ampliar el proyecto con módulos, conexiones o desarrollo específico sin empezar de cero.' },
];
const jsonLd = [{ '@context': 'https://schema.org', '@type': 'Service', name: 'Logic2B Ecommerce', description: 'Diseño y desarrollo de tiendas online a medida, con panel sencillo y mantenimiento técnico de Logic2B.', provider: { '@type': 'Organization', name: 'Logic2B', url: 'https://logic2b.com' }, areaServed: 'ES', offers: planOffers }, { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(faq => ({ '@type': 'Question', name: faq.q, acceptedAnswer: { '@type': 'Answer', text: faq.a } })) }];
---
<Landing title="Logic2B Ecommerce — tiendas online a medida con tecnología propia" description="Diseñamos tu tienda online a medida y la montamos sobre un motor ecommerce probado: catálogo, pagos, pedidos y envíos resueltos, un panel sencillo y mantenimiento incluido." canonicalPath="/" jsonLd={jsonLd}>
<main class="commerce-home">
  <!-- ── Héroe ────────────────────────────────────────────────────────── -->
  <section class="hx" aria-labelledby="hero-title">
    <div class="page-shell hx-grid">
      <div class="hx-copy">
        <a class="hx-badge" href="/arquitectura"><span>Infraestructura propia</span>Cómo funciona por dentro <b aria-hidden="true">→</b></a>
        <h1 id="hero-title">Tiendas online a medida, sobre tecnología probada.</h1>
        <p class="hx-lead">Diseñamos tu tienda con tu marca y la montamos sobre nuestro motor ecommerce: catálogo, pagos, pedidos y envíos resueltos desde el primer día. Tú gestionas desde un panel sencillo; nosotros mantenemos la tecnología.</p>
        <div class="hx-actions">
          <a class="btn btn-primary" href="#contacto" data-open-project>Solicitar propuesta <span class="btn-arrow" aria-hidden="true">→</span></a>
          <a class="btn btn-ghost" href={`${MAIN_DEMO_HREF}?tour=1`}>Ver una tienda demo</a>
        </div>
        <p class="hx-meta"><span>Desde {entryPrice} € sin IVA</span><span>Respuesta en 24 h laborables</span></p>
      </div>
      <figure class="hx-visual" aria-labelledby="hero-visual-caption">
        <div class="frame hx-store">
          <div class="frame-bar" aria-hidden="true"><i></i><i></i><i></i><span>arce.tienda / catálogo</span></div>
          <img src="/images/screens/store-arce-catalog-900.webp" srcset="/images/screens/store-arce-catalog-560.webp 560w, /images/screens/store-arce-catalog-900.webp 900w" sizes="(min-width: 1100px) 640px, 100vw" alt="" width="900" height="1875" fetchpriority="high" decoding="async" />
        </div>
        <div class="hx-orders" aria-hidden="true">
          <div class="hx-card-head"><span><Icon name="clipboard" size={15} />Pedidos</span><small>Hoy · 3 nuevos</small></div>
          <ul>{heroOrders.map((order) => <li><span class="hx-order-id">{order.n}</span><span class="hx-order-who"><b>{order.who}</b><small>{order.item}</small></span><span class="hx-order-total">{order.total}</span><span class:list={['ui-pill', order.tone]}>{order.state}</span></li>)}</ul>
        </div>
        <div class="hx-log" aria-hidden="true">
          <div class="hx-log-head"><span class="hx-live"></span>Pedido AR-1042</div>
          <ol>{heroEvents.map((event) => <li><time>{event.t}</time><span><b>{event.label}</b><small>{event.meta}</small></span></li>)}</ol>
        </div>
        <figcaption id="hero-visual-caption" class="sr-only">Tienda demo ARCE con su panel de pedidos: un pago confirmado actualiza el stock, avisa al cliente y deja el pedido listo para enviar. Datos ficticios.</figcaption>
      </figure>
    </div>
    <div class="page-shell">
      <ul class="hx-proof">{proof.map((item) => <li><strong>{item.value}</strong><span>{item.label}</span></li>)}</ul>
    </div>
  </section>

  <!-- ── Plataformas ─────────────────────────────────────────────────── -->
  <PlatformMarquee />

  <!-- ── Qué incluye ──────────────────────────────────────────────────── -->
  <section id="flujo" class="sx page-shell">
    <header class="sx-head is-split reveal">
      <div><p class="eyebrow"><span>01</span>Qué incluye</p><h2>Todo el ciclo de venta, en un solo sistema.</h2></div>
      <p>De la primera visita al último paquete, en tres fases.</p>
    </header>
    <JourneyBento />
  </section>

  <!-- ── Por qué ──────────────────────────────────────────────────────── -->
  <section id="por-que" class="sx sx-tint">
    <div class="page-shell">
      <header class="sx-head is-split reveal">
        <div><p class="eyebrow"><span>02</span>Por qué Logic2B Ecommerce</p><h2>La libertad de un proyecto a medida. La solidez de una plataforma.</h2></div>
        <p>La rapidez de una plataforma, sin plantillas ni apps de pago. La libertad de una web a medida, sin quedarte solo con el mantenimiento.</p>
      </header>
      <div class="compare reveal" role="region" aria-label="Comparativa de opciones" tabindex="0">
        <table>
          <caption class="sr-only">Comparativa entre una plataforma de suscripción, una web con plugins y Logic2B Ecommerce</caption>
          <thead><tr><td></td>{compareCols.map((col, i) => <th scope="col" class:list={[i === 2 && 'is-us']}>{i === 2 ? <span>{col}</span> : col}</th>)}</tr></thead>
          <tbody>{compareRows.map((row) => <tr><th scope="row">{row.label}</th>{row.cells.map((cell, i) => <td class:list={[i === 2 && 'is-us']} data-col={compareCols[i]}>{i === 2 && <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true"><path d="m3.5 8.5 3 3 6-6.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>}{cell}</td>)}</tr>)}</tbody>
        </table>
      </div>
      <p class="compare-note reveal"><strong>¿Prefieres montarla y gestionarla tú mismo?</strong> Una plataforma de suscripción puede encajarte mejor. Si no somos tu opción, te lo diremos.</p>
    </div>
  </section>

  <!-- ── Producto ─────────────────────────────────────────────────────── -->
  <section id="plataforma" class="sx page-shell">
    <header class="sx-head is-center reveal"><p class="eyebrow"><span>03</span>El producto</p><h2>Bonita por fuera. Bien resuelta por dentro.</h2><p>Cinco momentos que decide una venta, cada uno con su pantalla real en la demo.</p></header>
    <div class="explorer" data-platform-explorer>
      <div class="seg" aria-label="Recorrido de la tienda"><span class="seg-thumb" aria-hidden="true"></span>{moments.map((moment, i) => <a href={`#moment-${i}`} data-moment-tab={i}><Icon name={moment.icon} size={16} />{moment.label}</a>)}</div>
      {moments.map((moment, i) => <article id={`moment-${i}`} class="moment" data-moment-panel={i}>
        <div class="moment-copy">
          <p class="moment-count">0{i + 1} / 0{moments.length}</p>
          <h3>{moment.title}</h3>
          <ul>{moment.points.map(point => <li><span aria-hidden="true"><svg viewBox="0 0 16 16" width="14" height="14"><path d="m3.5 8.5 3 3 6-6.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg></span>{point}</li>)}</ul>
          <a class="btn btn-soft" href={moment.href}>{moment.link} <span class="btn-arrow" aria-hidden="true">→</span></a>
        </div>
        <figure class:list={['frame', 'moment-frame', moment.crop && 'is-crop']}>
          <div class="frame-bar" aria-hidden="true"><i></i><i></i><i></i><span>{moment.url}</span></div>
          <img src={moment.img} alt={`Vista de demostración: ${moment.label}`} width="1200" height="800" loading="lazy" decoding="async" />
          <figcaption>Demo navegable · datos simulados</figcaption>
        </figure>
      </article>)}
    </div>
  </section>

  <!-- ── Tiendas ──────────────────────────────────────────────────────── -->
  <section id="demos" class="sx sx-tint">
    <div class="page-shell">
      <header class="sx-head is-split reveal">
        <div><p class="eyebrow"><span>04</span>Direcciones visuales</p><h2>Tu marca merece su propia tienda.</h2></div>
        <div><p>{gallery.length} identidades distintas sobre el mismo motor. Cada una tiene su ficha con la tienda en vivo: entra, añade al carrito y llega hasta el pago simulado.</p><a class="text-link" href="/temas">Ver todos los diseños →</a></div>
      </header>
      <div class="bento">
        {featured.map((store, i) => <a class:list={['store-card', 'reveal', i === 0 && 'is-hero']} href={store.href} style={`--accent:${store.accent}`} data-hover-video={store.preview ?? undefined}>
          <span class="store-media">
            <img src={i === 0 ? store.img900 : store.img} srcset={`${store.img} 560w, ${store.img900} 900w`} sizes={i === 0 ? '(min-width: 900px) 50vw, 100vw' : '(min-width: 900px) 25vw, 50vw'} alt={`Escaparate de ${store.name}, tema ${store.style}`} width="900" height="700" loading="lazy" decoding="async" />
          </span>
          <span class="store-info"><span><strong>{store.name}</strong><small><i aria-hidden="true"></i>{store.tagline}</small></span><b aria-hidden="true">→</b></span>
        </a>)}
        <a class="store-more reveal" href="/temas"><span class="store-more-n">+{moreStores}</span><span>direcciones visuales más, cada una sobre el mismo motor</span><b>Ver todos los diseños <span aria-hidden="true">→</span></b></a>
      </div>
      <div class="inline-cta reveal">
        <p><strong>¿Te imaginas la tuya?</strong> Cuéntanos qué vendes y te proponemos una dirección visual para tu marca.</p>
        <a class="btn btn-primary" href="#contacto" data-open-project>Solicitar propuesta <span class="btn-arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <!-- ── Panel ────────────────────────────────────────────────────────── -->
  <section id="paneles" class="sx page-shell panels">
    <header class="sx-head is-split reveal">
      <div><p class="eyebrow"><span>05</span>El gestor</p><h2>Un panel que se aprende en cinco minutos.</h2></div>
      <div><p>Las vistas que necesita el comercio y nada más. Lo complejo queda de nuestro lado.</p><a class="text-link" href={DEMO_ADMIN_HREF ?? '/arquitectura'}>Entrar al panel de demostración →</a></div>
    </header>
    <PanelInspector />
    <ul class="panel-links">{panelViews.map((view) => <li><a href={view.href}><span class="panel-ico" aria-hidden="true"><Icon name={view.icon} size={18} /></span><span><strong>{view.name}</strong><small>{view.body}</small></span><b aria-hidden="true">→</b></a></li>)}</ul>
  </section>

  <!-- ── El motor por dentro ─────────────────────────────────────────── -->
  <section id="tecnologia" class="sx tech">
    <div class="page-shell">
      <header class="sx-head is-split reveal">
        <div><p class="eyebrow"><span>06</span>El motor por dentro</p><h2>Así viaja un pedido por el motor.</h2></div>
        <div><p>Seis pasos, cinco piezas y ninguna tarjeta en tu web. Lo que ocurre cada vez que alguien compra, de la cesta al email de confirmación.</p><a class="text-link" href="/arquitectura">Ver la arquitectura completa →</a></div>
      </header>
      <EngineBlueprint />
      <ul class="engine-notes">{engineNotes.map((note) => <li class="reveal"><span class="g-ico" aria-hidden="true"><Icon name={note.icon} size={18} /></span><div><h3>{note.title}</h3><p>{note.body}</p></div></li>)}</ul>
    </div>
  </section>

  <!-- ── Método ───────────────────────────────────────────────────────── -->
  <section class="sx page-shell craft">
    <figure class="craft-media reveal">
      <img src="/images/commercial/order-preparation.webp" alt="Preparación de un pedido con embalaje de papel y productos de un pequeño comercio" width="1536" height="1024" loading="lazy" decoding="async" />
      <span class="craft-chip" aria-hidden="true"><span class="ui-ico"><Icon name="box" size={16} /></span><span><b>Pedido preparado</b><small>Listo para etiquetar y enviar</small></span></span>
    </figure>
    <div class="craft-copy">
      <header class="sx-head reveal"><p class="eyebrow"><span>07</span>Cómo trabajamos</p><h2>Te acompañamos hasta ponerlo en marcha.</h2></header>
      <ol class="craft-steps">{steps.map((step, i) => <li><span aria-hidden="true">0{i + 1}</span><div><strong>{step.title}</strong><p>{step.body}</p></div></li>)}</ol>
      <small class="craft-note">El calendario depende del alcance y del estado de los contenidos.</small>
    </div>
  </section>

  <!-- ── Precios ──────────────────────────────────────────────────────── -->
  <section id="precios" class="sx sx-tint pricing">
    <div class="page-shell">
      <header class="sx-head is-center reveal"><p class="eyebrow"><span>08</span>Precios</p><h2>Empieza con lo que necesitas. Crece sobre la misma base.</h2><p>Una inversión inicial para construir tu tienda y un mantenimiento claro para cuidarla.</p></header>
      <CommercialPlans />
      <a class="section-more" href="/precios">Ver los packs y sus condiciones →</a>
    </div>
  </section>

  <!-- ── FAQ ──────────────────────────────────────────────────────────── -->
  <section class="sx page-shell faq">
    <div class="faq-aside">
      <header class="sx-head reveal"><p class="eyebrow"><span>09</span>Preguntas frecuentes</p><h2>Hablemos claro.</h2></header>
