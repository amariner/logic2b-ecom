</Landing>
<script>
const explorer = document.querySelector<HTMLElement>('[data-platform-explorer]');
if (explorer) {
  const tabs = Array.from(explorer.querySelectorAll<HTMLAnchorElement>('[data-moment-tab]'));
  const panels = Array.from(explorer.querySelectorAll<HTMLElement>('[data-moment-panel]'));
  const tablist = tabs[0]?.parentElement;
  tablist?.setAttribute('role', 'tablist');
  explorer.classList.add('is-enhanced');
  const activate = (index: number, focus = false) => {
    tabs.forEach((tab, i) => { tab.setAttribute('aria-selected', String(i === index)); tab.tabIndex = i === index ? 0 : -1; });
    panels.forEach((panel, i) => { panel.hidden = i !== index; });
    tablist?.style.setProperty('--i', String(index));
    if (focus) tabs[index]?.focus();
  };
  tabs.forEach((tab, i) => {
    tab.id = `moment-tab-${i}`; tab.setAttribute('role', 'tab'); tab.setAttribute('aria-controls', `moment-${i}`);
    panels[i]?.setAttribute('role', 'tabpanel'); panels[i]?.setAttribute('aria-labelledby', tab.id);
    tab.addEventListener('click', event => { event.preventDefault(); activate(i); });
    tab.addEventListener('keydown', event => {
      let index = i;
      if (event.key === 'ArrowRight') index = (i + 1) % tabs.length;
      else if (event.key === 'ArrowLeft') index = (i + tabs.length - 1) % tabs.length;
      else if (event.key === 'Home') index = 0;
      else if (event.key === 'End') index = tabs.length - 1;
      else return;
      event.preventDefault(); activate(index, true);
    });
  });
  activate(0);
}

// Vídeo de previsualización al pasar por encima: el <video> no existe hasta la
// primera interacción, así que la portada no descarga ni un byte de vídeo.
const calm = window.matchMedia('(prefers-reduced-motion: reduce)');
for (const card of document.querySelectorAll<HTMLElement>('[data-hover-video]')) {
  let video: HTMLVideoElement | null = null;
  const play = () => {
    if (calm.matches) return;
    if (!video) {
      video = Object.assign(document.createElement('video'), { src: card.dataset.hoverVideo ?? '', muted: true, loop: true, playsInline: true });
      video.setAttribute('aria-hidden', 'true');
      video.addEventListener('playing', () => card.classList.add('is-playing'));
      card.querySelector<HTMLElement>('.store-media')?.appendChild(video);
    }
    void video.play().catch(() => {});
  };
  const stop = () => { video?.pause(); card.classList.remove('is-playing'); };
  card.addEventListener('pointerenter', (event) => { if (event.pointerType === 'mouse') play(); });
  card.addEventListener('pointerleave', stop);
  card.addEventListener('focus', play);
  card.addEventListener('blur', stop);
}
</script>
