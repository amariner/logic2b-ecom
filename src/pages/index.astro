---
import Landing from '../layouts/Landing.astro';
import ThemeRail from '../components/ThemeRail.astro';
import CommercialPlans from '../components/CommercialPlans.astro';
import ProjectForm from '../components/ProjectForm.astro';
import Icon, { type IconName } from '../components/Icon.astro';
import BrandWall from '../components/BrandWall.astro';
import type { AnyBrandSlug } from '../lib/brands';
import { collections, storePaths } from '../collections';
import { getTheme } from '../lib/demo-themes';
import { MAIN_DEMO_HREF, DEMO_ADMIN_HREF } from '../lib/nav';
import { planOffers } from '../commercial/plans';
import '../styles/home.css';
const galleryOrder = [
  'zancada',
  // new-theme:gallery — no borrar: `pnpm new:theme <id>` añade aquí la tienda.
  'arce', 'nera', 'forma', 'lumbre', 'traza', 'bruma', 'brio', 'argent',
  'arista', 'eje', 'ensamble', 'sarga', 'monte', 'mixta', 'dintel', 'alva', 'orbe',
  'viso', 'litica', 'summit', 'sillage', 'stretch', 'sitega', 'noddo', 'demo',
  'launch', 'editorial', 'iris', 'street', 'industrial', 'natural', 'specs', 'minimal', 'guide',
];
const gallery = galleryOrder.map((id) => {
  const col = collections.find((c) => c.id === id)!;
  const theme = getTheme(col.themeId)!;
  return { id, name: col.name, tagline: col.tagline, style: theme.label, accent: theme.vars['--color-brand'], href: storePaths(id).catalog, img: `/images/screens/store-${id}-catalog-560.webp`, img900: `/images/screens/store-${id}-catalog-900.webp`, video: null, poster: null, poster900: null };
});
// Vídeos de previsualización que ya existen en /public (los mismos de /temas):
// la tarjeta los carga solo cuando alguien pasa el ratón o el foco por encima.
const previewVideos = new Set(
  Object.keys(import.meta.glob('../../public/images/screens/theme-*-preview.mp4')).map((path) => path.match(/theme-(.+)-preview\.mp4$/)?.[1]),
);
const featured = gallery.slice(0, 4).map((store) => ({ ...store, preview: previewVideos.has(store.id) ? `/images/screens/theme-${store.id}-preview.mp4` : null }));
const moreStores = gallery.length - featured.length;

const proof = [
  { value: String(gallery.length), label: 'tiendas de demostración navegables' },
  { value: '1', label: 'panel para pedidos, productos y envíos' },
  { value: '0', label: 'datos de tarjeta en nuestros servidores' },
];
/** Lo que mueve la tienda hoy: pagos, infraestructura, correo, envíos y contacto. */
const stack: AnyBrandSlug[] = ['stripe', 'cloudflare', 'resend', 'packlink', 'sendcloud', 'whatsapp'];
/** Conexiones habituales bajo alcance: se acuerdan por proyecto, no vienen activadas. */
const connectable: AnyBrandSlug[] = [
  'paypal', 'redsys', 'klarna', 'googleanalytics', 'googleads', 'googletagmanager', 'meta', 'instagram', 'tiktok', 'pinterest',
  'brevo', 'klaviyo', 'hubspot', 'zapier', 'make', 'n8n', 'correos', 'ups', 'holded', 'quickbooks', 'xero',
  'amazon', 'ebay', 'etsy', 'shopify', 'woocommerce',
];
const phases = [
  { label: 'Atrae y vende', span: 3 },
  { label: 'Cobra y prepara', span: 2 },
  { label: 'Fideliza y crece', span: 2 },
];
const workflow: { icon: IconName; title: string; body: string; phase?: string }[] = [
  { icon: 'store', title: 'Una web con tu marca', body: 'Tu catálogo, tus imágenes y una forma de comprar que encaja con tu negocio.', phase: 'Atrae y vende' },
  { icon: 'search', title: 'Productos fáciles de encontrar', body: 'Categorías, búsqueda y fichas que ayudan a elegir con confianza.' },
  { icon: 'cart', title: 'Compra sin rodeos', body: 'Un carrito claro y los datos de entrega en el momento adecuado.' },
  { icon: 'card', title: 'Pagos controlados', body: 'Importes y confirmaciones conectados al pedido.', phase: 'Cobra y prepara' },
  { icon: 'clipboard', title: 'Pedidos en orden', body: 'Tu equipo sabe qué preparar, qué enviar y qué revisar.' },
  { icon: 'mail', title: 'Cliente informado', body: 'Confirmación y seguimiento con la información de su compra.', phase: 'Fideliza y crece' },
  { icon: 'growth', title: 'Espacio para crecer', body: 'Añadimos capacidad cuando la operación lo necesita.' },
];
const moments: { label: string; icon: IconName; title: string; body: string; points: string[]; img: string; href: string; link: string; crop: boolean; url: string; note: string }[] = [
  { label: 'Tienda', icon: 'store', title: 'Una tienda que invita a quedarse.', body: 'El diseño presenta tus productos y acompaña la decisión de compra, desde el móvil hasta el escritorio.', points: ['Categorías con sentido para tu catálogo', 'Fotografía y contenido con una misma identidad', 'Fichas que responden antes de añadir al carrito'], img: '/images/screens/store-arce-catalog-900.webp', href: MAIN_DEMO_HREF, link: 'Explorar la tienda', crop: true, url: 'arce · catálogo', note: 'Tu identidad en cada página' },
  { label: 'Compra', icon: 'cart', title: 'De encontrarlo a tenerlo en el carrito.', body: 'Cantidad, precio y entrega visibles. Cada paso pide solo lo que hace falta para continuar.', points: ['Carrito fácil de revisar', 'Compra como invitado', 'Costes de envío antes de confirmar'], img: '/images/screens/store-demo-cart.webp', href: '/demo/carrito', link: 'Ver el carrito', crop: false, url: 'tienda · carrito', note: 'Envío calculado antes de pagar' },
  { label: 'Pedidos', icon: 'clipboard', title: 'Lo que necesita atención, a la vista.', body: 'Una lista de trabajo comprensible para el comercio. Sin menús que no necesitas ni hojas sueltas.', points: ['Pedidos ordenados por estado', 'Productos, dirección y total reunidos', 'Historial de cada pedido'], img: '/images/screens/panel-orders.webp', href: DEMO_ADMIN_HREF ?? '/arquitectura', link: 'Probar el gestor', crop: false, url: 'panel · pedidos', note: 'Filtra por estado en un clic' },
  { label: 'Envíos', icon: 'truck', title: 'Prepara, envía y sigue el pedido.', body: 'La gestión del envío forma parte del mismo recorrido, con tarifas y seguimiento en contexto.', points: ['Tarifas por zona y tramo', 'Exportación para preparar etiquetas', 'Transportista y seguimiento junto al pedido'], img: '/images/screens/panel-shipping.webp', href: '/demo/admin/envios', link: 'Ver los envíos', crop: false, url: 'panel · envíos', note: 'Etiquetas en tu plataforma de envíos' },
  { label: 'Comunicación', icon: 'mail', title: 'Cada mensaje, cuando toca.', body: 'El cliente recibe información útil y el equipo puede revisar lo que se ha comunicado.', points: ['Confirmación de compra', 'Aviso de envío con seguimiento', 'Bandeja de ejemplo sin enviar emails reales'], img: '/images/screens/panel-emails.webp', href: '/demo/admin/emails', link: 'Ver los emails', crop: false, url: 'panel · emails', note: 'Confirmación y aviso de envío' },
];
const panelViews: { key: string; icon: IconName; name: string; body: string; img: string; href: string }[] = [
  { key: 'orders', icon: 'clipboard', name: 'Pedidos', body: 'Estado, importe y siguiente paso.', img: '/images/screens/panel-orders-900.webp', href: DEMO_ADMIN_HREF ?? '/arquitectura' },
  { key: 'products', icon: 'tag', name: 'Productos', body: 'Tu catálogo, precios y existencias.', img: '/images/screens/panel-products.webp', href: '/demo/admin/productos' },
  { key: 'emails', icon: 'mail', name: 'Comunicaciones', body: 'Cada mensaje junto a su pedido.', img: '/images/screens/panel-emails-900.webp', href: '/demo/admin/emails' },
];
const steps = [
  { title: 'Entendemos tu operación', body: 'Qué vendes, cómo preparas los pedidos y qué tienes ya.' },
  { title: 'Acordamos diseño y alcance', body: 'Dirección visual, catálogo, contenidos y conexiones.' },
  { title: 'Probamos y preparamos la entrega', body: 'Revisamos contigo la compra completa antes de publicar.' },
];
const guides: { href: string; icon: IconName; title: string; body: string }[] = [
  { href: '/ayuda', icon: 'store', title: 'Para el comercio', body: 'Cómo gestionar pedidos y productos' },
  { href: '/dossier', icon: 'clipboard', title: 'Para quien decide', body: 'La propuesta completa de Logic2B' },
  { href: '/arquitectura', icon: 'plug', title: 'Para tu equipo técnico', body: 'Cómo funciona la infraestructura' },
  { href: '/agencias', icon: 'user', title: 'Para agencias', body: 'Un equipo de ecommerce en marca blanca' },
];
const faqs = [
  { q: '¿Qué estoy contratando?', a: 'Un proyecto de ecommerce adaptado a tu negocio y un servicio de mantenimiento. Logic2B construye sobre su infraestructura tecnológica propia; no es una suscripción a un SaaS ni una plantilla cerrada.' },
  { q: '¿Qué incluye el precio?', a: 'Cada pack indica su inversión inicial y, cuando corresponde, el mantenimiento mensual. El presupuesto concreta productos, contenidos y funciones. Los precios son sin IVA; publicidad, tarifas de pago e integraciones externas se detallan aparte.' },
  { q: '¿Puedo conservar mi dominio y mis productos?', a: 'Sí. Revisamos el dominio, el catálogo y los datos que ya tienes para acordar qué se migra y cómo se comprueba antes del lanzamiento.' },
  { q: '¿Es difícil gestionar la tienda?', a: 'El panel se adapta a las tareas del comercio: productos, pedidos y envíos. Puedes recorrer la demo y consultar la guía antes de decidir.' },
  { q: '¿Cómo funcionan los pagos?', a: 'El pago se realiza en una pasarela externa. Los datos de tarjeta no pasan por nuestros servidores. Las demos son simulaciones y no realizan cobros.' },
  { q: '¿Y si necesito más adelante otras funciones?', a: 'Revisamos la necesidad y acordamos su alcance. El motor común permite ampliar el proyecto con módulos, conexiones o desarrollo específico sin empezar de cero.' },
];
const jsonLd = [{ '@context': 'https://schema.org', '@type': 'Service', name: 'Logic2B Ecommerce', description: 'Diseño y desarrollo de tiendas online a medida, con panel sencillo y mantenimiento técnico de Logic2B.', provider: { '@type': 'Organization', name: 'Logic2B', url: 'https://logic2b.com' }, areaServed: 'ES', offers: planOffers }, { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(faq => ({ '@type': 'Question', name: faq.q, acceptedAnswer: { '@type': 'Answer', text: faq.a } })) }];
---
<Landing title="Logic2B Ecommerce — tienda online, pedidos y gestión a medida" description="Tu tienda online con tu marca y un panel sencillo. Diseño, catálogo, compra y gestión conectados. Descubre las demos y los packs de Logic2B Ecommerce." canonicalPath="/" jsonLd={jsonLd}>
<main class="commerce-home">
  <!-- ── Hero ─────────────────────────────────────────────────────────── -->
  <section class="hx page-shell" aria-labelledby="hero-title">
    <div class="hx-copy">
      <p class="hx-badge"><span aria-hidden="true"></span>Ecommerce a medida para tu negocio</p>
      <h1 id="hero-title">Tu tienda.<br /><span class="hx-mark">Tu forma</span> de vender.<br />Todo conectado.</h1>
      <p class="hx-lead">Web, compra y gestión en un mismo proyecto. Tú llevas el negocio. Nosotros, la tecnología.</p>
      <div class="hx-actions">
        <a class="btn btn-primary" href="#contacto" data-open-project>Cuéntanos qué vendes <span class="btn-arrow" aria-hidden="true">→</span></a>
        <a class="btn btn-ghost" href={MAIN_DEMO_HREF}>Ver una tienda demo <span aria-hidden="true">↗</span></a>
      </div>
      <ul class="hx-proof">{proof.map((item) => <li><strong>{item.value}</strong><span>{item.label}</span></li>)}</ul>
    </div>
    <div class="hx-stage">
      <div class="hx-canvas">
        <label class="rail-pause"><input type="checkbox" aria-label="Pausar movimiento de las tiendas" /><span aria-hidden="true"></span>Pausar</label>
        <ThemeRail stores={gallery.slice(0, 8)} />
      </div>
      {/* Ilustración: una tarjeta de pedido y otra de envío con los datos ficticios del panel demo. */}
      <div class="ui-float ui-order" aria-hidden="true">
        <div class="ui-head"><span class="ui-ico"><Icon name="cart" size={16} /></span><span><b>Nuevo pedido</b><small>BM-DEMO-1006 · ahora</small></span></div>
        <div class="ui-line"><span>Pau Riera Font</span><strong>80,70 €</strong></div>
        <div class="ui-foot"><span class="ui-pill is-paid">Pagado</span><span class="ui-meta">3 artículos</span></div>
      </div>
      <div class="ui-float ui-ship" aria-hidden="true">
        <div class="ui-head"><span class="ui-ico"><Icon name="truck" size={16} /></span><span><b>Pedido enviado</b><small>Aviso con seguimiento al cliente</small></span></div>
        <div class="ui-progress"><i></i><i></i><i></i><i></i></div>
      </div>
      <ol class="hx-track" aria-label="Todo conectado">
        <li>Tienda</li><li>Pago</li><li>Pedido</li><li>Envío</li>
      </ol>
    </div>
  </section>

  <!-- ── Herramientas ─────────────────────────────────────────────────── -->
  <section class="stack-strip page-shell" aria-label="Herramientas del ecosistema">
    <p>Un proyecto conectado a tu operativa</p>
    <BrandWall brands={stack} size={30} align="center" label="Pagos, infraestructura, correo, envíos y contacto" />
  </section>

  <!-- ── Flujo ────────────────────────────────────────────────────────── -->
  <section id="flujo" class="sx page-shell">
    <header class="sx-head is-split reveal">
      <div><p class="eyebrow"><span>01</span>Tu operativa, conectada</p><h2>De la primera visita<br />al último paquete.</h2></div>
      <p>Diseñamos el recorrido alrededor de lo que vendes y de cómo trabaja tu equipo.</p>
    </header>
    <div class="journey reveal" role="region" aria-label="Recorrido de tu ecommerce" tabindex="0">
      <div class="journey-phases" aria-hidden="true">{phases.map((phase) => <span style={`--span:${phase.span}`}>{phase.label}</span>)}</div>
      <ol class="journey-steps" aria-label="Los siete pasos de tu ecommerce">
        {workflow.map((step, i) => <li>
          {step.phase && <span class="journey-tag">{step.phase}</span>}
          <span class="journey-node" aria-hidden="true"><Icon name={step.icon} size={20} /></span>
          <span class="journey-n" aria-hidden="true">0{i + 1}</span>
          <h3>{step.title}</h3>
          <p>{step.body}</p>
        </li>)}
      </ol>
    </div>
  </section>

  <!-- ── Plataforma ───────────────────────────────────────────────────── -->
  <section id="plataforma" class="sx sx-tint">
    <div class="page-shell">
      <header class="sx-head is-center reveal"><p class="eyebrow"><span>02</span>Una tienda. Cinco momentos clave</p><h2>Bonita por fuera.<br />Bien resuelta por dentro.</h2></header>
      <div class="explorer" data-platform-explorer>
        <div class="seg" aria-label="Recorrido de la tienda"><span class="seg-thumb" aria-hidden="true"></span>{moments.map((moment, i) => <a href={`#moment-${i}`} data-moment-tab={i}><Icon name={moment.icon} size={16} />{moment.label}</a>)}</div>
        {moments.map((moment, i) => <article id={`moment-${i}`} class="moment" data-moment-panel={i}>
          <div class="moment-copy">
            <p class="moment-count"><span>0{i + 1}</span> / 0{moments.length}</p>
            <h3>{moment.title}</h3>
            <p>{moment.body}</p>
            <ul>{moment.points.map(point => <li><span aria-hidden="true"><svg viewBox="0 0 16 16" width="16" height="16"><path d="m4 8.5 2.5 2.5L12 5.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg></span>{point}</li>)}</ul>
            <a class="btn btn-soft" href={moment.href}>{moment.link} <span class="btn-arrow" aria-hidden="true">→</span></a>
          </div>
          <figure class:list={['frame', 'moment-frame', moment.crop && 'is-crop']}>
            <div class="frame-bar" aria-hidden="true"><i></i><i></i><i></i><span>{moment.url}</span></div>
            <img src={moment.img} alt={`Vista de demostración: ${moment.label}`} width="1200" height="800" loading="lazy" decoding="async" />
            <span class="frame-note" aria-hidden="true"><Icon name={moment.icon} size={14} />{moment.note}</span>
            <figcaption>Demo navegable · datos simulados</figcaption>
          </figure>
        </article>)}
      </div>
    </div>
  </section>

  <!-- ── Integraciones ────────────────────────────────────────────────── -->
  <section id="integraciones" class="sx page-shell">
    <header class="sx-head is-split reveal">
      <div><p class="eyebrow"><span>03</span>Conecta sin rehacer</p><h2>Tus herramientas.<br />En el mismo recorrido.</h2></div>
      <p>Definimos las conexiones que necesita tu negocio, con un alcance concreto para cada proyecto.</p>
    </header>
    <div class="links-grid">
      <article class="link-card reveal">
        <svg class="diagram" viewBox="0 0 320 150" aria-hidden="true">
          <path class="flow" d="M86 52h44M190 52h44M160 70v34" />
          <g class="node"><rect x="14" y="34" width="72" height="36" rx="18" /><text x="50" y="56">Catálogo</text></g>
          <g class="node is-core"><rect x="130" y="34" width="60" height="36" rx="18" /><text x="160" y="56">Pedido</text></g>
          <g class="node"><rect x="234" y="34" width="72" height="36" rx="18" /><text x="270" y="56">Envío</text></g>
          <g class="node is-soft"><rect x="124" y="104" width="72" height="32" rx="16" /><text x="160" y="124">Email</text></g>
          <circle class="pulse" r="3.5"><animateMotion dur="3.2s" repeatCount="indefinite" path="M86 52h44M190 52h44" /></circle>
        </svg>
        <h3>Operación conectada</h3>
        <p>Catálogo, correo y preparación de envíos comparten información útil.</p>
        <BrandWall class="link-brands" brands={['resend', 'packlink', 'sendcloud']} size={18} label="Correo y envíos" />
      </article>
      <article class="link-card reveal">
        <svg class="diagram" viewBox="0 0 320 150" aria-hidden="true">
          <rect class="zone" x="112" y="14" width="96" height="122" rx="16" />
          <text class="zone-label" x="160" y="30">Pasarela externa</text>
          <path class="flow" d="M82 76h46M192 76h40" />
          <g class="node"><rect x="14" y="58" width="68" height="36" rx="18" /><text x="48" y="80">Tienda</text></g>
          <g class="node is-core"><circle cx="160" cy="76" r="26" /><path class="glyph" d="M152 76v-5a8 8 0 0 1 16 0v5M149 76h22v14h-22z" /></g>
          <g class="node is-ok"><rect x="232" y="58" width="76" height="36" rx="18" /><text x="270" y="80">Pagado ✓</text></g>
          <text class="zone-label" x="160" y="124">Tarjeta fuera de tu web</text>
        </svg>
        <h3>Pagos en su sitio</h3>
        <p>La pasarela procesa la tarjeta y el pedido conserva su importe y estado.</p>
        <BrandWall class="link-brands" brands={['stripe', 'paypal', 'redsys']} size={18} label="Pasarelas de pago" />
      </article>
      <article class="link-card reveal">
        <svg class="diagram" viewBox="0 0 320 150" aria-hidden="true">
          <g class="node is-core"><rect x="118" y="46" width="84" height="58" rx="14" /><text x="160" y="80">Núcleo</text></g>
          <g class="node"><rect x="22" y="18" width="80" height="34" rx="12" /><text x="62" y="39">Catálogo</text></g>
          <g class="node"><rect x="22" y="98" width="80" height="34" rx="12" /><text x="62" y="119">Pagos</text></g>
          <g class="node"><rect x="218" y="18" width="80" height="34" rx="12" /><text x="258" y="39">Envíos</text></g>
          <g class="node is-slot"><rect x="218" y="98" width="80" height="34" rx="12" /><text x="258" y="119">+ módulo</text></g>
          <path class="flow" d="M102 35h16v16M102 115h16v-16M218 35h-16v16" />
          <path class="flow is-dashed" d="M218 115h-16v-16" />
        </svg>
        <h3>Preparada para evolucionar</h3>
        <p>Datos estructurados y una base ampliable para nuevas conexiones y automatizaciones.</p>
        <BrandWall class="link-brands" brands={['zapier', 'make', 'n8n']} size={18} label="Automatizaciones" />
      </article>
    </div>
    <div class="connect-wall reveal">
      <p class="connect-kicker">Plataformas que puedes conectar</p>
      <p>Pagos, marketing, analítica, envíos, facturación y marketplaces: se acuerdan por proyecto, con un alcance concreto para tu negocio.</p>
      <BrandWall brands={connectable} size={22} align="center" label="Plataformas con las que se puede conectar la tienda" />
    </div>
  </section>

  <!-- ── Precios ──────────────────────────────────────────────────────── -->
  <section id="precios" class="sx sx-tint pricing">
    <div class="page-shell">
      <header class="sx-head is-center reveal"><p class="eyebrow"><span>04</span>Diseño + tecnología + acompañamiento</p><h2>Empieza con lo que necesitas.<br />Crece sobre la misma base.</h2><p>Una inversión inicial para construir tu tienda y un mantenimiento claro para cuidarla.</p></header>
      <CommercialPlans />
      <a class="section-more" href="/precios">Ver los packs y sus condiciones <span aria-hidden="true">↗</span></a>
    </div>
  </section>

  <!-- ── Tiendas ──────────────────────────────────────────────────────── -->
  <section id="demos" class="sx page-shell">
    <header class="sx-head is-split reveal">
      <div><p class="eyebrow"><span>05</span>Direcciones visuales</p><h2>Tu marca merece<br />su propia tienda.</h2></div>
      <div><p>Explora identidades distintas sobre el mismo motor ecommerce. Cada una es una tienda navegable.</p><a class="text-link" href="/temas">Ver todos los diseños ↗</a></div>
    </header>
    <div class="bento">
      {featured.map((store, i) => <a class:list={['store-card', 'reveal', i === 0 && 'is-hero']} href={store.href} style={`--accent:${store.accent}`} data-hover-video={store.preview ?? undefined}>
        <span class="store-media">
          <img src={i === 0 ? store.img900 : store.img} srcset={`${store.img} 560w, ${store.img900} 900w`} sizes={i === 0 ? '(min-width: 900px) 50vw, 100vw' : '(min-width: 900px) 25vw, 50vw'} alt={`Escaparate de ${store.name}`} width="900" height="700" loading="lazy" decoding="async" />
        </span>
        <span class="store-info"><span><strong>{store.name}</strong><small><i aria-hidden="true"></i>{store.style} · Demo navegable</small></span><b aria-hidden="true">↗</b></span>
      </a>)}
      <a class="store-more reveal" href="/temas"><span class="store-more-n">+{moreStores}</span><span>direcciones visuales más, cada una sobre el mismo motor</span><b>Ver todos los diseños <span aria-hidden="true">↗</span></b></a>
    </div>
  </section>

  <!-- ── Panel ────────────────────────────────────────────────────────── -->
  <section id="paneles" class="sx page-shell panels">
    <div class="panels-copy">
      <header class="sx-head reveal"><p class="eyebrow"><span>06</span>Un panel para trabajar</p><h2>Menos buscar.<br />Más tenerlo a mano.</h2><p>Las vistas que necesita el comercio, sin añadir complejidad a su día a día.</p></header>
