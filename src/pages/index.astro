---
// Landing comercial de Logic2B Ecommerce — página de CONVERSIÓN.
//
// F13: el acento de la landing es el verde de marca y NO muta (antes cambiaba
// al de la tienda que pasaba por el centro de la galería: bonito, pero la
// página cambiaba de color mientras se lee y la marca se diluía). Cada tarjeta
// conserva el acento de SU tienda, que es donde el color significa algo.
//
// F13.2 — cambio de ARGUMENTO, no solo de copy:
//   · Fuera el «0 €/mes de infraestructura». El modelo pasa a ser una cuota que
//     ARRANCA BAJA Y CRECE CON EL TRÁFICO: cobramos poco mientras el tráfico es
//     poco, cobramos por traerlo (SEO, GEO y campañas) y subimos cuando el
//     tráfico —y las ventas— suben. Ganamos a la vez que el cliente.
//   · Fuera la comparativa de coste con Shopify (cuota de plataforma, comisión
//     por venta y calculadora a 3 años): nosotros también podemos cobrar
//     comisión, así que ese argumento ya no es honesto.
//   · Stripe deja de ser «la» pasarela: es una de las que se integran.
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import HeaderActions from '../components/HeaderActions.astro';
import ProjectDialog from '../components/ProjectDialog.astro';
import ProjectForm from '../components/ProjectForm.astro';
import LogoMarquee from '../components/LogoMarquee.astro';
import ThemeRail from '../components/ThemeRail.astro';
import FlowInterface from '../components/FlowInterface.astro';
import DemoInterface from '../components/DemoInterface.astro';
import { collections, storePaths } from '../collections';
import { demoThemes, defaultTheme, getTheme } from '../lib/demo-themes';
import { landingNav, MAIN_DEMO_HREF, MAIN_DEMO_NAME, DEMO_ADMIN_HREF } from '../lib/nav';
import { AGENCY_EMAIL, AGENCY_WHATSAPP } from '../lib/contact';

// ── Galería del hero — derivada del registro de tiendas (clonable) ──────────
// La tienda más reciente abre la fila; la demo genérica
// continúa disponible dentro del resto de la galería.
const galleryOrder = ['lumbre', 'dintel', 'traza', 'bruma', 'brio', 'alva', 'orbe', 'viso', 'nera', 'litica', 'summit', 'argent', 'arce', 'stretch', 'forma', 'sitega', 'noddo', 'demo', 'launch', 'editorial', 'iris', 'street', 'industrial', 'natural', 'specs', 'minimal', 'guide'];
const gallery = galleryOrder.map((id) => {
  const col = collections.find((c) => c.id === id)!;
  const theme = getTheme(col.themeId)!;
  return {
    id,
    name: col.name,
    tagline: col.tagline,
    style: theme.label,
    accent: theme.vars['--color-brand'],
    href: storePaths(id).catalog,
    // Dos anchos con `srcset`: la tarjeta pinta a 280 CSS px en móvil y 360 en
    // escritorio, así que 560 es lo que se lleva casi siempre y 900 queda para
    // pantallas de alta densidad. Servir solo 900 costaba ~200 KB de galería.
    img: `/images/screens/store-${id}-catalog-560.webp`,
    img900: `/images/screens/store-${id}-catalog-900.webp`,
    video: id === 'iris' ? '/images/screens/iris-scrub.mp4' : null,
    poster: id === 'iris' ? '/images/screens/iris-scrub-poster-560.webp' : null,
    poster900: id === 'iris' ? '/images/screens/iris-scrub-poster.webp' : null,
  };
});

// ── Contacto ────────────────────────────────────────────────────────────────
// El canal principal es el formulario; WhatsApp y email quedan de alternativa
// para quien prefiere escribir directamente.
const whatsappHref = AGENCY_WHATSAPP
  ? `https://wa.me/${AGENCY_WHATSAPP}?text=${encodeURIComponent('Hola, me interesa una tienda online con Logic2B Ecommerce.')}`
  : null;
const emailHref = `mailto:${AGENCY_EMAIL}?subject=${encodeURIComponent('Mi tienda online con Logic2B Ecommerce')}`;

// Recuento del catálogo de temas, derivado del registro (igual que hace
// /temas): un tema nuevo actualiza este copy solo.
const themeCount = demoThemes.filter((t) => t.id !== defaultTheme.id).length;

// ── Flujo del pedido, con capturas reales del producto ──────────────────────
const flow = [
  {
    n: '01',
    title: 'Web a medida',
    body: 'Diseñamos y desarrollamos una web a medida de tu negocio. Sin plantillas genéricas: cada pantalla, función y proceso responde a una necesidad concreta.',
    alt: 'Escaparate ARCE diseñado a medida por Logic2B Ecommerce',
    visualLabel: 'Diseño exclusivo',
    visual: 'storefront',
    tone: 'terracotta',
  },
  {
    n: '02',
    title: 'Gestión sencilla',
    body: 'Simplificamos el panel para que gestionar productos, pedidos y contenidos sea rápido. Tú ves lo esencial; la complejidad técnica queda de nuestro lado.',
    alt: 'Panel sencillo de gestión de pedidos de Logic2B Ecommerce',
    visualLabel: 'Panel de gestión',
    visual: 'management',
    tone: 'lime',
  },
  {
    n: '03',
    title: 'Crece contigo',
    body: 'Añadimos nuevas funciones cuando el negocio las necesita y trabajamos el SEO, el GEO y las campañas para hacer crecer tu tráfico, sin migraciones ni volver a empezar.',
    alt: 'Módulo de envíos añadido al panel de Logic2B Ecommerce',
    visualLabel: 'Funciones modulares',
    visual: 'growth',
    tone: 'sky',
  },
  {
    n: '04',
    title: 'Nativa para IA',
    body: 'La plataforma nace con datos estructurados y una arquitectura preparada para conectarse con asistentes, automatizaciones y modelos de lenguaje.',
    alt: 'Catálogo estructurado preparado para integraciones y modelos de inteligencia artificial',
    visualLabel: 'Arquitectura preparada para IA',
    visual: 'ai',
    tone: 'forest',
  },
] as const;

// ── FAQ ─────────────────────────────────────────────────────────────────────
const faqs = [
  {
    q: '¿Qué pasa con los pagos? ¿Es seguro?',
    a: 'El pago ocurre en la pasarela elegida. Los datos de tarjeta nunca pasan por tu tienda ni por nuestros servidores.',
  },
  {
    q: '¿Y si un día dejamos de trabajar juntos?',
    a: 'El dominio, las cuentas de pago y el código son tuyos. Te lo entregamos documentado y sin permanencia.',
  },
  {
    q: '¿Y si mañana necesito algo que la tienda no hace?',
    a: 'La añadimos sobre la misma plataforma. Tu tienda evoluciona sin acumular plugins y sin volver a empezar.',
  },
  {
    q: '¿Trabajáis con agencias?',
    a: 'Sí, también en marca blanca. Nosotros podemos ocuparnos del producto y el mantenimiento técnico.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Logic2B Ecommerce',
    description:
      'Tienda online a medida que arranca como MVP y escala de 10 referencias a un millón sin cambiar de plataforma: ultrarrápida, con diseño propio y con el posicionamiento (SEO, GEO y campañas) del mismo equipo que la construye.',
    provider: { '@type': 'Organization', name: 'Logic2B', url: 'https://logic2b.com' },
    areaServed: 'ES',
    serviceType: 'Desarrollo de comercio electrónico',
    offers: [
      { '@type': 'Offer', name: 'Kit Lite', price: '590', priceCurrency: 'EUR' },
      { '@type': 'Offer', name: 'Kit', price: '1900', priceCurrency: 'EUR' },
      { '@type': 'Offer', name: 'Kit a medida', price: '3400', priceCurrency: 'EUR' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: { '@type': 'Answer', text: faq.a },
    })),
  },
];
---

<Base
  title="Logic2B Ecommerce — tiendas online a medida, con el marketing incluido"
  description="Tu tienda online a medida: 10 productos o un millón. Arranca como MVP, crece sin cambiar de plataforma y la cuota crece contigo: cobramos más cuando tu tráfico y tus ventas suben. Hecha en Castellón por Logic2B."
  canonicalPath="/"
  preloadDisplayFont
  jsonLd={jsonLd}
>
  <div class="airtable-landing bg-background text-foreground">
    <div class="airtable-announcement" role="status">
      <span>Una tienda a medida que crece contigo.</span>
      <a href="/precios">Descubre el modelo de crecimiento <span aria-hidden="true">→</span></a>
    </div>
    <SiteHeader homeHref="/" wordmark="Logic2B Ecommerce" splitBrand nav={landingNav}>
      <Fragment slot="actions"><HeaderActions /></Fragment>
    </SiteHeader>

    <main>
    <!-- ── Héroe + rail de temas ─────────────────────────────────────────── -->
    <section class="airtable-hero mx-auto max-w-6xl px-5 pt-14 sm:pt-20">
      <div class="airtable-hero-layout">
        <div class="airtable-hero-copy">
          <p class="airtable-eyebrow">Un servicio de Logic2B · Hecho en Castellón</p>
          <h1 class="hero-title font-display">Tu tienda online a medida</h1>
          <p class="hero-fade hero-lcp-copy">
            Una tienda propia, rápida y lista para crecer contigo. Empieza con lo esencial y añade lo que el negocio necesite.
          </p>
          <form class="airtable-email-gate hero-fade" data-email-gate style="--d:.24s">
            <label class="sr-only" for="hero-email">Tu correo electrónico</label>
            <input id="hero-email" type="email" name="email" required autocomplete="email" placeholder="Empieza a vender ya" />
            <button type="submit" aria-label="Continuar con mi correo">→</button>
          </form>
          <p class="airtable-email-note">Sin compromiso. Te respondemos en 24 h laborables.</p>
          <button type="button" data-open-project data-email-trigger class="sr-only" tabindex="-1">Abrir formulario</button>
        </div>
        <ThemeRail stores={gallery} />
      </div>
    </section>

    <!-- ── Tecnología e integraciones ────────────────────────────────────── -->
    <LogoMarquee />

    <!-- ── El flujo del pedido, con capturas reales ──────────────────────── -->
    <section class="airtable-features border-y border-border bg-muted">
      <div class="mx-auto max-w-6xl px-5 py-14 sm:py-20">
        <h2 class="max-w-2xl font-display text-3xl sm:text-4xl">Así de simple</h2>
        <p class="mt-3 max-w-2xl text-muted-foreground">
          Hemos simplificado el proceso al máximo para que solo tengas lo esencial:
          un punto de partida minimalista y limpio para que puedas escalar hasta
          donde tú quieras.
        </p>
        <div class="airtable-flow mt-10">
          <nav class="airtable-flow-tabs" aria-label="Pasos de un pedido">
            {flow.map((step, index) => (
              <a
                href={`#pedido-${step.n}`}
                data-flow-tab={step.n}
                class:list={['airtable-flow-tab', index === 0 && 'is-active']}
                aria-current={index === 0 ? 'step' : undefined}
              >
                <span class="airtable-flow-tab-dot" aria-hidden="true"></span>
                <span>{step.n}</span>
                <span>{step.title}</span>
              </a>
            ))}
          </nav>

          <div class="airtable-flow-panels">
            {flow.map((step) => (
              <article
                id={`pedido-${step.n}`}
                data-flow-panel={step.n}
                class={`airtable-flow-card airtable-flow-card-${step.tone}`}
              >
                <div class="airtable-flow-card-copy">
                  <p class="airtable-flow-card-step">Paso {step.n}</p>
                  <h3>{step.title}</h3>
                  <p>{step.body}</p>
                </div>
                <figure class="airtable-flow-card-visual">
                  <span class="airtable-flow-visual-glow" aria-hidden="true"></span>
                  <div class="airtable-flow-screen">
                    <div class="airtable-flow-screen-bar" aria-hidden="true">
                      <strong>Logic2B Ecommerce</strong>
                      <span>{step.visualLabel}</span>
                    </div>
                    <FlowInterface variant={step.visual} label={step.alt} />
                  </div>
                </figure>
              </article>
            ))}
          </div>
        </div>
        {/* El panel salió del menú: este es su sitio, justo donde se acaba de
            explicar para qué sirve. */}
        <div class="mt-8 flex flex-col items-center gap-3 text-center sm:flex-row sm:justify-between sm:text-left">
          <p class="text-muted-foreground">
            El panel enseña esos pasos con pedidos ficticios independientes.
            Ábrelo y trastéalo en modo de solo lectura, sin registro.
          </p>
          <a
            href={DEMO_ADMIN_HREF}
            class="shrink-0 rounded-btn bg-foreground px-7 py-3 text-sm font-semibold text-background transition hover:bg-foreground/90"
          >Entrar en el panel de la demo →</a>
        </div>
      </div>
    </section>

    <!-- ── Escalado: el detalle económico vive en /precios ──────────────── -->
    <section class="airtable-scale-teaser mx-auto max-w-6xl px-5 py-14 sm:py-20">
      <div class="airtable-scale-teaser-copy">
        <p class="airtable-section-kicker">Una plataforma, todas tus etapas</p>
        <h2>Empieza simple.<br />Escala sin migrar.</h2>
        <p>La tienda, las funciones y el acompañamiento crecen cuando tu negocio lo necesita.</p>
        <a href="/precios">Ver cómo funciona el escalado <span aria-hidden="true">→</span></a>
      </div>
      <div class="airtable-scale-visual" aria-label="Evolución desde el lanzamiento hasta la escala">
        <div class="scale-visual-head">
          <div>
            <span class="scale-live"><i aria-hidden="true"></i>Evolución del negocio</span>
            <strong>Más tráfico. Más funciones. La misma base.</strong>
          </div>
          <span class="scale-no-migration">Sin migraciones <i aria-hidden="true">✓</i></span>
        </div>

        <div class="scale-visual-chart">
          <svg class="scale-growth-curve" viewBox="0 0 1000 300" preserveAspectRatio="none" aria-hidden="true">
            <defs>
              <linearGradient id="scale-area" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#64b5f6" stop-opacity=".28"></stop>
                <stop offset="1" stop-color="#64b5f6" stop-opacity="0"></stop>
              </linearGradient>
            </defs>
            <path d="M20 275C150 270 180 250 260 231S390 208 470 170 610 148 690 106 840 83 980 22V300H20Z" fill="url(#scale-area)"></path>
            <path d="M20 275C150 270 180 250 260 231S390 208 470 170 610 148 690 106 840 83 980 22" fill="none" stroke="#8ac9ff" stroke-width="3" stroke-linecap="round"></path>
          </svg>
          <article class="scale-stage">
            <span class="scale-stage-number">01</span>
            <i class="scale-stage-dot" aria-hidden="true"></i>
            <strong>Lanzamiento</strong>
            <span class="scale-stage-capability">Tienda · pagos</span>
          </article>
          <article class="scale-stage">
            <span class="scale-stage-number">02</span>
            <i class="scale-stage-dot" aria-hidden="true"></i>
            <strong>Tracción</strong>
            <span class="scale-stage-capability">SEO · GEO</span>
          </article>
          <article class="scale-stage">
            <span class="scale-stage-number">03</span>
            <i class="scale-stage-dot" aria-hidden="true"></i>
            <strong>Crecimiento</strong>
            <span class="scale-stage-capability">Nuevas funciones</span>
          </article>
          <article class="scale-stage scale-stage-current">
            <span class="scale-stage-number">04</span>
            <i class="scale-stage-dot" aria-hidden="true"></i>
            <strong>Escala</strong>
            <span class="scale-stage-capability">IA · automatización</span>
          </article>
        </div>

        <div class="scale-foundation">
          <div class="scale-foundation-title">
            <span aria-hidden="true">∞</span>
            <div><small>Core Logic2B</small><strong>Una plataforma todo el camino</strong></div>
          </div>
          <span class="scale-foundation-note">Código propio · Datos estructurados · Modular</span>
        </div>
      </div>
    </section>

    <!-- ── Demos: tienda, panel y emails ─────────────────────────────────── -->
    <section class="airtable-demos mx-auto max-w-6xl px-5 py-14 sm:py-20">
      <h2 class="font-display text-3xl sm:text-4xl">Míralo por dentro</h2>
      <p class="mt-3 max-w-2xl text-muted-foreground">
        Tienda, panel y comunicaciones. Todo abierto y sin registro.
      </p>
      <div class="airtable-demo-grid mt-10">
        <a href={MAIN_DEMO_HREF} class="airtable-demo-card airtable-demo-store rise group">
          <figure><DemoInterface variant="store" label="Ficha de producto y cesta de la tienda demo" /></figure>
          <div class="airtable-demo-copy">
            <p class="airtable-demo-kicker">Escaparate</p>
            <h3>Compra como tu cliente.</h3>
            <p>Explora el catálogo, configura un producto y recorre la compra completa.</p>
            <span>Entrar en {MAIN_DEMO_NAME} <i aria-hidden="true">→</i></span>
          </div>
        </a>
        <a href={DEMO_ADMIN_HREF} class="airtable-demo-card airtable-demo-orders rise group">
          <figure><DemoInterface variant="orders" label="Detalle de un pedido dentro del panel de gestión" /></figure>
          <div class="airtable-demo-copy">
            <p class="airtable-demo-kicker">Gestión</p>
            <h3>Controla lo importante.</h3>
            <p>Pedidos, clientes, pagos y envíos en un panel que no necesita manual.</p>
            <span>Abrir el panel <i aria-hidden="true">→</i></span>
          </div>
        </a>
        <a href="/demo/admin/emails" class="airtable-demo-card airtable-demo-emails rise group">
          <figure><DemoInterface variant="emails" label="Automatizaciones y vista previa de los emails transaccionales" /></figure>
          <div class="airtable-demo-copy">
            <p class="airtable-demo-kicker">Comunicaciones</p>
            <h3>Cada mensaje, en su momento.</h3>
            <p>Confirmaciones, seguimiento y avisos automáticos con tu identidad.</p>
            <span>Ver comunicaciones <i aria-hidden="true">→</i></span>
          </div>
        </a>
      </div>
      <div class="mt-6 rounded-2xl border border-border bg-muted p-6 text-center sm:p-8">
        <p class="font-display text-xl">¿Qué tema encaja con lo que vendes?</p>
        <p class="mx-auto mt-2 max-w-xl text-sm text-muted-foreground">{themeCount} direcciones visuales, del catálogo técnico al escaparate cinemático. Elige el punto de partida de tu tienda.</p>
        <a href="/temas" class="mt-4 inline-block rounded-btn border border-foreground px-6 py-2.5 text-sm font-semibold transition hover:bg-foreground hover:text-background">Ver otros temas</a>
      </div>
    </section>

    <!-- ── Logic2B: el estudio y sus cuatro capas ───────────────────────── -->
    <section aria-labelledby="casa-h" class="airtable-casa">
      <div class="airtable-casa-inner mx-auto max-w-6xl px-5 py-14 sm:py-20">
        <div class="logic2b-story">
          <div class="logic2b-lockup" aria-label="Logic2B">
            <span class="logic2b-mark" aria-hidden="true"></span>
            <span class="logic2b-wordmark">Logic<span>2B</span></span>
          </div>
          <p class="logic2b-kicker">Estudio digital · Castellón</p>
          <h2 id="casa-h">Diseño y tecnología<br />a medida.</h2>
          <p class="logic2b-intro">
            Ecommerce forma parte de un equipo que conecta marca, producto,
            tráfico y automatización. Una sola visión para hacer crecer el negocio completo.
          </p>
          <a href="https://logic2b.com" class="logic2b-link">Conocer Logic2B <span aria-hidden="true">→</span></a>
        </div>

        <div class="logic2b-system" aria-label="Capacidades de Logic2B">
          <span class="logic2b-system-line logic2b-system-line-a" aria-hidden="true"></span>
          <span class="logic2b-system-line logic2b-system-line-b" aria-hidden="true"></span>
          <div class="logic2b-core" aria-hidden="true"><span class="logic2b-mark"></span></div>
          <article>
            <span>01</span>
            <h3>Diseño</h3>
            <p>Una identidad propia.</p>
          </article>
          <article>
            <span>02</span>
            <h3>Desarrollo</h3>
            <p>Código y sistemas a medida.</p>
          </article>
          <article>
            <span>03</span>
            <h3>Crecimiento</h3>
            <p>SEO, GEO y campañas.</p>
          </article>
          <article>
            <span>04</span>
            <h3>IA</h3>
            <p>Integración y automatización.</p>
          </article>
        </div>
      </div>
      <div class="logic2b-capabilities" aria-label="Servicios de Logic2B">
        <span>Diseño</span><span>Ecommerce</span><span>Desarrollo</span><span>IA</span>
      </div>
    </section>

    <!-- ── FAQ ───────────────────────────────────────────────────────────── -->
    <section class="airtable-faq mx-auto max-w-3xl px-5 py-14 sm:py-20">
      <h2 class="text-center font-display text-3xl sm:text-4xl">Preguntas frecuentes</h2>
      <div class="mt-8 space-y-3">
        {faqs.map((faq) => (
          <details class="group rounded-2xl border border-border bg-card px-6 py-4 open:shadow-sm">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold marker:content-none">
              {faq.q}
              <span aria-hidden="true" class="text-xl leading-none text-brand transition group-open:rotate-45">+</span>
            </summary>
            <p class="mt-3 text-sm leading-relaxed text-muted-foreground">{faq.a}</p>
          </details>
        ))}
      </div>
    </section>
    </main>

    <!-- ── Formulario de cierre ──────────────────────────────────────────── -->
    <section id="contacto" class="airtable-contact scroll-mt-14 bg-foreground text-background">
      <div class="mx-auto max-w-4xl px-5 py-16 sm:py-20">
        <h2 class="font-display text-3xl sm:text-4xl">¿Hablamos de tu tienda?</h2>
        <p class="mt-4 max-w-xl leading-relaxed text-background/70">
          Cuéntanos qué vendes y te contestamos en 24 h laborables con dos o tres
          preguntas — y si no encajamos, te lo decimos.
        </p>
        <div class="mt-9">
          <ProjectForm idPrefix="end" source="cierre" inverted />
        </div>
        <p class="mt-8 text-sm text-background/60">
          ¿Prefieres escribir tú?
          {whatsappHref && (
            <>
              <a href={whatsappHref} class="font-medium text-background underline underline-offset-2">WhatsApp</a>
              {' · '}
            </>
          )}
          <a href={emailHref} class="font-medium text-background underline underline-offset-2">{AGENCY_EMAIL}</a>
        </p>
      </div>
    </section>

    {/* El pie compartido (SiteFooter) continúa el bloque oscuro de contacto:
        mismo fondo tinta, mismo menú que el resto de páginas comerciales. */}
    <SiteFooter />

    <ProjectDialog />
  </div>
</Base>

<style is:global>
  /* ── Motion de la landing — CSS primero, JS después ─────────────────────
     Todo lo de aquí degrada a página completa y estática: sin soporte de
     scroll-driven animations o con prefers-reduced-motion, no se anima nada
     y el contenido real ya está en el DOM. */

  /* Solo transform: nada de opacity en tarjetas (axe audita el estado inicial
     y el texto perdería contraste) y nada de font-weight/opacity en el H1 —
     animar el peso de la variable re-shapea el texto en main thread y costó
     2,1 s de TBT en Lighthouse (medido); el H1 es además el LCP. */
  @keyframes rise-in {
