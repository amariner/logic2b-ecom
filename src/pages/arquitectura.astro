---
// Página técnica de confianza: cómo funciona el sistema por dentro.
// Cabecera, pie, diálogo y lenguaje visual: el shell comercial (Landing.astro).
import Landing from '../layouts/Landing.astro';
import Icon, { type IconName } from '../components/Icon.astro';
import EngineBlueprint from '../components/home/EngineBlueprint.astro';
import { MAIN_DEMO_HREF, DEMO_ADMIN_HREF } from '../lib/nav';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'TechArticle',
    headline: 'Arquitectura de Logic2B Ecommerce',
    description:
      'Cómo funciona por dentro una tienda de Logic2B Ecommerce: Astro en el edge de Cloudflare, D1 como base de datos, Stripe Checkout y un flujo de envíos sin APIs de transportista.',
    author: { '@type': 'Organization', name: 'Logic2B' },
    inLanguage: 'es',
  },
];

const tables = [
  ['products', 'Catálogo: precio en céntimos, stock, categoría, activo'],
  ['orders', 'Pedido con totales congelados, estado y datos de envío'],
  ['order_items', 'Líneas con nombre y precio del momento de la compra'],
  ['order_events', 'Historial auditable de cada cambio de estado'],
  ['shipping_rates', 'Tarifa por zona con umbral de envío gratis'],
  ['emails_outbox', 'Cola de emails transaccionales'],
];

const benefits: [IconName, string, string][] = [
  ['growth', 'El coste sigue al tráfico', 'La tienda no paga servidores encendidos sin usar: el gasto acompaña a las visitas que recibe, y las visitas son justo lo que trabajamos por ti.'],
  ['route', 'Sin cuellos de botella', 'La distribución de contenido en el edge reduce la carga del servidor. La capacidad necesaria se dimensiona y verifica según el tráfico de cada proyecto.'],
  ['shield', 'Sin rehenes', 'El código está en un repositorio a tu nombre. Si mañana quieres irte, te lo llevas todo.'],
];
---

<Landing
  title="Arquitectura de Logic2B Ecommerce — así funciona por dentro"
  description="Astro estático en el edge, Cloudflare D1, Stripe Checkout con webhook idempotente y envíos por CSV a Packlink. La arquitectura completa de una tienda de Logic2B Ecommerce, explicada."
  canonicalPath="/arquitectura"
  activeHref="/arquitectura"
  jsonLd={jsonLd}
>
  <main class="arch">
    <section class="page-hero page-shell">
      <p class="page-kicker">La tecnología de tu tienda</p>
      <h1>Así funciona <span>por dentro</span></h1>
      <p class="page-lead">
        Una infraestructura común para construir cada tienda a medida.
        Cada proyecto conserva su propio despliegue y sus datos; Logic2B mantiene
        la tecnología que conecta catálogo, compra y gestión.
      </p>
      <div class="page-actions">
        <a href={MAIN_DEMO_HREF} class="btn btn-primary">Recorrer la tienda demo <span class="btn-arrow" aria-hidden="true">→</span></a>
        <a href={DEMO_ADMIN_HREF} class="btn btn-ghost">Abrir el panel del comercio <span aria-hidden="true">↗</span></a>
      </div>
    </section>

    {/* Lo primero, antes de cualquier diagrama: qué se entrega el día uno. */}
    <section class="page-shell">
      <div class="arch-intro reveal">
        <span class="card-ico" aria-hidden="true"><Icon name="box" size={22} /></span>
        <div>
          <p class="arch-intro-title">Una base común, un proyecto propio</p>
          <p>
            El catálogo, los pedidos y los pagos parten de un motor probado.
            Sobre esa base adaptamos diseño, contenido y funciones al comercio.
            Recibes una tienda propia y un panel sencillo, con un alcance acordado
            y capacidad para evolucionar.
          </p>
        </div>
      </div>
    </section>

    <section class="sx page-shell arch-row">
      <header class="sx-head reveal"><p class="eyebrow"><span>01</span>El principio</p><h2>Casi todo es estático</h2></header>
      <div class="arch-body">
        <p>
          La tienda se genera como HTML puro y se sirve desde la red global de Cloudflare
          para acercar el contenido al comprador. El rendimiento se mide en cada
          proyecto, con sus imágenes, catálogo y condiciones de uso.
          Las únicas piezas dinámicas son el carrito, el pago y el panel — funciones
          pequeñas que despiertan solo cuando se usan y se cobran por uso: una
          tienda que empieza gasta muy poco, y el gasto sube al ritmo del tráfico
          en vez de por adelantado.
        </p>
        <div class="split-bar reveal" aria-hidden="true">
          <div class="split-static"><small>Estático · en el edge</small><strong>Catálogo, fichas y contenido</strong></div>
          <div class="split-dynamic"><small>Bajo demanda</small><strong>Carrito · pago · panel</strong></div>
        </div>
      </div>
    </section>

    {/* El mismo diagrama de secuencia que la portada, con sus cuatro
        ampliaciones: aquí es el centro de la página técnica. */}
    <section class="sx arch-engine">
      <div class="page-shell">
        <header class="sx-head is-split reveal">
          <div><p class="eyebrow"><span>02</span>Paso a paso</p><h2>El flujo de una compra</h2></div>
          <p>
            El carrito solo guarda referencias, el precio se recalcula en el servidor
            y la tarjeta se escribe en la pasarela —en la demo, <strong>Stripe Checkout</strong>—.
            Un webhook firmado confirma el pago y todo se registra en un único lote.
            PayPal u otra pasarela encajan en el mismo hueco.
          </p>
        </header>
        <EngineBlueprint />
      </div>
    </section>

    <section class="sx page-shell arch-row">
      <header class="sx-head reveal"><p class="eyebrow"><span>03</span>Datos</p><h2>El modelo de datos completo</h2></header>
      <div class="arch-body">
        <p>
          Seis tablas. Sin ORM mágico, sin cincuenta relaciones. Dos decisiones importan:
          el dinero se guarda <strong>en céntimos enteros</strong> (nunca decimales flotantes)
          y cada línea de pedido <strong>congela el nombre y el precio</strong> del momento
          de la compra — cambiar una tarifa hoy jamás altera un pedido de ayer.
        </p>
        <ul class="arch-tables reveal">
          {tables.map(([name, desc]) => (
            <li><code>{name}</code><span>{desc}</span></li>
          ))}
        </ul>
      </div>
    </section>

    <section class="sx page-shell arch-row">
      <header class="sx-head reveal"><p class="eyebrow"><span>04</span>Escala</p><h2>¿Hasta dónde escala? De 10 referencias a un millón</h2></header>
      <div class="arch-body">
        <div class="arch-stats reveal" aria-hidden="true">
          <div><strong>~1–2 KB</strong><span>por referencia con su descripción</span></div>
          <div><strong>10 GB</strong><span>de capacidad por base D1</span></div>
        </div>
        <p>
          Las cuentas son públicas y se pueden comprobar: una referencia con su
          descripción pesa <strong>~1–2 KB</strong> en la base de
          datos, y cada base D1 admite <strong>10 GB</strong> — un
          millón de productos ocupa una fracción. Las páginas se sirven
          estáticas o cacheadas desde el CDN, así que el catálogo puede crecer
          tres órdenes de magnitud sin cambiar de arquitectura ni de plataforma.
        </p>
        <p>
          La parte honesta: a esa escala el trabajo no está en el motor, está en el
          catálogo — la búsqueda pasa a necesitar índice propio, aparecen los
          filtros por facetas y la sincronización de inventario.
          Eso se construye en el tramo <strong>a medida</strong>,
          sobre esta misma base y sin migrar nada: la tienda que arranca con 10
          productos y la que sirve un catálogo industrial comparten motor.
        </p>
      </div>
    </section>

    <section class="sx sx-tint">
      <div class="page-shell arch-row">
        <header class="sx-head reveal"><p class="eyebrow"><span>05</span>Logística</p><h2>Envíos: simple a propósito</h2></header>
        <div class="arch-body">
          <p>
            Nada de integraciones frágiles con APIs de transportistas. El comercio exporta
            los pedidos pagados en un CSV compatible con <strong>Packlink PRO o SendCloud</strong>,
            imprime las etiquetas allí (donde además el precio del envío es mejor), y pega el
            número de seguimiento en el panel. El cliente recibe su aviso automáticamente.
            Menos piezas, menos averías, y el mejor precio de etiqueta en cada momento.
          </p>
          <figure class="frame arch-shot reveal">
            <div class="frame-bar" aria-hidden="true"><i></i><i></i><i></i><span>panel · pedidos</span></div>
            <img
              src="/images/screens/panel-orders-900.webp"
              srcset="/images/screens/panel-orders-560.webp 560w, /images/screens/panel-orders-900.webp 900w, /images/screens/panel-orders.webp 1440w"
              sizes="(min-width: 1000px) 60vw, 100vw"
              alt="El listado de pedidos del panel con sus estados y el botón de exportar CSV para Packlink o SendCloud"
              width="1440"
              height="929"
              loading="lazy"
              decoding="async"
            />
            <figcaption>
              El panel de ejemplo: fixtures de pedidos, estados y exportación CSV para
              enseñar cómo funcionaría una tienda real.
            </figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section class="sx page-shell">
      <header class="sx-head is-center reveal"><p class="eyebrow"><span>06</span>Para tu negocio</p><h2>Lo que esto significa para ti</h2></header>
      <div class="arch-benefits">
        {benefits.map(([icon, title, body]) => (
          <article class="card is-lift reveal">
            <span class="card-ico" aria-hidden="true"><Icon name={icon} size={20} /></span>
            <h3>{title}</h3>
            <p>{body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="page-shell cta-wrap">
      <div class="cta-band reveal">
        <p class="eyebrow"><span>07</span>Pruébalo</p>
        <h2>¿Quieres verlo funcionando?</h2>
        <p>Recorre una compra simulada en ARCE y explora por separado el panel ficticio.</p>
        <div class="page-actions">
          <a href={MAIN_DEMO_HREF} class="btn btn-light">Tienda demo <span class="btn-arrow" aria-hidden="true">→</span></a>
          <a href={DEMO_ADMIN_HREF} class="btn btn-outline-light">Panel del comercio</a>
        </div>
      </div>
    </section>
  </main>
</Landing>

<style is:global>
  .commercial-page .arch-intro {
    display: flex;
    gap: 1.25rem;
    padding: clamp(1.5rem, 3vw, 2.4rem);
    border: 1px solid var(--c-border);
    border-radius: var(--r-lg);
    background: var(--c-surface);
  }
  .commercial-page .arch-intro .card-ico { background: #fff; }
  .commercial-page .arch-intro-title { font: 600 clamp(1.5rem, 2.4vw, 2rem)/1.15 var(--font-heading); letter-spacing: -.04em; }
  .commercial-page .arch-intro p:not(.arch-intro-title) { max-width: 52rem; margin-top: .7rem; color: var(--c-muted); line-height: 1.7; }

  /* Fila editorial: título fijo a la izquierda, contenido a la derecha. */
  .commercial-page .arch-row { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.4fr); align-items: start; gap: clamp(2rem, 6vw, 6rem); }
  .commercial-page .arch-row > .sx-head { position: sticky; top: 120px; margin-bottom: 0; }
  .commercial-page .arch-row > .sx-head h2 { font-size: clamp(2.1rem, 3.6vw, 3.4rem); }
  .commercial-page .arch-body { display: grid; gap: 1.5rem; }
  .commercial-page .arch-body > p { color: var(--c-muted); font-size: 1.04rem; line-height: 1.75; }
  .commercial-page .arch-body strong { color: var(--c-ink); font-weight: 600; }

  .commercial-page .split-bar { display: grid; grid-template-columns: 3fr 1.3fr; overflow: hidden; border: 1px solid var(--c-border); border-radius: var(--r-lg); }
  .commercial-page .split-bar > div { padding: 1.2rem 1.3rem; }
  .commercial-page .split-bar small { display: block; font-size: .64rem; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; }
  .commercial-page .split-bar strong { display: block; margin-top: .45rem; font-size: 1rem; letter-spacing: -.02em; }
  .commercial-page .split-static { background: #fff; color: var(--c-muted); }
  .commercial-page .split-dynamic { background: var(--c-green); color: var(--c-night-text); }
  .commercial-page .split-dynamic strong { color: #fff; }

  /* Paso a paso: superficie oscura para el diagrama del motor. */
  .commercial-page .arch-engine { position: relative; isolation: isolate; overflow: hidden; background: var(--c-night); color: var(--c-night-text); }
  .commercial-page .arch-engine::before {
    position: absolute;
    z-index: -1;
    inset: 0;
    background:
      radial-gradient(50rem 26rem at 85% 0%, rgb(16 185 129 / 14%), transparent 70%),
      linear-gradient(var(--c-night-line) 1px, transparent 1px) 0 0 / 64px 64px,
      linear-gradient(90deg, var(--c-night-line) 1px, transparent 1px) 0 0 / 64px 64px;
    -webkit-mask-image: linear-gradient(180deg, #000 0%, rgb(0 0 0 / 35%) 60%, transparent);
    mask-image: linear-gradient(180deg, #000 0%, rgb(0 0 0 / 35%) 60%, transparent);
    content: '';
  }
  .commercial-page .arch-engine h2 { color: #fff; }
  .commercial-page .arch-engine .eyebrow { color: var(--c-night-accent); }
  .commercial-page .arch-engine .eyebrow span { color: var(--c-night-muted); }
  .commercial-page .arch-engine .sx-head p:not(.eyebrow) { color: var(--c-night-text); }
  .commercial-page .arch-engine strong { color: #fff; }
  .commercial-page .arch-engine :focus-visible { outline-color: var(--c-night-accent); }
  .commercial-page .arch-shot { box-shadow: var(--shadow-lg); }
  .commercial-page .arch-shot img { aspect-ratio: 16 / 10; object-fit: cover; object-position: top left; }
  .commercial-page .arch-shot figcaption { padding: .85rem 1.1rem; border-top: 1px solid var(--line); background: var(--c-surface); color: var(--c-muted); font-size: .82rem; line-height: 1.55; }

  .commercial-page .arch-tables { overflow: hidden; border: 1px solid var(--c-border); border-radius: var(--r-lg); background: #fff; box-shadow: var(--shadow-sm); }
  .commercial-page .arch-tables li { display: grid; grid-template-columns: 11rem 1fr; gap: 1rem; align-items: baseline; padding: 1rem 1.25rem; font-size: .92rem; transition: background-color .25s var(--ease); }
  .commercial-page .arch-tables li + li { border-top: 1px solid var(--line); }
  .commercial-page .arch-tables li:hover { background: var(--c-surface); }
  .commercial-page .arch-tables code { color: var(--c-accent); font: 500 .84rem/1.4 var(--font-code); }
  .commercial-page .arch-tables span { color: var(--c-muted); }

  .commercial-page .arch-stats { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  .commercial-page .arch-stats > div { padding: 1.4rem; border: 1px solid var(--c-border); border-radius: var(--r-lg); background: #fff; }
  .commercial-page .arch-stats strong { display: block; color: var(--c-green); font: 600 clamp(2.2rem, 4vw, 3rem)/1 var(--font-heading); letter-spacing: -.05em; }
  .commercial-page .arch-stats span { display: block; margin-top: .5rem; color: var(--c-muted); font-size: .85rem; }

  .commercial-page .arch-benefits { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.25rem; }
  .commercial-page .arch-benefits h3 { margin: 1.4rem 0 .6rem; font-size: 1.2rem; }
  .commercial-page .arch-benefits p { color: var(--c-muted); font-size: .95rem; line-height: 1.65; }

  @media (max-width: 900px) {
    .commercial-page .arch-row { grid-template-columns: 1fr; gap: 1.5rem; }
    .commercial-page .arch-row > .sx-head { position: static; }
    .commercial-page .arch-benefits { grid-template-columns: 1fr; }
  }
  @media (max-width: 700px) {
    .commercial-page .arch-intro { flex-direction: column; }
    .commercial-page .split-bar { grid-template-columns: 1fr; }
    .commercial-page .arch-tables li { grid-template-columns: 1fr; gap: .25rem; }
    .commercial-page .arch-stats { grid-template-columns: 1fr; }
  }

</style>
