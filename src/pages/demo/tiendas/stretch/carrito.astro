---
import Shop from '../../../../layouts/Shop.astro';
import { stretchCollection } from '../../../../collections/stretch';
---

<Shop title="Carrito" description="Carrito visual STRETCH" collection={stretchCollection}>
  <main class="min-h-screen bg-[#f9f4f0] px-5 py-8 text-black sm:px-8 lg:px-10">
    <header class="flex items-center justify-between border-b border-black/10 pb-6">
      <a href="/demo/tiendas/stretch" class="text-lg font-bold uppercase tracking-[.2em]">STRETCH</a>
      <a href="/demo/tiendas/stretch#productos" class="text-[10px] uppercase tracking-[.12em]">Seguir comprando</a>
    </header>
    <div class="mx-auto max-w-4xl py-14">
      <p class="text-[10px] uppercase tracking-[.16em] text-black/60">Tu selección / Demo</p>
      <h1 class="mt-4 text-6xl font-light tracking-[-.06em] sm:text-7xl">Carrito.</h1>
      <div data-stretch-cart class="mt-12"></div>
      <div data-stretch-empty class="hidden py-20 text-center text-black/60">Tu carrito está vacío.</div>
      <div data-stretch-summary class="mt-10 hidden border-t border-black/10 pt-6">
        <div class="flex justify-between text-xl"><span>Total demo</span><strong data-stretch-total></strong></div>
        <a href="/demo/tiendas/stretch/checkout" class="mt-8 block rounded-full bg-black px-6 py-4 text-center text-[10px] uppercase tracking-widest text-white">Continuar compra</a>
      </div>
    </div>
  </main>
  <script>
    type CartItem = { slug:string; name:string; price:string; image:string; qty:number };
    const key = 'stretch-demo-cart';
    const root = document.querySelector<HTMLElement>('[data-stretch-cart]');
    const empty = document.querySelector<HTMLElement>('[data-stretch-empty]');
    const summary = document.querySelector<HTMLElement>('[data-stretch-summary]');
    const totalElement = document.querySelector<HTMLElement>('[data-stretch-total]');
    const cart = (() => { try { return JSON.parse(localStorage.getItem(key) || '[]') as CartItem[]; } catch { return [] as CartItem[]; } })();
    if (!cart.length) empty?.classList.remove('hidden');
    else if (root && summary && totalElement) {
      root.innerHTML = cart.map((item) => `<article class="flex items-center gap-5 border-b border-black/10 py-5"><img src="${item.image}" alt="" class="h-28 w-24 rounded-md bg-[#eee8e2] object-cover"><div class="flex-1"><h2 class="text-xl">${item.name}</h2><p class="mt-1 text-sm text-black/60">${item.price}</p></div><span>× ${item.qty}</span></article>`).join('');
      summary.classList.remove('hidden');
      const total = cart.reduce((sum, item) => sum + Number(item.price.replace('.', '').replace(',', '.').replace(' €', '')) * item.qty, 0);
      totalElement.textContent = new Intl.NumberFormat('es-ES', { style:'currency', currency:'EUR' }).format(total);
    }
  </script>
</Shop>
