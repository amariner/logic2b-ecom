---
/** STRETCH es una carcasa visual estática: su catálogo no consulta D1. */
import Shop from '../../../../layouts/Shop.astro';
import StretchCatalog from '../../../../components/themes/stretch/Catalog.astro';
import { stretchCollection } from '../../../../collections/stretch';
import { storePaths } from '../../../../lib/collections';

export const prerender = false;
const paths = storePaths(stretchCollection.id);
---

<Shop title="STRETCH" description={stretchCollection.description} collection={stretchCollection}>
  <StretchCatalog paths={paths} products={[]} collection={stretchCollection} sort="featured" />
</Shop>
