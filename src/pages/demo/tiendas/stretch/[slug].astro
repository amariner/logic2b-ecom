---
import Shop from '../../../../layouts/Shop.astro';
import { stretchCollection } from '../../../../collections/stretch';
import { stretchProductBySlug } from '../../../../collections/stretch-products';
import StretchProductDetail from '../../../../components/themes/stretch/ProductDetail.astro';

export const prerender = false;
const product = stretchProductBySlug.get(Astro.params.slug ?? '');
if (!product) return new Response(null, { status: 404 });
---

<Shop title={product.name} description={product.description} collection={stretchCollection}>
  <main class="bg-[#f9f4f0] text-black">
    <header class="flex items-center justify-between border-b border-black/10 px-5 py-5 sm:px-8 lg:px-10">
      <a href="/demo/tiendas/stretch" class="text-lg font-bold uppercase tracking-[.2em]">STRETCH</a>
      <nav class="flex items-center gap-5 text-[10px] uppercase tracking-[.12em]">
        <a href="/demo/tiendas/stretch#productos">Tienda</a>
        <a href="/demo/tiendas/stretch/carrito" class="rounded-full border border-black px-4 py-2">Carrito <span data-stretch-count>0</span></a>
      </nav>
    </header>
    <StretchProductDetail product={product} />
  </main>

  <script is:inline define:vars={{ slug: product.slug, productName: product.name, price: product.price, image: product.image }}>
    const key = 'stretch-demo-cart';
    const read = () => { try { return JSON.parse(localStorage.getItem(key) || '[]'); } catch { return []; } };
    const update = () => document.querySelectorAll('[data-stretch-count]').forEach((element) => { element.textContent = String(read().reduce((sum, item) => sum + item.qty, 0)); });
    const addButton = document.querySelector('[data-stretch-add]');
    addButton?.addEventListener('click', () => {
      const cart = read();
      const found = cart.find((item) => item.slug === slug);
      if (found) found.qty += 1;
      else cart.push({ slug, name: productName, price, image, qty: 1 });
      localStorage.setItem(key, JSON.stringify(cart));
      addButton.textContent = 'Añadido ✓';
      update();
    });
    update();
  </script>
</Shop>
