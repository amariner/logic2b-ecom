---
/**
 * Ficha de producto de una tienda del escaparate (9B.4). Colección y producto
 * validados; un slug de OTRA colección no resuelve aquí (404).
 */
import ProductPage from '../../../../components/store/ProductPage.astro';
import NoddoProductDetail from '../../../../components/themes/noddo/ProductDetail.astro';
import SitegaProductDetail from '../../../../components/themes/sitega/ProductDetail.astro';
import StretchProductDetail from '../../../../components/themes/stretch/ProductDetail.astro';
import { getDemoProduct, getDemoRelated } from '../../../../composition/demo-catalog';
import { resolveCollection } from '../../../../collections';
import { notFoundResponse } from '../../../../lib/not-found';

export const prerender = false;

const collection = resolveCollection(Astro.params.collection);
const { slug = '' } = Astro.params;
const product = collection ? getDemoProduct(collection.id, slug) : null;
const notFound = collection && product ? null : await notFoundResponse(Astro.locals.runtime.env, Astro.url);
if (!collection || !product || notFound) {
  return notFound;
}

const related = getDemoRelated(product);
const productPresentations = {
  noddo: NoddoProductDetail,
  sitega: SitegaProductDetail,
  stretch: StretchProductDetail,
} as const;
const ProductPresentation = productPresentations[collection.id as keyof typeof productPresentations];
---

<ProductPage
  collection={collection}
  product={product}
  related={related}
  site={Astro.site}
  customPresentation={Boolean(ProductPresentation)}
>
  {ProductPresentation && <ProductPresentation slot="presentation" product={product} />}
</ProductPage>
