---
import ThanksPage from '../../../../components/store/ThanksPage.astro';
import { resolveCollection } from '../../../../collections';
import { notFoundResponse } from '../../../../lib/not-found';

export const prerender = false;

const collection = resolveCollection(Astro.params.collection);
const notFound = collection ? null : await notFoundResponse(Astro.locals.runtime.env, Astro.url);
if (!collection || notFound) {
  return notFound;
}

const backLabels = {
  noddo: 'Volver a NODDO',
  sitega: 'Volver a Sitēga',
  stretch: 'Volver a STRETCH',
} as const;
const backLabel = backLabels[collection.id as keyof typeof backLabels];

---

<ThanksPage collection={collection}>
  {backLabel && <Fragment slot="back-label">{backLabel}</Fragment>}
</ThanksPage>
