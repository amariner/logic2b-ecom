---
/** Sitēga es una carcasa editorial estática: su catálogo no consulta D1. */
import Shop from '../../../../layouts/Shop.astro';
import SitegaCatalog from '../../../../components/themes/sitega/Catalog.astro';
import { sitegaCollection } from '../../../../collections/sitega';
import { storePaths } from '../../../../lib/collections';

export const prerender = false;
const paths = storePaths(sitegaCollection.id);
---

<Shop title="Product line" description={sitegaCollection.description} collection={sitegaCollection}>
  <SitegaCatalog paths={paths} products={[]} collection={sitegaCollection} sort="featured" />
</Shop>
