---
import Shop from '../../../../layouts/Shop.astro';
import { sitegaCollection } from '../../../../collections/sitega';
import { sitegaProductBySlug } from '../../../../collections/sitega-products';
import SitegaProductDetail from '../../../../components/themes/sitega/ProductDetail.astro';

export const prerender = false;
const product = sitegaProductBySlug.get(Astro.params.slug ?? '');
if (!product) return new Response(null, { status: 404 });
---

<Shop title={product.name} description={product.description} collection={sitegaCollection}>
  <main class="bg-[#f7f7f5] text-[#111]"><header class="flex items-center justify-between border-b border-black/10 px-5 py-5 md:px-10"><a href="/demo/tiendas/sitega" class="text-xl font-medium tracking-[-.06em]">Sitēga</a><nav class="flex items-center gap-5 text-[10px] uppercase tracking-[.12em]"><a href="/demo/tiendas/sitega">Catálogo</a><a href="/demo/tiendas/sitega/carrito" class="rounded-full border border-black px-4 py-2">Carrito <span data-sitega-count>0</span></a></nav></header><SitegaProductDetail product={product} /></main>
  <script is:inline define:vars={{ slug: product.slug, productName: product.name, price: product.price, image: product.image }}>
    const key='sitega-demo-cart';
    const read=()=>{try{return JSON.parse(localStorage.getItem(key)||'[]')}catch{return[]}};
    const update=()=>document.querySelectorAll('[data-sitega-count]').forEach(el=>el.textContent=String(read().reduce((sum,item)=>sum+item.qty,0)));
    const addButton=document.querySelector('[data-sitega-add]');
    addButton?.addEventListener('click',()=>{const cart=read();const found=cart.find(item=>item.slug===slug);if(found)found.qty+=1;else cart.push({slug,name:productName,price,image,qty:1});localStorage.setItem(key,JSON.stringify(cart));addButton.textContent='Añadido ✓';update()});
    update();
  </script>
</Shop>
