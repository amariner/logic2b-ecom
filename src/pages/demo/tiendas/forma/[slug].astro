---
import ProductPage from '../../../../components/store/ProductPage.astro';
import FormaProductDetail from '../../../../components/themes/forma/ProductDetail.astro';
import { formaCollection } from '../../../../collections/forma';
import { getDemoProduct, getDemoRelated } from '../../../../lib/demo-catalog';
import { categoryLabel, storePaths } from '../../../../collections';
import { notFoundResponse } from '../../../../lib/not-found';

export const prerender = false;
const product = getDemoProduct(formaCollection.id, Astro.params.slug ?? '');
const notFound = product ? null : await notFoundResponse(Astro.locals.runtime.env, Astro.url);
if (!product || notFound) return notFound;

const paths = storePaths(formaCollection.id);
const related = getDemoRelated(product);
---

<ProductPage collection={formaCollection} product={product} related={related} site={Astro.site}>
  <FormaProductDetail
    slot="presentation"
    product={product}
    categoryLabel={categoryLabel(formaCollection, product.category)}
    catalogPath={paths.catalog}
    cartPath={paths.cart}
  />
</ProductPage>
