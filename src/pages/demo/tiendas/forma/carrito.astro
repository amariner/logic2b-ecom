---
import CartPage from '../../../../components/store/CartPage.astro';
import { formaCollection } from '../../../../collections/forma';
import '../../../../components/themes/forma/commerce.css';
---

<CartPage collection={formaCollection}>
  <Fragment slot="heading">
    <header class="forma-commerce-header">
      <a href="/demo/tiendas/forma" class="text-xl font-medium tracking-[-.06em]">Forma</a>
      <a href="/demo/tiendas/forma" class="text-[10px] uppercase tracking-[.12em]">Seguir viendo</a>
    </header>
    <p class="mt-14 text-[10px] uppercase tracking-widest text-black/60">Carrito / Demo</p>
    <h1 class="mt-3 font-display text-6xl font-light tracking-[-.07em]">Tus productos.</h1>
  </Fragment>
  <p slot="empty">Tu carrito está vacío.</p>
</CartPage>
