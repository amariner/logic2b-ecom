---
import CheckoutPage from '../../../../components/store/CheckoutPage.astro';
import { formaCollection } from '../../../../collections/forma';
import '../../../../components/themes/forma/commerce.css';
---

<CheckoutPage collection={formaCollection}>
  <Fragment slot="heading">
    <a href="/demo/tiendas/forma" class="text-xl font-medium tracking-[-.06em]">Forma</a>
    <p class="mt-16 text-[10px] uppercase tracking-widest text-black/60">Compra / Demo</p>
    <h1 class="mt-3 font-display text-6xl font-light tracking-[-.07em]">Envío.</h1>
  </Fragment>
  <p slot="intro" class="mt-3 text-sm text-black/60">El total se valida en servidor. La demo registra el pedido sin solicitar datos de tarjeta.</p>
  <Fragment slot="submit-label">Completar pedido demo</Fragment>
  <p slot="footnote" class="mt-3 text-center text-xs text-black/60">No se solicitarán datos de tarjeta ni se realizará ningún cobro.</p>
</CheckoutPage>
