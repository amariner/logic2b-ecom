---
import ThanksPage from '../../../../components/store/ThanksPage.astro';
import { formaCollection } from '../../../../collections/forma';
import '../../../../components/themes/forma/commerce.css';

export const prerender = false;
---

<ThanksPage collection={formaCollection}>
    <div slot="success" class="text-center">
      <p class="text-[10px] uppercase tracking-[.2em] text-white/60">Referencia <span data-demo-order-number></span> / Demo local</p>
      <h1 class="mt-6 font-display text-7xl font-light leading-[.82] tracking-[-.08em] md:text-9xl">Listo.<br/>en calma.</h1>
      <p class="mx-auto mt-8 max-w-md text-white/70">
        Has completado una simulación por <strong class="text-white" data-demo-total></strong>. No se ha creado ningún pedido, descontado stock ni enviado nada a <span data-demo-email></span>.
      </p>
    </div>
    <div slot="missing" class="text-center">
      <p class="text-[10px] uppercase tracking-[.2em] text-white/60">Simulación no iniciada</p>
      <h1 class="mt-6 font-display text-6xl font-light tracking-[-.07em]">Aún no.</h1>
      <p class="mx-auto mt-6 max-w-md text-white/70">Completa el recorrido local de Forma para ver esta pantalla.</p>
    </div>
  <Fragment slot="back-label">Volver a Forma</Fragment>
</ThanksPage>
