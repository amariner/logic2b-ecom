---
import Shop from '../../../../layouts/Shop.astro';
import { noddoCollection } from '../../../../collections/noddo';
---
<Shop title="Checkout" description="Checkout visual NODDO" collection={noddoCollection}>
  <main class="min-h-screen bg-[#f7f7f5] px-5 py-8 text-[#111]">
    <div class="mx-auto max-w-xl">
      <a href="/demo/tiendas/noddo" class="text-xl font-black tracking-[-.08em]">NODDO®</a>
      <p class="mt-16 font-mono text-[10px] uppercase tracking-widest text-black/60">Checkout / Demo</p>
      <h1 class="mt-3 text-6xl tracking-[-.07em]">Delivery.</h1>
      <form data-noddo-checkout class="mt-10 space-y-4">
        <label class="sr-only" for="noddo-name">Nombre y apellidos</label><input id="noddo-name" required autocomplete="name" placeholder="Nombre y apellidos" class="w-full rounded-lg border border-black/15 bg-white px-4 py-4">
        <label class="sr-only" for="noddo-email">Email</label><input id="noddo-email" required type="email" autocomplete="email" placeholder="Email" class="w-full rounded-lg border border-black/15 bg-white px-4 py-4">
        <label class="sr-only" for="noddo-address">Dirección</label><input id="noddo-address" required autocomplete="street-address" placeholder="Dirección" class="w-full rounded-lg border border-black/15 bg-white px-4 py-4">
        <div class="grid grid-cols-2 gap-4"><label class="sr-only" for="noddo-postal-code">Código postal</label><input id="noddo-postal-code" required autocomplete="postal-code" placeholder="Código postal" class="rounded-lg border border-black/15 bg-white px-4 py-4"><label class="sr-only" for="noddo-city">Ciudad</label><input id="noddo-city" required autocomplete="address-level2" placeholder="Ciudad" class="rounded-lg border border-black/15 bg-white px-4 py-4"></div>
        <button class="w-full rounded-full bg-black px-6 py-4 text-sm uppercase tracking-widest text-white">Completar pedido demo</button>
        <p class="text-center text-xs text-black/60">No se solicitarán datos de tarjeta ni se realizará ningún cobro.</p>
      </form>
    </div>
  </main>
  <script>document.querySelector('[data-noddo-checkout]')?.addEventListener('submit',(event)=>{event.preventDefault();localStorage.removeItem('noddo-demo-cart');window.location.assign('/demo/tiendas/noddo/gracias')})</script>
</Shop>
