---
/**
 * NODDO es una carcasa visual del escaparate: no consulta D1 ni comparte
 * catálogo con el backoffice. La interacción vive enteramente en su tema.
 */
import Shop from '../../../../layouts/Shop.astro';
import NoddoCatalog from '../../../../components/themes/noddo/Catalog.astro';
import { noddoCollection } from '../../../../collections/noddo';
import { storePaths } from '../../../../lib/collections';

export const prerender = false;
const paths = storePaths(noddoCollection.id);
---

<Shop title="Product line" description={noddoCollection.description} collection={noddoCollection}>
  <NoddoCatalog
    paths={paths}
    products={[]}
    collection={noddoCollection}
    sort="featured"
  />
</Shop>
