---
import { canShowCurrencyMethodsDemo } from '../../../composition/currency-methods-demo';
import { runtimePlatform } from '../../../composition/runtime-platform';
import Admin from '../../../layouts/Admin.astro';
import AdminPageHeader from '../../../components/admin/AdminPageHeader.astro';
import CurrencyMethodsDemo from '../../../components/admin/CurrencyMethodsDemo.astro';

export const prerender = false;

if (!canShowCurrencyMethodsDemo(Astro.locals.runtime?.env, runtimePlatform)) {
  return new Response('Página no encontrada.', {
    status: 404,
    headers: { 'content-type': 'text/plain; charset=utf-8', 'cache-control': 'no-store' },
  });
}
---

<Admin title="Monedas y métodos" active="divisas">
  <AdminPageHeader eyebrow="Internacional · demostración" title="Monedas y métodos" description="Explora cómo se presenta un importe en otra moneda y por qué un método admite o no el contexto del ejemplo." />
  <CurrencyMethodsDemo />
</Admin>
