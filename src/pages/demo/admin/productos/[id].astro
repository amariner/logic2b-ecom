---
import Admin from '../../../../layouts/Admin.astro';
import { runtimePlatform } from '../../../../composition/runtime-platform';
import { createProductAdmin } from '../../../../modules/catalog';

export const prerender = false;

const productId = Number(Astro.params.id);
if (!Number.isInteger(productId) || productId <= 0 || !runtimePlatform.isCapabilityActive('CAT-003')) {
  return new Response('Producto no encontrado', { status: 404 });
}
const details = await createProductAdmin(Astro.locals.runtime.env.DB).details(productId);
if (!details) return new Response('Producto no encontrado', { status: 404 });

const readOnly = Astro.locals.runtime.env.DEMO_MODE === 'true';
const showMedia = runtimePlatform.isCapabilityActive('CAT-008');
const showAttributes = runtimePlatform.isCapabilityActive('CAT-007');
const attributeValueText = (value: (typeof details.attribute_values)[number]): string => {
  if (value.value_text !== null) return value.value_text;
  if (value.value_number !== null) return String(value.value_number);
  if (value.value_boolean !== null) return value.value_boolean === 1 ? 'true' : 'false';
  if (value.value_reference !== null) return value.value_reference;
  if (value.value_list_json !== null) {
    try { return (JSON.parse(value.value_list_json) as string[]).join(', '); } catch { return value.value_list_json; }
  }
  return '';
};
const typeLabel = { text: 'Texto', number: 'Número', boolean: 'Sí/no', reference: 'Referencia', list: 'Lista' } as const;
---

<Admin title={`Variantes · ${details.product.name}`} active="productos">
  <a href="/demo/admin/productos" class="inline-flex min-h-11 items-center text-sm text-stone-600 underline-offset-4 hover:underline">
    ← Volver a productos
  </a>

  <div class="mt-2 flex flex-wrap items-start justify-between gap-3">
    <div>
      <h1 class="text-2xl font-bold">{details.product.name}</h1>
      <p class="mt-1 font-mono text-xs text-stone-600">{details.product.slug}</p>
    </div>
    <span class:list={[
      'rounded-full px-3 py-1 text-xs font-medium',
      details.product.active === 1 ? 'bg-emerald-100 text-emerald-900' : 'bg-stone-200 text-stone-700',
    ]}>
      {details.product.active === 1 ? 'Producto publicado' : 'Producto oculto'}
    </span>
  </div>

  <p class="mt-4 max-w-3xl text-sm text-stone-600">
    {readOnly
      ? 'Configuración ficticia de ejemplo. En una tienda real, esta pantalla permite mantener opciones, valores y combinaciones.'
      : 'Cada combinación tiene su propio SKU, precio e identificadores. La marcada por defecto alimenta el escaparate y conserva el espejo compatible.'}
  </p>
  <p class="mt-2 max-w-3xl text-xs text-stone-600">
    El stock sigue siendo global para el producto ({details.product.stock} uds.) hasta la entrada del ledger por variante en R2.7.
  </p>

  <p data-catalog-status role="status" aria-live="polite" class="mt-4 min-h-6 text-sm text-stone-700"></p>

  {showMedia && (
    <section class="mt-2 rounded-xl border border-stone-300 bg-white p-4 sm:p-5" aria-labelledby="media-title">
      <div>
        <h2 id="media-title" class="text-lg font-semibold">Galería</h2>
        <p class="mt-1 text-sm text-stone-600">Orden, texto alternativo, foco de recorte y media específica por variante.</p>
      </div>
      <div class="mt-4 grid gap-4 lg:grid-cols-2">
        {details.media.map((media, mediaIndex) => (
          <form data-media-form data-media-id={media.id} class="rounded-lg border border-stone-200 p-4">
            <div class="grid gap-4 sm:grid-cols-[8rem_1fr]">
              <div class="overflow-hidden rounded-lg bg-stone-100">
                {media.kind === 'image' ? (
                  <img src={media.source} alt={media.alt_text} width="240" height="240" loading="lazy"
                    class="aspect-square h-full w-full object-cover"
                    style={`object-position:${media.focal_x_bps / 100}% ${media.focal_y_bps / 100}%`} />
                ) : (
                  <video src={media.source} aria-label={media.alt_text} controls preload="metadata" class="aspect-square h-full w-full object-cover"></video>
                )}
              </div>
              <div class="grid gap-3">
                <label class="text-xs font-medium text-stone-600">Tipo
                  <select name="kind" disabled={readOnly} class="mt-1 min-h-11 w-full rounded border border-stone-300 bg-white px-3 text-sm disabled:bg-stone-50">
                    <option value="image" selected={media.kind === 'image'}>Imagen</option>
                    <option value="video" selected={media.kind === 'video'}>Vídeo</option>
                  </select>
                </label>
                <label class="text-xs font-medium text-stone-600">Ruta o clave
                  <input name="source" value={media.source} required maxlength="500" disabled={readOnly}
                    class="mt-1 min-h-11 w-full rounded border border-stone-300 px-3 font-mono text-xs disabled:bg-stone-50" />
                </label>
                <label class="text-xs font-medium text-stone-600">Texto alternativo
                  <input name="alt_text" value={media.alt_text} required maxlength="240" disabled={readOnly}
                    class="mt-1 min-h-11 w-full rounded border border-stone-300 px-3 text-sm disabled:bg-stone-50" />
                </label>
              </div>
            </div>
            <div class="mt-3 grid gap-3 sm:grid-cols-2">
              <label class="text-xs font-medium text-stone-600">Foco horizontal (0–100 %)
                <input name="focal_x" type="number" min="0" max="100" step="0.01" value={media.focal_x_bps / 100} disabled={readOnly}
                  class="mt-1 min-h-11 w-full rounded border border-stone-300 px-3 text-sm disabled:bg-stone-50" />
              </label>
              <label class="text-xs font-medium text-stone-600">Foco vertical (0–100 %)
                <input name="focal_y" type="number" min="0" max="100" step="0.01" value={media.focal_y_bps / 100} disabled={readOnly}
                  class="mt-1 min-h-11 w-full rounded border border-stone-300 px-3 text-sm disabled:bg-stone-50" />
              </label>
            </div>
            <fieldset class="mt-3">
              <legend class="text-xs font-medium text-stone-600">Visible específicamente en variantes</legend>
              <div class="mt-2 flex flex-wrap gap-3">
                {details.variants.map((variant) => (
                  <label class="inline-flex min-h-11 items-center gap-2 text-xs">
                    <input type="checkbox" name="variant_ids" value={variant.id} checked={media.variant_ids.includes(variant.id)} disabled={readOnly} />
                    {variant.title || variant.sku}
                  </label>
                ))}
              </div>
            </fieldset>
            {!readOnly && (
              <div class="mt-3 flex flex-wrap gap-2">
                <button class="min-h-11 rounded bg-stone-900 px-4 text-sm font-medium text-white">Guardar media</button>
                <button type="button" data-move-media="-1" disabled={mediaIndex === 0}
                  aria-label={`Subir ${media.alt_text} una posición`}
                  class="min-h-11 rounded border border-stone-300 px-4 text-sm disabled:cursor-not-allowed disabled:opacity-40">↑ Subir</button>
                <button type="button" data-move-media="1" disabled={mediaIndex === details.media.length - 1}
                  aria-label={`Bajar ${media.alt_text} una posición`}
                  class="min-h-11 rounded border border-stone-300 px-4 text-sm disabled:cursor-not-allowed disabled:opacity-40">↓ Bajar</button>
                <button type="button" data-delete-media class="min-h-11 rounded px-4 text-sm text-red-700 hover:bg-red-50">Eliminar</button>
              </div>
            )}
          </form>
        ))}
      </div>
      {!readOnly && (
        <details class="mt-4 rounded-lg border border-dashed border-stone-400 p-4">
          <summary class="min-h-11 cursor-pointer py-2 font-medium">Añadir media</summary>
          <form data-create-media class="mt-3 grid gap-3 sm:grid-cols-2">
            <label class="text-xs font-medium text-stone-600">Tipo
              <select name="kind" class="mt-1 min-h-11 w-full rounded border border-stone-300 bg-white px-3"><option value="image">Imagen</option><option value="video">Vídeo</option></select>
            </label>
            <label class="text-xs font-medium text-stone-600">Ruta o clave
              <input name="source" required maxlength="500" class="mt-1 min-h-11 w-full rounded border border-stone-300 px-3 font-mono text-xs" />
            </label>
            <label class="text-xs font-medium text-stone-600 sm:col-span-2">Texto alternativo
              <input name="alt_text" required maxlength="240" class="mt-1 min-h-11 w-full rounded border border-stone-300 px-3" />
            </label>
            <label class="text-xs font-medium text-stone-600">Foco horizontal %
              <input name="focal_x" type="number" min="0" max="100" step="0.01" value="50" class="mt-1 min-h-11 w-full rounded border border-stone-300 px-3" />
            </label>
            <label class="text-xs font-medium text-stone-600">Foco vertical %
              <input name="focal_y" type="number" min="0" max="100" step="0.01" value="50" class="mt-1 min-h-11 w-full rounded border border-stone-300 px-3" />
            </label>
            <div class="sm:col-span-2"><button class="min-h-11 rounded bg-stone-900 px-4 text-sm font-medium text-white">Crear media</button></div>
          </form>
        </details>
      )}
    </section>
  )}

  {showAttributes && (
    <section class="mt-6 rounded-xl border border-stone-300 bg-white p-4 sm:p-5" aria-labelledby="attributes-title">
      <div>
        <h2 id="attributes-title" class="text-lg font-semibold">Atributos técnicos</h2>
        <p class="mt-1 text-sm text-stone-600">Valores tipados del producto; una variante puede sustituir el valor general.</p>
      </div>
      <div class="mt-4 space-y-4">
        {details.attribute_definitions.map((definition) => {
          const values = details.attribute_values.filter((value) => value.attribute_definition_id === definition.id);
          return (
            <article class="rounded-lg border border-stone-200 p-4">
              <form data-definition-form data-definition-id={definition.id} class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
                <label class="text-xs font-medium text-stone-600">Etiqueta
                  <input name="label" value={definition.label} maxlength="120" disabled={readOnly} class="mt-1 min-h-11 w-full rounded border border-stone-300 px-3 disabled:bg-stone-50" />
                </label>
                <label class="text-xs font-medium text-stone-600">Código
                  <input name="code" value={definition.code} maxlength="80" disabled={readOnly} class="mt-1 min-h-11 w-full rounded border border-stone-300 px-3 font-mono text-sm disabled:bg-stone-50" />
                </label>
                <label class="text-xs font-medium text-stone-600">Tipo
                  <select name="value_type" disabled={readOnly || definition.value_count > 0} class="mt-1 min-h-11 w-full rounded border border-stone-300 bg-white px-3 disabled:bg-stone-50">
                    {Object.entries(typeLabel).map(([type, label]) => <option value={type} selected={definition.value_type === type}>{label}</option>)}
                  </select>
                </label>
                <label class="text-xs font-medium text-stone-600">Unidad
                  <input name="unit" value={definition.unit ?? ''} maxlength="24" disabled={readOnly || definition.value_count > 0} class="mt-1 min-h-11 w-full rounded border border-stone-300 px-3 disabled:bg-stone-50" />
                </label>
                <label class="text-xs font-medium text-stone-600 sm:col-span-2 lg:col-span-3">Restricciones JSON
                  <input name="constraints" value={definition.constraints_json} disabled={readOnly || definition.value_count > 0} class="mt-1 min-h-11 w-full rounded border border-stone-300 px-3 font-mono text-xs disabled:bg-stone-50" />
                </label>
                <label class="inline-flex min-h-11 items-center gap-2 pt-5 text-sm"><input name="active" type="checkbox" checked={definition.active === 1} disabled={readOnly} /> Activo</label>
                {!readOnly && <div class="flex flex-wrap gap-2 sm:col-span-2 lg:col-span-4"><button class="min-h-11 rounded bg-stone-900 px-4 text-sm text-white">Guardar definición</button><button type="button" data-delete-definition class="min-h-11 rounded px-4 text-sm text-red-700">Eliminar</button></div>}
              </form>
              <ul class="mt-3 space-y-2">
                {values.map((value) => {
                  const variant = details.variants.find((candidate) => candidate.id === value.variant_id);
                  return (
                    <li>
                      <form data-attribute-value-form data-value-id={value.id} data-value-type={definition.value_type} class="flex flex-wrap items-end gap-2 rounded bg-stone-50 p-3">
                        <label class="min-w-32 flex-1 text-xs font-medium text-stone-600">{variant ? `Variante ${variant.title || variant.sku}` : 'Valor general'}
                          <input name="value" value={attributeValueText(value)} disabled={readOnly} class="mt-1 min-h-11 w-full rounded border border-stone-300 px-3 text-sm disabled:bg-white" />
                        </label>
                        {!readOnly && <><button class="min-h-11 rounded border border-stone-300 px-3 text-sm">Guardar</button><button type="button" data-delete-attribute-value class="min-h-11 rounded px-3 text-sm text-red-700">Eliminar</button></>}
                      </form>
                    </li>
                  );
                })}
              </ul>
            </article>
          );
        })}
      </div>
      {!readOnly && (
        <div class="mt-4 grid gap-4 lg:grid-cols-2">
          <form data-create-definition class="rounded-lg border border-dashed border-stone-400 p-4">
            <h3 class="font-medium">Nueva definición</h3>
            <div class="mt-3 grid gap-3 sm:grid-cols-2">
              <input name="label" required maxlength="120" placeholder="Etiqueta" aria-label="Etiqueta del atributo" class="min-h-11 rounded border border-stone-300 px-3" />
              <input name="code" required maxlength="80" placeholder="codigo_interno" aria-label="Código del atributo" class="min-h-11 rounded border border-stone-300 px-3 font-mono text-sm" />
              <select name="value_type" aria-label="Tipo del atributo" class="min-h-11 rounded border border-stone-300 bg-white px-3">{Object.entries(typeLabel).map(([type, label]) => <option value={type}>{label}</option>)}</select>
              <input name="unit" maxlength="24" placeholder="Unidad (solo número)" aria-label="Unidad del atributo" class="min-h-11 rounded border border-stone-300 px-3" />
              <input name="constraints" value="{}" aria-label="Restricciones JSON" class="min-h-11 rounded border border-stone-300 px-3 font-mono text-xs sm:col-span-2" />
              <button class="min-h-11 rounded bg-stone-900 px-4 text-sm font-medium text-white sm:col-span-2">Crear definición</button>
            </div>
          </form>
          <form data-create-attribute-value class="rounded-lg border border-dashed border-stone-400 p-4">
            <h3 class="font-medium">Nuevo valor</h3>
            <div class="mt-3 grid gap-3">
              <select name="definition_id" aria-label="Definición" required class="min-h-11 rounded border border-stone-300 bg-white px-3">
                <option value="">Selecciona atributo</option>
                {details.attribute_definitions.filter((definition) => definition.active === 1).map((definition) => <option value={definition.id} data-value-type={definition.value_type}>{definition.label} · {typeLabel[definition.value_type]}</option>)}
              </select>
              <select name="variant_id" aria-label="Ámbito del valor" class="min-h-11 rounded border border-stone-300 bg-white px-3"><option value="">Producto completo</option>{details.variants.map((variant) => <option value={variant.id}>Variante {variant.title || variant.sku}</option>)}</select>
              <input name="value" required placeholder="Valor; listas separadas por comas" aria-label="Valor del atributo" class="min-h-11 rounded border border-stone-300 px-3" />
              <button class="min-h-11 rounded bg-stone-900 px-4 text-sm font-medium text-white">Crear valor</button>
            </div>
          </form>
        </div>
      )}
    </section>
  )}

  <section class="mt-2 rounded-xl border border-stone-300 bg-white p-4 sm:p-5" aria-labelledby="options-title">
    <div class="flex flex-wrap items-start justify-between gap-3">
      <div>
        <h2 id="options-title" class="text-lg font-semibold">Opciones y valores</h2>
        <p class="mt-1 text-sm text-stone-600">Por ejemplo, «Talla» con los valores S, M y L.</p>
      </div>
      {!readOnly && (
        <form data-create-option class="flex flex-wrap gap-2">
          <label class="sr-only" for="new-option-name">Nueva opción</label>
          <input id="new-option-name" name="name" required maxlength="80" placeholder="Nueva opción"
            class="min-h-11 rounded border border-stone-300 px-3 text-sm" />
          <button class="min-h-11 rounded bg-stone-900 px-4 text-sm font-medium text-white hover:bg-stone-700">Añadir</button>
        </form>
      )}
    </div>

    {details.options.length === 0 ? (
      <p class="mt-4 rounded-lg bg-stone-50 p-4 text-sm text-stone-600">
        Producto simple: crea una opción antes de añadir combinaciones.
      </p>
    ) : (
      <div class="mt-4 grid gap-4 lg:grid-cols-2">
        {details.options.map((option) => (
          <article data-option-id={option.id} class="rounded-lg border border-stone-200 p-4">
            <div class="flex flex-wrap items-center gap-2">
              <label class="sr-only" for={`option-${option.id}`}>Nombre de la opción</label>
              <input id={`option-${option.id}`} data-option-name value={option.name} maxlength="80" disabled={readOnly}
                class="min-h-11 min-w-0 flex-1 rounded border border-stone-300 px-3 font-medium disabled:border-transparent disabled:bg-transparent disabled:px-0 disabled:text-stone-900" />
              {!readOnly && (
                <>
                  <button type="button" data-save-option class="min-h-11 rounded border border-stone-300 px-3 text-sm hover:bg-stone-50">Guardar</button>
                  <button type="button" data-delete-option class="min-h-11 rounded px-3 text-sm text-red-700 hover:bg-red-50">Eliminar</button>
                </>
              )}
            </div>

            <ul class="mt-3 space-y-2">
              {option.values.map((value) => (
                <li data-value-id={value.id} class="flex items-center gap-2">
                  <label class="sr-only" for={`value-${value.id}`}>Valor de {option.name}</label>
                  <input id={`value-${value.id}`} data-value-name value={value.value} maxlength="100" disabled={readOnly}
                    class="min-h-11 min-w-0 flex-1 rounded border border-stone-300 px-3 text-sm disabled:border-transparent disabled:bg-stone-50 disabled:text-stone-800" />
                  {!readOnly && (
                    <>
                      <button type="button" data-save-value class="min-h-11 rounded border border-stone-300 px-3 text-sm hover:bg-stone-50">Guardar</button>
                      <button type="button" data-delete-value aria-label={`Eliminar ${value.value}`} class="min-h-11 min-w-11 rounded text-red-700 hover:bg-red-50">×</button>
                    </>
                  )}
                </li>
              ))}
            </ul>
            {!readOnly && (
              <form data-create-value class="mt-3 flex gap-2">
                <label class="sr-only" for={`new-value-${option.id}`}>Nuevo valor de {option.name}</label>
                <input id={`new-value-${option.id}`} name="value" required maxlength="100" placeholder="Nuevo valor"
                  class="min-h-11 min-w-0 flex-1 rounded border border-stone-300 px-3 text-sm" />
                <button class="min-h-11 rounded bg-stone-800 px-3 text-sm font-medium text-white hover:bg-stone-700">Añadir</button>
              </form>
            )}
          </article>
        ))}
      </div>
    )}
  </section>

  <section class="mt-6" aria-labelledby="variants-title">
    <div>
      <h2 id="variants-title" class="text-lg font-semibold">Variantes</h2>
      <p class="mt-1 text-sm text-stone-600">
        No se puede borrar la combinación por defecto ni una variante que ya aparezca en pedidos; en ese caso se archiva.
      </p>
    </div>

    <div class="mt-4 space-y-4">
      {details.variants.map((variant) => (
        <form data-variant-form data-variant-id={variant.id} class="rounded-xl border border-stone-300 bg-white p-4 sm:p-5">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <div class="flex flex-wrap items-center gap-2">
              <h3 class="font-semibold">{variant.title || variant.sku}</h3>
              {variant.is_default && <span class="rounded-full bg-stone-900 px-2 py-0.5 text-xs text-white">Por defecto</span>}
              {variant.order_item_count > 0 && <span class="rounded-full bg-sky-100 px-2 py-0.5 text-xs text-sky-900">En pedidos</span>}
            </div>
            <span class="text-xs text-stone-500">#{variant.id}</span>
          </div>

          <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
            <label class="text-xs font-medium text-stone-600">Título
              <input name="title" value={variant.title} maxlength="160" disabled={readOnly}
                class="mt-1 min-h-11 w-full rounded border border-stone-300 px-3 text-sm disabled:bg-stone-50" />
            </label>
            <label class="text-xs font-medium text-stone-600">SKU
              <input name="sku" value={variant.sku} required maxlength="100" disabled={readOnly}
                class="mt-1 min-h-11 w-full rounded border border-stone-300 px-3 font-mono text-sm disabled:bg-stone-50" />
            </label>
            <label class="text-xs font-medium text-stone-600">Precio €
              <input name="price" value={(variant.price_cents / 100).toFixed(2)} required inputmode="decimal" disabled={readOnly}
                class="mt-1 min-h-11 w-full rounded border border-stone-300 px-3 text-sm disabled:bg-stone-50" />
            </label>
            <label class="text-xs font-medium text-stone-600">Precio anterior €
              <input name="compare_at" value={variant.compare_at_price_cents === null ? '' : (variant.compare_at_price_cents / 100).toFixed(2)} inputmode="decimal" disabled={readOnly}
                class="mt-1 min-h-11 w-full rounded border border-stone-300 px-3 text-sm disabled:bg-stone-50" />
            </label>
            <label class="text-xs font-medium text-stone-600">Estado
              <select name="status" disabled={readOnly} class="mt-1 min-h-11 w-full rounded border border-stone-300 bg-white px-3 text-sm disabled:bg-stone-50">
                <option value="active" selected={variant.status === 'active'}>Activa</option>
                <option value="draft" selected={variant.status === 'draft'}>Borrador</option>
                <option value="archived" selected={variant.status === 'archived'}>Archivada</option>
              </select>
            </label>
            <label class="text-xs font-medium text-stone-600">GTIN / EAN
              <input name="gtin" value={variant.gtin ?? ''} inputmode="numeric" pattern="[0-9]{8,14}" disabled={readOnly}
                class="mt-1 min-h-11 w-full rounded border border-stone-300 px-3 text-sm disabled:bg-stone-50" />
            </label>
            <label class="text-xs font-medium text-stone-600">MPN
              <input name="mpn" value={variant.mpn ?? ''} maxlength="100" disabled={readOnly}
                class="mt-1 min-h-11 w-full rounded border border-stone-300 px-3 text-sm disabled:bg-stone-50" />
            </label>
            {details.options.map((option) => (
              <label class="text-xs font-medium text-stone-600">{option.name}
                <select data-option-value name={`option-${option.id}`} required disabled={readOnly}
                  class="mt-1 min-h-11 w-full rounded border border-stone-300 bg-white px-3 text-sm disabled:bg-stone-50">
                  <option value="">Sin asignar</option>
                  {option.values.map((value) => (
                    <option value={value.id} selected={variant.option_value_ids.includes(value.id)}>{value.value}</option>
                  ))}
                </select>
              </label>
            ))}
          </div>

          {!readOnly && (
            <div class="mt-4 flex flex-wrap gap-2">
              <button class="min-h-11 rounded bg-stone-900 px-4 text-sm font-medium text-white hover:bg-stone-700">Guardar variante</button>
              {!variant.is_default && (
                <button data-make-default class="min-h-11 rounded border border-stone-400 px-4 text-sm font-medium hover:bg-stone-50">
                  Marcar por defecto
                </button>
              )}
              {!variant.is_default && (
                <button type="button" data-delete-variant class="min-h-11 rounded px-4 text-sm font-medium text-red-700 hover:bg-red-50">
                  Eliminar
                </button>
              )}
            </div>
          )}
        </form>
      ))}
    </div>

    {!readOnly && details.options.length > 0 && details.options.every((option) => option.values.length > 0) && (
      <details class="mt-4 rounded-xl border border-dashed border-stone-400 bg-white p-4">
        <summary class="min-h-11 cursor-pointer py-2 font-medium">Añadir variante</summary>
        <form data-create-variant class="mt-3 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
          <label class="text-xs font-medium text-stone-600">Título
            <input name="title" maxlength="160" class="mt-1 min-h-11 w-full rounded border border-stone-300 px-3 text-sm" />
          </label>
          <label class="text-xs font-medium text-stone-600">SKU
            <input name="sku" required maxlength="100" class="mt-1 min-h-11 w-full rounded border border-stone-300 px-3 font-mono text-sm" />
          </label>
          <label class="text-xs font-medium text-stone-600">Precio €
            <input name="price" required inputmode="decimal" class="mt-1 min-h-11 w-full rounded border border-stone-300 px-3 text-sm" />
          </label>
          <label class="text-xs font-medium text-stone-600">Precio anterior €
            <input name="compare_at" inputmode="decimal" class="mt-1 min-h-11 w-full rounded border border-stone-300 px-3 text-sm" />
          </label>
          <label class="text-xs font-medium text-stone-600">Estado
            <select name="status" class="mt-1 min-h-11 w-full rounded border border-stone-300 bg-white px-3 text-sm">
              <option value="active">Activa</option>
              <option value="draft">Borrador</option>
              <option value="archived">Archivada</option>
            </select>
          </label>
          <label class="text-xs font-medium text-stone-600">GTIN / EAN
            <input name="gtin" inputmode="numeric" pattern="[0-9]{8,14}" class="mt-1 min-h-11 w-full rounded border border-stone-300 px-3 text-sm" />
          </label>
          <label class="text-xs font-medium text-stone-600">MPN
            <input name="mpn" maxlength="100" class="mt-1 min-h-11 w-full rounded border border-stone-300 px-3 text-sm" />
          </label>
          {details.options.map((option) => (
            <label class="text-xs font-medium text-stone-600">{option.name}
              <select data-option-value name={`option-${option.id}`} required class="mt-1 min-h-11 w-full rounded border border-stone-300 bg-white px-3 text-sm">
                <option value="">Selecciona</option>
                {option.values.map((value) => <option value={value.id}>{value.value}</option>)}
              </select>
            </label>
          ))}
          <div class="sm:col-span-2 lg:col-span-4">
            <button class="min-h-11 rounded bg-stone-900 px-4 text-sm font-medium text-white hover:bg-stone-700">Crear variante</button>
          </div>
        </form>
      </details>
    )}
  </section>

  <script is:inline define:vars={{ productId }}>
    const statusElement = document.querySelector('[data-catalog-status]');

    function setStatus(message, error = false) {
      if (!(statusElement instanceof HTMLElement)) return;
      statusElement.textContent = message;
      statusElement.classList.toggle('text-red-700', error);
      statusElement.classList.toggle('text-stone-700', !error);
      statusElement.scrollIntoView({ block: 'nearest' });
    }

    async function mutate(method, url, body) {
      setStatus('Guardando…');
      const response = await fetch(url, {
        method,
        headers: body === undefined ? undefined : { 'content-type': 'application/json' },
        body: body === undefined ? undefined : JSON.stringify(body),
      });
      if (!response.ok) {
        const payload = await response.json().catch(() => ({}));
        setStatus(`Error: ${payload.error ?? 'inesperado'}`, true);
        return false;
      }
      setStatus('Guardado ✓');
      window.location.reload();
      return true;
    }

    function cents(value) {
      const normalized = String(value).trim().replace(',', '.');
      if (normalized === '') return null;
      const result = Math.round(Number(normalized) * 100);
      return Number.isInteger(result) && result >= 0 ? result : NaN;
    }

    function mediaPayload(form) {
      const data = new FormData(form);
      const focalX = Math.round(Number(data.get('focal_x')) * 100);
      const focalY = Math.round(Number(data.get('focal_y')) * 100);
      if (![focalX, focalY].every((value) => Number.isInteger(value) && value >= 0 && value <= 10000)) {
        setStatus('El foco debe estar entre 0 y 100 %.', true);
        return null;
      }
      return {
        kind: String(data.get('kind') ?? ''),
        source: String(data.get('source') ?? '').trim(),
        alt_text: String(data.get('alt_text') ?? '').trim(),
        focal_x_bps: focalX,
        focal_y_bps: focalY,
        variant_ids: data.getAll('variant_ids').map(Number),
      };
    }

    function definitionPayload(form) {
      const data = new FormData(form);
      let constraints;
      try { constraints = JSON.parse(String(data.get('constraints') ?? '{}')); }
      catch { setStatus('Las restricciones deben ser JSON válido.', true); return null; }
      if (!constraints || Array.isArray(constraints) || typeof constraints !== 'object') {
        setStatus('Las restricciones deben ser un objeto JSON.', true);
        return null;
      }
      return {
        code: String(data.get('code') ?? '').trim(),
        label: String(data.get('label') ?? '').trim(),
        value_type: String(data.get('value_type') ?? ''),
        unit: String(data.get('unit') ?? '').trim() || null,
        constraints,
        active: data.get('active') === 'on' || !form.hasAttribute('data-definition-form'),
      };
    }

    function typedAttributeValue(type, raw) {
      const value = String(raw).trim();
      if (type === 'number') {
        const number = Number(value.replace(',', '.'));
        if (!Number.isFinite(number)) { setStatus('El valor debe ser numérico.', true); return null; }
        return { type, value: number };
      }
      if (type === 'boolean') {
        const normalized = value.toLocaleLowerCase('es');
        if (['true', '1', 'sí', 'si'].includes(normalized)) return { type, value: true };
        if (['false', '0', 'no'].includes(normalized)) return { type, value: false };
        setStatus('Usa sí/no o true/false para un atributo booleano.', true);
        return null;
      }
      if (type === 'list') return { type, value: value.split(',').map((item) => item.trim()).filter(Boolean) };
      if (type === 'text' || type === 'reference') return { type, value };
      setStatus('Tipo de atributo desconocido.', true);
      return null;
    }

    document.querySelectorAll('[data-media-form]').forEach((element) => {
      if (!(element instanceof HTMLFormElement)) return;
      const mediaId = element.dataset.mediaId ?? '';
      element.addEventListener('submit', (event) => {
        event.preventDefault();
        const payload = mediaPayload(element);
        if (payload) void mutate('PATCH', `/api/admin/catalog-media/${mediaId}`, payload);
      });
      element.querySelector('[data-delete-media]')?.addEventListener('click', () => {
        if (window.confirm('¿Eliminar esta media de la galería?')) void mutate('DELETE', `/api/admin/catalog-media/${mediaId}`);
      });
      element.querySelectorAll('[data-move-media]').forEach((button) => {
        button.addEventListener('click', () => {
          if (!(button instanceof HTMLButtonElement)) return;
          const forms = [...document.querySelectorAll('[data-media-form]')];
          const currentIndex = forms.indexOf(element);
          const nextIndex = currentIndex + Number(button.dataset.moveMedia);
          if (currentIndex < 0 || nextIndex < 0 || nextIndex >= forms.length) return;
          const orderedIds = forms.map((form) => Number((form instanceof HTMLElement ? form.dataset.mediaId : '') ?? ''));
          [orderedIds[currentIndex], orderedIds[nextIndex]] = [orderedIds[nextIndex], orderedIds[currentIndex]];
          void mutate('PUT', `/api/admin/catalog-media/product/${productId}`, { ordered_ids: orderedIds });
        });
      });
    });

    const createMediaForm = document.querySelector('[data-create-media]');
    createMediaForm?.addEventListener('submit', (event) => {
      event.preventDefault();
      if (!(createMediaForm instanceof HTMLFormElement)) return;
      const payload = mediaPayload(createMediaForm);
      if (payload) void mutate('POST', `/api/admin/catalog-media/product/${productId}`, payload);
    });

    document.querySelectorAll('[data-definition-form]').forEach((element) => {
      if (!(element instanceof HTMLFormElement)) return;
      const definitionId = element.dataset.definitionId ?? '';
      element.addEventListener('submit', (event) => {
        event.preventDefault();
        const payload = definitionPayload(element);
        if (payload) void mutate('PATCH', `/api/admin/catalog-attributes/definitions/${definitionId}`, payload);
      });
      element.querySelector('[data-delete-definition]')?.addEventListener('click', () => {
        if (window.confirm('¿Eliminar esta definición sin valores?')) void mutate('DELETE', `/api/admin/catalog-attributes/definitions/${definitionId}`);
      });
    });

    const createDefinitionForm = document.querySelector('[data-create-definition]');
    createDefinitionForm?.addEventListener('submit', (event) => {
      event.preventDefault();
      if (!(createDefinitionForm instanceof HTMLFormElement)) return;
      const payload = definitionPayload(createDefinitionForm);
      if (payload) void mutate('POST', `/api/admin/catalog-attributes/definitions/product/${productId}`, payload);
    });

    document.querySelectorAll('[data-attribute-value-form]').forEach((element) => {
      if (!(element instanceof HTMLFormElement)) return;
      const valueId = element.dataset.valueId ?? '';
      element.addEventListener('submit', (event) => {
        event.preventDefault();
        const input = element.elements.namedItem('value');
        const payload = typedAttributeValue(element.dataset.valueType, input instanceof HTMLInputElement ? input.value : '');
        if (payload) void mutate('PATCH', `/api/admin/catalog-attributes/values/${valueId}`, payload);
      });
      element.querySelector('[data-delete-attribute-value]')?.addEventListener('click', () => {
        if (window.confirm('¿Eliminar este valor?')) void mutate('DELETE', `/api/admin/catalog-attributes/values/${valueId}`);
      });
    });

    const createAttributeValueForm = document.querySelector('[data-create-attribute-value]');
    createAttributeValueForm?.addEventListener('submit', (event) => {
      event.preventDefault();
      if (!(createAttributeValueForm instanceof HTMLFormElement)) return;
      const data = new FormData(createAttributeValueForm);
      const definition = createAttributeValueForm.elements.namedItem('definition_id');
      const option = definition instanceof HTMLSelectElement ? definition.selectedOptions[0] : null;
      const value = typedAttributeValue(option?.dataset.valueType, data.get('value'));
      if (!value) return;
      const variant = String(data.get('variant_id') ?? '');
      void mutate('POST', `/api/admin/catalog-attributes/values/product/${productId}`, {
        definition_id: Number(data.get('definition_id')),
        variant_id: variant ? Number(variant) : null,
        value,
      });
    });

    function variantPayload(form, makeDefault = false) {
      const data = new FormData(form);
      const price = cents(data.get('price'));
      const compare = cents(data.get('compare_at'));
      if (!Number.isInteger(price) || Number.isNaN(compare)) {
        setStatus('Revisa los importes de la variante.', true);
        return null;
      }
      const optionValueIds = [...form.querySelectorAll('[data-option-value]')].map((element) =>
        element instanceof HTMLSelectElement ? Number(element.value) : NaN,
      );
      if (optionValueIds.some((value) => !Number.isInteger(value) || value <= 0)) {
        setStatus('Selecciona un valor para cada opción.', true);
        return null;
      }
      return {
        sku: String(data.get('sku') ?? '').trim(),
        gtin: String(data.get('gtin') ?? '').trim() || null,
        mpn: String(data.get('mpn') ?? '').trim() || null,
        title: String(data.get('title') ?? '').trim(),
        price_cents: price,
        compare_at_price_cents: compare,
        status: String(data.get('status') ?? ''),
        option_value_ids: optionValueIds,
        ...(makeDefault ? { make_default: true } : {}),
      };
    }

    document.querySelector('[data-create-option]')?.addEventListener('submit', (event) => {
      event.preventDefault();
      if (!(event.currentTarget instanceof HTMLFormElement)) return;
      const name = String(new FormData(event.currentTarget).get('name') ?? '').trim();
      void mutate('POST', `/api/admin/catalog-options/product/${productId}`, { name });
    });

    document.querySelectorAll('[data-option-id]').forEach((container) => {
      if (!(container instanceof HTMLElement)) return;
      const optionId = container.dataset.optionId ?? '';
      const nameInput = container.querySelector('[data-option-name]');
      container.querySelector('[data-save-option]')?.addEventListener('click', () => {
        if (nameInput instanceof HTMLInputElement) {
          void mutate('PATCH', `/api/admin/catalog-options/${optionId}`, { name: nameInput.value.trim() });
        }
      });
      container.querySelector('[data-delete-option]')?.addEventListener('click', () => {
        if (window.confirm('¿Eliminar esta opción y sus valores sin usar?')) {
          void mutate('DELETE', `/api/admin/catalog-options/${optionId}`);
        }
      });
      const createValueForm = container.querySelector('[data-create-value]');
      createValueForm?.addEventListener('submit', (event) => {
        event.preventDefault();
        if (!(createValueForm instanceof HTMLFormElement)) return;
        const value = String(new FormData(createValueForm).get('value') ?? '').trim();
        void mutate('POST', `/api/admin/catalog-option-values/option/${optionId}`, { value });
      });
    });

    document.querySelectorAll('[data-value-id]').forEach((row) => {
      if (!(row instanceof HTMLElement)) return;
      const valueId = row.dataset.valueId ?? '';
      const input = row.querySelector('[data-value-name]');
      row.querySelector('[data-save-value]')?.addEventListener('click', () => {
        if (input instanceof HTMLInputElement) {
          void mutate('PATCH', `/api/admin/catalog-option-values/${valueId}`, { value: input.value.trim() });
        }
      });
      row.querySelector('[data-delete-value]')?.addEventListener('click', () => {
        if (window.confirm('¿Eliminar este valor sin usar?')) {
          void mutate('DELETE', `/api/admin/catalog-option-values/${valueId}`);
        }
      });
    });

    document.querySelectorAll('[data-variant-form]').forEach((element) => {
      if (!(element instanceof HTMLFormElement)) return;
      const variantId = element.dataset.variantId ?? '';
      element.addEventListener('submit', (event) => {
        event.preventDefault();
        const submitter = event instanceof SubmitEvent ? event.submitter : null;
        const payload = variantPayload(element, submitter instanceof HTMLElement && submitter.hasAttribute('data-make-default'));
        if (payload) void mutate('PATCH', `/api/admin/catalog-variants/${variantId}`, payload);
      });
      element.querySelector('[data-delete-variant]')?.addEventListener('click', () => {
        if (window.confirm('¿Eliminar esta variante? Si ya aparece en pedidos, el servidor lo impedirá.')) {
          void mutate('DELETE', `/api/admin/catalog-variants/${variantId}`);
        }
      });
    });

    const createVariantForm = document.querySelector('[data-create-variant]');
    createVariantForm?.addEventListener('submit', (event) => {
      event.preventDefault();
      if (!(createVariantForm instanceof HTMLFormElement)) return;
      const payload = variantPayload(createVariantForm);
      if (payload) void mutate('POST', `/api/admin/catalog-variants/product/${productId}`, payload);
    });
  </script>
</Admin>
