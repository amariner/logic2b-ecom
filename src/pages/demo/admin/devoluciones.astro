---
import Admin from '../../../layouts/Admin.astro';
import AdminPageHeader from '../../../components/admin/AdminPageHeader.astro';
import { createReturnOperations } from '../../../composition/return-operations';

export const prerender = false;
const readOnly = Astro.locals.runtime.env.DEMO_MODE === 'true';
const operations = createReturnOperations(Astro.locals.runtime.env.DB);
const [records, options] = await Promise.all([operations.list(), operations.adminOptions()]);
const details = (await Promise.all(records.map((record) => operations.find(record.id))))
  .filter((detail) => detail !== null);
const { orders, locations, variants } = options;
const statusLabel = { requested: 'Solicitada', authorized: 'Autorizada', in_transit: 'En tránsito',
  received: 'Recibida', inspected: 'Inspeccionada', resolved: 'Resuelta', rejected: 'Rechazada',
  cancelled: 'Cancelada' } as const;
const resolutionLabel = { refund: 'Reembolso', exchange: 'Cambio', reject: 'Rechazo', pending: 'Pendiente' } as const;
const inspectionLabel = { restock: 'Reponer', damaged: 'Dañado', reject: 'Rechazar', pending: 'Pendiente' } as const;
const reasonLabel = { damaged: 'Dañado', defective: 'Defectuoso', wrong_item: 'Artículo incorrecto',
  not_as_expected: 'No era lo esperado', other: 'Otro' } as const;
---

<Admin title="Devoluciones" active="devoluciones">
  <AdminPageHeader eyebrow="Logística inversa" title="Devoluciones y RMA" description="Autoriza, recibe e inspecciona mercancía antes de reembolsar, cambiar o reponer stock." />

  <section class="mt-6 grid gap-4 sm:grid-cols-4" aria-label="Resumen de devoluciones">
    <div class="rounded-2xl border border-border bg-card p-4 shadow-sm"><p class="text-xs font-semibold uppercase tracking-[0.12em] text-muted-foreground">Abiertas</p><p class="mt-2 font-display text-2xl">{records.filter((item) => !['resolved','rejected','cancelled'].includes(item.status)).length}</p></div>
    <div class="rounded-2xl border border-border bg-card p-4 shadow-sm"><p class="text-xs font-semibold uppercase tracking-[0.12em] text-muted-foreground">Por recibir</p><p class="mt-2 font-display text-2xl">{records.filter((item) => ['authorized','in_transit'].includes(item.status)).length}</p></div>
    <div class="rounded-2xl border border-border bg-card p-4 shadow-sm"><p class="text-xs font-semibold uppercase tracking-[0.12em] text-muted-foreground">Por resolver</p><p class="mt-2 font-display text-2xl">{records.filter((item) => ['received','inspected'].includes(item.status)).length}</p></div>
    <div class="rounded-2xl border border-border bg-card p-4 shadow-sm"><p class="text-xs font-semibold uppercase tracking-[0.12em] text-muted-foreground">Cerradas</p><p class="mt-2 font-display text-2xl">{records.filter((item) => ['resolved','rejected'].includes(item.status)).length}</p></div>
  </section>

  <section class="mt-6 rounded-2xl border border-border bg-card shadow-sm" aria-labelledby="returns-title">
    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-border p-5"><div><h2 id="returns-title" class="font-display text-xl">Cola RMA</h2><p class="mt-1 text-sm text-muted-foreground">{records.length} expedientes con versión e historial inmutable</p></div>{readOnly && <span class="rounded-full bg-sky-50 px-3 py-1 text-xs font-semibold text-sky-800 ring-1 ring-sky-200">Solo lectura</span>}</div>
    <div class="grid gap-4 p-4 sm:p-5 xl:grid-cols-2">
      {details.length === 0 && <p class="rounded-2xl border border-dashed border-border p-8 text-center text-sm text-muted-foreground xl:col-span-2">No hay devoluciones registradas.</p>}
      {details.map(({ request: item, lines, events }) => <article class="rounded-2xl border border-border p-4 sm:p-5">
        <div class="flex flex-wrap items-start justify-between gap-3"><div><p class="font-mono text-xs text-muted-foreground">{item.return_number}</p><h3 class="mt-1 font-display text-lg">Pedido {item.order_number}</h3><p class="mt-1 text-xs text-muted-foreground">{reasonLabel[item.reason_code as keyof typeof reasonLabel] ?? item.reason_code} · {item.receive_location_name}</p></div><span class="rounded-full bg-muted px-2.5 py-1 text-xs font-semibold">{statusLabel[item.status]}</span></div>
        <ul class="mt-4 space-y-2">{lines.map((line) => <li class="rounded-xl bg-muted/60 p-3 text-sm"><div class="flex flex-wrap justify-between gap-2"><span class="font-semibold">{line.name}</span><span class="font-mono text-xs text-muted-foreground">{line.sku}</span></div><p class="mt-1 text-xs text-muted-foreground">Solicitadas {line.requested_quantity} · recibidas {line.received_quantity} · {inspectionLabel[line.inspection]} · {resolutionLabel[line.resolution]}</p></li>)}</ul>
        <p class="mt-3 text-xs text-muted-foreground">Versión {item.version} · {events.length} hitos · actualizado {new Date(item.updated_at).toLocaleString('es-ES')}</p>

        {item.status === 'requested' && <form data-return-action data-id={item.id} data-action="authorize" data-version={item.version} class="mt-4"><p data-status role="status" aria-live="polite" class="min-h-6 text-sm text-muted-foreground"></p><button disabled={readOnly} class="min-h-11 rounded-xl bg-foreground px-5 text-sm font-semibold text-background disabled:opacity-45">Autorizar RMA</button></form>}
        {item.status === 'authorized' && <form data-return-action data-id={item.id} data-action="in_transit" data-version={item.version} class="mt-4"><p data-status role="status" aria-live="polite" class="min-h-6 text-sm text-muted-foreground"></p><button disabled={readOnly} class="min-h-11 rounded-xl bg-foreground px-5 text-sm font-semibold text-background disabled:opacity-45">Marcar en tránsito</button></form>}
        {['authorized','in_transit'].includes(item.status) && <form data-return-lines data-id={item.id} data-action="receive" data-version={item.version} class="mt-4 rounded-xl border border-border p-3"><p class="text-sm font-semibold">Registrar recepción</p>{lines.map((line) => <label class="mt-3 grid grid-cols-[minmax(0,1fr)_6rem] items-center gap-3 text-sm"><span>{line.sku} · máximo {line.requested_quantity}</span><input data-line-id={line.id} type="number" min="1" max={line.requested_quantity} value={line.requested_quantity} disabled={readOnly} class="min-h-11 rounded-xl border border-input bg-background px-3 disabled:opacity-100" /></label>)}<p data-status role="status" aria-live="polite" class="mt-2 min-h-6 text-sm text-muted-foreground"></p><button disabled={readOnly} class="min-h-11 rounded-xl bg-foreground px-5 text-sm font-semibold text-background disabled:opacity-45">Confirmar recepción</button></form>}
        {item.status === 'received' && <form data-return-lines data-id={item.id} data-action="inspect" data-version={item.version} class="mt-4 rounded-xl border border-border p-3"><p class="text-sm font-semibold">Inspeccionar lote completo</p>{lines.map((line) => <div data-inspection-line data-line-id={line.id} class="mt-3 grid gap-2 rounded-xl bg-muted/60 p-3 sm:grid-cols-3"><label class="text-xs font-semibold">Estado<select name="inspection" disabled={readOnly} class="mt-1 min-h-11 w-full rounded-xl border border-input bg-background px-2 font-normal disabled:opacity-100"><option value="restock">Apto para reponer</option><option value="damaged">Dañado</option><option value="reject">Rechazar</option></select></label><label class="text-xs font-semibold">Resolución<select name="resolution" disabled={readOnly} class="mt-1 min-h-11 w-full rounded-xl border border-input bg-background px-2 font-normal disabled:opacity-100"><option value="refund">Reembolso</option><option value="exchange">Cambio</option><option value="reject">Rechazo</option></select></label><label class="text-xs font-semibold">Variante de cambio<select name="exchange_variant_id" disabled={readOnly} class="mt-1 min-h-11 w-full rounded-xl border border-input bg-background px-2 font-normal disabled:opacity-100"><option value="">No aplica</option>{variants.map((variant) => <option value={variant.id}>{variant.name} · {variant.sku}</option>)}</select></label></div>)}<p data-status role="status" aria-live="polite" class="mt-2 min-h-6 text-sm text-muted-foreground"></p><button disabled={readOnly} class="min-h-11 rounded-xl bg-foreground px-5 text-sm font-semibold text-background disabled:opacity-45">Guardar inspección</button></form>}
        {item.status === 'inspected' && <form data-return-action data-id={item.id} data-action="resolve" data-version={item.version} class="mt-4"><p class="text-sm text-muted-foreground">El cierre aplica dinero, cambio y stock en una única unidad atómica.</p><p data-status role="status" aria-live="polite" class="min-h-6 text-sm text-muted-foreground"></p><button disabled={readOnly} class="min-h-11 rounded-xl bg-foreground px-5 text-sm font-semibold text-background disabled:opacity-45">Resolver RMA</button></form>}
      </article>)}
    </div>
  </section>

  <section class="mt-6 grid gap-6 xl:grid-cols-[minmax(0,1fr)_22rem]">
    <form data-return-create class="rounded-2xl border border-border bg-card p-5 shadow-sm"><h2 class="font-display text-lg">Nueva solicitud</h2><p class="mt-1 text-sm text-muted-foreground">Solo aparecen pedidos entregados y unidades aún no reclamadas.</p><div class="mt-5 grid gap-4 sm:grid-cols-2"><label class="text-sm font-semibold">Pedido<select name="order_id" required disabled={readOnly} class="mt-2 min-h-11 w-full rounded-xl border border-input bg-background px-3 font-normal disabled:opacity-100"><option value="">Selecciona…</option>{orders.map((order) => <option value={order.id}>{order.order_number}</option>)}</select></label><label class="text-sm font-semibold">Recepción<select name="receive_location_id" required disabled={readOnly} class="mt-2 min-h-11 w-full rounded-xl border border-input bg-background px-3 font-normal disabled:opacity-100">{locations.map((location) => <option value={location.id}>{location.name}</option>)}</select></label><label class="text-sm font-semibold">Motivo<select name="reason" disabled={readOnly} class="mt-2 min-h-11 w-full rounded-xl border border-input bg-background px-3 font-normal disabled:opacity-100"><option value="not_as_expected">No era lo esperado</option><option value="damaged">Dañado</option><option value="defective">Defectuoso</option><option value="wrong_item">Artículo incorrecto</option><option value="other">Otro</option></select></label><label class="text-sm font-semibold">Referencia solicitante<input name="requested_by_id" value="admin-panel" minlength="2" maxlength="80" disabled={readOnly} class="mt-2 min-h-11 w-full rounded-xl border border-input bg-background px-3 font-normal disabled:opacity-100" /></label></div><div data-eligible-lines class="mt-4 rounded-xl border border-dashed border-border p-4 text-sm text-muted-foreground">Selecciona un pedido para cargar sus líneas elegibles.</div><label class="mt-4 block text-sm font-semibold">Nota opcional<input name="note" maxlength="500" disabled={readOnly} class="mt-2 min-h-11 w-full rounded-xl border border-input bg-background px-3 font-normal disabled:opacity-100" /></label><p data-status role="status" aria-live="polite" class="mt-2 min-h-6 text-sm text-muted-foreground"></p><button disabled={readOnly} class="min-h-11 rounded-xl bg-foreground px-5 text-sm font-semibold text-background disabled:opacity-45">Crear solicitud</button></form>
    <aside class="h-fit rounded-2xl border border-border bg-card p-5 shadow-sm"><h2 class="font-display text-lg">Cuándo vuelve el stock</h2><p class="mt-3 text-sm leading-6 text-muted-foreground">La autorización no mueve inventario. Solo una inspección marcada como apta para reponer crea el movimiento al resolver el expediente.</p></aside>
  </section>

  {!readOnly && <script>
    const post = (url: string, method: string, body: unknown) => fetch(url, { method, headers: { 'content-type': 'application/json' }, body: JSON.stringify(body) });
    const key = (form: HTMLFormElement, scope: string) => form.dataset.key ??= `${scope}:${crypto.randomUUID()}`;
    const show = (form: HTMLFormElement, message: string, error = false) => { const node = form.querySelector<HTMLElement>('[data-status]'); if (!node) return; node.textContent = message; node.classList.toggle('text-red-700', error); };
    document.querySelectorAll<HTMLFormElement>('[data-return-action]').forEach((form) => form.addEventListener('submit', async (event) => { event.preventDefault(); show(form, 'Aplicando…'); const action = form.dataset.action!; const response = await post(`/api/admin/returns/${form.dataset.id}`, 'PATCH', { action, expected_version: Number(form.dataset.version), idempotency_key: key(form, `return:${action}`) }); const payload = await response.json() as { error?: string }; if (!response.ok) return show(form, payload.error ?? 'No se pudo aplicar.', true); location.reload(); }));
    document.querySelectorAll<HTMLFormElement>('[data-return-lines]').forEach((form) => form.addEventListener('submit', async (event) => { event.preventDefault(); const action = form.dataset.action!; show(form, 'Guardando…'); const lines = action === 'receive' ? [...form.querySelectorAll<HTMLInputElement>('[data-line-id]')].map((input) => ({ return_line_id: input.dataset.lineId!, received_quantity: Number(input.value) })) : [...form.querySelectorAll<HTMLElement>('[data-inspection-line]')].map((row) => { const resolution = (row.querySelector('[name="resolution"]') as unknown as HTMLSelectElement).value; const exchange = Number((row.querySelector('[name="exchange_variant_id"]') as unknown as HTMLSelectElement).value); return { return_line_id: row.dataset.lineId!, inspection: (row.querySelector('[name="inspection"]') as unknown as HTMLSelectElement).value, resolution, ...(resolution === 'exchange' && exchange > 0 ? { exchange_variant_id: exchange } : {}) }; }); const response = await post(`/api/admin/returns/${form.dataset.id}`, 'PATCH', { action, expected_version: Number(form.dataset.version), idempotency_key: key(form, `return:${action}`), lines }); const payload = await response.json() as { error?: string }; if (!response.ok) return show(form, payload.error ?? 'No se pudo guardar.', true); location.reload(); }));
    const create = document.querySelector<HTMLFormElement>('[data-return-create]'); const order = create?.querySelector('[name="order_id"]') as unknown as HTMLSelectElement | null | undefined; const linesNode = create?.querySelector<HTMLElement>('[data-eligible-lines]');
    order?.addEventListener('change', async () => { if (!linesNode || !order.value) return; linesNode.textContent = 'Cargando…'; const response = await fetch(`/api/admin/returns?order_id=${encodeURIComponent(order.value)}`); const payload = await response.json() as { eligibility?: Array<{ orderItemId: number; deliveredQuantity: number; claimedQuantity: number }> }; const lines = payload.eligibility ?? []; linesNode.innerHTML = lines.length ? lines.map((line) => `<label class="flex items-center justify-between gap-3 py-2"><span>Línea ${line.orderItemId} · disponibles ${line.deliveredQuantity - line.claimedQuantity}</span><input data-order-item-id="${line.orderItemId}" type="number" min="0" max="${line.deliveredQuantity - line.claimedQuantity}" value="0" class="min-h-11 w-24 rounded-xl border border-input bg-background px-3"></label>`).join('') : 'No quedan unidades elegibles.'; });
    create?.addEventListener('submit', async (event) => { event.preventDefault(); const data = new FormData(create); const lines = [...create.querySelectorAll<HTMLInputElement>('[data-order-item-id]')].flatMap((input) => Number(input.value) > 0 ? [{ order_item_id: Number(input.dataset.orderItemId), quantity: Number(input.value) }] : []); show(create, 'Creando…'); const response = await post('/api/admin/returns', 'POST', { order_id: Number(data.get('order_id')), receive_location_id: Number(data.get('receive_location_id')), reason: String(data.get('reason')), requested_by_kind: 'admin', requested_by_id: String(data.get('requested_by_id')), note: String(data.get('note') ?? ''), lines, idempotency_key: key(create, 'return:create') }); const payload = await response.json() as { error?: string }; if (!response.ok) return show(create, payload.error ?? 'No se pudo crear.', true); location.reload(); });
  </script>}
</Admin>
