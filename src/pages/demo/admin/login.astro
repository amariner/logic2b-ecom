---
/**
 * Acceso al panel. La demo entra mediante un enlace guiado sin formulario;
 * la cookie firmada identifica el recorrido y no escribe en la base de datos.
 * En producción el panel va además tras Cloudflare Access (ver docs/PRODUCCION.md).
 */
import Base from '../../../layouts/Base.astro';
import { runtimePlatform } from '../../../composition/runtime-platform';
import DemoAssistant from '../../../components/store/DemoAssistant.astro';
import { shopConfig } from '../../../../shop.config';
import { MAIN_DEMO_HREF, MAIN_DEMO_NAME } from '../../../lib/nav';
import { demoAdminNextPath } from '../../../shared-kernel/demo-guide-routes';
import AdminIcon from '../../../components/admin/AdminIcon.astro';
import {
  ADMIN_COOKIE_NAME,
  DEMO_ADMIN_PASSWORD,
  SESSION_TTL_MS,
  createSessionToken,
  resolveCookieSecret,
  isGuidedDemoEntry,
} from '../../../lib/admin-auth';

export const prerender = false;

const env = Astro.locals.runtime.env;
const demoMode = runtimePlatform.manifest.deployment.mode === 'demo' || env.DEMO_MODE === 'true';
const secret = resolveCookieSecret(env);

const rawNext = Astro.url.searchParams.get('next') ?? '';
const nextPath = demoAdminNextPath(rawNext);

const loggedOut = Astro.url.searchParams.has('salir');
if (loggedOut) {
  Astro.cookies.delete(ADMIN_COOKIE_NAME, { path: '/' });
}

// El middleware redirige aquí con `limited=1` cuando el rate limit del login corta el paso.
const rateLimited = Astro.url.searchParams.has('limited');

// La guía entra al panel ficticio sin pedir contraseña. La cookie sigue
// firmada y todas las escrituras siguen bloqueadas por DEMO_MODE en servidor.
if (secret && isGuidedDemoEntry(env.DEMO_MODE, Astro.request.method, Astro.url.searchParams.get('tour'), loggedOut, rateLimited)) {
  Astro.cookies.set(ADMIN_COOKIE_NAME, await createSessionToken(secret), {
    path: '/', httpOnly: true, sameSite: 'lax', secure: Astro.url.protocol === 'https:',
    maxAge: SESSION_TTL_MS / 1000,
  });
  return Astro.redirect(nextPath, 303);
}

let error: string | null = null;
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const password = String(form.get('password') ?? '');
  if (demoMode && secret && password === DEMO_ADMIN_PASSWORD) {
    Astro.cookies.set(ADMIN_COOKIE_NAME, await createSessionToken(secret), {
      path: '/',
      httpOnly: true,
      sameSite: 'lax',
      secure: Astro.url.protocol === 'https:',
      maxAge: SESSION_TTL_MS / 1000,
    });
    return Astro.redirect(nextPath, 303);
  }
  error = demoMode
    ? `Contraseña incorrecta. En esta demo es «${DEMO_ADMIN_PASSWORD}».`
    : 'Login demo deshabilitado: en producción el acceso al panel va tras Cloudflare Access.';
}
---

<Base title={`Acceso al panel · ${shopConfig.backofficeName}`} noindex>
  <DemoAssistant />
  <div class="admin-shell grid min-h-screen bg-[#f7f7f8] lg:grid-cols-[minmax(0,1fr)_minmax(28rem,38rem)]">
    <section class="hidden bg-foreground p-12 text-background lg:flex lg:flex-col lg:justify-between xl:p-16">
      <a href="/" class="font-display text-xl">Logic2B <span class="text-background/60">Gestión</span></a>
      <div class="max-w-2xl"><p class="text-xs font-semibold uppercase tracking-[0.18em] text-background/50">Panel del comercio</p><h2 class="mt-4 font-display text-5xl leading-[1.08] xl:text-6xl">Tu tienda.<br/>Sin misterios.</h2><p class="mt-6 max-w-lg text-lg leading-8 text-background/65">Pedidos, productos, envíos y comunicaciones. Solo lo necesario para operar bien cada día.</p></div>
      <p class="text-sm text-background/50">Logic2B Ecommerce · Demo con datos ficticios</p>
    </section>

    <div class="flex min-h-screen flex-col">
      <div class="border-b border-sky-200 bg-sky-50 px-4 py-2 text-center text-xs font-medium text-sky-950">Panel ficticio de solo lectura · datos independientes de los escaparates</div>
      <main class="mx-auto flex w-full max-w-md flex-1 flex-col justify-center px-5 py-10 sm:px-8">
        <a href="/" class="mb-10 font-display text-lg lg:hidden">Logic2B <span class="text-muted-foreground">Gestión</span></a>
        <div class="rounded-2xl border border-border bg-card p-6 shadow-sm sm:p-8">
          <span class="flex size-11 items-center justify-center rounded-xl bg-foreground text-background"><AdminIcon name="store"/></span>
          <p class="mt-6 text-xs font-semibold uppercase tracking-[0.16em] text-muted-foreground">Centro de operaciones</p>
          <h1 class="mt-2 font-display text-3xl">Acceso al panel</h1>
          <p class="mt-2 text-sm leading-6 text-muted-foreground">Entra en el entorno de demostración para recorrer la operativa de una tienda.</p>

        {demoMode && (
          <p class="mt-5 rounded-xl border border-emerald-200 bg-emerald-50 p-4 text-sm leading-6 text-emerald-950">
            El panel muestra datos ficticios de solo lectura. Puedes recorrerlo
            sin enviar un formulario ni crear una cuenta.
          </p>
        )}

        {loggedOut && !error && (
          <p class="mt-5 rounded-xl border border-border bg-muted p-4 text-sm">Sesión cerrada.</p>
        )}

        {rateLimited && !error && (
          <p class="mt-5 rounded-xl border border-amber-200 bg-amber-50 p-4 text-sm text-amber-950">Demasiados intentos seguidos; espera un momento y vuelve a intentarlo.</p>
        )}

        {error && <p role="alert" class="mt-5 rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-950">{error}</p>}

        {demoMode ? <a href={`/demo/admin/login?tour=1&next=${encodeURIComponent(nextPath)}`} class="mt-5 flex min-h-12 w-full items-center justify-center rounded-xl bg-foreground px-4 font-semibold text-background shadow-sm hover:bg-foreground/85">Explorar el panel de ejemplo</a> : <form method="post" action={`/demo/admin/login?next=${encodeURIComponent(nextPath)}`} class="mt-5">
          <label class="block text-sm font-semibold" for="password">Contraseña</label>
          <input
            id="password"
            name="password"
            type="password"
            required
            autocomplete="current-password"
            autofocus
            class="mt-2 min-h-12 w-full rounded-xl border border-input bg-background px-3 shadow-sm"
          />
          <button
            type="submit"
            class="mt-4 min-h-12 w-full rounded-xl bg-foreground px-4 font-semibold text-background shadow-sm hover:bg-foreground/85"
          >Entrar</button>
        </form>}
        </div>
        <p class="mt-5 text-center text-sm text-muted-foreground"><a href={MAIN_DEMO_HREF} class="inline-flex min-h-11 items-center gap-2 font-medium hover:text-foreground"><AdminIcon name="arrow-left" class="size-4"/>Volver a {MAIN_DEMO_NAME}</a></p>
      </main>
    </div>
  </div>
  <style is:global>
    /* Mismo criterio que Admin.astro: titulares en Inter, sin fuente de marca. */
    .admin-shell { --font-display: var(--font-sans); --tracking-display: -0.025em; }
  </style>
</Base>
