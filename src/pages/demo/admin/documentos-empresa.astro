---
import { canShowCompanyDocumentDemo } from '../../../composition/company-document-demo';
import { runtimePlatform } from '../../../composition/runtime-platform';
import Admin from '../../../layouts/Admin.astro';
import AdminPageHeader from '../../../components/admin/AdminPageHeader.astro';
import CompanyDocumentDemo from '../../../components/admin/CompanyDocumentDemo.astro';

export const prerender = false;

if (!canShowCompanyDocumentDemo(Astro.locals.runtime?.env, runtimePlatform)) {
  return new Response('Página no encontrada.', {
    status: 404,
    headers: { 'content-type': 'text/plain; charset=utf-8', 'cache-control': 'no-store' },
  });
}
---

<Admin title="Referencias y documentos" active="documentos-empresa">
  <AdminPageHeader eyebrow="Clientes · demostración" title="Referencias y documentos" description="Lee una referencia de compra y compara los datos declarados de un documento de ejemplo, campo a campo." />
  <CompanyDocumentDemo />
</Admin>
