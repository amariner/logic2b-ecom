---
import { canShowVariantQuantityDemo } from '../../../composition/variant-quantity-demo';
import { runtimePlatform } from '../../../composition/runtime-platform';
import Admin from '../../../layouts/Admin.astro';
import AdminPageHeader from '../../../components/admin/AdminPageHeader.astro';
import VariantQuantityDemo from '../../../components/admin/VariantQuantityDemo.astro';

export const prerender = false;

if (!canShowVariantQuantityDemo(Astro.locals.runtime?.env, runtimePlatform)) {
  return new Response('Página no encontrada.', {
    status: 404,
    headers: { 'content-type': 'text/plain; charset=utf-8', 'cache-control': 'no-store' },
  });
}
---

<Admin title="Mínimos, múltiplos y cajas" active="cantidades">
  <AdminPageHeader eyebrow="Clientes · demostración" title="Mínimos, múltiplos y cajas" description="Comprueba cómo una cantidad cumple el rango y el múltiplo de su variante, tanto por unidades como por cajas." />
  <VariantQuantityDemo />
</Admin>
