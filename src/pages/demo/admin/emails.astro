---
import Admin from '../../../layouts/Admin.astro';
import AdminIcon from '../../../components/admin/AdminIcon.astro';
import AdminPageHeader from '../../../components/admin/AdminPageHeader.astro';
import { MAIN_DEMO_HREF } from '../../../lib/nav';
import { getOutbox } from '../../../modules/notifications';

export const prerender = false;
const db = Astro.locals.runtime.env.DB;
const demoMode = Astro.locals.runtime.env.DEMO_MODE === 'true';
const EMAIL_LIMIT = 100;
const { emails, total } = await getOutbox(db, EMAIL_LIMIT);
const date = (value: string) => new Intl.DateTimeFormat('es-ES', { dateStyle: 'medium', timeStyle: 'short' }).format(new Date(value));
---

<Admin title="Emails" active="emails">
  <AdminPageHeader eyebrow="Comunicaciones" title="Emails" description="Previsualiza las confirmaciones de pedido y los avisos de envío generados por el sistema. En producción se entregan con el dominio del comercio." />

  <section class="mt-6 overflow-hidden rounded-2xl border border-border bg-card shadow-sm" aria-labelledby="outbox-title">
    <div class="flex items-center justify-between gap-4 border-b border-border p-5"><div><h2 id="outbox-title" class="font-display text-xl">Bandeja de salida simulada</h2><p class="mt-1 text-sm text-muted-foreground">{total} mensaje{total === 1 ? '' : 's'} capturado{total === 1 ? '' : 's'}</p></div><span class="flex size-11 items-center justify-center rounded-xl bg-muted text-muted-foreground"><AdminIcon name="email"/></span></div>
    {total > EMAIL_LIMIT && <p class="border-b border-amber-200 bg-amber-50 px-5 py-3 text-sm text-amber-950">Mostrando los {EMAIL_LIMIT} más recientes de {total}. Los anteriores siguen en la copia SQL.</p>}
    {emails.length > 0 && <div class="divide-y divide-border">{emails.map((email, index) => <details class="group" open={index === 0}>
      <summary class="flex min-h-16 cursor-pointer list-none items-center gap-4 px-4 py-3 hover:bg-muted/60 sm:px-5"><span class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-muted text-muted-foreground"><AdminIcon name="email" class="size-4"/></span><span class="min-w-0 flex-1"><span class="block truncate text-sm font-semibold">{email.subject}</span><span class="mt-1 block truncate text-xs text-muted-foreground">Para {email.to_addr} · {date(email.created_at)}</span></span><AdminIcon name="chevron" class="size-4 shrink-0 text-muted-foreground transition group-open:rotate-90"/></summary>
      <div class="border-t border-border bg-muted/30 p-3 sm:p-5"><div class="overflow-hidden rounded-xl border border-border bg-white"><div class="flex flex-wrap items-center justify-between gap-2 border-b border-border bg-card px-4 py-3 text-xs"><span class="font-semibold text-foreground">Vista previa</span><span class="text-muted-foreground">HTML aislado y sin scripts</span></div><iframe srcdoc={email.body_html} title={`Vista previa: ${email.subject}`} sandbox="" class="h-[32rem] w-full bg-white sm:h-[38rem]"></iframe></div></div>
    </details>)}</div>}
    {emails.length === 0 && <div class="px-5 py-14 text-center"><span class="mx-auto flex size-12 items-center justify-center rounded-2xl bg-muted text-muted-foreground"><AdminIcon name="email"/></span><h3 class="mt-4 font-display text-lg">La bandeja está vacía</h3><p class="mx-auto mt-2 max-w-md text-sm leading-6 text-muted-foreground">Los emails aparecerán aquí cuando el sistema procese un pedido de ejemplo.</p><a href={MAIN_DEMO_HREF} class="mt-5 inline-flex min-h-11 items-center rounded-xl border border-border px-4 text-sm font-semibold hover:bg-muted">Ver tienda ARCE</a></div>}
  </section>

  {demoMode && <section class="mt-6 rounded-2xl bg-foreground p-6 text-background shadow-sm sm:p-8"><p class="text-xs font-semibold uppercase tracking-[0.16em] text-background/60">Fin del recorrido</p><h2 class="mt-2 font-display text-2xl">Esto es todo lo que hay que aprender.</h2><p class="mt-3 max-w-2xl text-sm leading-6 text-background/70">Has visto el escaparate y, por separado, ejemplos de pedidos y emails del panel. Una tienda real funciona igual con tu marca y tus datos.</p><div class="mt-5 flex flex-wrap gap-3 text-sm font-semibold"><a href="https://wa.me/34626434316?text=Hola%2C%20acabo%20de%20probar%20la%20demo%20de%20Logic2B%20Ecommerce." class="inline-flex min-h-11 items-center rounded-xl bg-background px-4 text-foreground">WhatsApp 626 434 316</a><a href="mailto:hola@logic2b.com?subject=Mi%20tienda%20online%20con%20Logic2B%20Ecommerce" class="inline-flex min-h-11 items-center rounded-xl border border-background/30 px-4 text-background">hola@logic2b.com</a><a href="/#precios" class="inline-flex min-h-11 items-center rounded-xl px-3 text-background/80 hover:text-background">Ver precios</a></div></section>}
</Admin>
