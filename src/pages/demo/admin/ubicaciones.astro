---
import Admin from '../../../layouts/Admin.astro';
import AdminIcon from '../../../components/admin/AdminIcon.astro';
import AdminPageHeader from '../../../components/admin/AdminPageHeader.astro';
import { createInventoryLocationOperations } from '../../../composition/inventory-location-operations';

export const prerender = false;
const readOnly = Astro.locals.runtime.env.DEMO_MODE === 'true';
const locations = await createInventoryLocationOperations(Astro.locals.runtime.env.DB).list();
---

<Admin title="Ubicaciones" active="ubicaciones">
  <AdminPageHeader eyebrow="Inventario" title="Ubicaciones" description="Separa almacenes y tiendas sin perder la compatibilidad con el inventario global existente." />

  <section class="mt-6 rounded-2xl border border-border bg-card shadow-sm" aria-labelledby="locations-title">
    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-border p-5">
      <div><h2 id="locations-title" class="font-display text-xl">Red operativa</h2><p class="mt-1 text-sm text-muted-foreground">{locations.length} ubicaciones · el stock histórico vive en la principal</p></div>
      {readOnly && <span class="rounded-full bg-sky-50 px-3 py-1 text-xs font-semibold text-sky-800 ring-1 ring-sky-200">Solo lectura</span>}
    </div>
    <div class="grid gap-4 p-4 sm:p-5 lg:grid-cols-2 xl:grid-cols-3">
      {locations.map((location) => <article class="rounded-2xl border border-border p-4">
        <div class="flex items-start justify-between gap-3"><span class="flex size-11 items-center justify-center rounded-xl bg-muted text-muted-foreground"><AdminIcon name="store" /></span><div class="flex flex-wrap justify-end gap-2">{location.is_primary === 1 && <span class="rounded-full bg-emerald-50 px-2.5 py-1 text-xs font-semibold text-emerald-800">Principal</span>}<span class:list={['rounded-full px-2.5 py-1 text-xs font-semibold', location.status === 'active' ? 'bg-sky-50 text-sky-800' : 'bg-muted text-muted-foreground']}>{location.status === 'active' ? 'Activa' : 'Inactiva'}</span></div></div>
        <h3 class="mt-4 font-display text-lg">{location.name}</h3><p class="mt-1 font-mono text-xs text-muted-foreground">{location.code} · {location.kind === 'warehouse' ? 'Almacén' : 'Tienda'}</p>
        <dl class="mt-4 grid grid-cols-3 gap-2 border-t border-border pt-4 text-sm"><div><dt class="text-xs text-muted-foreground">Variantes</dt><dd class="mt-1 font-semibold">{location.variant_count}</dd></div><div><dt class="text-xs text-muted-foreground">Físico</dt><dd class="mt-1 font-semibold">{location.on_hand}</dd></div><div><dt class="text-xs text-muted-foreground">Reservado</dt><dd class="mt-1 font-semibold">{location.reserved}</dd></div></dl>
        <p class="mt-4 text-xs text-muted-foreground">{location.timezone} · versión {location.version}</p>
      </article>)}
    </div>
  </section>

  <section class="mt-6 grid gap-6 xl:grid-cols-[minmax(0,1fr)_22rem]">
    <form data-location-form class="rounded-2xl border border-border bg-card p-5 shadow-sm">
      <h2 class="font-display text-lg">Añadir ubicación</h2><p class="mt-1 text-sm text-muted-foreground">Las nuevas ubicaciones nacen sin stock. Transferencias y asignación llegan en los bloques siguientes.</p>
      <div class="mt-5 grid gap-4 sm:grid-cols-2"><label class="text-sm font-semibold">Nombre<input name="name" required minlength="2" maxlength="100" disabled={readOnly} class="mt-2 min-h-11 w-full rounded-xl border border-input bg-background px-3 font-normal disabled:opacity-100" /></label><label class="text-sm font-semibold">Código<input name="code" required minlength="2" maxlength="32" disabled={readOnly} placeholder="almacen-norte" class="mt-2 min-h-11 w-full rounded-xl border border-input bg-background px-3 font-mono font-normal disabled:opacity-100" /></label><label class="text-sm font-semibold">Tipo<select name="kind" disabled={readOnly} class="mt-2 min-h-11 w-full rounded-xl border border-input bg-background px-3 font-normal disabled:opacity-100"><option value="warehouse">Almacén</option><option value="store">Tienda</option></select></label><label class="text-sm font-semibold">Zona horaria<input name="timezone" value="Europe/Madrid" disabled={readOnly} class="mt-2 min-h-11 w-full rounded-xl border border-input bg-background px-3 font-normal disabled:opacity-100" /></label></div>
      <p data-location-status role="status" aria-live="polite" class="mt-3 min-h-6 text-sm text-muted-foreground"></p><button type="submit" disabled={readOnly} class="mt-2 min-h-11 rounded-xl bg-foreground px-5 text-sm font-semibold text-background disabled:cursor-not-allowed disabled:opacity-45">Crear ubicación</button>
    </form>
    <aside class="h-fit rounded-2xl border border-border bg-card p-5 shadow-sm"><h2 class="font-display text-lg">Compatibilidad segura</h2><p class="mt-3 text-sm leading-6 text-muted-foreground">La ubicación principal refleja cada balance, reserva y movimiento global. Un Worker anterior sigue siendo compatible durante el despliegue gradual.</p><p class="mt-3 text-sm leading-6 text-muted-foreground">No cambies la principal ni repartas stock manualmente: R3.7 añadirá transferencias trazables.</p></aside>
  </section>

  {!readOnly && <script>
    const form = document.querySelector<HTMLFormElement>('[data-location-form]');
    const status = document.querySelector<HTMLElement>('[data-location-status]');
    form?.addEventListener('submit', async (event) => { event.preventDefault(); if (!status) return; status.textContent = 'Guardando…'; const data = new FormData(form); const response = await fetch('/api/admin/inventory-locations', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(Object.fromEntries(data)) }); const payload = await response.json() as { error?: string }; if (!response.ok) { status.textContent = payload.error ?? 'No se pudo crear.'; status.classList.add('text-red-700'); return; } location.reload(); });
  </script>}
</Admin>
