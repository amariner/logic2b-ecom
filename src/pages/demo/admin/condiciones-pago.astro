---
import { canShowCompanyCollectionDemo } from '../../../composition/company-collection-demo';
import { runtimePlatform } from '../../../composition/runtime-platform';
import Admin from '../../../layouts/Admin.astro';
import AdminPageHeader from '../../../components/admin/AdminPageHeader.astro';
import CompanyCollectionDemo from '../../../components/admin/CompanyCollectionDemo.astro';

export const prerender = false;

if (!canShowCompanyCollectionDemo(Astro.locals.runtime?.env, runtimePlatform)) {
  return new Response('Página no encontrada.', {
    status: 404,
    headers: { 'content-type': 'text/plain; charset=utf-8', 'cache-control': 'no-store' },
  });
}
---

<Admin title="Condiciones y cobros de ejemplo" active="condiciones-pago">
  <AdminPageHeader eyebrow="Clientes · demostración" title="Condiciones y cobros de ejemplo" description="Distingue las fechas de una condición de pago de los importes que declara una evidencia de ejemplo." />
  <CompanyCollectionDemo />
</Admin>
