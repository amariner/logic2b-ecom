---
import Admin from '../../../layouts/Admin.astro';
import AdminIcon from '../../../components/admin/AdminIcon.astro';
import AdminNotice from '../../../components/admin/AdminNotice.astro';
import AdminPageHeader from '../../../components/admin/AdminPageHeader.astro';
import AdminStatusBadge from '../../../components/admin/AdminStatusBadge.astro';
import { formatEurCents } from '../../../lib/format';
import { MAIN_DEMO_HREF } from '../../../lib/nav';
import { ORDER_STATUSES } from '../../../lib/order-transitions';
import { runtimePlatform } from '../../../composition/runtime-platform';
import { createOrderReader } from '../../../modules/orders';

export const prerender = false;

const rawStatus = Astro.url.searchParams.get('estado') ?? '';
const status = (ORDER_STATUSES as readonly string[]).includes(rawStatus) ? rawStatus : undefined;
const search = (Astro.url.searchParams.get('q') ?? '').trim().slice(0, 120);
const rawPage = Number(Astro.url.searchParams.get('pagina') ?? '1');
const page = Number.isInteger(rawPage) && rawPage > 0 ? rawPage : 1;
const ORDER_LIMIT = 25;
const { orders, counts, total } = await createOrderReader(Astro.locals.runtime.env.DB).list({
  status, search, limit: ORDER_LIMIT, offset: (page - 1) * ORDER_LIMIT,
});
const countFor = (st: string): number => counts.find((c) => c.status === st)?.n ?? 0;
const allCount = counts.reduce((sum, c) => sum + c.n, 0);
const pageCount = Math.max(1, Math.ceil(total / ORDER_LIMIT));
const canBackup = runtimePlatform.hasCapabilityFlag('INT-004', 'routes');
const canExport = runtimePlatform.hasCapabilityFlag('FUL-003', 'routes');
const statusLabel: Record<string, string> = {
  pending: 'Pendiente', paid: 'Pagado', shipped: 'Enviado', delivered: 'Entregado', cancelled: 'Cancelado',
};
const hrefFor = (next: { status?: string | undefined; page?: number | undefined }) => {
  const params = new URLSearchParams();
  if (next.status) params.set('estado', next.status);
  if (search) params.set('q', search);
  if ((next.page ?? 1) > 1) params.set('pagina', String(next.page));
  const qs = params.toString();
  return `/demo/admin${qs ? `?${qs}` : ''}`;
};
const date = (value: string) => new Intl.DateTimeFormat('es-ES', { day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit' }).format(new Date(value));
---

<Admin title="Pedidos" active="pedidos">
  <AdminPageHeader eyebrow="Operación diaria" title="Pedidos" description="Controla cobros, preparación y entrega desde una vista clara. Los datos de esta demo son ficticios y no pertenecen a ningún escaparate.">
    {canBackup && <a slot="actions" href="/api/admin/backup.sql" download class="inline-flex min-h-11 items-center gap-2 rounded-xl border border-border bg-card px-4 text-sm font-semibold shadow-sm hover:bg-muted"><AdminIcon name="download" class="size-4" />Copia SQL</a>}
    {canExport && <a slot="actions" href="/api/admin/orders/export.csv" download class="inline-flex min-h-11 items-center gap-2 rounded-xl bg-foreground px-4 text-sm font-semibold text-background shadow-sm hover:bg-foreground/85"><AdminIcon name="download" class="size-4" />Exportar envíos</a>}
  </AdminPageHeader>

  <section class="mt-6 grid gap-3 sm:grid-cols-2 xl:grid-cols-4" aria-label="Resumen de pedidos">
    <div class="rounded-2xl border border-border bg-card p-5 shadow-sm"><p class="text-xs font-semibold uppercase tracking-[0.14em] text-muted-foreground">Total</p><p class="mt-3 text-3xl font-semibold tracking-tight">{allCount}</p><p class="mt-1 text-sm text-muted-foreground">pedidos registrados</p></div>
    <div class="rounded-2xl border border-border bg-card p-5 shadow-sm"><p class="text-xs font-semibold uppercase tracking-[0.14em] text-muted-foreground">Por preparar</p><p class="mt-3 text-3xl font-semibold tracking-tight text-amber-700">{countFor('paid')}</p><p class="mt-1 text-sm text-muted-foreground">pagados y pendientes de envío</p></div>
    <div class="rounded-2xl border border-border bg-card p-5 shadow-sm"><p class="text-xs font-semibold uppercase tracking-[0.14em] text-muted-foreground">En tránsito</p><p class="mt-3 text-3xl font-semibold tracking-tight text-sky-700">{countFor('shipped')}</p><p class="mt-1 text-sm text-muted-foreground">enviados al cliente</p></div>
    <div class="rounded-2xl border border-border bg-card p-5 shadow-sm"><p class="text-xs font-semibold uppercase tracking-[0.14em] text-muted-foreground">Completados</p><p class="mt-3 text-3xl font-semibold tracking-tight text-emerald-700">{countFor('delivered')}</p><p class="mt-1 text-sm text-muted-foreground">entregas confirmadas</p></div>
  </section>

  <section class="mt-6 rounded-2xl border border-border bg-card shadow-sm" aria-labelledby="order-list-title">
    <div class="border-b border-border p-4 sm:p-5">
      <div class="flex flex-col gap-4 xl:flex-row xl:items-center xl:justify-between">
        <div><h2 id="order-list-title" class="font-display text-xl">Listado de pedidos</h2><p class="mt-1 text-sm text-muted-foreground">{total} resultado{total === 1 ? '' : 's'} con los filtros actuales</p></div>
        <form class="flex w-full max-w-xl gap-2" method="get">
          {status && <input type="hidden" name="estado" value={status} />}
          <label class="relative flex-1"><span class="sr-only">Buscar pedidos</span><AdminIcon name="search" class="pointer-events-none absolute left-3 top-1/2 size-4 -translate-y-1/2 text-muted-foreground"/><input type="search" name="q" value={search} placeholder="Número, cliente o email" class="min-h-11 w-full rounded-xl border border-input bg-background pl-10 pr-3 text-sm shadow-sm" /></label>
          <button class="min-h-11 rounded-xl bg-foreground px-4 text-sm font-semibold text-background">Buscar</button>
          {(search || status) && <a href="/demo/admin" class="inline-flex min-h-11 items-center rounded-xl px-3 text-sm font-medium text-muted-foreground hover:bg-muted">Limpiar</a>}
        </form>
      </div>
      <nav class="mt-4 flex gap-2 overflow-x-auto pb-1" aria-label="Filtrar pedidos por estado">
        <a href={hrefFor({})} aria-current={!status ? 'page' : undefined} class:list={['inline-flex min-h-10 shrink-0 items-center rounded-xl border px-3 text-sm font-medium', !status ? 'border-foreground bg-foreground text-background' : 'border-border bg-background text-muted-foreground hover:text-foreground']}>Todos <span class="ml-2">{allCount}</span></a>
        {ORDER_STATUSES.map((st) => <a href={hrefFor({ status: st })} aria-current={status === st ? 'page' : undefined} class:list={['inline-flex min-h-10 shrink-0 items-center rounded-xl border px-3 text-sm font-medium', status === st ? 'border-foreground bg-foreground text-background' : 'border-border bg-background text-muted-foreground hover:text-foreground']}>{statusLabel[st]} <span class="ml-2">{countFor(st)}</span></a>)}
      </nav>
    </div>

    {page > pageCount && <div class="p-5"><AdminNotice tone="warning">Esta página ya no existe con los filtros actuales. <a class="font-semibold underline" href={hrefFor({ status, page: pageCount })}>Ir a la última página</a>.</AdminNotice></div>}

    {orders.length > 0 && <>
      <div class="hidden overflow-x-auto md:block">
        <table class="w-full text-sm">
          <thead class="border-b border-border bg-muted/60 text-left text-xs uppercase tracking-[0.11em] text-muted-foreground"><tr><th class="px-5 py-3 font-semibold">Pedido</th><th class="px-5 py-3 font-semibold">Cliente</th><th class="px-5 py-3 font-semibold">Fecha</th><th class="px-5 py-3 text-right font-semibold">Total</th><th class="px-5 py-3 font-semibold">Estado</th><th class="w-12 px-3"><span class="sr-only">Abrir</span></th></tr></thead>
          <tbody class="divide-y divide-border">{orders.map((order) => <tr class="group hover:bg-muted/50"><td class="px-5 py-4"><a href={`/demo/admin/pedidos/${order.id}`} class="font-mono font-semibold underline-offset-4 after:absolute hover:underline">{order.order_number}</a></td><td class="px-5 py-4"><p class="font-medium">{order.customer_name}</p><p class="mt-0.5 text-xs text-muted-foreground">{order.email}</p></td><td class="whitespace-nowrap px-5 py-4 text-muted-foreground">{date(order.created_at)}</td><td class="px-5 py-4 text-right font-semibold">{formatEurCents(order.total_cents)}</td><td class="px-5 py-4"><AdminStatusBadge status={order.status} label={statusLabel[order.status] ?? order.status}/></td><td class="px-3 py-4"><a href={`/demo/admin/pedidos/${order.id}`} class="flex size-11 items-center justify-center rounded-xl text-muted-foreground group-hover:bg-card group-hover:text-foreground" aria-label={`Abrir pedido ${order.order_number}`}><AdminIcon name="chevron" class="size-4"/></a></td></tr>)}</tbody>
        </table>
      </div>
      <ul class="divide-y divide-border md:hidden">{orders.map((order) => <li><a href={`/demo/admin/pedidos/${order.id}`} class="block min-h-11 p-4 hover:bg-muted/60"><div class="flex items-start justify-between gap-3"><div><p class="font-mono text-sm font-semibold">{order.order_number}</p><p class="mt-1 text-sm font-medium">{order.customer_name}</p></div><p class="font-semibold">{formatEurCents(order.total_cents)}</p></div><div class="mt-3 flex items-center justify-between gap-3"><AdminStatusBadge status={order.status} label={statusLabel[order.status] ?? order.status}/><time class="text-xs text-muted-foreground">{date(order.created_at)}</time></div></a></li>)}</ul>
    </>}

    {orders.length === 0 && <div class="px-5 py-14 text-center"><span class="mx-auto flex size-12 items-center justify-center rounded-2xl bg-muted text-muted-foreground"><AdminIcon name="orders"/></span><h3 class="mt-4 font-display text-lg">No hay pedidos que coincidan</h3><p class="mx-auto mt-2 max-w-md text-sm leading-6 text-muted-foreground">Prueba a quitar algún filtro o visita la tienda demo para conocer el recorrido de compra.</p><a href={search || status ? '/demo/admin' : MAIN_DEMO_HREF} class="mt-5 inline-flex min-h-11 items-center rounded-xl border border-border px-4 text-sm font-semibold hover:bg-muted">{search || status ? 'Quitar filtros' : 'Ver tienda ARCE'}</a></div>}

    {pageCount > 1 && <nav class="flex items-center justify-between border-t border-border px-4 py-3 text-sm" aria-label="Paginación de pedidos"><span class="text-muted-foreground">Página {page} de {pageCount}</span><div class="flex gap-2">{page > 1 && <a href={hrefFor({ status, page: page - 1 })} class="inline-flex min-h-11 items-center rounded-xl border border-border px-3 font-medium hover:bg-muted">Anterior</a>}{page < pageCount && <a href={hrefFor({ status, page: page + 1 })} class="inline-flex min-h-11 items-center rounded-xl border border-border px-3 font-medium hover:bg-muted">Siguiente</a>}</div></nav>}
  </section>
</Admin>
