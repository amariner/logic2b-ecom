---
import Admin from '../../../layouts/Admin.astro';
import AdminNotice from '../../../components/admin/AdminNotice.astro';
import AdminStatusBadge from '../../../components/admin/AdminStatusBadge.astro';
import { createOrderDocumentOperations } from '../../../composition/order-document-operations';
import { runtimePlatform } from '../../../composition/runtime-platform';
import { formatEurCents } from '../../../lib/format';

export const prerender = false;

const readOnly = Astro.locals.runtime.env.DEMO_MODE === 'true';
const effectsEnabled = runtimePlatform.hasCapabilityFlag('ORD-012', 'sideEffects');
const operations = createOrderDocumentOperations(Astro.locals.runtime.env.DB);
const [documents, options] = await Promise.all([operations.list(), operations.adminOptions()]);
const typeLabel: Record<string, string> = {
  packing_slip: 'Albarán', internal_label: 'Etiqueta interna',
  external_invoice: 'Factura externa', external_credit_note: 'Rectificativa externa',
};
const statusLabel: Record<string, string> = { active: 'Activa', superseded: 'Sustituida', voided: 'Anulada' };
const date = (value: string) => new Intl.DateTimeFormat('es-ES', { dateStyle: 'medium', timeStyle: 'short' }).format(new Date(value));
const activeCount = documents.filter((document) => document.status === 'active').length;
const generatedCount = documents.filter((document) => document.source === 'generated').length;
const externalCount = documents.filter((document) => document.source === 'external').length;
---

<Admin title="Documentos" active="documentos">
  <header class="border-b border-border pb-6">
    <p class="text-xs font-semibold uppercase tracking-[0.16em] text-muted-foreground">Pedidos · operación documental</p>
    <div class="mt-2 flex flex-col gap-3 lg:flex-row lg:items-end lg:justify-between">
      <div><h1 class="font-display text-3xl sm:text-4xl">Documentos</h1><p class="mt-2 max-w-3xl text-sm leading-6 text-muted-foreground">Albaranes y etiquetas son snapshots imprimibles e inmutables. Facturas y rectificativas se emiten fuera y aquí solo queda su referencia trazable.</p></div>
      <span class="w-fit rounded-full border border-border bg-card px-3 py-1.5 text-xs font-semibold text-muted-foreground">ORD-012 · versión y checksum</span>
    </div>
  </header>

  <div class="mt-5"><AdminNotice tone="info">Logic2B no actúa como software fiscal ni sustituye VeriFactu. Los importes de referencias externas se recalculan desde pedido o reembolso y nunca llegan desde el navegador.</AdminNotice></div>
  {readOnly && <div class="mt-4"><AdminNotice tone="warning">La demo enseña documentos ficticios de solo lectura. Alta, sustitución y anulación responden 403.</AdminNotice></div>}

  <dl class="mt-6 grid gap-3 sm:grid-cols-3">
    <div class="rounded-2xl border border-border bg-card p-4"><dt class="text-xs font-semibold uppercase tracking-wide text-muted-foreground">Activos</dt><dd class="mt-2 text-2xl font-semibold">{activeCount}</dd></div>
    <div class="rounded-2xl border border-border bg-card p-4"><dt class="text-xs font-semibold uppercase tracking-wide text-muted-foreground">Generados</dt><dd class="mt-2 text-2xl font-semibold">{generatedCount}</dd></div>
    <div class="rounded-2xl border border-border bg-card p-4"><dt class="text-xs font-semibold uppercase tracking-wide text-muted-foreground">Externos</dt><dd class="mt-2 text-2xl font-semibold">{externalCount}</dd></div>
  </dl>

  <div class="mt-7 grid gap-6 2xl:grid-cols-[minmax(0,1fr)_25rem]">
    <section class="min-w-0" aria-labelledby="document-list-title">
      <div class="flex items-end justify-between gap-4"><div><h2 id="document-list-title" class="font-display text-2xl">Registro documental</h2><p class="mt-1 text-sm text-muted-foreground">Cada sustitución conserva la versión previa; un documento anulado no vuelve a imprimirse.</p></div><span class="text-sm font-semibold text-muted-foreground">{documents.length}</span></div>
      {documents.length === 0 ? <p class="mt-4 rounded-2xl border border-dashed border-border bg-card p-8 text-center text-sm text-muted-foreground">Todavía no hay documentos para los pedidos.</p> : <ol class="mt-4 space-y-3">
        {documents.map((document) => <li class="rounded-2xl border border-border bg-card p-4 shadow-sm sm:p-5">
          <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
            <div class="min-w-0"><div class="flex flex-wrap items-center gap-2"><p class="break-all font-semibold">{document.document_number}</p><AdminStatusBadge status={document.status} label={statusLabel[document.status] ?? document.status}/></div><p class="mt-1 text-sm text-muted-foreground">{typeLabel[document.document_type]} · <a href={`/demo/admin/pedidos/${document.order_id}`} class="underline underline-offset-4">{document.order_number}</a> · versión {document.document_version}</p><p class="mt-1 text-xs text-muted-foreground">{date(document.issued_at)} · SHA-256 {document.content_sha256.slice(0, 12)}…</p></div>
            <div class="flex shrink-0 flex-wrap gap-2">
              {document.source === 'generated' && document.status === 'active' && <a href={`/api/admin/order-documents/${document.id}/artifact`} target="_blank" rel="noreferrer" class="inline-flex min-h-11 items-center rounded-xl border border-border px-3 text-sm font-semibold hover:bg-muted">Abrir para imprimir</a>}
              {document.source === 'external' && document.external_url && <a href={document.external_url} target="_blank" rel="noreferrer" class="inline-flex min-h-11 items-center rounded-xl border border-border px-3 text-sm font-semibold hover:bg-muted">Abrir proveedor</a>}
            </div>
          </div>
          <dl class="mt-4 grid gap-2 border-t border-border pt-4 text-sm sm:grid-cols-2">
            {document.fulfillment_id && <div><dt class="text-xs font-semibold text-muted-foreground">Envío</dt><dd class="mt-1">#{document.fulfillment_id} · {document.carrier ?? 'interno'}{document.tracking_number ? ` · ${document.tracking_number}` : ''}</dd></div>}
            {document.template_key && <div><dt class="text-xs font-semibold text-muted-foreground">Plantilla congelada</dt><dd class="mt-1">{document.template_key} · v{document.template_version}</dd></div>}
            {document.external_reference && <div><dt class="text-xs font-semibold text-muted-foreground">Referencia externa</dt><dd class="mt-1 break-all">{document.external_provider} · {document.external_reference}</dd></div>}
            {document.expected_amount_cents !== null && <div><dt class="text-xs font-semibold text-muted-foreground">Importe contrastado</dt><dd class="mt-1">{formatEurCents(document.expected_amount_cents)}</dd></div>}
            {document.void_reason && <div class="sm:col-span-2"><dt class="text-xs font-semibold text-muted-foreground">Motivo de anulación del registro</dt><dd class="mt-1">{document.void_reason}</dd></div>}
          </dl>
          {!readOnly && effectsEnabled && document.status === 'active' && <details class="mt-3 border-t border-border pt-3"><summary class="flex min-h-11 cursor-pointer items-center text-sm font-semibold text-muted-foreground">Anular esta versión</summary><form data-void-document data-document-id={document.id} data-version={document.lifecycle_version} class="grid gap-2 sm:grid-cols-[1fr_auto]"><label class="text-sm">Motivo<input name="reason" minlength="3" maxlength="240" required class="mt-1 min-h-11 w-full rounded-xl border border-input bg-background px-3" /></label><button class="min-h-11 self-end rounded-xl border border-red-300 px-4 text-sm font-semibold text-red-800 hover:bg-red-50">Anular registro</button><p data-form-error role="alert" class="hidden text-sm text-red-700 sm:col-span-2"></p></form></details>}
        </li>)}
      </ol>}
    </section>

    <aside class="space-y-5">
      <section class="rounded-2xl border border-border bg-card p-5 shadow-sm" aria-labelledby="generated-title">
        <h2 id="generated-title" class="font-display text-xl">Generar operativo</h2><p class="mt-1 text-sm leading-6 text-muted-foreground">Crea un snapshot sin precios para un envío concreto.</p>
        <form data-generated-document class="mt-4 space-y-3">
          <label class="block text-sm font-semibold">Tipo<select name="document_type" disabled={readOnly || !effectsEnabled} class="mt-1 min-h-11 w-full rounded-xl border border-input bg-background px-3 font-normal"><option value="packing_slip">Albarán</option><option value="internal_label">Etiqueta interna</option></select></label>
          <label class="block text-sm font-semibold">Envío<select name="fulfillment_id" required disabled={readOnly || !effectsEnabled} class="mt-1 min-h-11 w-full rounded-xl border border-input bg-background px-3 font-normal"><option value="">Selecciona…</option>{options.fulfillments.map((fulfillment) => <option value={fulfillment.id} data-order-id={fulfillment.order_id}>{fulfillment.order_number} · envío #{fulfillment.id} · {fulfillment.status}</option>)}</select></label>
          <label class="block text-sm font-semibold">Plantilla<select name="template_id" required disabled={readOnly || !effectsEnabled} class="mt-1 min-h-11 w-full rounded-xl border border-input bg-background px-3 font-normal"><option value="">Selecciona…</option>{options.templates.map((template) => <option value={template.id} data-document-type={template.document_type}>{typeLabel[template.document_type]} · {template.template_key} v{template.version}</option>)}</select></label>
          <p data-form-error role="alert" class="hidden text-sm text-red-700"></p><button disabled={readOnly || !effectsEnabled} class="min-h-11 w-full rounded-xl bg-foreground px-4 text-sm font-semibold text-background disabled:cursor-not-allowed">Generar versión</button>
        </form>
      </section>

      <section class="rounded-2xl border border-border bg-card p-5 shadow-sm" aria-labelledby="external-title">
        <h2 id="external-title" class="font-display text-xl">Registrar fiscal externo</h2><p class="mt-1 text-sm leading-6 text-muted-foreground">Guarda el número y enlace que ya emitió la gestoría, ERP o proveedor.</p>
        <form data-external-document class="mt-4 space-y-3">
          <label class="block text-sm font-semibold">Tipo<select name="document_type" disabled={readOnly || !effectsEnabled} class="mt-1 min-h-11 w-full rounded-xl border border-input bg-background px-3 font-normal"><option value="external_invoice">Factura externa</option><option value="external_credit_note">Rectificativa externa</option></select></label>
          <label class="block text-sm font-semibold">Pedido<select name="order_id" required disabled={readOnly || !effectsEnabled} class="mt-1 min-h-11 w-full rounded-xl border border-input bg-background px-3 font-normal"><option value="">Selecciona…</option>{options.orders.map((order) => <option value={order.id}>{order.order_number} · {order.status}</option>)}</select></label>
          <label class="block text-sm font-semibold">Reembolso confirmado <span class="font-normal text-muted-foreground">(solo rectificativa)</span><select name="refund_id" disabled={readOnly || !effectsEnabled} class="mt-1 min-h-11 w-full rounded-xl border border-input bg-background px-3 font-normal"><option value="">Ninguno</option>{options.refunds.map((refund) => <option value={refund.id} data-order-id={refund.order_id}>{refund.order_number} · #{refund.id} · {formatEurCents(refund.total_cents)}</option>)}</select></label>
          <label class="block text-sm font-semibold">Proveedor<input name="provider" minlength="2" maxlength="80" required placeholder="gestoría, ERP…" disabled={readOnly || !effectsEnabled} class="mt-1 min-h-11 w-full rounded-xl border border-input bg-background px-3 font-normal" /></label>
          <label class="block text-sm font-semibold">Número oficial<input name="document_number" minlength="3" maxlength="120" required disabled={readOnly || !effectsEnabled} class="mt-1 min-h-11 w-full rounded-xl border border-input bg-background px-3 font-normal" /></label>
          <label class="block text-sm font-semibold">Referencia del proveedor<input name="external_reference" minlength="2" maxlength="120" required disabled={readOnly || !effectsEnabled} class="mt-1 min-h-11 w-full rounded-xl border border-input bg-background px-3 font-normal" /></label>
          <label class="block text-sm font-semibold">URL HTTPS <span class="font-normal text-muted-foreground">(opcional)</span><input name="external_url" type="url" pattern="https://.*" disabled={readOnly || !effectsEnabled} class="mt-1 min-h-11 w-full rounded-xl border border-input bg-background px-3 font-normal" /></label>
          <p class="text-xs leading-5 text-muted-foreground">El importe no se introduce aquí: el servidor toma el total del pedido o del reembolso confirmado.</p><p data-form-error role="alert" class="hidden text-sm text-red-700"></p><button disabled={readOnly || !effectsEnabled} class="min-h-11 w-full rounded-xl bg-foreground px-4 text-sm font-semibold text-background disabled:cursor-not-allowed">Registrar referencia</button>
        </form>
      </section>
    </aside>
  </div>

  {!readOnly && effectsEnabled && <script>
    const submitJson = async (form: HTMLFormElement, payload: Record<string, unknown>, path = '/api/admin/order-documents') => {
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"], button:not([type])');
      const error = form.querySelector<HTMLElement>('[data-form-error]');
      if (button) button.disabled = true;
      if (error) error.classList.add('hidden');
      const response = await fetch(path, { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(payload) });
      if (response.ok) { window.location.reload(); return; }
      const body = await response.json().catch(() => ({})) as { error?: string };
      if (error) { error.textContent = body.error ?? 'No se pudo completar la operación.'; error.classList.remove('hidden'); }
      if (button) button.disabled = false;
    };
    document.querySelector<HTMLFormElement>('[data-generated-document]')?.addEventListener('submit', (event) => {
      event.preventDefault(); const form = event.currentTarget as HTMLFormElement; if (!form.reportValidity()) return;
      const data = new FormData(form); const fulfillment = form.querySelector('select[name="fulfillment_id"]') as unknown as HTMLSelectElement;
      const orderId = Number(fulfillment.selectedOptions[0]?.dataset.orderId);
      void submitJson(form, { kind: 'generated', document_type: String(data.get('document_type')), order_id: orderId, fulfillment_id: Number(data.get('fulfillment_id')), template_id: String(data.get('template_id')), idempotency_key: crypto.randomUUID() });
    });
    document.querySelector<HTMLFormElement>('[data-external-document]')?.addEventListener('submit', (event) => {
      event.preventDefault(); const form = event.currentTarget as HTMLFormElement; if (!form.reportValidity()) return;
      const data = new FormData(form); const refundId = Number(data.get('refund_id'));
      void submitJson(form, { kind: 'external', document_type: String(data.get('document_type')), order_id: Number(data.get('order_id')), ...(refundId > 0 ? { refund_id: refundId } : {}), provider: String(data.get('provider')), document_number: String(data.get('document_number')), external_reference: String(data.get('external_reference')), ...(String(data.get('external_url')).trim() ? { external_url: String(data.get('external_url')).trim() } : {}), idempotency_key: crypto.randomUUID() });
    });
    document.querySelectorAll<HTMLFormElement>('[data-void-document]').forEach((form) => form.addEventListener('submit', (event) => {
      event.preventDefault(); if (!form.reportValidity()) return; const data = new FormData(form);
      void submitJson(form, { expected_version: Number(form.dataset.version), idempotency_key: crypto.randomUUID(), reason: String(data.get('reason')) }, `/api/admin/order-documents/${form.dataset.documentId}/void`);
    }));
  </script>}
</Admin>
