---
import Admin from '../../../layouts/Admin.astro';
import AdminPageHeader from '../../../components/admin/AdminPageHeader.astro';
import { createInventoryAllocationOperations } from '../../../composition/inventory-allocation-operations';

export const prerender = false;
const readOnly = Astro.locals.runtime.env.DEMO_MODE === 'true';
const operations = createInventoryAllocationOperations(Astro.locals.runtime.env.DB);
const [policies, decisions] = await Promise.all([operations.policies(), operations.decisions()]);
const euro = new Intl.NumberFormat('es-ES', { style: 'currency', currency: 'EUR' });
const date = new Intl.DateTimeFormat('es-ES', { dateStyle: 'medium', timeStyle: 'short' });
const list = (json: string) => (JSON.parse(json) as string[]).join(', ');
type Explanation = Readonly<{
  selected_location_id: number;
  candidates: readonly Readonly<{
    code: string; eligible: boolean; reason: 'eligible' | 'market' | 'channel' | 'stock';
    priority: number; handling_cost_cents: number;
  }>[];
}>;
const explanation = (json: string) => JSON.parse(json) as Explanation;
const reasonLabel = { eligible: 'Elegible', market: 'Fuera de mercado', channel: 'Fuera de canal', stock: 'Stock insuficiente' } as const;
---

<Admin title="Asignación de inventario" active="asignacion">
  <AdminPageHeader eyebrow="Inventario" title="Asignación de pedidos" description="Decide una única ubicación por expedición con reglas reproducibles y conserva el porqué de cada decisión." />

  <section class="mt-6 grid gap-4 md:grid-cols-3" aria-label="Resumen de asignación">
    <article class="rounded-2xl border border-border bg-card p-5 shadow-sm"><p class="text-sm text-muted-foreground">Ubicaciones configuradas</p><p class="mt-2 font-display text-3xl">{policies.length}</p><p class="mt-2 text-xs text-muted-foreground">{policies.filter((policy) => policy.enabled === 1).length} participan en el enrutado</p></article>
    <article class="rounded-2xl border border-border bg-card p-5 shadow-sm"><p class="text-sm text-muted-foreground">Decisiones explicadas</p><p class="mt-2 font-display text-3xl">{decisions.length}</p><p class="mt-2 text-xs text-muted-foreground">Últimas 100 expediciones vinculadas</p></article>
    <article class="rounded-2xl border border-border bg-card p-5 shadow-sm"><p class="text-sm text-muted-foreground">Contrato de selección</p><p class="mt-2 font-display text-xl">Prioridad → coste → ID</p><p class="mt-2 text-xs text-muted-foreground">Mercado, canal y stock actúan primero como filtros</p></article>
  </section>

  <section class="mt-6 rounded-2xl border border-border bg-card shadow-sm" aria-labelledby="routing-rules-title">
    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-border p-5">
      <div><h2 id="routing-rules-title" class="font-display text-xl">Reglas por ubicación</h2><p class="mt-1 text-sm text-muted-foreground">Un número menor tiene preferencia. El coste solo desempata prioridades iguales.</p></div>
      {readOnly && <span class="rounded-full bg-sky-50 px-3 py-1 text-xs font-semibold text-sky-800 ring-1 ring-sky-200">Solo lectura</span>}
    </div>
    <div class="grid gap-4 p-4 lg:grid-cols-2 lg:p-5">
      {policies.map((policy) => <form data-routing-form class="rounded-2xl border border-border p-4" data-location-id={policy.location_id} data-version={policy.version}>
        <div class="flex items-start justify-between gap-3"><div><h3 class="font-display text-lg">{policy.location_name}</h3><p class="mt-1 font-mono text-xs text-muted-foreground">{policy.location_code}{policy.is_primary === 1 ? ' · principal' : ''}</p></div><label class="flex items-center gap-2 text-sm font-semibold"><input name="enabled" type="checkbox" checked={policy.enabled === 1} disabled={readOnly} class="size-4 accent-foreground" /> Activa</label></div>
        <div class="mt-4 grid gap-4 sm:grid-cols-2"><label class="text-sm font-semibold">Prioridad<input name="priority" type="number" min="0" max="100000" value={policy.priority} disabled={readOnly} class="mt-2 min-h-11 w-full rounded-xl border border-input bg-background px-3 font-normal disabled:opacity-100" /></label><label class="text-sm font-semibold">Coste de manipulación (€)<input name="cost" type="number" min="0" max="100000" step="0.01" value={(policy.handling_cost_cents / 100).toFixed(2)} disabled={readOnly} class="mt-2 min-h-11 w-full rounded-xl border border-input bg-background px-3 font-normal disabled:opacity-100" /></label><label class="text-sm font-semibold sm:col-span-2">Mercados<input name="markets" value={list(policy.markets_json)} disabled={readOnly} aria-describedby={`markets-${policy.location_id}`} class="mt-2 min-h-11 w-full rounded-xl border border-input bg-background px-3 font-mono text-sm font-normal disabled:opacity-100" /><span id={`markets-${policy.location_id}`} class="mt-1 block text-xs font-normal text-muted-foreground">Códigos separados por coma; * acepta todos.</span></label><label class="text-sm font-semibold sm:col-span-2">Canales<input name="channels" value={list(policy.channels_json)} disabled={readOnly} class="mt-2 min-h-11 w-full rounded-xl border border-input bg-background px-3 font-mono text-sm font-normal disabled:opacity-100" /></label></div>
        <div class="mt-4 flex flex-wrap items-center justify-between gap-3"><p data-routing-status role="status" aria-live="polite" class="min-h-5 text-sm text-muted-foreground">Versión {policy.version}</p><button type="submit" disabled={readOnly} class="min-h-11 rounded-xl bg-foreground px-4 text-sm font-semibold text-background disabled:cursor-not-allowed disabled:opacity-45">Guardar regla</button></div>
      </form>)}
    </div>
  </section>

  <section class="mt-6 rounded-2xl border border-border bg-card shadow-sm" aria-labelledby="routing-history-title">
    <div class="border-b border-border p-5"><h2 id="routing-history-title" class="font-display text-xl">Decisiones recientes</h2><p class="mt-1 text-sm text-muted-foreground">La explicación queda fijada con la versión de política utilizada.</p></div>
    {decisions.length === 0 ? <p class="p-8 text-center text-sm text-muted-foreground">Todavía no hay expediciones asignadas.</p> : <div class="divide-y divide-border">
      {decisions.map((decision) => {
        const detail = explanation(decision.explanation_json);
        return <article class="p-5">
          <div class="flex flex-wrap items-start justify-between gap-3"><div><h3 class="font-display text-lg">{decision.order_number}</h3><p class="mt-1 text-sm text-muted-foreground">{decision.line_count} líneas · {decision.quantity} unidades · {decision.market}/{decision.channel}</p></div><div class="text-right"><span class="rounded-full bg-emerald-50 px-3 py-1 text-xs font-semibold text-emerald-800">{decision.location_name}</span><p class="mt-2 text-xs text-muted-foreground">{date.format(new Date(decision.created_at))} · política v{decision.policy_version}</p></div></div>
          <div class="mt-4 flex flex-wrap gap-2">{detail.candidates.map((candidate) => <span class:list={['rounded-lg border px-2.5 py-1.5 text-xs', candidate.eligible ? 'border-emerald-200 bg-emerald-50 text-emerald-900' : 'border-border bg-muted text-muted-foreground']}><strong>{candidate.code}</strong> · {reasonLabel[candidate.reason]} · P{candidate.priority} · {euro.format(candidate.handling_cost_cents / 100)}</span>)}</div>
        </article>;
      })}
    </div>}
  </section>

  {!readOnly && <script>
    document.querySelectorAll<HTMLFormElement>('[data-routing-form]').forEach((form) => {
      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        const status = form.querySelector<HTMLElement>('[data-routing-status]');
        if (!status) return;
        status.textContent = 'Guardando…'; status.classList.remove('text-red-700');
        const data = new FormData(form);
        const values = (name: string) => String(data.get(name) ?? '').split(',').map((value) => value.trim()).filter(Boolean);
        const response = await fetch('/api/admin/inventory-routing', {
          method: 'PATCH', headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            location_id: Number(form.dataset.locationId), expected_version: Number(form.dataset.version),
            priority: Number(data.get('priority')), handling_cost_cents: Math.round(Number(data.get('cost')) * 100),
            markets: values('markets'), channels: values('channels'), enabled: data.get('enabled') === 'on',
          }),
        });
        const payload = await response.json() as { error?: string };
        if (!response.ok) { status.textContent = payload.error ?? 'No se pudo guardar.'; status.classList.add('text-red-700'); return; }
        location.reload();
      });
    });
  </script>}
</Admin>
