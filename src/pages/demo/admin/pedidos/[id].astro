---
import Admin from '../../../../layouts/Admin.astro';
import AdminIcon from '../../../../components/admin/AdminIcon.astro';
import AdminNotice from '../../../../components/admin/AdminNotice.astro';
import AdminStatusBadge from '../../../../components/admin/AdminStatusBadge.astro';
import { formatEurCents } from '../../../../lib/format';
import { runtimePlatform } from '../../../../composition/runtime-platform';
import { createOrderReader } from '../../../../modules/orders';
import { createD1PaymentLedger } from '../../../../modules/payments';

export const prerender = false;
const readOnly = Astro.locals.runtime.env.DEMO_MODE === 'true';
const trackingEnabled = runtimePlatform.hasCapabilityFlag('FUL-002', 'routes');
const id = Number(Astro.params.id);
const detail = Number.isInteger(id) ? await createOrderReader(Astro.locals.runtime.env.DB).detail(id) : null;
if (!detail) return new Response(null, { status: 404 });
const { order, items, events } = detail;
const paymentLedger = createD1PaymentLedger(Astro.locals.runtime.env.DB);
const [payment, refund] = await Promise.all([
  paymentLedger.findByOrderId(order.id),
  paymentLedger.findRefundByOrderId(order.id),
]);
const refundRouteEnabled = runtimePlatform.hasCapabilityFlag('ORD-007', 'routes');
const refundEffectsEnabled = runtimePlatform.hasCapabilityFlag('ORD-007', 'sideEffects');
const addr = JSON.parse(order.address_json) as { name: string; phone: string | null; street: string; city: string; postal_code: string; zone: string; nif?: string | null; company?: string | null; };
const statusLabel: Record<string, string> = { pending: 'Pendiente de pago', paid: 'Pagado', shipped: 'Enviado', delivered: 'Entregado', cancelled: 'Cancelado' };
const date = (value: string) => new Intl.DateTimeFormat('es-ES', { dateStyle: 'medium', timeStyle: 'short' }).format(new Date(value));
const financialStatusLabel: Record<string, string> = {
  pending: 'Pendiente', captured: 'Cobrado', refunded: 'Reembolsado',
  processing: 'En proceso', failed: 'Fallido', requires_review: 'Revisión necesaria',
};
---

<Admin title={`Pedido ${order.order_number}`} active="pedidos">
  <a href="/demo/admin" class="inline-flex min-h-11 items-center gap-2 rounded-xl text-sm font-semibold text-muted-foreground hover:text-foreground"><AdminIcon name="arrow-left" class="size-4"/>Todos los pedidos</a>

  <header class="mt-3 flex flex-col gap-4 border-b border-border pb-6 sm:flex-row sm:items-end sm:justify-between">
    <div><p class="text-xs font-semibold uppercase tracking-[0.16em] text-muted-foreground">Detalle del pedido</p><div class="mt-1 flex flex-wrap items-center gap-3"><h1 class="font-display text-3xl sm:text-4xl">{order.order_number}</h1><AdminStatusBadge status={order.status} label={statusLabel[order.status] ?? order.status}/></div><p class="mt-2 text-sm text-muted-foreground">Creado el {date(order.created_at)}</p></div>
    <div class="text-left sm:text-right"><p class="text-xs font-semibold uppercase tracking-[0.12em] text-muted-foreground">Total</p><p class="mt-1 text-2xl font-semibold">{formatEurCents(order.total_cents)}</p></div>
  </header>

  {readOnly && <div class="mt-5"><AdminNotice tone="info">Pedido ficticio de ejemplo. El panel público es de solo lectura: ninguna acción modifica datos ni envía avisos.</AdminNotice></div>}

  <div class="mt-6 grid gap-6 xl:grid-cols-[minmax(0,1fr)_22rem]">
    <div class="space-y-6">
      <section class="overflow-hidden rounded-2xl border border-border bg-card shadow-sm" aria-labelledby="lines-title">
        <div class="border-b border-border px-5 py-4"><h2 id="lines-title" class="font-display text-xl">Productos</h2><p class="mt-1 text-sm text-muted-foreground">{items.reduce((sum, item) => sum + item.qty, 0)} unidades en {items.length} líneas</p></div>
        <ul class="divide-y divide-border">{items.map((item) => <li class="grid grid-cols-[1fr_auto] gap-3 px-5 py-4 text-sm sm:grid-cols-[1fr_auto_auto] sm:items-center"><div><p class="font-semibold">{item.name_snapshot}</p><p class="mt-1 text-xs text-muted-foreground sm:hidden">{item.qty} × {formatEurCents(item.unit_price_cents)}</p></div><p class="hidden text-muted-foreground sm:block">{item.qty} × {formatEurCents(item.unit_price_cents)}</p><p class="text-right font-semibold">{formatEurCents(item.qty * item.unit_price_cents)}</p></li>)}</ul>
        <dl class="space-y-2 border-t border-border bg-muted/40 px-5 py-4 text-sm"><div class="flex justify-between gap-4"><dt class="text-muted-foreground">Subtotal</dt><dd>{formatEurCents(order.subtotal_cents)}</dd></div><div class="flex justify-between gap-4"><dt class="text-muted-foreground">Envío</dt><dd>{formatEurCents(order.shipping_cents)}</dd></div><div class="flex justify-between gap-4 border-t border-border pt-3 text-base font-semibold"><dt>Total</dt><dd>{formatEurCents(order.total_cents)}</dd></div></dl>
      </section>

      <section class="rounded-2xl border border-border bg-card p-5 shadow-sm" aria-labelledby="timeline-title">
        <h2 id="timeline-title" class="font-display text-xl">Actividad</h2><p class="mt-1 text-sm text-muted-foreground">Historial inmutable del pedido</p>
        <ol class="relative mt-6 space-y-6 before:absolute before:bottom-2 before:left-[0.44rem] before:top-2 before:w-px before:bg-border">{events.map((event) => <li class="relative grid grid-cols-[1rem_1fr] gap-4"><span class="relative z-10 mt-1.5 size-3 rounded-full border-2 border-card bg-foreground ring-2 ring-border"></span><div><div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between"><p class="font-semibold">{statusLabel[event.to_status] ?? event.to_status}</p><time class="text-xs text-muted-foreground">{date(event.created_at)}</time></div>{event.note && <p class="mt-1 text-sm leading-6 text-muted-foreground">{event.note}</p>}</div></li>)}</ol>
      </section>
    </div>

    <aside class="space-y-6">
      {refundRouteEnabled && payment && <section class="rounded-2xl border border-border bg-card p-5 shadow-sm" aria-labelledby="payment-title"><h2 id="payment-title" class="font-display text-lg">Pago y reembolso</h2><dl class="mt-4 space-y-2 text-sm"><div class="flex items-center justify-between gap-4"><dt class="text-muted-foreground">Pago</dt><dd class="font-semibold">{financialStatusLabel[payment.status] ?? payment.status}</dd></div><div class="flex items-center justify-between gap-4"><dt class="text-muted-foreground">Proveedor</dt><dd class="font-mono text-xs uppercase">{payment.provider}</dd></div>{refund && <div class="flex items-center justify-between gap-4"><dt class="text-muted-foreground">Reembolso</dt><dd class="font-semibold">{financialStatusLabel[refund.status] ?? refund.status}</dd></div>}</dl>{refund?.status === 'processing' && <p class="mt-3 text-sm leading-6 text-muted-foreground">La pasarela aún está procesando el abono. Reintentar reconcilia la misma referencia: no crea otro reembolso.</p>}{(refund?.status === 'failed' || refund?.status === 'requires_review') && <AdminNotice tone="warning">La pasarela no confirmó el abono. Revisa el pago antes de preparar el pedido.</AdminNotice>}</section>}

      <section class="rounded-2xl border border-border bg-card p-5 shadow-sm" aria-labelledby="customer-title"><h2 id="customer-title" class="font-display text-lg">Cliente y entrega</h2><div class="mt-4 text-sm leading-6"><p class="font-semibold">{addr.name}</p><p>{addr.street}</p><p>{addr.postal_code} {addr.city}</p><a href={`mailto:${order.email}`} class="mt-3 block break-all text-muted-foreground underline underline-offset-4">{order.email}</a>{addr.phone && <a href={`tel:${addr.phone}`} class="block text-muted-foreground underline underline-offset-4">{addr.phone}</a>}</div>{(addr.nif || addr.company) && <div class="mt-4 rounded-xl bg-amber-50 p-3 text-sm text-amber-950"><p class="text-xs font-semibold uppercase tracking-wide">Facturación</p><p class="mt-1">{[addr.company, addr.nif].filter(Boolean).join(' · ')}</p></div>}{order.tracking_number && <div class="mt-4 rounded-xl bg-sky-50 p-3 text-sm text-sky-950"><p class="text-xs font-semibold uppercase tracking-wide">Seguimiento</p><p class="mt-1 font-semibold">{order.tracking_carrier}</p><p class="break-all font-mono text-xs">{order.tracking_number}</p></div>}</section>

      {!readOnly && trackingEnabled && order.status === 'paid' && <form data-ship-form data-order-id={order.id} class="rounded-2xl border border-border bg-card p-5 shadow-sm"><h2 class="font-display text-lg">Preparar envío</h2><p class="mt-1 text-sm leading-6 text-muted-foreground">Añade el seguimiento y avisa al cliente.</p><label class="mt-4 block text-xs font-semibold text-muted-foreground" for="carrier">Transportista</label><input id="carrier" name="carrier" required list="carriers" class="mt-1 min-h-11 w-full rounded-xl border border-input px-3 text-sm"/><datalist id="carriers"><option value="SEUR"></option><option value="Correos Express"></option><option value="GLS"></option><option value="MRW"></option><option value="CTT"></option></datalist><label class="mt-3 block text-xs font-semibold text-muted-foreground" for="tracking">Nº de seguimiento</label><input id="tracking" name="tracking" required class="mt-1 min-h-11 w-full rounded-xl border border-input px-3 text-sm"/><p data-ship-error role="alert" class="mt-2 hidden text-sm text-red-700"></p><button type="submit" class="mt-4 min-h-11 w-full rounded-xl bg-foreground px-4 text-sm font-semibold text-background hover:bg-foreground/85">Marcar enviado y avisar</button></form>}

      {!readOnly && trackingEnabled && order.status === 'shipped' && <button type="button" data-deliver data-order-id={order.id} class="min-h-11 w-full rounded-xl bg-foreground px-4 text-sm font-semibold text-background hover:bg-foreground/85">Marcar como entregado</button>}

      {!readOnly && refundEffectsEnabled && order.status === 'paid' && payment?.status === 'captured' && payment.provider !== 'legacy' && <form data-refund-form data-order-id={order.id} class="rounded-2xl border border-red-200 bg-red-50 p-5"><h2 class="font-display text-lg text-red-950">Reembolso total</h2><p class="mt-2 text-sm leading-6 text-red-900">Devuelve {formatEurCents(order.total_cents)} por la pasarela y cancela el pedido. El importe siempre sale del servidor.</p><label class="mt-4 block text-xs font-semibold text-red-900" for="refund-reason">Motivo</label><select id="refund-reason" name="reason" required class="mt-1 min-h-11 w-full rounded-xl border border-red-300 bg-white px-3 text-sm text-red-950"><option value="Cancelación solicitada por el cliente">Cancelación solicitada por el cliente</option><option value="Pedido duplicado">Pedido duplicado</option><option value="Producto no disponible">Producto no disponible</option></select><label class="mt-4 flex min-h-11 items-center gap-3 text-sm font-medium text-red-950"><input type="checkbox" name="restock" checked class="size-5"/>Reponer las unidades en stock</label><p class="mt-1 text-xs leading-5 text-red-800">El abono y la reposición quedan registrados como decisiones separadas.</p><p data-refund-error role="alert" class="mt-2 hidden text-sm font-medium text-red-800"></p><button type="submit" class="mt-4 min-h-11 w-full rounded-xl border border-red-300 bg-white px-4 text-sm font-semibold text-red-800 hover:bg-red-100">{refund ? 'Reintentar o reconciliar' : 'Reembolsar y cancelar'}</button></form>}
    </aside>
  </div>

  <script>
    const shipForm = document.querySelector<HTMLFormElement>('[data-ship-form]');
    const shipSubmitBtn = shipForm?.querySelector<HTMLButtonElement>('button[type="submit"]');
    shipForm?.addEventListener('submit', (event) => { event.preventDefault(); if (!shipForm.reportValidity() || shipSubmitBtn?.disabled) return; if (shipSubmitBtn) shipSubmitBtn.disabled = true; const data = new FormData(shipForm); void (async () => { const res = await fetch(`/api/admin/orders/${shipForm.dataset.orderId}`, { method: 'PATCH', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ status: 'shipped', tracking_carrier: String(data.get('carrier') ?? ''), tracking_number: String(data.get('tracking') ?? '') }) }); if (res.ok) window.location.reload(); else { const body = await res.json() as { error?: string }; const error = document.querySelector<HTMLElement>('[data-ship-error]')!; error.textContent = body.error ?? 'Error inesperado'; error.classList.remove('hidden'); if (shipSubmitBtn) shipSubmitBtn.disabled = false; } })(); });
    document.querySelector<HTMLButtonElement>('[data-deliver]')?.addEventListener('click', (event) => { const button = event.currentTarget as HTMLButtonElement; if (button.disabled) return; button.disabled = true; void fetch(`/api/admin/orders/${button.dataset.orderId}`, { method: 'PATCH', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ status: 'delivered' }) }).then((res) => { if (res.ok) window.location.reload(); else button.disabled = false; }); });
    const refundForm = document.querySelector<HTMLFormElement>('[data-refund-form]');
    const refundButton = refundForm?.querySelector<HTMLButtonElement>('button[type="submit"]');
    refundForm?.addEventListener('submit', (event) => { event.preventDefault(); if (!refundForm.reportValidity() || refundButton?.disabled) return; const data = new FormData(refundForm); if (!window.confirm('¿Confirmas el reembolso total y la cancelación? La pasarela recibirá la orden una sola vez aunque haya reintentos.')) return; if (refundButton) refundButton.disabled = true; void (async () => { const res = await fetch(`/api/admin/refunds/${refundForm.dataset.orderId}`, { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ reason: String(data.get('reason') ?? ''), restock: data.get('restock') === 'on' }) }); if (res.ok) window.location.reload(); else { if (refundButton) refundButton.disabled = false; const body = await res.json() as { error?: string }; const error = document.querySelector<HTMLElement>('[data-refund-error]')!; error.textContent = body.error ?? 'Error inesperado'; error.classList.remove('hidden'); } })(); });
  </script>
</Admin>
