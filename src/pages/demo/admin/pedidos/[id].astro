---
import Admin from '../../../../layouts/Admin.astro';
import AdminIcon from '../../../../components/admin/AdminIcon.astro';
import AdminNotice from '../../../../components/admin/AdminNotice.astro';
import AdminStatusBadge from '../../../../components/admin/AdminStatusBadge.astro';
import { formatEurCents } from '../../../../lib/format';
import { runtimePlatform } from '../../../../composition/runtime-platform';
import { createD1OrderAmendments, createOrderReader } from '../../../../modules/orders';
import { createD1PaymentLedger } from '../../../../modules/payments';
import { createD1FulfillmentLedger } from '../../../../modules/fulfillment';
import { shopConfig } from '../../../../../shop.config';

export const prerender = false;
const readOnly = Astro.locals.runtime.env.DEMO_MODE === 'true';
const collaborationEnabled = runtimePlatform.hasCapabilityFlag('ORD-004', 'routes');
const collaborationEffectsEnabled = runtimePlatform.hasCapabilityFlag('ORD-004', 'sideEffects');
const trackingEnabled = runtimePlatform.hasCapabilityFlag('FUL-002', 'routes');
const partialEnabled = runtimePlatform.hasCapabilityFlag('FUL-004', 'routes');
const partialEffectsEnabled = runtimePlatform.hasCapabilityFlag('FUL-004', 'sideEffects');
const amendmentRouteEnabled = runtimePlatform.hasCapabilityFlag('ORD-005', 'routes');
const amendmentEffectsEnabled = runtimePlatform.hasCapabilityFlag('ORD-005', 'sideEffects');
const id = Number(Astro.params.id);
const detail = Number.isInteger(id) ? await createOrderReader(Astro.locals.runtime.env.DB).detail(id) : null;
if (!detail) return new Response(null, { status: 404 });
const { order, items, notes, tags, availableTags, timeline } = detail;
const paymentLedger = createD1PaymentLedger(Astro.locals.runtime.env.DB);
const fulfillmentLedger = createD1FulfillmentLedger(Astro.locals.runtime.env.DB);
const amendmentLedger = createD1OrderAmendments(Astro.locals.runtime.env.DB);
const [payment, refunds, fulfillments, fulfillmentBalances, amendmentContext, amendments] = await Promise.all([
  paymentLedger.findByOrderId(order.id),
  paymentLedger.listRefundsForOrder(order.id),
  fulfillmentLedger.listForOrder(order.id),
  fulfillmentLedger.lineBalances(order.id),
  amendmentRouteEnabled ? amendmentLedger.context(order.id) : null,
  amendmentRouteEnabled ? amendmentLedger.listForOrder(order.id) : [],
]);
const balancesByItem = new Map(fulfillmentBalances.map((balance) => [balance.order_item_id, balance] as const));
const itemProgress = items.map((item) => {
  const balance = balancesByItem.get(item.order_item_id);
  const fulfilled = balance?.fulfilled_quantity ?? 0;
  const cancelled = balance?.cancelled_quantity ?? 0;
  return {
    ...item,
    fulfilled_quantity: fulfilled,
    cancelled_quantity: cancelled,
    remaining_quantity: item.qty - fulfilled - cancelled,
  };
});
const remainingQuantity = itemProgress.reduce((sum, item) => sum + item.remaining_quantity, 0);
const activeFulfillments = fulfillments.filter((group) => group.status !== 'cancelled');
const totalRefund = refunds.find((candidate) => candidate.operation_type === 'total_cancellation');
const activePartialRefund = refunds.find((candidate) =>
  candidate.operation_type === 'partial_cancellation' &&
  ['pending', 'processing', 'failed', 'requires_review'].includes(candidate.status)
);
const activePartialLines = activePartialRefund
  ? await paymentLedger.refundItems(activePartialRefund.id)
  : [];
const partialRefundKey = activePartialRefund?.idempotency_key.split(':').at(-1) ?? '';
const partialShippingPolicy = shopConfig.refunds.partialShippingPolicy;
const refundRouteEnabled = runtimePlatform.hasCapabilityFlag('ORD-007', 'routes');
const refundEffectsEnabled = runtimePlatform.hasCapabilityFlag('ORD-007', 'sideEffects');
const refundActionDisabled = readOnly || !refundEffectsEnabled;
const activeAmendment = amendments.find((candidate) =>
  ['pending_payment', 'pending_refund', 'ready', 'requires_review'].includes(candidate.status)
);
const addr = JSON.parse(order.address_json) as { name: string; phone: string | null; street: string; city: string; postal_code: string; zone: string; nif?: string | null; company?: string | null; };
const statusLabel: Record<string, string> = { pending: 'Pendiente de pago', paid: 'Pagado', shipped: 'Enviado', delivered: 'Entregado', cancelled: 'Cancelado' };
const date = (value: string) => new Intl.DateTimeFormat('es-ES', { dateStyle: 'medium', timeStyle: 'short' }).format(new Date(value));
const financialStatusLabel: Record<string, string> = {
  pending: 'Pendiente', captured: 'Cobrado', partially_refunded: 'Reembolso parcial', refunded: 'Reembolsado',
  processing: 'En proceso', failed: 'Fallido', requires_review: 'Revisión necesaria',
};
const fulfillmentStatusLabel: Record<string, string> = {
  pending: 'Pendiente', ready: 'Preparado', shipped: 'En camino',
  delivered: 'Entregado', cancelled: 'Cancelado',
};
const timelineTitle = (kind: string, title: string): string => kind === 'status'
  ? (statusLabel[title] ?? title)
  : title;
const visibilityLabel: Record<string, string> = { internal: 'Interno', customer: 'Visible al cliente' };
---

<Admin title={`Pedido ${order.order_number}`} active="pedidos">
  <a href="/demo/admin" class="inline-flex min-h-11 items-center gap-2 rounded-xl text-sm font-semibold text-muted-foreground hover:text-foreground"><AdminIcon name="arrow-left" class="size-4"/>Todos los pedidos</a>

  <header class="mt-3 flex flex-col gap-4 border-b border-border pb-6 sm:flex-row sm:items-end sm:justify-between">
    <div><p class="text-xs font-semibold uppercase tracking-[0.16em] text-muted-foreground">Detalle del pedido</p><div class="mt-1 flex flex-wrap items-center gap-3"><h1 class="font-display text-3xl sm:text-4xl">{order.order_number}</h1><AdminStatusBadge status={order.status} label={statusLabel[order.status] ?? order.status}/></div><p class="mt-2 text-sm text-muted-foreground">Creado el {date(order.created_at)}</p></div>
    <div class="text-left sm:text-right"><p class="text-xs font-semibold uppercase tracking-[0.12em] text-muted-foreground">Total</p><p class="mt-1 text-2xl font-semibold">{formatEurCents(order.total_cents)}</p></div>
  </header>

  {readOnly && <div class="mt-5"><AdminNotice tone="info">Pedido ficticio de ejemplo. El panel público es de solo lectura: ninguna acción modifica datos ni envía avisos.</AdminNotice></div>}

  <div class="mt-6 grid gap-6 xl:grid-cols-[minmax(0,1fr)_22rem]">
    <div class="space-y-6">
      <section class="overflow-hidden rounded-2xl border border-border bg-card shadow-sm" aria-labelledby="lines-title">
        <div class="border-b border-border px-5 py-4"><h2 id="lines-title" class="font-display text-xl">Productos</h2><p class="mt-1 text-sm text-muted-foreground">{items.reduce((sum, item) => sum + item.qty, 0)} unidades en {items.length} líneas</p></div>
        <ul class="divide-y divide-border">{itemProgress.map((item) => <li class="grid grid-cols-[1fr_auto] gap-3 px-5 py-4 text-sm sm:grid-cols-[1fr_auto_auto] sm:items-center"><div><p class="font-semibold">{item.name_snapshot}</p><p class="mt-1 text-xs text-muted-foreground">Enviado {item.fulfilled_quantity} · Cancelado {item.cancelled_quantity} · Pendiente {item.remaining_quantity}</p><p class="mt-1 text-xs text-muted-foreground sm:hidden">{item.qty} × {formatEurCents(item.unit_price_cents)}</p></div><p class="hidden text-muted-foreground sm:block">{item.qty} × {formatEurCents(item.unit_price_cents)}</p><p class="text-right font-semibold">{formatEurCents(item.qty * item.unit_price_cents)}</p></li>)}</ul>
        <dl class="space-y-2 border-t border-border bg-muted/40 px-5 py-4 text-sm"><div class="flex justify-between gap-4"><dt class="text-muted-foreground">Subtotal</dt><dd>{formatEurCents(order.subtotal_cents)}</dd></div><div class="flex justify-between gap-4"><dt class="text-muted-foreground">Envío</dt><dd>{formatEurCents(order.shipping_cents)}</dd></div><div class="flex justify-between gap-4 border-t border-border pt-3 text-base font-semibold"><dt>Total</dt><dd>{formatEurCents(order.total_cents)}</dd></div></dl>
      </section>

      {amendmentRouteEnabled && amendmentContext && <section class="rounded-2xl border border-border bg-card p-5 shadow-sm" aria-labelledby="amendment-title">
        <div class="flex flex-wrap items-start justify-between gap-3">
          <div><h2 id="amendment-title" class="font-display text-xl">Editar pedido</h2><p class="mt-1 text-sm text-muted-foreground">Recalcula precio, envío y stock antes de aplicar cualquier cambio.</p></div>
          <span class="rounded-full bg-muted px-3 py-1 text-xs font-semibold text-muted-foreground">Versión {amendmentContext.order.edit_version}</span>
        </div>
        {readOnly ? <div class="mt-5 grid gap-3 sm:grid-cols-3">
          <div class="rounded-xl border border-border p-4"><p class="text-xs font-semibold uppercase tracking-wide text-muted-foreground">1 · Cambios</p><p class="mt-2 text-sm">Cantidades, nuevas variantes o dirección.</p></div>
          <div class="rounded-xl border border-border p-4"><p class="text-xs font-semibold uppercase tracking-wide text-muted-foreground">2 · Vista previa</p><p class="mt-2 text-sm">Delta económico y stock, siempre desde datos servidor.</p></div>
          <div class="rounded-xl border border-border p-4"><p class="text-xs font-semibold uppercase tracking-wide text-muted-foreground">3 · Conciliación</p><p class="mt-2 text-sm">Cobro alojado o reembolso a capturas concretas.</p></div>
          <div class="rounded-xl bg-muted p-4 sm:col-span-3"><p class="text-sm font-semibold">Ejemplo inerte</p><p class="mt-1 text-sm text-muted-foreground">Añadir 1 unidad · total anterior {formatEurCents(order.total_cents)} · la instalación activa mostraría aquí el nuevo total y el importe a cobrar.</p></div>
        </div> : activeAmendment ? <div class="mt-5 space-y-3">
          <AdminNotice tone={activeAmendment.status === 'requires_review' ? 'warning' : 'info'}>Hay una edición {activeAmendment.status === 'pending_payment' ? 'pendiente de pago' : activeAmendment.status === 'requires_review' ? 'que requiere revisión financiera' : 'en conciliación'}. No se puede abrir otra hasta cerrarla.</AdminNotice>
          {activeAmendment.status === 'requires_review' && amendmentEffectsEnabled && <button type="button" data-amendment-reconcile data-amendment-id={activeAmendment.id} class="min-h-11 rounded-xl border border-border px-4 text-sm font-semibold hover:bg-muted">Reintentar conciliación</button>}
        </div> : amendmentEffectsEnabled && order.status === 'paid' ? <form data-amendment-form data-order-id={order.id} data-order-version={amendmentContext.order.edit_version} class="mt-5 space-y-5">
          <fieldset class="space-y-3"><legend class="text-sm font-semibold">Cantidades vigentes</legend>{amendmentContext.lines.map((line) => <label class="grid gap-2 rounded-xl border border-border p-3 text-sm sm:grid-cols-[1fr_7rem] sm:items-center"><span><strong>{line.name_snapshot}</strong><span class="mt-1 block text-xs text-muted-foreground">{line.sku_snapshot} · mínimo comprometido {line.fulfilled_quantity + line.cancelled_quantity}</span></span><input type="number" min={line.fulfilled_quantity + line.cancelled_quantity} max="999" value={line.current_quantity} data-current={line.current_quantity} data-order-item-id={line.order_item_id} aria-label={`Cantidad de ${line.name_snapshot}`} class="min-h-11 rounded-xl border border-input bg-background px-3 text-right" /></label>)}</fieldset>
          <div class="grid gap-3 sm:grid-cols-[1fr_7rem]"><label class="text-sm font-semibold">Añadir variante<select data-new-variant class="mt-2 min-h-11 w-full rounded-xl border border-input bg-background px-3 font-normal"><option value="">Ninguna</option>{amendmentContext.variants.filter((variant) => !amendmentContext.lines.some((line) => line.variant_id === variant.variant_id)).map((variant) => <option value={variant.variant_id}>{variant.name}{variant.variant_name ? ` · ${variant.variant_name}` : ''} — {formatEurCents(variant.unit_price_cents)} · stock {variant.available_quantity}</option>)}</select></label><label class="text-sm font-semibold">Cantidad<input data-new-quantity type="number" min="1" max="999" value="1" class="mt-2 min-h-11 w-full rounded-xl border border-input bg-background px-3 text-right font-normal" /></label></div>
          {!amendmentContext.hasActiveFulfillment && <fieldset class="grid gap-3 border-t border-border pt-5 sm:grid-cols-2"><legend class="mb-2 text-sm font-semibold">Dirección de entrega</legend><label class="text-sm">Nombre<input name="name" value={addr.name} data-original={addr.name} class="mt-1 min-h-11 w-full rounded-xl border border-input bg-background px-3" /></label><label class="text-sm">Teléfono<input name="phone" value={addr.phone ?? ''} data-original={addr.phone ?? ''} class="mt-1 min-h-11 w-full rounded-xl border border-input bg-background px-3" /></label><label class="text-sm sm:col-span-2">Calle<input name="street" value={addr.street} data-original={addr.street} class="mt-1 min-h-11 w-full rounded-xl border border-input bg-background px-3" /></label><label class="text-sm">Ciudad<input name="city" value={addr.city} data-original={addr.city} class="mt-1 min-h-11 w-full rounded-xl border border-input bg-background px-3" /></label><label class="text-sm">Código postal<input name="postal_code" value={addr.postal_code} data-original={addr.postal_code} pattern="[0-9]{5}" class="mt-1 min-h-11 w-full rounded-xl border border-input bg-background px-3" /></label><label class="text-sm">NIF<input name="nif" value={addr.nif ?? ''} data-original={addr.nif ?? ''} class="mt-1 min-h-11 w-full rounded-xl border border-input bg-background px-3" /></label><label class="text-sm">Empresa<input name="company" value={addr.company ?? ''} data-original={addr.company ?? ''} class="mt-1 min-h-11 w-full rounded-xl border border-input bg-background px-3" /></label></fieldset>}
          <label class="block text-sm font-semibold">Motivo<input name="reason" maxlength="240" required placeholder="Motivo operativo de la edición" class="mt-2 min-h-11 w-full rounded-xl border border-input bg-background px-3 font-normal" /></label>
          <div data-amendment-preview class="hidden rounded-xl bg-muted p-4" aria-live="polite"></div>
          <div class="flex flex-col gap-2 sm:flex-row"><button type="button" data-amendment-preview-button class="min-h-11 rounded-xl border border-border px-4 text-sm font-semibold hover:bg-muted">Calcular vista previa</button><button type="submit" data-amendment-apply disabled class="min-h-11 rounded-xl bg-foreground px-4 text-sm font-semibold text-background disabled:cursor-not-allowed disabled:opacity-50">Aplicar edición</button></div>
          <p data-amendment-error class="hidden text-sm text-red-700" role="alert"></p>
        </form> : <p class="mt-5 rounded-xl bg-muted p-4 text-sm text-muted-foreground">La edición no está disponible para el estado actual del pedido.</p>}
        {amendments.length > 0 && <ol class="mt-5 space-y-2 border-t border-border pt-4">{amendments.slice(0, 5).map((amendment) => <li class="flex items-center justify-between gap-3 rounded-xl bg-muted/60 p-3 text-sm"><span><strong>{amendment.reason}</strong><span class="mt-1 block text-xs text-muted-foreground">{date(amendment.created_at)} · {amendment.status}</span></span><span class:list={['font-semibold', amendment.delta_cents > 0 ? 'text-amber-700' : amendment.delta_cents < 0 ? 'text-emerald-700' : '']}>{amendment.delta_cents > 0 ? '+' : ''}{formatEurCents(amendment.delta_cents)}</span></li>)}</ol>}
      </section>}

      {partialEnabled && <section class="rounded-2xl border border-border bg-card p-5 shadow-sm" aria-labelledby="fulfillments-title"><div class="flex flex-wrap items-end justify-between gap-3"><div><h2 id="fulfillments-title" class="font-display text-xl">Envíos</h2><p class="mt-1 text-sm text-muted-foreground">{remainingQuantity} unidades pendientes · {fulfillments.length} grupos</p></div></div>{fulfillments.length === 0 ? <p class="mt-5 rounded-xl bg-muted p-4 text-sm text-muted-foreground">Todavía no ha salido ningún paquete.</p> : <ol class="mt-5 space-y-3">{fulfillments.map((fulfillment, index) => <li class="rounded-xl border border-border p-4"><div class="flex flex-wrap items-start justify-between gap-3"><div><p class="font-semibold">Envío {index + 1} · {fulfillment.total_quantity} unidades</p><p class="mt-1 text-sm text-muted-foreground">{fulfillment.carrier} · <span class="break-all font-mono text-xs">{fulfillment.tracking_number}</span></p></div><AdminStatusBadge status={fulfillment.status} label={fulfillmentStatusLabel[fulfillment.status] ?? fulfillment.status}/></div>{fulfillment.shipped_at && <p class="mt-3 text-xs text-muted-foreground">Salió el {date(fulfillment.shipped_at)}</p>}{fulfillment.delivered_at && <p class="mt-1 text-xs text-muted-foreground">Entregado el {date(fulfillment.delivered_at)}</p>}{!readOnly && partialEffectsEnabled && fulfillment.status === 'shipped' && <button type="button" data-deliver-fulfillment data-fulfillment-id={fulfillment.id} class="mt-4 min-h-11 w-full rounded-xl border border-border px-4 text-sm font-semibold hover:bg-muted">Marcar este envío como entregado</button>}</li>)}</ol>}</section>}

      {collaborationEnabled && <section class="rounded-2xl border border-border bg-card p-5 shadow-sm" aria-labelledby="notes-title">
        <div class="flex flex-wrap items-start justify-between gap-3"><div><h2 id="notes-title" class="font-display text-xl">Notas</h2><p class="mt-1 text-sm text-muted-foreground">Contexto operativo con visibilidad explícita y revisiones auditadas</p></div><span class="rounded-full bg-muted px-3 py-1 text-xs font-semibold text-muted-foreground">{notes.length} nota{notes.length === 1 ? '' : 's'}</span></div>
        {notes.length > 0 ? <ol class="mt-5 space-y-3">{notes.map((note) => <li class="rounded-xl border border-border p-4"><div class="flex flex-wrap items-center justify-between gap-2"><div class="flex flex-wrap items-center gap-2"><span class="rounded-full bg-muted px-2.5 py-1 text-xs font-semibold">{visibilityLabel[note.visibility]}</span><span class="text-xs text-muted-foreground">v{note.version} · {note.actor_label ?? note.actor_kind}</span></div><time class="text-xs text-muted-foreground">{date(note.updated_at)}</time></div><p class="mt-3 whitespace-pre-wrap text-sm leading-6">{note.body}</p>{!readOnly && collaborationEffectsEnabled && <details class="mt-3"><summary class="flex min-h-11 cursor-pointer items-center text-sm font-semibold text-muted-foreground">Editar nota</summary><form data-note-form data-note-id={note.id} data-order-id={order.id} data-version={note.version} class="grid gap-3 border-t border-border pt-3"><textarea name="body" maxlength="4000" required class="min-h-28 rounded-xl border border-input bg-background p-3 text-sm">{note.body}</textarea><div class="flex flex-col gap-2 sm:flex-row"><select name="visibility" class="min-h-11 rounded-xl border border-input bg-background px-3 text-sm"><option value="internal" selected={note.visibility === 'internal'}>Solo equipo</option><option value="customer" selected={note.visibility === 'customer'}>Visible al cliente</option></select><button class="min-h-11 rounded-xl bg-foreground px-4 text-sm font-semibold text-background">Guardar revisión</button></div><p data-form-error class="hidden text-sm text-red-700" role="alert"></p></form></details>}</li>)}</ol> : <p class="mt-5 rounded-xl bg-muted p-4 text-sm text-muted-foreground">Todavía no hay notas para este pedido.</p>}
        {!readOnly && collaborationEffectsEnabled && <form data-note-create data-order-id={order.id} class="mt-5 grid gap-3 border-t border-border pt-5"><label class="text-sm font-semibold">Añadir nota<textarea name="body" maxlength="4000" required placeholder="Contexto útil para el equipo o el cliente" class="mt-2 min-h-28 w-full rounded-xl border border-input bg-background p-3 text-sm font-normal"></textarea></label><div class="flex flex-col gap-2 sm:flex-row"><select name="visibility" class="min-h-11 rounded-xl border border-input bg-background px-3 text-sm"><option value="internal">Solo equipo</option><option value="customer">Visible al cliente</option></select><button class="min-h-11 rounded-xl bg-foreground px-4 text-sm font-semibold text-background">Añadir nota</button></div><p data-form-error class="hidden text-sm text-red-700" role="alert"></p></form>}
      </section>}

      <section class="rounded-2xl border border-border bg-card p-5 shadow-sm" aria-labelledby="timeline-title">
        <h2 id="timeline-title" class="font-display text-xl">Actividad</h2><p class="mt-1 text-sm text-muted-foreground">Estados, notas y etiquetas en un historial unificado</p>
        <ol class="relative mt-6 space-y-6 before:absolute before:bottom-2 before:left-[0.44rem] before:top-2 before:w-px before:bg-border">{timeline.map((event) => <li class="relative grid grid-cols-[1rem_1fr] gap-4"><span class:list={['relative z-10 mt-1.5 size-3 rounded-full border-2 border-card ring-2 ring-border', event.kind === 'note' ? 'bg-sky-600' : event.kind === 'tag' ? 'bg-amber-600' : 'bg-foreground']}></span><div><div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between"><p class="font-semibold">{timelineTitle(event.kind, event.title)}</p><time class="text-xs text-muted-foreground">{date(event.occurred_at)}</time></div><p class="mt-1 text-xs font-medium text-muted-foreground">{event.actor_label ?? event.actor_kind} · {visibilityLabel[event.visibility]}</p>{event.detail && <p class="mt-1 whitespace-pre-wrap text-sm leading-6 text-muted-foreground">{event.detail}</p>}</div></li>)}</ol>
      </section>
    </div>

    <aside class="space-y-6">
      {collaborationEnabled && <section class="rounded-2xl border border-border bg-card p-5 shadow-sm" aria-labelledby="tags-title"><h2 id="tags-title" class="font-display text-lg">Etiquetas</h2><p class="mt-1 text-sm text-muted-foreground">Clasificación interna para localizar y priorizar pedidos</p>{tags.length > 0 ? <ul class="mt-4 flex flex-wrap gap-2">{tags.map((tag) => <li class="flex items-center rounded-full border border-border bg-muted pl-3 text-xs font-semibold"><span>{tag.label}</span>{!readOnly && collaborationEffectsEnabled && <button type="button" data-tag-action="remove" data-tag-id={tag.id} data-order-id={order.id} class="ml-1 flex size-11 items-center justify-center rounded-full text-muted-foreground hover:bg-background" aria-label={`Quitar etiqueta ${tag.label}`}>×</button>}</li>)}</ul> : <p class="mt-4 text-sm text-muted-foreground">Sin etiquetas asignadas.</p>}{!readOnly && collaborationEffectsEnabled && <div class="mt-5 space-y-4 border-t border-border pt-4"><form data-tag-assign data-order-id={order.id} class="grid gap-2"><label class="text-xs font-semibold text-muted-foreground">Asignar etiqueta<select name="tag_id" required class="mt-1 min-h-11 w-full rounded-xl border border-input bg-background px-3 text-sm text-foreground"><option value="">Selecciona…</option>{availableTags.filter((tag) => tag.active === 1 && !tags.some((selected) => selected.id === tag.id)).map((tag) => <option value={tag.id}>{tag.label}</option>)}</select></label><button class="min-h-11 rounded-xl border border-border px-3 text-sm font-semibold hover:bg-muted">Asignar</button><p data-form-error class="hidden text-sm text-red-700" role="alert"></p></form><form data-tag-create class="grid gap-2"><label class="text-xs font-semibold text-muted-foreground">Nueva etiqueta<input name="label" maxlength="80" required class="mt-1 min-h-11 w-full rounded-xl border border-input bg-background px-3 text-sm text-foreground" /></label><button class="min-h-11 rounded-xl border border-border px-3 text-sm font-semibold hover:bg-muted">Crear etiqueta</button><p data-form-error class="hidden text-sm text-red-700" role="alert"></p></form></div>}</section>}
      {refundRouteEnabled && payment && <section class="rounded-2xl border border-border bg-card p-5 shadow-sm" aria-labelledby="payment-title">
        <h2 id="payment-title" class="font-display text-lg">Pago y reembolsos</h2>
        <dl class="mt-4 space-y-2 text-sm">
          <div class="flex items-center justify-between gap-4"><dt class="text-muted-foreground">Pago</dt><dd class="font-semibold">{financialStatusLabel[payment.status] ?? payment.status}</dd></div>
          <div class="flex items-center justify-between gap-4"><dt class="text-muted-foreground">Proveedor</dt><dd class="font-mono text-xs uppercase">{payment.provider}</dd></div>
          <div class="flex items-center justify-between gap-4"><dt class="text-muted-foreground">Abonado</dt><dd class="font-semibold">{formatEurCents(payment.refunded_cents)}</dd></div>
        </dl>
        {refunds.length > 0 && <ol class="mt-4 space-y-2 border-t border-border pt-4">{refunds.map((refund) => <li class="rounded-xl bg-muted/60 p-3 text-sm"><div class="flex items-start justify-between gap-3"><div><p class="font-semibold">{refund.operation_type === 'partial_cancellation' ? 'Parcial' : 'Total'} · {formatEurCents(refund.total_cents)}</p><p class="mt-1 text-xs text-muted-foreground">{refund.reason}</p></div><span class="text-xs font-semibold">{financialStatusLabel[refund.status] ?? refund.status}</span></div></li>)}</ol>}
        {activePartialRefund?.status === 'processing' && <p class="mt-3 text-sm leading-6 text-muted-foreground">La pasarela aún procesa el abono parcial. Reintentar conserva la misma referencia.</p>}
        {(activePartialRefund?.status === 'failed' || activePartialRefund?.status === 'requires_review') && <div class="mt-3"><AdminNotice tone="warning">La pasarela no confirmó el parcial. Reconcílialo antes de preparar más unidades.</AdminNotice></div>}
      </section>}

      <section class="rounded-2xl border border-border bg-card p-5 shadow-sm" aria-labelledby="customer-title"><h2 id="customer-title" class="font-display text-lg">Cliente y entrega</h2><div class="mt-4 text-sm leading-6"><p class="font-semibold">{addr.name}</p><p>{addr.street}</p><p>{addr.postal_code} {addr.city}</p><a href={`mailto:${order.email}`} class="mt-3 block break-all text-muted-foreground underline underline-offset-4">{order.email}</a>{addr.phone && <a href={`tel:${addr.phone}`} class="block text-muted-foreground underline underline-offset-4">{addr.phone}</a>}</div>{(addr.nif || addr.company) && <div class="mt-4 rounded-xl bg-amber-50 p-3 text-sm text-amber-950"><p class="text-xs font-semibold uppercase tracking-wide">Facturación</p><p class="mt-1">{[addr.company, addr.nif].filter(Boolean).join(' · ')}</p></div>}</section>

      {!readOnly && trackingEnabled && partialEffectsEnabled && order.status === 'paid' && remainingQuantity > 0 && <form data-ship-form data-order-id={order.id} class="rounded-2xl border border-border bg-card p-5 shadow-sm"><h2 class="font-display text-lg">Preparar envío</h2><p class="mt-1 text-sm leading-6 text-muted-foreground">Elige cantidades o usa la salida completa. Cada paquete avisa al cliente.</p><fieldset class="mt-4 space-y-2"><legend class="text-xs font-semibold text-muted-foreground">Unidades de este envío</legend>{itemProgress.filter((item) => item.remaining_quantity > 0).map((item) => <label class="flex min-h-11 items-center justify-between gap-3 rounded-xl border border-border px-3 text-sm"><span class="min-w-0 truncate">{item.name_snapshot}</span><input type="number" inputmode="numeric" min="0" max={item.remaining_quantity} value="0" data-fulfillment-line data-line-id={item.order_item_id} aria-label={`Cantidad de ${item.name_snapshot}; máximo ${item.remaining_quantity}`} class="h-9 w-16 rounded-lg border border-input px-2 text-right"/></label>)}</fieldset><label class="mt-4 block text-xs font-semibold text-muted-foreground" for="carrier">Transportista</label><input id="carrier" name="carrier" required list="carriers" class="mt-1 min-h-11 w-full rounded-xl border border-input px-3 text-sm"/><datalist id="carriers"><option value="SEUR"></option><option value="Correos Express"></option><option value="GLS"></option><option value="MRW"></option><option value="CTT"></option></datalist><label class="mt-3 block text-xs font-semibold text-muted-foreground" for="tracking">Nº de seguimiento</label><input id="tracking" name="tracking" required class="mt-1 min-h-11 w-full rounded-xl border border-input px-3 text-sm"/><p data-ship-error role="alert" class="mt-2 hidden text-sm text-red-700"></p><div class="mt-4 grid gap-2"><button type="submit" data-ship-mode="selected" class="min-h-11 rounded-xl border border-border px-4 text-sm font-semibold hover:bg-muted">Enviar selección</button><button type="submit" data-ship-mode="all" class="min-h-11 rounded-xl bg-foreground px-4 text-sm font-semibold text-background hover:bg-foreground/85">Enviar todo lo pendiente</button></div></form>}

      {refundRouteEnabled && order.status === 'paid' && remainingQuantity > 0 && payment && (payment.status === 'captured' || payment.status === 'partially_refunded') && payment.provider !== 'legacy' && <form
        data-refund-form
        data-refund-mode="partial"
        data-order-id={order.id}
        data-idempotency-key={partialRefundKey}
        data-refund-lines={activePartialRefund ? JSON.stringify(activePartialLines.map((line) => ({ order_item_id: line.order_item_id, quantity: line.quantity }))) : undefined}
        class="rounded-2xl border border-amber-300 bg-amber-50 p-5"
      >
        <h2 class="font-display text-lg text-amber-950">Cancelación parcial</h2>
        <p class="mt-2 text-sm leading-6 text-amber-900">Selecciona unidades no enviadas. Precio, saldo e importe se recalculan en el servidor.</p>
        {refundActionDisabled && <p class="mt-3 rounded-xl border border-amber-300 bg-white/60 p-3 text-sm text-amber-950">Vista demostrativa: la operación está desactivada y la API responde 403.</p>}
        {activePartialRefund ? <p class="mt-4 rounded-xl border border-amber-300 bg-white/60 p-3 text-sm text-amber-950">Hay un parcial {financialStatusLabel[activePartialRefund.status]?.toLowerCase() ?? activePartialRefund.status}. Reintenta la misma selección para reconciliarlo sin duplicar el abono.</p> : <fieldset class="mt-4 space-y-2"><legend class="text-xs font-semibold text-amber-900">Unidades a cancelar</legend>{itemProgress.filter((item) => item.remaining_quantity > 0).map((item) => <label class="flex min-h-11 items-center justify-between gap-3 rounded-xl border border-amber-300 bg-white/70 px-3 text-sm text-amber-950"><span class="min-w-0 truncate">{item.name_snapshot}</span><input type="number" inputmode="numeric" min="0" max={item.remaining_quantity} value="0" data-refund-line data-line-id={item.order_item_id} aria-label={`Cancelar unidades de ${item.name_snapshot}; máximo ${item.remaining_quantity}`} disabled={refundActionDisabled} class="h-9 w-16 rounded-lg border border-amber-300 bg-white px-2 text-right"/></label>)}</fieldset>}
        <label class="mt-4 block text-xs font-semibold text-amber-900" for="partial-refund-reason">Motivo</label>
        <select id="partial-refund-reason" name="reason" required disabled={refundActionDisabled} class="mt-1 min-h-11 w-full rounded-xl border border-amber-300 bg-white px-3 text-sm text-amber-950"><option value="Cancelación solicitada por el cliente">Cancelación solicitada por el cliente</option><option value="Producto no disponible">Producto no disponible</option><option value="Ajuste acordado con el cliente">Ajuste acordado con el cliente</option></select>
        <label class="mt-4 flex min-h-11 items-center gap-3 text-sm font-medium text-amber-950"><input type="checkbox" name="restock" checked disabled={refundActionDisabled} class="size-5"/>Reponer las unidades canceladas</label>
        <p class="mt-1 text-xs leading-5 text-amber-900">{partialShippingPolicy === 'merchandise-only' ? 'Esta tienda devuelve solo la mercancía en parciales; el envío se conserva.' : 'Esta tienda devuelve el envío completo únicamente al cancelar la última mercancía y si nada ha salido.'}</p>
        <p data-refund-error role="alert" class="mt-2 hidden text-sm font-medium text-red-800"></p>
        <button type="submit" disabled={refundActionDisabled} class="mt-4 min-h-11 w-full rounded-xl border border-amber-400 bg-white px-4 text-sm font-semibold text-foreground hover:bg-amber-100 disabled:cursor-not-allowed">{activePartialRefund ? 'Reintentar o reconciliar' : 'Reembolsar selección'}</button>
      </form>}

      {!readOnly && refundEffectsEnabled && order.status === 'paid' && activeFulfillments.length === 0 && (refunds.length === 0 || (refunds.length === 1 && totalRefund)) && payment?.status === 'captured' && payment.provider !== 'legacy' && <form data-refund-form data-refund-mode="total" data-order-id={order.id} class="rounded-2xl border border-red-200 bg-red-50 p-5"><h2 class="font-display text-lg text-red-950">Reembolso total</h2><p class="mt-2 text-sm leading-6 text-red-900">Devuelve {formatEurCents(order.total_cents)} por la pasarela y cancela el pedido. El importe siempre sale del servidor.</p><label class="mt-4 block text-xs font-semibold text-red-900" for="refund-reason">Motivo</label><select id="refund-reason" name="reason" required class="mt-1 min-h-11 w-full rounded-xl border border-red-300 bg-white px-3 text-sm text-red-950"><option value="Cancelación solicitada por el cliente">Cancelación solicitada por el cliente</option><option value="Pedido duplicado">Pedido duplicado</option><option value="Producto no disponible">Producto no disponible</option></select><label class="mt-4 flex min-h-11 items-center gap-3 text-sm font-medium text-red-950"><input type="checkbox" name="restock" checked class="size-5"/>Reponer las unidades en stock</label><p class="mt-1 text-xs leading-5 text-red-800">El abono total incluye el envío y la reposición queda registrada aparte.</p><p data-refund-error role="alert" class="mt-2 hidden text-sm font-medium text-red-800"></p><button type="submit" class="mt-4 min-h-11 w-full rounded-xl border border-red-300 bg-white px-4 text-sm font-semibold text-red-800 hover:bg-red-100">{totalRefund ? 'Reintentar o reconciliar' : 'Reembolsar y cancelar'}</button></form>}
    </aside>
  </div>

  <script>
    const shipForm = document.querySelector<HTMLFormElement>('[data-ship-form]');
    shipForm?.addEventListener('submit', (event) => { event.preventDefault(); if (!shipForm.reportValidity()) return; const submitter = (event as SubmitEvent).submitter as HTMLButtonElement | null; const buttons = [...shipForm.querySelectorAll<HTMLButtonElement>('button[type="submit"]')]; if (buttons.some((button) => button.disabled)) return; const data = new FormData(shipForm); const lines = [...shipForm.querySelectorAll<HTMLInputElement>('[data-fulfillment-line]')].map((input) => ({ order_item_id: Number(input.dataset.lineId), quantity: Number(input.value) })).filter((line) => Number.isInteger(line.quantity) && line.quantity > 0); const error = shipForm.querySelector<HTMLElement>('[data-ship-error]')!; if (submitter?.dataset.shipMode !== 'all' && lines.length === 0) { error.textContent = 'Selecciona al menos una unidad o usa “Enviar todo”.'; error.classList.remove('hidden'); return; } buttons.forEach((button) => { button.disabled = true; }); shipForm.dataset.idempotencyKey ||= crypto.randomUUID(); void (async () => { const res = await fetch('/api/admin/fulfillments', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ order_id: Number(shipForm.dataset.orderId), tracking_carrier: String(data.get('carrier') ?? ''), tracking_number: String(data.get('tracking') ?? ''), idempotency_key: shipForm.dataset.idempotencyKey, ...(submitter?.dataset.shipMode === 'all' ? {} : { lines }) }) }); if (res.ok) window.location.reload(); else { const body = await res.json() as { error?: string }; error.textContent = body.error ?? 'Error inesperado'; error.classList.remove('hidden'); buttons.forEach((button) => { button.disabled = false; }); } })(); });
    document.querySelectorAll<HTMLButtonElement>('[data-deliver-fulfillment]').forEach((button) => button.addEventListener('click', () => { if (button.disabled) return; button.disabled = true; void fetch(`/api/admin/fulfillments/${button.dataset.fulfillmentId}`, { method: 'PATCH', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ status: 'delivered' }) }).then((res) => { if (res.ok) window.location.reload(); else button.disabled = false; }); }));
    document.querySelectorAll<HTMLFormElement>('[data-refund-form]').forEach((refundForm) => {
      const refundButton = refundForm.querySelector<HTMLButtonElement>('button[type="submit"]');
      refundForm.addEventListener('submit', (event) => {
        event.preventDefault();
        if (!refundForm.reportValidity() || refundButton?.disabled) return;
        const data = new FormData(refundForm);
        const partial = refundForm.dataset.refundMode === 'partial';
        const presetLines = refundForm.dataset.refundLines;
        const lines = presetLines
          ? JSON.parse(presetLines) as { order_item_id: number; quantity: number }[]
          : [...refundForm.querySelectorAll<HTMLInputElement>('[data-refund-line]')]
              .map((input) => ({
                order_item_id: Number(input.dataset.lineId),
                quantity: Number(input.value),
              }))
              .filter((line) => Number.isInteger(line.quantity) && line.quantity > 0);
        const error = refundForm.querySelector<HTMLElement>('[data-refund-error]')!;
        if (partial && lines.length === 0) {
          error.textContent = 'Selecciona al menos una unidad para cancelar.';
          error.classList.remove('hidden');
          return;
        }
        const confirmation = partial
          ? '¿Confirmas el reembolso de las unidades seleccionadas? El servidor recalculará el importe y bloqueará cualquier unidad ya enviada.'
          : '¿Confirmas el reembolso total y la cancelación? La pasarela recibirá la orden una sola vez aunque haya reintentos.';
        if (!window.confirm(confirmation)) return;
        if (refundButton) refundButton.disabled = true;
        if (partial) refundForm.dataset.idempotencyKey ||= crypto.randomUUID();
        const payload = partial
          ? {
              mode: 'partial',
              reason: String(data.get('reason') ?? ''),
              restock: data.get('restock') === 'on',
              idempotency_key: refundForm.dataset.idempotencyKey,
              lines,
            }
          : {
              mode: 'total',
              reason: String(data.get('reason') ?? ''),
              restock: data.get('restock') === 'on',
            };
        void (async () => {
          const res = await fetch(`/api/admin/refunds/${refundForm.dataset.orderId}`, {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify(payload),
          });
          if (res.ok) window.location.reload();
          else {
            if (refundButton) refundButton.disabled = false;
            const body = await res.json() as { error?: string };
            error.textContent = body.error ?? 'Error inesperado';
            error.classList.remove('hidden');
          }
        })();
      });
    });

    const sendCollaboration = async (form: HTMLFormElement, url: string, method: 'POST' | 'PATCH', payload: Record<string, unknown>) => {
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      const error = form.querySelector<HTMLElement>('[data-form-error]');
      if (button) button.disabled = true;
      const response = await fetch(url, {
        method,
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify(payload),
      });
      if (response.ok) { window.location.reload(); return; }
      const result = await response.json().catch(() => ({})) as { error?: string };
      if (error) { error.textContent = result.error ?? 'No se pudo guardar el cambio.'; error.classList.remove('hidden'); }
      if (button) button.disabled = false;
    };
    document.querySelectorAll<HTMLFormElement>('[data-note-create], [data-note-form]').forEach((form) => {
      form.addEventListener('submit', (event) => {
        event.preventDefault();
        if (!form.reportValidity()) return;
        const data = new FormData(form);
        const noteId = form.dataset.noteId;
        const payload = {
          order_id: Number(form.dataset.orderId),
          body: String(data.get('body') ?? ''),
          visibility: String(data.get('visibility') ?? 'internal'),
          ...(noteId ? { expected_version: Number(form.dataset.version) } : {}),
        };
        void sendCollaboration(form, noteId ? `/api/admin/order-notes/${noteId}` : '/api/admin/order-notes', noteId ? 'PATCH' : 'POST', payload);
      });
    });
    document.querySelectorAll<HTMLFormElement>('[data-tag-assign]').forEach((form) => {
      form.addEventListener('submit', (event) => {
        event.preventDefault();
        if (!form.reportValidity()) return;
        const data = new FormData(form);
        void sendCollaboration(form, '/api/admin/order-tags/assignments', 'POST', {
          order_id: Number(form.dataset.orderId), tag_id: Number(data.get('tag_id')), action: 'assign',
        });
      });
    });
    document.querySelectorAll<HTMLFormElement>('[data-tag-create]').forEach((form) => {
      form.addEventListener('submit', (event) => {
        event.preventDefault();
        if (!form.reportValidity()) return;
        const data = new FormData(form);
        void sendCollaboration(form, '/api/admin/order-tags', 'POST', { label: String(data.get('label') ?? '') });
      });
    });
    document.querySelectorAll<HTMLButtonElement>('[data-tag-action]').forEach((button) => {
      button.addEventListener('click', () => {
        if (button.disabled) return;
        button.disabled = true;
        void fetch('/api/admin/order-tags/assignments', {
          method: 'POST', headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ order_id: Number(button.dataset.orderId), tag_id: Number(button.dataset.tagId), action: 'remove' }),
        }).then((response) => { if (response.ok) window.location.reload(); else button.disabled = false; });
      });
    });

    const amendmentForm = document.querySelector<HTMLFormElement>('[data-amendment-form]');
    if (amendmentForm) {
      const previewBox = amendmentForm.querySelector<HTMLElement>('[data-amendment-preview]')!;
      const errorBox = amendmentForm.querySelector<HTMLElement>('[data-amendment-error]')!;
      const applyButton = amendmentForm.querySelector<HTMLButtonElement>('[data-amendment-apply]')!;
      const previewButton = amendmentForm.querySelector<HTMLButtonElement>('[data-amendment-preview-button]')!;
      let previewFingerprint = '';
      const payload = () => {
        const data = new FormData(amendmentForm);
        const lines: Array<{ order_item_id: number; quantity: number } | { variant_id: number; quantity: number }> = [...amendmentForm.querySelectorAll<HTMLInputElement>('[data-order-item-id]')]
          .filter((input) => Number(input.value) !== Number(input.dataset.current))
          .map((input) => ({ order_item_id: Number(input.dataset.orderItemId), quantity: Number(input.value) }));
        const newVariant = amendmentForm.querySelector<HTMLInputElement>('[data-new-variant]');
        const newQuantity = amendmentForm.querySelector<HTMLInputElement>('[data-new-quantity]');
        if (newVariant?.value) lines.push({ variant_id: Number(newVariant.value), quantity: Number(newQuantity?.value ?? 1) });
        const addressFields = ['name', 'phone', 'street', 'city', 'postal_code', 'nif', 'company'] as const;
        const changedAddress = addressFields.some((field) => {
          const input = amendmentForm.elements.namedItem(field) as HTMLInputElement | null;
          return input && input.value !== input.dataset.original;
        });
        const address = changedAddress ? {
          name: String(data.get('name') ?? ''), phone: String(data.get('phone') ?? '') || null,
          street: String(data.get('street') ?? ''), city: String(data.get('city') ?? ''),
          postal_code: String(data.get('postal_code') ?? ''), nif: String(data.get('nif') ?? '') || null,
          company: String(data.get('company') ?? '') || null,
        } : undefined;
        return {
          order_id: Number(amendmentForm.dataset.orderId),
          expected_version: Number(amendmentForm.dataset.orderVersion),
          lines,
          ...(address ? { address } : {}),
        };
      };
      amendmentForm.addEventListener('input', () => { applyButton.disabled = true; previewFingerprint = ''; });
      previewButton.addEventListener('click', () => {
        if (!amendmentForm.reportValidity() || previewButton.disabled) return;
        previewButton.disabled = true;
        errorBox.classList.add('hidden');
        void (async () => {
          const requestPayload = payload();
          const response = await fetch('/api/admin/order-amendments/preview', {
            method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(requestPayload),
          });
          const result = await response.json() as { error?: string; preview?: { total_before_cents: number; total_after_cents: number; delta_cents: number; status: string; stock_increments: unknown[]; stock_restock: unknown[] } };
          previewButton.disabled = false;
          if (!response.ok || !result.preview) {
            errorBox.textContent = result.error ?? 'No se pudo calcular la vista previa.';
            errorBox.classList.remove('hidden');
            return;
          }
          const euros = (cents: number) => new Intl.NumberFormat('es-ES', { style: 'currency', currency: 'EUR' }).format(cents / 100);
          const financial = result.preview.delta_cents > 0 ? `Cobro adicional ${euros(result.preview.delta_cents)}` : result.preview.delta_cents < 0 ? `Reembolso ${euros(-result.preview.delta_cents)}` : 'Sin ajuste económico';
          previewBox.textContent = `Total ${euros(result.preview.total_before_cents)} → ${euros(result.preview.total_after_cents)}. ${financial}. Stock: +${result.preview.stock_increments.length} reservas, ${result.preview.stock_restock.length} reposiciones.`;
          previewBox.classList.remove('hidden');
          previewFingerprint = JSON.stringify(requestPayload);
          applyButton.disabled = false;
        })();
      });
      amendmentForm.addEventListener('submit', (event) => {
        event.preventDefault();
        if (!amendmentForm.reportValidity() || applyButton.disabled) return;
        const requestPayload = payload();
        if (JSON.stringify(requestPayload) !== previewFingerprint) { applyButton.disabled = true; return; }
        const reason = String(new FormData(amendmentForm).get('reason') ?? '');
        if (!window.confirm('¿Confirmas esta edición? El servidor volverá a validar precio, stock, versión y estado antes de conciliar dinero.')) return;
        amendmentForm.dataset.idempotencyKey ||= crypto.randomUUID();
        applyButton.disabled = true;
        void (async () => {
          const response = await fetch('/api/admin/order-amendments', {
            method: 'POST', headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ ...requestPayload, reason, idempotency_key: amendmentForm.dataset.idempotencyKey }),
          });
          const result = await response.json() as { error?: string; payment_url?: string | null };
          if (response.ok && result.payment_url) { window.location.assign(result.payment_url); return; }
          if (response.ok) { window.location.reload(); return; }
          applyButton.disabled = false;
          errorBox.textContent = result.error ?? 'No se pudo aplicar la edición.';
          errorBox.classList.remove('hidden');
        })();
      });
    }
    document.querySelectorAll<HTMLButtonElement>('[data-amendment-reconcile]').forEach((button) => {
      button.addEventListener('click', () => {
        if (button.disabled) return;
        button.disabled = true;
        void fetch(`/api/admin/order-amendments/${button.dataset.amendmentId}`, { method: 'POST' })
          .then((response) => { if (response.ok) window.location.reload(); else button.disabled = false; });
      });
    });
  </script>
</Admin>
