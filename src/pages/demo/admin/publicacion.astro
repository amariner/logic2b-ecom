---
import { canShowMarketPublicationDemo } from '../../../composition/market-publication-demo';
import { runtimePlatform } from '../../../composition/runtime-platform';
import Admin from '../../../layouts/Admin.astro';
import AdminPageHeader from '../../../components/admin/AdminPageHeader.astro';
import MarketPublicationDemo from '../../../components/admin/MarketPublicationDemo.astro';

export const prerender = false;

if (!canShowMarketPublicationDemo(Astro.locals.runtime?.env, runtimePlatform)) {
  return new Response('Página no encontrada.', {
    status: 404,
    headers: { 'content-type': 'text/plain; charset=utf-8', 'cache-control': 'no-store' },
  });
}
---

<Admin title="Publicación del catálogo" active="publicacion">
  <AdminPageHeader eyebrow="Internacional · demostración" title="Publicación del catálogo" description="Explora qué productos y variantes aparecerían en cada mercado y canal. Prepara una selección y comprueba el resultado con un catálogo ficticio." />
  <MarketPublicationDemo />
</Admin>
