---
import { canShowMarketContentDemo } from '../../../composition/market-content-demo';
import { runtimePlatform } from '../../../composition/runtime-platform';
import Admin from '../../../layouts/Admin.astro';
import AdminPageHeader from '../../../components/admin/AdminPageHeader.astro';
import MarketContentDemo from '../../../components/admin/MarketContentDemo.astro';

export const prerender = false;

if (!canShowMarketContentDemo(Astro.locals.runtime?.env, runtimePlatform)) {
  return new Response('Página no encontrada.', {
    status: 404,
    headers: { 'content-type': 'text/plain; charset=utf-8', 'cache-control': 'no-store' },
  });
}
---

<Admin title="Mercados e idiomas" active="mercados">
  <AdminPageHeader eyebrow="Internacional · demostración" title="Mercados e idiomas" description="Comprueba qué contenido verá cada visitante. Prepara una versión en otro idioma y compara sus direcciones en este ejemplo." />
  <MarketContentDemo />
</Admin>
