---
import { canShowCompanyDirectoryDemo } from '../../../composition/company-directory-demo';
import { runtimePlatform } from '../../../composition/runtime-platform';
import Admin from '../../../layouts/Admin.astro';
import AdminPageHeader from '../../../components/admin/AdminPageHeader.astro';
import CompanyDirectoryDemo from '../../../components/admin/CompanyDirectoryDemo.astro';

export const prerender = false;

if (!canShowCompanyDirectoryDemo(Astro.locals.runtime?.env, runtimePlatform)) {
  return new Response('Página no encontrada.', {
    status: 404,
    headers: { 'content-type': 'text/plain; charset=utf-8', 'cache-control': 'no-store' },
  });
}
---

<Admin title="Empresas y sedes" active="empresas">
  <AdminPageHeader eyebrow="Clientes · demostración" title="Empresas y sedes" description="Consulta sedes, contactos y roles descriptivos, y distingue una declaración fiscal de su evidencia de ejemplo." />
  <CompanyDirectoryDemo />
</Admin>
