---
// Página 404 propia (sustituye a la genérica del Worker). Misma cabecera, pie
// y lenguaje visual que el resto de páginas comerciales (shell Landing).
import Landing from '../layouts/Landing.astro';
import { MAIN_DEMO_HREF, DEMO_ADMIN_HREF } from '../lib/nav';
---

<Landing title="Página no encontrada — Logic2B Ecommerce" noindex>
  <main class="mx-auto flex w-full max-w-2xl flex-col items-center justify-center px-5 py-20 text-center">
    <p class="font-display text-7xl sm:text-8xl">404</p>
    <h1 class="mt-4 text-2xl sm:text-3xl">Esta página no existe</h1>
    <p class="mt-3 max-w-md leading-relaxed text-muted-foreground">
      Puede que el enlace esté mal escrito o que la página haya cambiado de sitio.
      Estas rutas sí llevan a alguna parte:
    </p>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:gap-4">
      <a href="/" class="rounded-btn bg-foreground px-7 py-3 font-semibold text-background transition hover:bg-foreground/90">Ir a la página principal</a>
      <a href={MAIN_DEMO_HREF} class="rounded-btn border border-foreground px-7 py-3 font-semibold text-foreground transition hover:bg-foreground hover:text-background">Entrar en la tienda demo</a>
    </div>
    <p class="mt-6 text-sm text-muted-foreground">
      ¿Buscabas el panel? <a href={DEMO_ADMIN_HREF} class="text-link">Está aquí</a>.
    </p>
  </main>
</Landing>
