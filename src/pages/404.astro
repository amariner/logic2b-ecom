---
// Página 404 propia (sustituye a la genérica del Worker). Misma cabecera, pie
// y lenguaje visual que el resto de páginas comerciales (shell Landing).
import Landing from '../layouts/Landing.astro';
import { MAIN_DEMO_HREF, DEMO_ADMIN_HREF } from '../lib/nav';
---

<Landing title="Página no encontrada — Logic2B Ecommerce" noindex>
  <main class="page-hero page-shell status-page">
    <p class="status-code" aria-hidden="true">4<span>0</span>4</p>
    <p class="page-kicker">Página no encontrada</p>
    <h1>Esta página no existe</h1>
    <p class="page-lead">
      Puede que el enlace esté mal escrito o que la página haya cambiado de sitio.
      Estas rutas sí llevan a alguna parte:
    </p>
    <div class="page-actions">
      <a href="/" class="btn btn-primary">Ir a la página principal <span class="btn-arrow" aria-hidden="true">→</span></a>
      <a href={MAIN_DEMO_HREF} class="btn btn-ghost">Entrar en la tienda demo <span aria-hidden="true">↗</span></a>
    </div>
    <p class="status-note">¿Buscabas el panel? <a href={DEMO_ADMIN_HREF} class="text-link">Entra en el panel de la demo</a>.</p>
  </main>
</Landing>

<style is:global>
  .commercial-page .status-code { position: relative; margin-bottom: 1.5rem; color: var(--c-green); font: 600 clamp(6rem, 18vw, 12rem)/.85 var(--font-heading); letter-spacing: -.08em; }
  .commercial-page .status-code span { display: inline-block; margin-inline: .04em; width: .72em; height: .72em; border: .09em solid var(--c-accent); border-radius: 50%; color: transparent; vertical-align: -.02em; }
  .commercial-page .status-note { margin-top: 1.8rem; color: var(--c-muted); font-size: .9rem; }
  @media (prefers-reduced-motion: no-preference) {
    .commercial-page .status-code span { animation: status-spin 9s linear infinite; border-top-color: var(--c-green); }
  }
  @keyframes status-spin { to { transform: rotate(360deg); } }
</style>
