---
/**
 * /temas — CATÁLOGO DE ESTILOS de Logic2B Ecommerce.
 *
 * Pieza de venta: convierte "te lo hacemos a medida" (abstracto, suena caro) en
 * una elección concreta de catálogo. El cliente elige el punto de partida y a
 * partir de ahí se adapta a su marca.
 *
 * La fuente de verdad es src/lib/demo-themes.ts — esta página solo la pinta.
 * Documentación de cada tema: docs/TEMAS.md
 */
import Landing from '../layouts/Landing.astro';
import { MAIN_DEMO_HREF } from '../lib/nav';
import { demoThemes, defaultTheme } from '../lib/demo-themes';
import { collections, storePaths } from '../collections';
import { THEME_FILTERS, newestThemesFirst, themeCategoryIds, themeSearchText } from '../lib/theme-catalog';

/**
 * Tienda viva de cada tema (9B: un tema desarrollado = una tienda con URL).
 * Si existe, la ficha enseña la CAPTURA REAL de esa tienda (F11.1) y enlaza
 * directo a ella — el catálogo deja de describir y pasa a demostrar.
 */
/**
 * Encuadre del recorte 16:10 sobre la captura de página completa. Por defecto
 * arriba; Vector (launch) baja al arranque de la franja de producto — su
 * cabecera es texto sobre blanco y recortada sola parece una tarjeta vacía.
 */
const CROP: Record<string, string> = { launch: 'object-[center_18%]' };

const storeFor = (themeId: string) => {
  const col = collections.find((c) => c.themeId === themeId);
  if (!col) return null;
  return {
    name: col.name,
    href: storePaths(col.id).catalog,
    img: `/images/screens/store-${col.id}-catalog-900.webp`,
    srcset: `/images/screens/store-${col.id}-catalog-560.webp 560w, /images/screens/store-${col.id}-catalog-900.webp 900w`,
    crop: CROP[col.id] ?? 'object-top',
  };
};

/**
 * Se enseña la imaginería PROPIA de cada tema (`sample`), no la captura de
 * referencia: esta página es indexable y republicar el diseño de otra tienda
 * aquí no procede. Las referencias son material interno de trabajo.
 *
 * Existencia resuelta en BUILD con el glob de Vite —no `node:fs`, que exigiría
 * @types/node— para pintar un marcador de hueco en vez de un <img> roto.
 */
const sampleFiles = new Set(
  Object.keys(import.meta.glob('../../public/images/temas/*.webp')).map(
    (path) => `/images/temas/${path.split('/').pop()!}`,
  ),
);
const hasSample = (sample: string | null): boolean => Boolean(sample) && sampleFiles.has(sample!);

const styles = newestThemesFirst(demoThemes.filter((t) => t.id !== defaultTheme.id));

const layoutLabels: Record<string, string> = {
  // rejilla
  '2': '2 columnas', '3': '3 columnas', '4': '4 columnas', '5': '5 columnas',
  // nav
  top: 'Nav superior', sidebar: 'Nav lateral', immersive: 'Inmersivo (header propio)',
  // tarjeta
  hairline: 'Tarjeta con filete', plain: 'Tarjeta sin borde',
  elevated: 'Tarjeta elevada', divided: 'Tarjeta dividida',
  // filtros
  chips: 'Filtros en chips', sidebar_f: 'Filtros laterales', dropdown: 'Filtros en desplegable',
  // densidad
  compact: 'Densidad compacta', regular: 'Densidad normal', airy: 'Densidad aireada',
};

/**
 * Nunca devuelve vacío: si falta una etiqueta (p. ej. al añadir un valor nuevo a
 * ThemeLayout), cae al valor crudo en vez de renderizar una fila en blanco.
 * `tests/temas-labels.test.ts` avisa antes de que eso llegue a producción.
 */
const label = (key: string | number): string => layoutLabels[String(key)] ?? String(key);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Catálogo de temas — Logic2B Ecommerce',
    description:
      `${styles.length} direcciones visuales completas para tu tienda online. Elige el punto de partida y lo adaptamos a tu marca.`,
    isPartOf: { '@type': 'WebSite', name: 'Logic2B Ecommerce', url: 'https://ecom.logic2b.com' },
  },
];
---

<Landing
  title="Catálogo de temas — Logic2B Ecommerce"
  description={`${styles.length} direcciones visuales completas para tu tienda online: del catálogo técnico B2B al minimalismo de mobiliario. Elige el punto de partida y lo adaptamos a tu marca.`}
  canonicalPath="/temas"
  activeHref="/temas"
  jsonLd={jsonLd}
>
    <main>
      <!-- Héroe -->
      <section class="page-hero page-shell">
        <p class="page-kicker">{styles.length} tiendas · un solo motor</p>
        <h1>
          Tu tienda no tiene por qué parecerse a <span>ninguna otra</span>.
        </h1>
        <p class="page-lead">
          Elige un punto de partida. Nosotros lo adaptamos a tu marca.
        </p>
      </section>

      <!-- Rejilla de temas -->
      <section class="page-shell pb-14 pt-4 sm:pb-20 sm:pt-8">
        <div data-theme-controls hidden class="mb-8 border-y border-border py-4 sm:mb-10">
          <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
            <label class="block min-w-0 flex-1 lg:max-w-md" for="theme-search">
              <span class="mb-2 block text-xs font-semibold uppercase tracking-wide text-muted-foreground">Buscar un estilo</span>
              <span class="flex items-center gap-2 border-b border-foreground pb-2">
                <svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4 shrink-0 fill-none stroke-current" stroke-width="1.75">
                  <circle cx="11" cy="11" r="7"></circle>
                  <path d="m16 16 4 4"></path>
                </svg>
                <input
                  id="theme-search"
                  data-theme-search
                  type="search"
                  autocomplete="off"
                  placeholder="Estilo, sector o referencia"
                  class="w-full bg-transparent text-sm text-foreground outline-offset-4 placeholder:text-muted-foreground focus-visible:outline focus-visible:outline-2 focus-visible:outline-foreground"
                />
              </span>
            </label>

            <div class="hidden shrink-0 lg:block">
              <span class="mb-2 block text-xs font-semibold uppercase tracking-wide text-muted-foreground">Vista</span>
              <div class="flex gap-1" role="group" aria-label="Número de columnas del catálogo">
                <button type="button" data-theme-columns="2" aria-pressed="true" class="theme-view-button">
                  <span class="theme-grid-icon theme-grid-icon--2" aria-hidden="true"><i></i><i></i></span>
                  <span class="sr-only">Ver en 2 columnas</span>
                </button>
                <button type="button" data-theme-columns="3" aria-pressed="false" class="theme-view-button">
                  <span class="theme-grid-icon theme-grid-icon--3" aria-hidden="true"><i></i><i></i><i></i></span>
                  <span class="sr-only">Ver en 3 columnas</span>
                </button>
              </div>
            </div>
          </div>

          <div class="mt-5 flex items-center gap-4">
            <div class="min-w-0 flex-1 overflow-x-auto pb-1" role="group" aria-label="Filtrar temas por sector">
              <div class="flex w-max gap-2">
                {THEME_FILTERS.map((filter) => (
                  <button
                    type="button"
                    data-theme-filter={filter.id}
                    aria-pressed={filter.id === 'all' ? 'true' : 'false'}
                    class="theme-filter-button"
                  >{filter.label}</button>
                ))}
              </div>
            </div>
            <p data-theme-count class="shrink-0 text-xs tabular-nums text-muted-foreground" aria-live="polite">
              {styles.length} temas
            </p>
          </div>
        </div>

        <ul data-theme-grid data-columns="2" class="grid gap-8 sm:grid-cols-2">
          {styles.map((theme, i) => (
            <li
              id={`tema-${theme.id}`}
              data-theme-card
              data-theme-categories={themeCategoryIds(theme).join(' ')}
              data-theme-search-text={themeSearchText(theme)}
              class="flex scroll-mt-24 flex-col overflow-hidden rounded-2xl border border-border bg-card"
            >
              {/* Tema con tienda viva → captura REAL enlazable; si no, la
                  imaginería propia del tema; y si tampoco, marcador de hueco. */}
              <div
                class="relative flex aspect-[16/10] items-end border-b border-border"
                style={`background: ${theme.vars['--surface-sunken']};`}
              >
                {storeFor(theme.id) ? (
                  <a href={storeFor(theme.id)!.href} class="group absolute inset-0 block" aria-label={`Entra en ${storeFor(theme.id)!.name}, la tienda de muestra del tema ${theme.label}`}>
                    <img
                      src={storeFor(theme.id)!.img}
                      srcset={storeFor(theme.id)!.srcset}
                      sizes="(min-width: 640px) 50vw, 100vw"
                      alt={`La tienda ${storeFor(theme.id)!.name}, construida con el tema ${theme.label}`}
                      loading="lazy"
                      decoding="async"
                      width="900"
                      height="563"
                      class={`h-full w-full object-cover transition duration-300 group-hover:scale-[1.02] ${storeFor(theme.id)!.crop}`}
                    />
                  </a>
                ) : hasSample(theme.sample) ? (
                  <img
                    src={theme.sample!}
                    alt={`Imaginería de producto en la estética del tema ${theme.label}`}
                    loading="lazy"
                    decoding="async"
                    width="2752"
                    height="1536"
                    class="absolute inset-0 h-full w-full object-cover"
                  />
                ) : (
                  <div class="absolute inset-0 flex items-center justify-center">
                    <span class="font-mono text-[11px] uppercase tracking-widest text-muted-foreground">
                      Muestra pendiente
                    </span>
                  </div>
                )}
                <span
                  class="pointer-events-none absolute left-4 top-4 rounded-full px-2.5 py-1 text-[11px] font-semibold"
                  style={`background: ${theme.vars['--color-brand']}; color: ${theme.vars['--color-brand-fg']};`}
                >
                  {String(i + 1).padStart(2, '0')} · {theme.label}
                </span>
                {theme.status === 'planned' && (
                  <span class="absolute right-4 top-4 rounded-full border border-border bg-background/90 px-2.5 py-1 text-[11px] font-medium text-muted-foreground">
                    En desarrollo
                  </span>
                )}
              </div>

              <div class="flex flex-1 flex-col p-6">
                <h2
                  class="font-display text-2xl"
                  style={`letter-spacing: ${theme.vars['--tracking-display']}; font-weight: ${theme.vars['--weight-display']};`}
                >
                  {theme.label}
                </h2>
                <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{theme.hint}</p>

                <p class="mt-4 text-xs font-medium uppercase tracking-wide text-muted-foreground">
                  Encaja bien en
                </p>
                <ul class="mt-2 flex flex-wrap gap-1.5">
                  {theme.bestFor.map((use) => (
                    <li class="rounded-full bg-muted px-2.5 py-1 text-xs text-foreground">{use}</li>
                  ))}
                </ul>

                {/* Ficha técnica del tema — la prueba de que hay sistema detrás */}
                <dl class="mt-5 grid grid-cols-2 gap-x-4 gap-y-2 border-t border-border pt-4 text-xs">
                  <dt class="text-muted-foreground">Acento</dt>
                  <dd class="flex items-center gap-1.5 justify-self-end font-mono text-foreground">
                    <span
                      class="inline-block h-3 w-3 rounded-full border border-border"
                      style={`background: ${theme.vars['--color-brand']};`}
                      aria-hidden="true"
                    ></span>
                    {theme.vars['--color-brand']}
                  </dd>

                  <dt class="text-muted-foreground">Rejilla</dt>
                  <dd class="justify-self-end text-foreground">{label(theme.layout.gridCols)}</dd>

                  <dt class="text-muted-foreground">Navegación</dt>
                  <dd class="justify-self-end text-foreground">{label(theme.layout.nav)}</dd>

                  <dt class="text-muted-foreground">Densidad</dt>
                  <dd class="justify-self-end text-foreground">{label(theme.layout.density)}</dd>
                </dl>

                <p class="mt-4 border-t border-border pt-4 text-xs text-muted-foreground">
                  Inspirado en la dirección visual de <strong class="font-medium text-foreground">{theme.reference?.name}</strong>,
                  reconstruida sobre el sistema Logic2B UI.
                </p>
                {storeFor(theme.id) && (
                  <a
                    href={storeFor(theme.id)!.href}
                    class="mt-4 inline-flex items-center gap-1.5 self-start px-4 py-2 text-sm font-semibold transition hover:opacity-85"
                    style={`background: ${theme.vars['--color-brand']}; color: ${theme.vars['--color-brand-fg']}; border-radius: ${theme.vars['--radius-btn']};`}
                  >
                    Entra en {storeFor(theme.id)!.name} <span aria-hidden="true">→</span>
                  </a>
                )}
              </div>
            </li>
          ))}
        </ul>
        <div data-theme-empty hidden class="rounded-2xl border border-dashed border-border px-6 py-14 text-center">
          <p class="font-display text-xl">No encontramos un tema con esos criterios.</p>
          <p class="mt-2 text-sm text-muted-foreground">Prueba otra palabra o vuelve a ver el catálogo completo.</p>
          <button type="button" data-theme-reset class="mt-5 rounded-btn border border-foreground px-4 py-2 text-sm font-semibold transition hover:bg-foreground hover:text-background">
            Ver todos los temas
          </button>
        </div>
      </section>

      <!-- Nota honesta sobre el estado -->
      <section class="border-t border-border bg-muted/40">
        <div class="mx-auto max-w-3xl px-[clamp(24px,4vw,32px)] py-14 text-center">
          <h2 class="font-display text-2xl sm:text-3xl">¿Y si ninguno es exactamente lo tuyo?</h2>
          <p class="mt-4 text-base leading-relaxed text-muted-foreground">
            Mejor. Estos son puntos de partida, no un menú cerrado: lo normal es
            coger la rejilla de uno, la tipografía de otro y el color de tu marca. El
            catálogo existe para tener una conversación concreta, no para encajarte en
            una plantilla.
          </p>
          <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
            <a
              href={MAIN_DEMO_HREF}
              class="rounded-btn bg-foreground px-6 py-3 text-sm font-semibold text-background transition hover:bg-foreground/90"
            >Entra en la tienda demo</a>
            <a
              href="/#contacto"
              data-open-project
              class="rounded-btn border border-foreground px-6 py-3 text-sm font-semibold text-foreground transition hover:bg-foreground hover:text-background"
            >Cuéntanos tu proyecto</a>
          </div>
        </div>
      </section>
    </main>
</Landing>

<style>
  .theme-filter-button {
    border: 1px solid var(--border);
    border-radius: 9999px;
    padding: 0.5rem 0.85rem;
    color: var(--muted-foreground);
    font-size: 0.8125rem;
    line-height: 1rem;
    white-space: nowrap;
    transition: border-color 150ms ease, background-color 150ms ease, color 150ms ease;
  }

  .theme-filter-button:hover,
  .theme-filter-button[aria-pressed='true'] {
    border-color: var(--foreground);
    background: var(--foreground);
    color: var(--background);
  }

  .theme-view-button {
    display: grid;
    min-width: 2.5rem;
    min-height: 2.25rem;
    place-items: center;
    border: 1px solid var(--border);
    color: var(--muted-foreground);
    transition: border-color 150ms ease, background-color 150ms ease, color 150ms ease;
  }

  .theme-view-button[aria-pressed='true'] {
    border-color: var(--foreground);
    background: var(--foreground);
    color: var(--background);
  }

  .theme-grid-icon {
    display: grid;
    width: 1rem;
    gap: 2px;
  }

  .theme-grid-icon--2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .theme-grid-icon--3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }

  .theme-grid-icon i {
    display: block;
    height: 0.85rem;
    border: 1px solid currentColor;
  }

  @media (min-width: 64rem) {
    [data-theme-grid][data-columns='3'] { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
</style>

<script>
  const controls = document.querySelector<HTMLElement>('[data-theme-controls]');
  const grid = document.querySelector<HTMLElement>('[data-theme-grid]');
  const search = document.querySelector<HTMLInputElement>('[data-theme-search]');
  const cards = [...document.querySelectorAll<HTMLElement>('[data-theme-card]')];
  const filterButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-theme-filter]')];
  const columnButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-theme-columns]')];
  const count = document.querySelector<HTMLElement>('[data-theme-count]');
  const empty = document.querySelector<HTMLElement>('[data-theme-empty]');
  const reset = document.querySelector<HTMLButtonElement>('[data-theme-reset]');

  if (controls && grid && search && count && empty) {
    controls.hidden = false;
    let activeFilter = 'all';

    const normalize = (value: string) => value
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .toLocaleLowerCase('es')
      .trim();

    const applyFilters = () => {
      const query = normalize(search.value);
      let visible = 0;
      for (const card of cards) {
        const categories = card.dataset.themeCategories?.split(' ') ?? [];
        const matchesFilter = activeFilter === 'all' || categories.includes(activeFilter);
        const matchesSearch = !query || (card.dataset.themeSearchText ?? '').includes(query);
        card.hidden = !(matchesFilter && matchesSearch);
        if (!card.hidden) visible += 1;
      }
      count.textContent = `${visible} ${visible === 1 ? 'tema' : 'temas'}`;
      empty.hidden = visible !== 0;
      grid.hidden = visible === 0;
    };

    search.addEventListener('input', applyFilters);
    filterButtons.forEach((button) => button.addEventListener('click', () => {
      activeFilter = button.dataset.themeFilter ?? 'all';
      filterButtons.forEach((candidate) => candidate.setAttribute('aria-pressed', String(candidate === button)));
      applyFilters();
    }));
    columnButtons.forEach((button) => button.addEventListener('click', () => {
      grid.dataset.columns = button.dataset.themeColumns ?? '2';
      columnButtons.forEach((candidate) => candidate.setAttribute('aria-pressed', String(candidate === button)));
    }));
    reset?.addEventListener('click', () => {
      search.value = '';
      activeFilter = 'all';
      filterButtons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.themeFilter === 'all')));
      applyFilters();
      search.focus();
    });
  }
</script>
