---
/**
 * /temas — CATÁLOGO DE ESTILOS de Logic2B Ecommerce.
 *
 * Pieza de venta: convierte "te lo hacemos a medida" (abstracto, suena caro) en
 * una elección concreta de catálogo. El cliente elige el punto de partida y a
 * partir de ahí se adapta a su marca.
 *
 * La fuente de verdad es src/lib/demo-themes.ts — esta página solo la pinta.
 * Documentación de cada tema: docs/TEMAS.md
 */
import Landing from '../layouts/Landing.astro';
import { MAIN_DEMO_HREF } from '../lib/nav';
import { demoThemes, defaultTheme } from '../lib/demo-themes';
import { collections, storePaths } from '../collections';
import { THEME_FILTERS, newestThemesFirst, themeCategoryIds, themeSearchText } from '../lib/theme-catalog';
import { THEME_LAYOUT_LABELS } from '../lib/theme-labels';
import { themePagePath } from '../lib/theme-profiles';

/**
 * Tienda viva de cada tema (9B: un tema desarrollado = una tienda con URL).
 * Si existe, la ficha enseña la CAPTURA REAL de esa tienda (F11.1) y enlaza
 * directo a ella — el catálogo deja de describir y pasa a demostrar.
 */
/**
 * Encuadre del recorte 16:10 sobre la captura de página completa. Por defecto
 * arriba; Vector (launch) baja al arranque de la franja de producto — su
 * cabecera es texto sobre blanco y recortada sola parece una tarjeta vacía.
 */
const CROP: Record<string, string> = { launch: 'object-[center_18%]' };

const storeFor = (themeId: string) => {
  const col = collections.find((c) => c.themeId === themeId);
  if (!col) return null;
  return {
    name: col.name,
    href: storePaths(col.id).catalog,
    img: `/images/screens/store-${col.id}-catalog-900.webp`,
    srcset: `/images/screens/store-${col.id}-catalog-560.webp 560w, /images/screens/store-${col.id}-catalog-900.webp 900w`,
    crop: CROP[col.id] ?? 'object-top',
  };
};

/**
 * Se enseña la imaginería PROPIA de cada tema (`sample`), no la captura de
 * referencia: esta página es indexable y republicar el diseño de otra tienda
 * aquí no procede. Las referencias son material interno de trabajo.
 *
 * Existencia resuelta en BUILD con el glob de Vite —no `node:fs`, que exigiría
 * @types/node— para pintar un marcador de hueco en vez de un <img> roto.
 */
const sampleFiles = new Set(
  Object.keys(import.meta.glob('../../public/images/temas/*.webp')).map(
    (path) => `/images/temas/${path.split('/').pop()!}`,
  ),
);
const hasSample = (sample: string | null): boolean => Boolean(sample) && sampleFiles.has(sample!);

const previewFiles = new Set(
  Object.keys(import.meta.glob('../../public/images/screens/theme-*-preview.mp4')).map(
    (path) => `/images/screens/${path.split('/').pop()!}`,
  ),
);
const previewFor = (themeId: string): string | null => {
  const preview = `/images/screens/theme-${themeId}-preview.mp4`;
  return previewFiles.has(preview) ? preview : null;
};

const styles = newestThemesFirst(demoThemes.filter((t) => t.id !== defaultTheme.id));

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Catálogo de temas — Logic2B Ecommerce',
    description:
      `${styles.length} direcciones visuales completas para tu tienda online. Elige el punto de partida y lo adaptamos a tu marca.`,
    isPartOf: { '@type': 'WebSite', name: 'Logic2B Ecommerce', url: 'https://ecom.logic2b.com' },
  },
];
---

<Landing
  title="Catálogo de temas — Logic2B Ecommerce"
  description={`${styles.length} direcciones visuales completas para tu tienda online: del catálogo técnico B2B al minimalismo de mobiliario. Elige el punto de partida y lo adaptamos a tu marca.`}
  canonicalPath="/temas"
  activeHref="/temas"
  jsonLd={jsonLd}
>
    <main>
      <!-- Héroe -->
      <section class="page-hero page-shell">
        <p class="page-kicker">{styles.length} tiendas · un solo motor</p>
        <h1>
          Tu tienda no tiene por qué parecerse a <span>ninguna otra</span>.
        </h1>
        <p class="page-lead">
          Elige un punto de partida. Nosotros lo adaptamos a tu marca.
        </p>
        <div class="page-actions">
          <a href="/#contacto" data-open-project class="btn btn-primary">Solicitar propuesta <span class="btn-arrow" aria-hidden="true">→</span></a>
          <a href={MAIN_DEMO_HREF} class="btn btn-ghost">Entra en la tienda demo <span aria-hidden="true">↗</span></a>
        </div>
        <ul class="themes-proof" aria-label="El catálogo en cifras">
          <li><strong>{styles.length}</strong><span>direcciones visuales navegables</span></li>
          <li><strong>{THEME_FILTERS.length - 1}</strong><span>sectores para filtrar</span></li>
          <li><strong>1</strong><span>motor común detrás de todas</span></li>
        </ul>
      </section>

      <!-- Rejilla de temas -->
      <section class="page-shell pb-14 pt-4 sm:pb-20 sm:pt-8">
        <div data-theme-controls hidden class="themes-controls">
          <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
            <label class="block min-w-0 flex-1 lg:max-w-md" for="theme-search">
              <span class="mb-2 block text-xs font-semibold uppercase tracking-wide text-muted-foreground">Buscar un estilo</span>
              <span class="flex items-center gap-2 border-b border-foreground pb-2">
                <svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4 shrink-0 fill-none stroke-current" stroke-width="1.75">
                  <circle cx="11" cy="11" r="7"></circle>
                  <path d="m16 16 4 4"></path>
                </svg>
                <input
                  id="theme-search"
                  data-theme-search
                  type="search"
                  autocomplete="off"
                  placeholder="Estilo, sector o referencia"
                  class="w-full bg-transparent text-sm text-foreground outline-offset-4 placeholder:text-muted-foreground focus-visible:outline focus-visible:outline-2 focus-visible:outline-foreground"
                />
              </span>
            </label>

            <div class="hidden shrink-0 lg:block">
              <span class="mb-2 block text-xs font-semibold uppercase tracking-wide text-muted-foreground">Vista</span>
              <div class="flex gap-1" role="group" aria-label="Número de columnas del catálogo">
                <button type="button" data-theme-columns="2" aria-pressed="true" class="theme-view-button">
                  <span class="theme-grid-icon theme-grid-icon--2" aria-hidden="true"><i></i><i></i></span>
                  <span class="sr-only">Ver en 2 columnas</span>
                </button>
                <button type="button" data-theme-columns="3" aria-pressed="false" class="theme-view-button">
                  <span class="theme-grid-icon theme-grid-icon--3" aria-hidden="true"><i></i><i></i><i></i></span>
                  <span class="sr-only">Ver en 3 columnas</span>
                </button>
              </div>
            </div>
          </div>

          <div class="mt-5 flex items-center gap-4">
            <div class="min-w-0 flex-1 overflow-x-auto pb-1" role="group" aria-label="Filtrar temas por sector">
              <div class="flex w-max gap-2">
                {THEME_FILTERS.map((filter) => (
                  <button
                    type="button"
                    data-theme-filter={filter.id}
                    aria-pressed={filter.id === 'all' ? 'true' : 'false'}
                    class="theme-filter-button"
                  >{filter.label}</button>
                ))}
              </div>
            </div>
            <p data-theme-count class="shrink-0 text-xs tabular-nums text-muted-foreground" aria-live="polite">
              {styles.length} temas
            </p>
          </div>
        </div>
        <!-- Mejora progresiva sin CLS: el script bloqueante revela los
             controles antes del primer pintado. Sin JS siguen ocultos y la
             rejilla completa continúa siendo usable. -->
        <script is:inline>document.querySelector('[data-theme-controls]')?.removeAttribute('hidden');</script>

        <ul data-theme-grid data-columns="2" class="grid gap-8 sm:grid-cols-2">
          {styles.map((theme, i) => (
            <li
              id={`tema-${theme.id}`}
              data-theme-card
              data-theme-categories={themeCategoryIds(theme).join(' ')}
              data-theme-search-text={themeSearchText(theme)}
              class="theme-card reveal flex scroll-mt-24 flex-col overflow-hidden"
            >
              {/* Tema con tienda viva → captura REAL enlazable; si no, la
                  imaginería propia del tema; y si tampoco, marcador de hueco. */}
              <div
                class="theme-card-media relative flex aspect-[16/10] items-end"
                style={`background: ${theme.vars['--surface-sunken']};`}
              >
                {storeFor(theme.id) ? (
                  <a href={themePagePath(theme.id)} class="group absolute inset-0 block" aria-label={`Ficha del tema ${theme.label}: vista previa navegable y detalles`}>
                    <img
                      src={storeFor(theme.id)!.img}
                      srcset={storeFor(theme.id)!.srcset}
                      sizes="(min-width: 640px) 50vw, 100vw"
                      alt={`La tienda ${storeFor(theme.id)!.name}, construida con el tema ${theme.label}`}
                      loading="lazy"
                      decoding="async"
                      width="900"
                      height="563"
                      class={`theme-card-img h-full w-full object-cover ${storeFor(theme.id)!.crop}`}
                      data-theme-video-src={previewFor(theme.id) ?? undefined}
                      data-theme-video-label={`Recorrido en movimiento por ${storeFor(theme.id)!.name}, tema ${theme.label}`}
                    />
                  </a>
                ) : hasSample(theme.sample) ? (
                  <img
                    src={theme.sample!}
                    alt={`Imaginería de producto en la estética del tema ${theme.label}`}
                    loading="lazy"
                    decoding="async"
                    width="2752"
                    height="1536"
                    class="absolute inset-0 h-full w-full object-cover"
                  />
                ) : (
                  <div class="absolute inset-0 flex items-center justify-center">
                    <span class="font-mono text-[11px] uppercase tracking-widest text-muted-foreground">
                      Muestra pendiente
                    </span>
                  </div>
                )}
                <span class="theme-card-badge pointer-events-none absolute left-4 top-4">
                  <i aria-hidden="true" style={`background: ${theme.vars['--color-brand']};`}></i>
                  {String(i + 1).padStart(2, '0')} · {theme.label}
                </span>
                {theme.status === 'planned' && (
                  <span class="absolute right-4 top-4 rounded-full border border-border bg-background/90 px-2.5 py-1 text-[11px] font-medium text-muted-foreground">
                    En desarrollo
                  </span>
                )}
                {previewFor(theme.id) && (
                  <button
                    type="button"
                    hidden
                    data-theme-video-toggle
                    aria-pressed="false"
                    aria-label={`Pausar el recorrido del tema ${theme.label}`}
                    class="theme-video-toggle"
                  >
                    <svg data-theme-video-pause aria-hidden="true" viewBox="0 0 24 24"><path d="M8 6v12M16 6v12"></path></svg>
                    <svg data-theme-video-play aria-hidden="true" viewBox="0 0 24 24" class="hidden"><path d="m9 6 9 6-9 6Z"></path></svg>
                  </button>
                )}
              </div>

              <div class="theme-card-body flex flex-1 flex-col">
                <h2
                  class="font-display text-2xl"
                  style={`letter-spacing: ${theme.vars['--tracking-display']}; font-weight: ${theme.vars['--weight-display']};`}
                >
                  {theme.label}
                </h2>
                <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{theme.hint}</p>

                <p class="mt-4 text-xs font-medium uppercase tracking-wide text-muted-foreground">
                  Encaja bien en
                </p>
                <ul class="mt-2 flex flex-wrap gap-1.5">
                  {theme.bestFor.map((use) => (
                    <li class="theme-chip">{use}</li>
                  ))}
                </ul>

                {/* Ficha técnica del tema — la prueba de que hay sistema detrás */}
                <dl class="mt-5 grid grid-cols-2 gap-x-4 gap-y-2 border-t border-border pt-4 text-xs">
                  <dt class="text-muted-foreground">Acento</dt>
                  <dd class="flex items-center gap-1.5 justify-self-end font-mono text-foreground">
                    <span
                      class="inline-block h-3 w-3 rounded-full border border-border"
                      style={`background: ${theme.vars['--color-brand']};`}
                      aria-hidden="true"
                    ></span>
                    {theme.vars['--color-brand']}
                  </dd>

                  <dt class="text-muted-foreground">Rejilla</dt>
                  <dd class="justify-self-end text-foreground">{THEME_LAYOUT_LABELS.gridCols[theme.layout.gridCols]}</dd>

                  <dt class="text-muted-foreground">Navegación</dt>
                  <dd class="justify-self-end text-foreground">{THEME_LAYOUT_LABELS.nav[theme.layout.nav]}</dd>

                  <dt class="text-muted-foreground">Densidad</dt>
                  <dd class="justify-self-end text-foreground">{THEME_LAYOUT_LABELS.density[theme.layout.density]}</dd>
                </dl>

                <p class="mt-4 border-t border-border pt-4 text-xs text-muted-foreground">
                  Inspirado en la dirección visual de <strong class="font-medium text-foreground">{theme.reference?.name}</strong>,
                  reconstruida sobre el sistema Logic2B UI.
                </p>
                {/* La ficha es la acción principal: explica el tema y lo
                    embebe navegable. La tienda viva queda como atajo. */}
                <div class="theme-card-actions mt-5">
                  <a
                    href={themePagePath(theme.id)}
                    class="theme-card-cta inline-flex items-center gap-2 text-sm font-semibold"
                    style={`--brand: ${theme.vars['--color-brand']}; --brand-fg: ${theme.vars['--color-brand-fg']}; border-radius: ${theme.vars['--radius-btn']};`}
                  >
                    Ver ficha completa<span class="sr-only"> del tema {theme.label}</span> <span class="btn-arrow" aria-hidden="true">→</span>
                  </a>
                  {storeFor(theme.id) && (
                    <a href={storeFor(theme.id)!.href} class="theme-card-store">
                      Entra en {storeFor(theme.id)!.name} <span aria-hidden="true">↗</span>
                    </a>
                  )}
                </div>
              </div>
            </li>
          ))}
        </ul>
        <div data-theme-empty hidden class="themes-empty">
          <p class="font-display text-xl">No encontramos un tema con esos criterios.</p>
          <p class="mt-2 text-sm text-muted-foreground">Prueba otra palabra o vuelve a ver el catálogo completo.</p>
          <button type="button" data-theme-reset class="btn btn-soft mt-5">
            Ver todos los temas
          </button>
        </div>
      </section>

      <!-- Nota honesta sobre el estado -->
      <section class="page-shell cta-wrap">
        <div class="cta-band reveal">
          <p class="eyebrow"><span>+</span>A tu medida</p>
          <h2>¿Y si ninguno es exactamente lo tuyo?</h2>
          <p>
            Mejor. Estos son puntos de partida, no un menú cerrado: lo normal es
            coger la rejilla de uno, la tipografía de otro y el color de tu marca. El
            catálogo existe para tener una conversación concreta, no para encajarte en
            una plantilla.
          </p>
          <div class="page-actions">
            <a href="/#contacto" data-open-project class="btn btn-light">Solicitar propuesta <span class="btn-arrow" aria-hidden="true">→</span></a>
            <a href={MAIN_DEMO_HREF} class="btn btn-outline-light">Entra en la tienda demo</a>
          </div>
        </div>
      </section>
    </main>
</Landing>

<style>
  .themes-proof { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); max-width: 36rem; margin-top: 2.6rem; border-top: 1px solid var(--c-border); }
  .themes-proof li { padding: 1.1rem 1rem 0 0; }
  .themes-proof li + li { padding-left: 1rem; border-left: 1px solid var(--c-border); }
  .themes-proof strong { display: block; color: var(--c-green); font: 600 2.1rem/1 var(--font-heading); letter-spacing: -.05em; }
  .themes-proof span { display: block; margin-top: .45rem; color: var(--c-muted); font-size: .76rem; line-height: 1.45; }

  /* Barra de filtros fija bajo la cabecera: con 35 temas, filtrar no debe
     obligar a volver arriba. */
  .themes-controls {
    position: sticky;
    top: 96px;
    z-index: 20;
    margin-bottom: 2.25rem;
    padding: 1rem 1.2rem;
    border: 1px solid var(--c-border);
    border-radius: var(--r-lg);
    background: rgb(255 255 255 / 88%);
    backdrop-filter: blur(14px) saturate(1.2);
    box-shadow: var(--shadow-sm);
  }
  .themes-controls[hidden] { display: none; }

  .theme-card {
    border: 1px solid rgb(12 20 36 / 9%);
    border-radius: var(--r-lg);
    background: #fff;
    transition: box-shadow .4s var(--ease), transform .4s var(--ease);
  }
  .theme-card:hover { box-shadow: var(--shadow-lg); transform: translateY(-4px); }
  .theme-card-media { overflow: hidden; border-bottom: 1px solid var(--line); }
  .theme-card-img { transition: transform .9s var(--ease); }
  .theme-card:hover .theme-card-img { transform: scale(1.035); }
  .theme-card-badge {
    display: inline-flex;
    align-items: center;
    gap: .45rem;
    padding: .35rem .75rem .35rem .55rem;
    border: 1px solid rgb(255 255 255 / 60%);
    border-radius: var(--r-sm);
    background: rgb(255 255 255 / 90%);
    backdrop-filter: blur(8px);
    color: var(--c-ink);
    font-size: 11px;
    font-weight: 600;
    box-shadow: var(--shadow-sm);
  }
  .theme-card-badge i { width: .55rem; height: .55rem; border-radius: 50%; box-shadow: 0 0 0 1px rgb(0 0 0 / 10%); }
  .theme-card-body { padding: 1.6rem 1.6rem 1.7rem; }
  .theme-chip { padding: .25rem .6rem; border: 1px solid var(--c-border); border-radius: var(--r-sm); background: var(--c-surface); color: var(--c-ink); font-size: .74rem; }
  .theme-card-cta {
    min-height: 2.9rem;
    padding: .65rem 1.2rem;
    background: var(--brand);
    color: var(--brand-fg);
    box-shadow: 0 8px 20px color-mix(in oklab, var(--brand) 25%, transparent);
    transition: transform .25s var(--ease), box-shadow .25s var(--ease);
  }
  .theme-card-cta:hover { transform: translateY(-1px); box-shadow: 0 12px 26px color-mix(in oklab, var(--brand) 32%, transparent); }
  .theme-card-cta:hover .btn-arrow { transform: translateX(3px); }
  .theme-card-actions { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem 1.25rem; }
  .theme-card-store {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: .35rem;
    color: var(--c-ink);
    font-size: .875rem;
    font-weight: 500;
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, currentColor 30%, transparent);
    text-underline-offset: 4px;
    transition: text-decoration-color .2s var(--ease);
  }
  .theme-card-store:hover { text-decoration-color: currentColor; }
  .themes-empty { padding: 3.5rem 1.5rem; border: 1px dashed var(--c-border); border-radius: var(--r-lg); background: #fff; text-align: center; }

  @media (max-width: 700px) {
    .themes-controls { top: 78px; padding: .8rem .9rem; border-radius: var(--r-lg); }
    .themes-proof strong { font-size: 1.7rem; }
    .themes-proof span { font-size: .7rem; }
  }

  .theme-filter-button {
    border: 1px solid var(--border);
    border-radius: var(--r-sm);
    padding: 0.5rem 0.85rem;
    color: var(--muted-foreground);
    font-size: 0.8125rem;
    line-height: 1rem;
    white-space: nowrap;
    transition: border-color 150ms ease, background-color 150ms ease, color 150ms ease;
  }

  .theme-filter-button { min-height: 2.4rem; background: #fff; }
  .theme-filter-button:hover { border-color: var(--c-green); color: var(--c-green); }
  .theme-filter-button[aria-pressed='true'] {
    border-color: var(--c-green);
    background: var(--c-green);
    color: #fff;
  }

  .theme-view-button {
    display: grid;
    min-width: 2.5rem;
    min-height: 2.25rem;
    place-items: center;
    border: 1px solid var(--border);
    color: var(--muted-foreground);
    transition: border-color 150ms ease, background-color 150ms ease, color 150ms ease;
  }

  .theme-view-button { border-radius: var(--r-sm); background: #fff; }
  .theme-view-button[aria-pressed='true'] {
    border-color: var(--c-green);
    background: var(--c-green);
    color: #fff;
  }

  .theme-grid-icon {
    display: grid;
    width: 1rem;
    gap: 2px;
  }

  .theme-grid-icon--2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .theme-grid-icon--3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }

  .theme-grid-icon i {
    display: block;
    height: 0.85rem;
    border: 1px solid currentColor;
  }

  .theme-video-toggle {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    z-index: 2;
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    border: 1px solid color-mix(in oklab, var(--background) 45%, transparent);
    border-radius: 9999px;
    background: color-mix(in oklab, var(--foreground) 86%, transparent);
    color: var(--background);
    box-shadow: 0 0.25rem 1rem color-mix(in oklab, var(--foreground) 18%, transparent);
    transition: transform 150ms ease, background-color 150ms ease;
  }

  .theme-video-toggle:hover { transform: scale(1.05); }
  .theme-video-toggle:focus-visible { outline: 2px solid var(--background); outline-offset: 2px; }
  .theme-video-toggle svg { width: 1rem; height: 1rem; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .theme-video-toggle[hidden] { display: none; }

  :global(.theme-card-video) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }

  @media (min-width: 64rem) {
    [data-theme-grid][data-columns='3'] { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
</style>

<script>
  const controls = document.querySelector<HTMLElement>('[data-theme-controls]');
  const grid = document.querySelector<HTMLElement>('[data-theme-grid]');
  const search = document.querySelector<HTMLInputElement>('[data-theme-search]');
  const cards = [...document.querySelectorAll<HTMLElement>('[data-theme-card]')];
  const filterButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-theme-filter]')];
  const columnButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-theme-columns]')];
  const count = document.querySelector<HTMLElement>('[data-theme-count]');
  const empty = document.querySelector<HTMLElement>('[data-theme-empty]');
  const reset = document.querySelector<HTMLButtonElement>('[data-theme-reset]');

  if (controls && grid && search && count && empty) {
    let activeFilter = 'all';

    const normalize = (value: string) => value
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .toLocaleLowerCase('es')
      .trim();

    const applyFilters = () => {
      const query = normalize(search.value);
      let visible = 0;
      for (const card of cards) {
        const categories = card.dataset.themeCategories?.split(' ') ?? [];
        const matchesFilter = activeFilter === 'all' || categories.includes(activeFilter);
        const matchesSearch = !query || (card.dataset.themeSearchText ?? '').includes(query);
        card.hidden = !(matchesFilter && matchesSearch);
        if (!card.hidden) visible += 1;
      }
      count.textContent = `${visible} ${visible === 1 ? 'tema' : 'temas'}`;
      empty.hidden = visible !== 0;
      grid.hidden = visible === 0;
    };

    search.addEventListener('input', applyFilters);
    filterButtons.forEach((button) => button.addEventListener('click', () => {
      activeFilter = button.dataset.themeFilter ?? 'all';
      filterButtons.forEach((candidate) => candidate.setAttribute('aria-pressed', String(candidate === button)));
      applyFilters();
    }));
    columnButtons.forEach((button) => button.addEventListener('click', () => {
      grid.dataset.columns = button.dataset.themeColumns ?? '2';
      columnButtons.forEach((candidate) => candidate.setAttribute('aria-pressed', String(candidate === button)));
    }));
    reset?.addEventListener('click', () => {
      search.value = '';
      activeFilter = 'all';
      filterButtons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.themeFilter === 'all')));
      applyFilters();
      search.focus();
    });
  }

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData === true;
  const previewImages = [...document.querySelectorAll<HTMLImageElement>('[data-theme-video-src]')];

  if (!reduceMotion && !saveData && previewImages.length > 0) {
    const manuallyPaused = new WeakSet<HTMLVideoElement>();
    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        const current = entry.target;
        let video: HTMLVideoElement;

        if (current instanceof HTMLImageElement) {
          if (!entry.isIntersecting) continue;
          const src = current.dataset.themeVideoSrc;
          if (!src) continue;
          video = document.createElement('video');
          video.src = src;
          video.poster = current.currentSrc || current.src;
          video.preload = 'none';
          video.muted = true;
          video.loop = true;
          video.playsInline = true;
          video.className = 'theme-card-video';
          video.setAttribute('aria-label', current.dataset.themeVideoLabel ?? current.alt);
          current.replaceWith(video);
          observer.unobserve(current);
          observer.observe(video);
          video.closest('[data-theme-card]')
            ?.querySelector<HTMLButtonElement>('[data-theme-video-toggle]')
            ?.removeAttribute('hidden');
        } else if (current instanceof HTMLVideoElement) {
          video = current;
        } else {
          continue;
        }

        if (entry.isIntersecting && entry.intersectionRatio >= 0.35 && !manuallyPaused.has(video)) {
          void video.play().catch(() => {});
        } else {
          video.pause();
        }
      }
    }, { rootMargin: '160px 0px', threshold: [0, 0.35] });

    previewImages.forEach((image) => observer.observe(image));
    document.querySelectorAll<HTMLButtonElement>('[data-theme-video-toggle]').forEach((button) => {
      button.addEventListener('click', () => {
        const video = button.closest('[data-theme-card]')?.querySelector<HTMLVideoElement>('video.theme-card-video');
        if (!video) return;
        const pauseIcon = button.querySelector<SVGElement>('[data-theme-video-pause]');
        const playIcon = button.querySelector<SVGElement>('[data-theme-video-play]');
        if (video.paused) {
          manuallyPaused.delete(video);
          void video.play().catch(() => {});
          button.setAttribute('aria-pressed', 'false');
          button.setAttribute('aria-label', button.getAttribute('aria-label')?.replace('Reproducir', 'Pausar') ?? 'Pausar recorrido');
          pauseIcon?.classList.remove('hidden');
          playIcon?.classList.add('hidden');
        } else {
          manuallyPaused.add(video);
          video.pause();
          button.setAttribute('aria-pressed', 'true');
          button.setAttribute('aria-label', button.getAttribute('aria-label')?.replace('Pausar', 'Reproducir') ?? 'Reproducir recorrido');
          pauseIcon?.classList.add('hidden');
          playIcon?.classList.remove('hidden');
        }
      });
    });
  }
</script>
