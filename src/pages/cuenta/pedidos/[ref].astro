---
import CustomerAccount from '../../../layouts/CustomerAccount.astro';
import type { CustomerOrderAccessView } from '../../../modules/customers/application/resource-ownership-ports';
import {
  CUSTOMER_ORDER_PAGE_PATH,
  customerOrderAccessHttpFromLocals,
} from '../../../modules/customers/presentation/customer-order-access-http';

export const prerender = false;

const method = Astro.request.method.toUpperCase();
if (method !== 'GET' && method !== 'HEAD') {
  return new Response('Método no permitido.', { status: 405, headers: { allow: 'GET, HEAD' } });
}
const http = customerOrderAccessHttpFromLocals(Astro.locals);
if (http === null) return new Response('Acceso no disponible.', { status: 503 });
const result = await http.readView(Astro.request, Astro.params.ref);
if (result instanceof Response && result.status >= 300 && result.status < 400) return result;
const order: CustomerOrderAccessView | null = result instanceof Response ? null : result;
if (result instanceof Response) Astro.response.status = result.status;

const statusLabels: Readonly<Record<string, string>> = Object.freeze({
  pending: 'Pendiente', paid: 'Pagado', shipped: 'Enviado', delivered: 'Entregado',
  cancelled: 'Cancelado', refunded: 'Reembolsado',
});

function date(value: string, includeTime = false): string {
  const parsed = new Date(value);
  return Number.isFinite(parsed.getTime())
    ? new Intl.DateTimeFormat('es-ES', includeTime
      ? { dateStyle: 'medium', timeStyle: 'short' }
      : { dateStyle: 'medium' }).format(parsed)
    : 'No disponible';
}

function money(cents: number, currency: string): string {
  try {
    return new Intl.NumberFormat('es-ES', { style: 'currency', currency }).format(cents / 100);
  } catch {
    return `${(cents / 100).toFixed(2)} ${currency}`;
  }
}
---

<CustomerAccount
  title={order ? `Pedido ${order.orderNumber}` : 'Pedido no encontrado'}
  description="Estado y seguimiento de un pedido vinculado a tu cuenta."
  width="wide"
>
  <div class="w-full">
    <nav aria-label="Cuenta de cliente" class="mb-6 flex flex-wrap gap-2 text-sm">
      <a href={CUSTOMER_ORDER_PAGE_PATH} aria-current="page" class="rounded-lg bg-foreground px-4 py-2 font-semibold text-background">Pedidos</a>
      <a href="/cuenta/sesiones" class="rounded-lg border border-border bg-background px-4 py-2 font-semibold hover:bg-muted">Sesión</a>
    </nav>

    {order ? (
      <article class="rounded-2xl border border-border bg-background p-6 shadow-sm sm:p-8" aria-labelledby="order-title">
        <a href={CUSTOMER_ORDER_PAGE_PATH} class="inline-flex min-h-11 items-center text-sm font-semibold underline underline-offset-4">← Volver a mis pedidos</a>
        <div class="mt-5 flex flex-col gap-4 border-b border-border pb-6 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.16em] text-muted-foreground">{statusLabels[order.status] ?? 'En proceso'}</p>
            <h1 id="order-title" class="mt-2 font-display text-3xl leading-tight">Pedido {order.orderNumber}</h1>
            <p class="mt-2 text-sm text-muted-foreground">Realizado el {date(order.createdAt)}</p>
          </div>
          <p class="font-display text-2xl">{money(order.totalCents, order.currency)}</p>
        </div>

        <dl class="mt-6 grid gap-4 sm:grid-cols-2">
          <div class="rounded-xl border border-border bg-muted/35 p-5">
            <dt class="text-sm font-medium text-muted-foreground">Estado</dt>
            <dd class="mt-2 font-display text-xl">{statusLabels[order.status] ?? 'En proceso'}</dd>
          </div>
          <div class="rounded-xl border border-border bg-muted/35 p-5">
            <dt class="text-sm font-medium text-muted-foreground">Última actualización</dt>
            <dd class="mt-2 font-semibold">{date(order.updatedAt, true)}</dd>
          </div>
        </dl>

        <section class="mt-6 rounded-xl border border-border p-5" aria-labelledby="tracking-title">
          <h2 id="tracking-title" class="font-display text-xl">Seguimiento</h2>
          {order.tracking ? (
            <dl class="mt-4 grid gap-4 sm:grid-cols-2">
              <div><dt class="text-sm text-muted-foreground">Transportista</dt><dd class="mt-1 font-semibold">{order.tracking.carrier}</dd></div>
              <div><dt class="text-sm text-muted-foreground">Número de seguimiento</dt><dd class="mt-1 break-all font-mono text-sm font-semibold">{order.tracking.number}</dd></div>
            </dl>
          ) : (
            <p class="mt-3 text-sm leading-6 text-muted-foreground">El seguimiento aparecerá aquí cuando el pedido haya salido.</p>
          )}
        </section>
      </article>
    ) : (
      <section class="rounded-2xl border border-border bg-background p-8 text-center shadow-sm" aria-labelledby="missing-title">
        <p class="text-xs font-semibold uppercase tracking-[0.16em] text-muted-foreground">Cuenta de cliente</p>
        <h1 id="missing-title" class="mt-2 font-display text-3xl">Pedido no encontrado</h1>
        <p class="mx-auto mt-3 max-w-md text-sm leading-6 text-muted-foreground">No podemos mostrar ese pedido desde esta cuenta.</p>
        <a href={CUSTOMER_ORDER_PAGE_PATH} class="mt-6 inline-flex min-h-12 items-center rounded-xl bg-foreground px-6 font-semibold text-background">Volver a mis pedidos</a>
      </section>
    )}
  </div>
</CustomerAccount>
