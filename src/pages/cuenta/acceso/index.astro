---
import CustomerAccount from '../../../layouts/CustomerAccount.astro';
import {
  CUSTOMER_ACCOUNT_ROUTES,
  customerAccountHttpFromLocals,
} from '../../../modules/customers/presentation/customer-account-http';

export const prerender = false;

const accountHttp = customerAccountHttpFromLocals(Astro.locals);
const method = Astro.request.method.toUpperCase();

if (method === 'POST') {
  if (accountHttp === null) {
    return new Response('Acceso no disponible.', { status: 503 });
  }
  return accountHttp.requestAccess(Astro.request);
}
if (method !== 'GET' && method !== 'HEAD') {
  return new Response('Método no permitido.', {
    status: 405,
    headers: { allow: 'GET, HEAD, POST' },
  });
}

const surfaceReady = accountHttp !== null;
---

<CustomerAccount
  title="Accede a tu cuenta"
  description="Solicita un enlace de un solo uso para acceder a tu cuenta de cliente."
>
  <section class="rounded-2xl border border-border bg-background p-6 shadow-sm sm:p-8" aria-labelledby="access-title">
    <p class="text-xs font-semibold uppercase tracking-[0.16em] text-muted-foreground">Acceso seguro</p>
    <h1 id="access-title" class="mt-2 font-display text-3xl leading-tight">Entra sin contraseña</h1>
    <p class="mt-3 text-sm leading-6 text-muted-foreground">
      Escribe el email asociado a tu cuenta. Te enviaremos un enlace de un solo uso si podemos tramitar la solicitud.
    </p>

    <form method="post" action={CUSTOMER_ACCOUNT_ROUTES.access} class="mt-6">
      <label for="customer-email" class="block text-sm font-semibold">Email</label>
      <input
        id="customer-email"
        name="email"
        type="email"
        inputmode="email"
        autocomplete="email"
        autocapitalize="none"
        spellcheck="false"
        maxlength="254"
        required
        disabled={!surfaceReady}
        aria-describedby="email-help"
        class="mt-2 min-h-12 w-full rounded-xl border border-input bg-background px-3 shadow-sm disabled:cursor-not-allowed disabled:opacity-60"
      />
      <p id="email-help" class="mt-2 text-xs leading-5 text-muted-foreground">
        Abre el enlace en este mismo navegador. Caduca en unos minutos y solo puede utilizarse una vez.
      </p>
      <button
        type="submit"
        disabled={!surfaceReady}
        class="mt-5 min-h-12 w-full rounded-xl bg-foreground px-5 font-semibold text-background shadow-sm hover:bg-foreground/85 disabled:cursor-not-allowed disabled:opacity-50"
      >Enviar enlace de acceso</button>
    </form>

    {!surfaceReady && (
      <p role="status" class="mt-5 rounded-xl border border-border bg-muted p-4 text-sm leading-6 text-muted-foreground">
        El acceso no está disponible en este momento. Puedes seguir comprando sin iniciar sesión.
      </p>
    )}
  </section>

  <p class="mt-6 text-center text-sm leading-6 text-muted-foreground">
    Pedir un enlace no cambia tu carrito ni impide comprar como invitado.
  </p>
</CustomerAccount>
