---
import CustomerAccount from '../../../layouts/CustomerAccount.astro';
import {
  CUSTOMER_RETURN_PAGE_PATH,
  customerReturnHttpFromLocals,
  type CustomerReturnListView,
} from '../../../modules/customers/presentation/customer-return-http';

export const prerender = false;

const method = Astro.request.method.toUpperCase();
if (!['GET', 'HEAD', 'POST'].includes(method)) {
  return new Response('Método no permitido.', { status: 405, headers: { allow: 'GET, HEAD, POST' } });
}
const http = customerReturnHttpFromLocals(Astro.locals);
if (http === null) return new Response('Acceso no disponible.', { status: 503 });
let feedback: 'saved' | 'invalid' | 'conflict' | 'forbidden' | null =
  Astro.url.searchParams.get('saved') === '1' ? 'saved' : null;

if (method === 'POST') {
  const result = await http.create(Astro.request);
  if (result.status >= 200 && result.status < 300) {
    return Astro.redirect(`${CUSTOMER_RETURN_PAGE_PATH}?saved=1`, 303);
  }
  Astro.response.status = result.status;
  feedback = result.status === 409 ? 'conflict' : result.status === 403 ? 'forbidden' : 'invalid';
}
const viewRequest = method === 'POST'
  ? new Request(Astro.request.url, { method: 'GET', headers: Astro.request.headers })
  : Astro.request;
const result = await http.listView(viewRequest);
if (result instanceof Response) return result;
const view: CustomerReturnListView = result;
const labels = { requested: 'Solicitada', authorized: 'Autorizada', in_transit: 'En camino',
  received: 'Recibida', inspected: 'Revisada', resolved: 'Resuelta', rejected: 'Rechazada',
  cancelled: 'Cancelada' } as const;
const reasons = [
  ['not_as_expected', 'No era lo esperado'], ['damaged', 'Llegó dañado'],
  ['defective', 'Tiene un defecto'], ['wrong_item', 'Producto equivocado'], ['other', 'Otro motivo'],
] as const;
const date = (value: string) => new Intl.DateTimeFormat('es-ES', { dateStyle: 'medium' }).format(new Date(value));
---

<CustomerAccount title="Mis devoluciones" description="Solicita y consulta devoluciones de pedidos entregados." width="wide">
  <div class="w-full">
    <nav aria-label="Cuenta de cliente" class="mb-6 flex flex-wrap gap-2 text-sm">
      {view.ordersAvailable && <a href="/cuenta/pedidos" class="rounded-lg border border-border bg-background px-4 py-2 font-semibold hover:bg-muted">Pedidos</a>}
      {view.addressesAvailable && <a href="/cuenta/direcciones" class="rounded-lg border border-border bg-background px-4 py-2 font-semibold hover:bg-muted">Direcciones</a>}
      <a href={CUSTOMER_RETURN_PAGE_PATH} aria-current="page" class="rounded-lg bg-foreground px-4 py-2 font-semibold text-background">Devoluciones</a>
      <a href="/cuenta/sesiones" class="rounded-lg border border-border bg-background px-4 py-2 font-semibold hover:bg-muted">Sesión</a>
    </nav>

    <section class="rounded-2xl border border-border bg-background p-6 shadow-sm sm:p-8" aria-labelledby="returns-title">
      <p class="text-xs font-semibold uppercase tracking-[0.16em] text-muted-foreground">Cuenta de cliente</p>
      <h1 id="returns-title" class="mt-2 font-display text-3xl leading-tight">Mis devoluciones</h1>
      <p class="mt-2 max-w-2xl text-sm leading-6 text-muted-foreground">Consulta tus solicitudes sin compartir por email datos del pedido.</p>
      {feedback === 'saved' && <p role="status" class="mt-6 rounded-xl border border-border bg-muted/45 p-4 font-medium">La solicitud se ha guardado.</p>}
      {feedback === 'conflict' && <p role="alert" class="mt-6 rounded-xl border border-border bg-muted/45 p-4 font-medium">Las unidades disponibles han cambiado. Revisa el pedido y vuelve a intentarlo.</p>}
      {feedback === 'forbidden' && <p role="alert" class="mt-6 rounded-xl border border-border bg-muted/45 p-4 font-medium">La sesión ya no permite esta solicitud.</p>}
      {feedback === 'invalid' && <p role="alert" class="mt-6 rounded-xl border border-border bg-muted/45 p-4 font-medium">No hemos podido validar la solicitud.</p>}
      {view.requests.length === 0 ? (
        <div class="mt-8 rounded-xl border border-dashed border-border bg-muted/35 p-7 text-center">
          <h2 class="font-display text-xl">Todavía no has solicitado devoluciones</h2>
          <p class="mx-auto mt-2 max-w-md text-sm leading-6 text-muted-foreground">Cuando envíes una solicitud aparecerá aquí con su estado.</p>
        </div>
      ) : (
        <ul class="mt-8 grid gap-4" aria-label="Solicitudes de devolución">
          {view.requests.map((request) => <li><a href={`${CUSTOMER_RETURN_PAGE_PATH}/${request.publicRef}`} class="block rounded-xl border border-border p-5 shadow-sm hover:bg-muted/40 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">
            <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
              <div><p class="text-sm text-muted-foreground">{date(request.requestedAt)}</p><h2 class="mt-1 font-display text-xl">{request.lines.length} {request.lines.length === 1 ? 'producto' : 'productos'}</h2></div>
              <p class="rounded-full border border-border px-3 py-1 text-sm font-semibold">{labels[request.status as keyof typeof labels] ?? 'En proceso'}</p>
            </div>
            <p class="mt-4 border-t border-border pt-4 text-sm font-semibold underline underline-offset-4">Ver solicitud</p>
          </a></li>)}
        </ul>
      )}
    </section>

    <section class="mt-6 rounded-2xl border border-border bg-background p-6 shadow-sm sm:p-8" aria-labelledby="eligible-title">
      <h2 id="eligible-title" class="font-display text-2xl">Solicitar una devolución</h2>
      <p class="mt-2 max-w-2xl text-sm leading-6 text-muted-foreground">Puedes solicitar unidades entregadas durante los últimos 30 días. La tienda revisará después la autorización y el envío de vuelta.</p>
      {view.eligibility.length === 0 ? <p class="mt-6 rounded-xl border border-dashed border-border bg-muted/35 p-6 text-center text-sm text-muted-foreground">No tienes productos elegibles ahora mismo.</p> :
        <div class="mt-6 grid gap-5">{view.eligibility.map((order) => <article class="rounded-xl border border-border p-5">
          <h3 class="font-display text-xl">Pedido {order.orderNumber}</h3>
          <div class="mt-4 grid gap-4">{order.lines.map((line) => <form method="post" action={CUSTOMER_RETURN_PAGE_PATH} class="grid gap-4 rounded-xl bg-muted/35 p-4 sm:grid-cols-[1fr_auto] sm:items-end">
            <input type="hidden" name="operation" value="create" />
            <input type="hidden" name="orderPublicRef" value={order.orderPublicRef} />
            <input type="hidden" name="ownershipVersion" value={order.ownershipVersion} />
            <input type="hidden" name="orderItemId" value={line.orderItemId} />
            <input type="hidden" name="csrfToken" value={view.csrfToken} />
            <input type="hidden" name="idempotencyKey" value={`customer-return-${crypto.randomUUID()}`} />
            <div><h4 class="font-semibold">{line.name}</h4><p class="mt-1 text-sm text-muted-foreground">{line.availableQuantity} {line.availableQuantity === 1 ? 'unidad disponible' : 'unidades disponibles'} · entregado {date(line.lastDeliveredAt)}</p>
              <div class="mt-3 grid gap-3 sm:grid-cols-2">
              <label class="grid gap-1 text-sm font-medium">Cantidad
                <input required type="number" min="1" max={line.availableQuantity} value="1" name="quantity" class="min-h-12 rounded-lg border border-border bg-background px-3" />
              </label>
              <label class="grid gap-1 text-sm font-medium">Motivo
                <select required name="reason" class="min-h-12 rounded-lg border border-border bg-background px-3">{reasons.map(([value, label]) => <option value={value}>{label}</option>)}</select>
              </label>
              </div>
            </div>
            <button type="submit" class="min-h-12 rounded-xl bg-foreground px-5 font-semibold text-background">Enviar solicitud</button>
          </form>)}</div>
        </article>)}</div>}
    </section>
  </div>
</CustomerAccount>
