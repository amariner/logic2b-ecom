---
/**
 * Confirmación del formulario cuando se envía SIN JavaScript.
 *
 * La landing es estática, así que la confirmación no puede ser un parámetro de
 * `/`: es una página propia a la que redirige `/api/contact`. Con JS nadie la
 * ve — la confirmación se pinta en el sitio. `noindex`: es un acuse de recibo,
 * no una página de captación.
 */
import Landing from '../layouts/Landing.astro';
import { MAIN_DEMO_HREF } from '../lib/nav';
---

<Landing title="Solicitud recibida — Logic2B Ecommerce" noindex>
  <main class="page-hero page-shell status-page">
    <span class="status-check" aria-hidden="true"><svg viewBox="0 0 24 24" width="34" height="34"><path d="m5 12.5 4.5 4.5L19 7.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
    <p class="page-kicker">Recibido</p>
    <h1>Gracias, ya lo tenemos</h1>
    <p class="page-lead">
      Te contestamos en 24 h laborables con dos o tres preguntas para entender
      bien tu proyecto. Sin compromiso y sin llamadas comerciales.
    </p>
    <div class="page-actions">
      <a href={MAIN_DEMO_HREF} class="btn btn-primary">Mientras tanto, mira la demo <span class="btn-arrow" aria-hidden="true">→</span></a>
      <a href="/" class="btn btn-ghost">Volver a la portada</a>
    </div>
  </main>
</Landing>

<style is:global>
  .commercial-page .status-check { display: grid; place-items: center; width: 5rem; height: 5rem; margin-bottom: 1.6rem; border-radius: 50%; background: var(--c-green); color: #fff; box-shadow: 0 0 0 .6rem var(--c-tint), var(--shadow-md); }
</style>
