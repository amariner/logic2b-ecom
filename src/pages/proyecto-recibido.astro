---
/**
 * Confirmación del formulario cuando se envía SIN JavaScript.
 *
 * La landing es estática, así que la confirmación no puede ser un parámetro de
 * `/`: es una página propia a la que redirige `/api/contact`. Con JS nadie la
 * ve — la confirmación se pinta en el sitio. `noindex`: es un acuse de recibo,
 * no una página de captación.
 */
import Landing from '../layouts/Landing.astro';
import { MAIN_DEMO_HREF } from '../lib/nav';
---

<Landing title="Solicitud recibida — Logic2B Ecommerce" noindex>
  <main class="mx-auto flex w-full max-w-2xl flex-col justify-center px-5 py-20 text-center">
    <p class="page-kicker">Recibido</p>
    <h1 class="mt-3 text-4xl sm:text-5xl">Gracias, ya lo tenemos</h1>
    <p class="mx-auto mt-5 max-w-lg leading-relaxed text-muted-foreground">
      Te contestamos en 24 h laborables con dos o tres preguntas para entender
      bien tu proyecto. Sin compromiso y sin llamadas comerciales.
    </p>
    <div class="mt-9 flex flex-col justify-center gap-3 sm:flex-row">
      <a
        href={MAIN_DEMO_HREF}
        class="rounded-btn bg-foreground px-7 py-3 text-sm font-semibold text-background transition hover:bg-foreground/90"
      >Mientras tanto, mira la demo</a>
      <a
        href="/"
        class="rounded-btn border border-foreground px-7 py-3 text-sm font-semibold transition hover:bg-foreground hover:text-background"
      >Volver a la portada</a>
    </div>
  </main>
</Landing>
