---
// Dossier comercial del servicio — pensado para enviarlo a un prospecto o
// imprimirlo en PDF (Ctrl/Cmd+P). Indexable, cero JS, mismo lenguaje visual
// que la landing (shell comercial). Los precios son los publicados en la landing.
import Landing from '../layouts/Landing.astro';
import CommercialPlans from '../components/CommercialPlans.astro';
import { planOffers } from '../commercial/plans';
import { MAIN_DEMO_HREF } from '../lib/nav';

// ── El camino MVP → tienda que crece (P2) ───────────────────────────────────
// Se VENDE, no se construye (§14): sin fechas prometidas y sin dar por
// incluida en la cuota ninguna función de la columna «después».
const path = [
  {
    k: 'Mes 1',
    title: 'La tienda que vende',
    body: 'Se entrega el MVP completo y operativo: catálogo, carrito, pagos, envíos, emails y panel. No es una versión recortada — es todo lo que un comercio necesita para vender, sin lo que no necesita todavía.',
  },
  {
    k: 'Los primeros meses',
    title: 'Se afina con datos reales',
    body: 'Con las primeras ventas se ve qué funciona: qué se busca y no se encuentra, dónde se abandona el carrito, qué producto merece mejor foto. Los ajustes entran en el mantenimiento; nadie diseña a ciegas.',
  },
  {
    k: 'Cuando el negocio lo pida',
    title: 'Se añade, no se migra',
    body: 'Cuentas de cliente, promociones y descuentos, multiidioma, transportistas integrados, feeds de catálogo, email marketing… Cada pieza se construye sobre la misma tienda, con presupuesto propio y sin tocar lo que ya funciona.',
  },
  {
    k: 'A cualquier escala',
    title: 'El techo no lo pone la plataforma',
    body: 'La arquitectura sirve un expositor de 10 referencias y un catálogo industrial. Cuando el catálogo crece de verdad, el trabajo está en búsqueda con índice, facetas y sincronización de inventario — no en cambiar de plataforma. Las cuentas, en /arquitectura.',
  },
];

// ── Qué compra la mensualidad (P3 · concepto D7) ────────────────────────────
// Una sola cuota que se sustituye al subir de tramo, nunca se apila. El
// marketing de Logic2B se presenta como continuación natural (P4) y SEPARADO
// de la cuota: mientras D7 no fije lo contrario, no se promete incluido.
const monthly = [
  {
    title: 'Que siga en pie',
    body: 'Copias de seguridad, actualizaciones, vigilancia de que los pagos y los emails salen. El día que algo se rompe —y algún día pasa— hay alguien a quien escribir que ya conoce tu tienda.',
  },
  {
    title: 'Que alguien te atienda',
    body: 'Asistencia personalizada de las personas que la construyeron: dudas del panel, cambios de contenido (hasta 2 h/mes en el Kit), una mano cuando llega la campaña de Navidad. No un ticket en una cola.',
  },
  {
    title: 'Que evolucione contigo',
    body: 'Seguimiento del proyecto: qué está pidiendo tu tienda, qué merece la pena construir después y qué no. Las ampliaciones se presupuestan aparte; el criterio para elegirlas va incluido.',
  },
];

const included = [
  {
    area: 'La tienda que ve tu cliente',
    items: [
      'Catálogo con categorías, buscador y ordenación, del expositor pequeño al catálogo grande.',
      'Ficha de producto con foto optimizada, precio, stock y datos estructurados (schema Product) que Google entiende.',
      'Carrito y checkout como invitado: nadie tiene que crearse una cuenta para comprarte.',
      'Pago en la página segura de la pasarela (Stripe, PayPal o la que encaje): la tarjeta nunca pasa por tu web, y tú no tocas papeleo PCI.',
      'Cálculo de envío por zona con umbral de envío gratis configurable.',
      'Página de confirmación y email de pedido con tu marca.',
    ],
  },
  {
    area: 'El panel desde el que gestionas',
    items: [
      'Lista de pedidos con filtros por estado: pendiente, pagado, enviado, entregado.',
      'Detalle de cada pedido: líneas, dirección, NIF si piden factura, y su historial completo.',
      'Marcar «enviado» pegando el número de seguimiento: el cliente recibe el aviso solo.',
      'Exportación CSV compatible con Packlink PRO y SendCloud para imprimir etiquetas.',
      'Edición de productos al momento: nombre, precio, stock, activar/desactivar.',
      'Tarifas de envío editables y copia de seguridad de la base de datos en un clic.',
    ],
  },
  {
    area: 'Lo invisible que marca la diferencia',
    items: [
      'Carga en menos de medio segundo desde cualquier lugar (CDN global de Cloudflare).',
      'Lighthouse 100/100/100/100: rendimiento, accesibilidad, buenas prácticas y SEO.',
      'SEO técnico de serie: sitemap, canonicals, Open Graph, datos estructurados validables.',
      'Emails transaccionales con tu dominio (confirmación de pedido y aviso de envío).',
      'Infraestructura que escala sola y sin servidores que mantener: el gasto acompaña al tráfico, no va por delante.',
      'El repositorio de código es tuyo. Si un día te vas, te lo llevas todo.',
    ],
  },
];

const process = [
  {
    step: '1',
    title: 'Brief y materiales',
    body: 'Una reunión (o un email largo) para entender qué vendes y a quién. Nos pasas fotos, lista de productos y textos; te damos una plantilla sencilla para organizarlo.',
  },
  {
    step: '2',
    title: 'Diseño y montaje',
    body: 'Construimos el ecommerce sobre la infraestructura Logic2B y lo adaptamos a tu marca, operación y contenido. Te enseñamos una versión navegable en un dominio de pruebas para que opines sobre algo real.',
  },
  {
    step: '3',
    title: 'Catálogo, pagos y envíos',
    body: 'Cargamos el catálogo completo, conectamos tu cuenta de la pasarela de pago y configuramos zonas y tarifas de envío con sus umbrales de envío gratis.',
  },
  {
    step: '4',
    title: 'Lanzamiento y formación',
    body: 'Publicamos en tu dominio y te enseñamos el panel: son tres pasos por pedido y se aprende en cinco minutos. Manual de una página incluido.',
  },
];

const needs = [
  ['Fotos de producto', 'Las que tengas; si hacen falta mejores, te orientamos sobre cómo hacerlas o con quién.'],
  ['Lista de productos', 'Nombre, precio, descripción corta y stock en una hoja de cálculo que te pasamos.'],
  ['Tu dominio', 'Si ya lo tienes, lo conectamos; si no, te ayudamos a registrarlo (~12 €/año).'],
  ['Cuenta de la pasarela de pago', 'Gratis darse de alta (Stripe, PayPal…). Te guiamos: se hace online en una tarde con tus datos fiscales.'],
  ['Textos legales', 'Aviso legal, privacidad y condiciones de venta: te damos las plantillas base para tu gestoría.'],
];

const faqs = [
  {
    q: '¿Por qué la cuota crece con el tráfico?',
    a: 'Porque así nuestro interés y el tuyo son el mismo. Mientras tu tienda tiene pocas visitas pagas el mínimo; nosotros trabajamos el posicionamiento (SEO, GEO) y las campañas; y cuando ese trabajo trae tráfico —y ventas— la cuota sube de tramo. Nunca cobramos más por adelantado: cobramos más después de que funcione. El tramo se fija en la propuesta, con tus números.',
  },
  {
    q: '¿Es seguro el pago?',
    a: 'El pago ocurre en la página de la pasarela —Stripe, PayPal o la que mejor encaje contigo—, nunca en tu tienda. El número de tarjeta no pasa por ella: cero superficie de ataque, cero papeleo PCI para ti.',
  },
  {
    q: '¿Podré gestionarlo yo sin saber de informática?',
    a: 'Ese es el diseño. Por cada pedido: llega el email, exportas la dirección a Packlink o SendCloud e imprimes la etiqueta, marcas «enviado» y pegas el seguimiento. Nada más. El panel entero se aprende en cinco minutos y te lo enseñamos en el lanzamiento.',
  },
  {
    q: '¿Emite facturas la tienda?',
    a: 'No, y es deliberado: el software de facturación tiene requisitos legales propios (VeriFactu). La tienda te da todos los datos del pedido —incluido el NIF si el cliente lo pide— para que factures desde tu herramienta o tu gestoría, sin comisiones por factura.',
  },
  {
    q: '¿Y si mi catálogo crece o cambia?',
    a: 'Precios, stock, nombres y productos activos los cambias tú desde el panel al momento. Cambios grandes (fotos nuevas, categorías, secciones) entran en el mantenimiento. Si creces hasta necesitar funciones nuevas, el código es a medida: se amplía, no se tira. Y el tamaño no es el límite: la misma arquitectura sirve 10 referencias o un millón.',
  },
  {
    q: '¿Qué incluye exactamente la mensualidad y qué no?',
    a: 'Incluye mantenimiento (copias, actualizaciones, vigilancia), asistencia personalizada y seguimiento del proyecto; en el Kit, además, hasta 2 h de cambios de contenido al mes. No incluye construir funciones nuevas ni campañas de marketing: eso se presupuesta aparte y se decide contigo. Es una sola cuota: si tu tienda sube de nivel de servicio, se sustituye por la nueva, nunca se apila una suscripción encima de otra.',
  },
  {
    q: '¿Y el marketing? ¿Tenemos que buscar otra agencia?',
    a: 'No hace falta: Logic2B es agencia de desarrollo y SEO, así que el posicionamiento, las campañas y el contenido los puede llevar el mismo equipo que construyó la tienda, con presupuesto propio. Trabajar con quien ya conoce tu tienda por dentro ahorra la mitad de las reuniones.',
  },
  {
    q: '¿Qué pasa si dejo el mantenimiento?',
    a: 'Nada dramático: no hay permanencia y el código y los datos son tuyos. La tienda sigue funcionando; simplemente dejas de tener soporte, actualizaciones y cambios de contenido incluidos.',
  },
  {
    q: '¿Por qué no Shopify o WooCommerce?',
    a: 'Shopify y WooCommerce también permiten crear tiendas personalizadas. Aquí contratas a Logic2B para diseñar, desarrollar y mantener tu proyecto sobre su infraestructura propia. Comparamos el alcance completo, incluidos diseño, mantenimiento e integraciones, antes de recomendar una opción.',
  },
  {
    q: '¿Tienda en varios idiomas?',
    a: 'La versión actual es monoidioma a propósito: cada función que no necesitas es coste y fricción que te ahorras. Si tu negocio lo pide de verdad, se presupuesta como ampliación.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Logic2B Ecommerce',
    description:
      'Proyecto de comercio electrónico a medida sobre la infraestructura tecnológica propia de Logic2B, con panel sencillo, mantenimiento y evolución sin migraciones.',
    provider: { '@type': 'Organization', name: 'Logic2B', url: 'https://logic2b.com' },
    areaServed: 'ES',
    serviceType: 'Desarrollo de comercio electrónico',
    // Sincronizado con la sección «Cuánto cuesta» y con la landing (D4).
    offers: planOffers,
  },
];
---

<Landing
  title="Dossier del servicio — Logic2B Ecommerce"
  description="Qué entrega Logic2B Ecommerce: un proyecto a medida sobre infraestructura propia, panel sencillo, mantenimiento y evolución sin migrar."
  canonicalPath="/dossier"
  activeHref="/dossier"
  jsonLd={jsonLd}
>
  <main>
    <!-- Portada -->
    <section class="page-hero page-shell">
      <p class="page-kicker">Dossier del servicio</p>
      <h1>Tu ecommerce.<br /><span>Todo lo que incluye.</span></h1>
      <p class="page-lead">
        Diseño, tecnología, mantenimiento y responsabilidades. Una guía para
        entender el servicio antes de acordar la propuesta de tu tienda.
      </p>
      <div class="page-actions print:hidden">
        <a href="/#contacto" data-open-project class="btn btn-primary">Preparar mi propuesta <span class="btn-arrow" aria-hidden="true">→</span></a>
        <a href="/precios" class="btn btn-ghost">Ver los packs</a>
      </div>
    </section>

    <div class="page-shell doc">
      <nav class="doc-toc print:hidden" aria-label="Índice del dossier">
        <p>Índice</p>
        <ol><li><a href="#para-quien"><span>01</span>Para quién es (y para quién no)</a></li><li><a href="#camino"><span>02</span>El camino: de MVP a tienda que crece</a></li><li><a href="#incluye"><span>03</span>Qué incluye el primer mes, exactamente</a></li><li><a href="#proceso"><span>04</span>Cómo trabajamos</a></li><li><a href="#necesitamos"><span>05</span>Qué necesitamos de ti</a></li><li><a href="#mensualidad"><span>06</span>Qué compra tu mensualidad</a></li><li><a href="#precio"><span>07</span>Cuánto cuesta</a></li><li><a href="#salida"><span>08</span>Qué pasa si un día nos vamos</a></li><li><a href="#faq"><span>09</span>Preguntas frecuentes</a></li></ol>
      </nav>
      <div class="doc-body">
      <section class="mb-8 doc-card sm:p-8" aria-labelledby="positioning-title">
        <p class="page-kicker">Qué es Logic2B Ecommerce</p>
        <h2 id="positioning-title" class="mt-3 font-display text-2xl sm:text-3xl">Infraestructura propia. Proyecto a medida.</h2>
        <div class="mt-4 space-y-3 text-sm leading-relaxed text-muted-foreground sm:text-base">
          <p>
            <strong class="text-foreground">Logic2B Ecommerce no es un SaaS ni una plantilla cerrada.</strong>
            Es la infraestructura tecnológica propia con la que Logic2B crea y
            gestiona proyectos de comercio electrónico a medida.
          </p>
          <p>
            Hemos resuelto previamente catálogo, pedidos, pagos, inventario,
            promociones, integraciones, seguridad y escalabilidad para concentrar
            la inversión de cada cliente en estrategia, diseño, contenido,
            desarrollo específico y acompañamiento continuo.
          </p>
          <p>
            Recibes un ecommerce adaptado a tu negocio y un panel sencillo.
            Logic2B asume la complejidad técnica, el mantenimiento y la evolución,
            para que la tienda crezca sin migrar ni reconstruirse.
          </p>
        </div>
      </section>

      {/* Lo primero que hay que entender del servicio: se empieza sencillo.
          Va antes que cualquier tabla porque es la decisión que ahorra dinero
          al cliente y la que explica todas las demás. */}
      <div class="chapter-sky p-6 sm:p-7">
        <p class="font-display text-xl">Todo proyecto empieza igual: sencillo</p>
        <p class="mt-3 max-w-3xl text-sm leading-relaxed opacity-80">
          No montamos primero la tienda perfecta. Montamos un
          <strong>MVP</strong> —una tienda mínima pero completa
          y en producción— que sirve igual a una bodega con 20 referencias que a
          un distribuidor industrial. A partir de ahí crece sobre lo que tu
          ecommerce pida de verdad, no sobre lo que alguien supuso al principio.
          Ese es nuestro punto fuerte: <strong>hacer las cosas
          sencillas desde el primer día</strong>. Lo barato no es el precio: es
          no construir lo que no vas a usar.
        </p>
      </div>
      <p class="mt-6 text-sm text-muted-foreground print:hidden">
        Guárdalo o compártelo: esta página está pensada para imprimirse en PDF (Ctrl/Cmd + P).
      </p>

      <!-- Para quién es -->
      <section id="para-quien" class="doc-chapter">
        <p class="eyebrow"><span>01</span>Capítulo</p>
        <h2 class="doc-h2">Para quién es (y para quién no)</h2>
        <div class="mt-6 grid gap-5 sm:grid-cols-2">
          <div class="doc-card is-positive">
            <p class="font-semibold">Es para ti si…</p>
            <ul class="mt-3 space-y-2 text-sm leading-relaxed text-muted-foreground">
              <li class="flex gap-2"><span aria-hidden="true" class="tick">✓</span> Quieres una tienda seria, tuya y rápida — con 20 referencias o con miles.</li>
              <li class="flex gap-2"><span aria-hidden="true" class="tick">✓</span> Estás pagando cuotas y comisiones de plataforma que no entiendes.</li>
              <li class="flex gap-2"><span aria-hidden="true" class="tick">✓</span> Quieres gestionar los pedidos tú, sin depender de nadie para el día a día.</li>
              <li class="flex gap-2"><span aria-hidden="true" class="tick">✓</span> Prefieres empezar por lo esencial y añadir cuando el negocio lo pida.</li>
            </ul>
          </div>
          <div class="doc-card">
            <p class="font-semibold">No es para ti si…</p>
            <ul class="mt-3 space-y-2 text-sm leading-relaxed text-muted-foreground">
              <li class="flex gap-2"><span aria-hidden="true">—</span> <span>Quieres un marketplace con varios vendedores, o vender por suscripción recurrente: eso es otro proyecto (y podemos hablarlo).</span></li>
              <li class="flex gap-2"><span aria-hidden="true">—</span> <span>Tu catálogo cambia a diario y necesita sincronizarse solo con un ERP: se puede construir, pero no es el proyecto que describe este dossier.</span></li>
              <li class="flex gap-2"><span aria-hidden="true">—</span> <span>Buscas la tienda más barata posible sin diseño propio: una plantilla te servirá.</span></li>
              <li class="flex gap-2"><span aria-hidden="true">—</span> <span>Vendes menos de 10 productos: pregunta por el <a href="mailto:hola@logic2b.com?subject=Kit%20Lite%20para%20mi%20negocio" class="text-link">Kit Lite</a>, la versión de entrada.</span></li>
            </ul>
          </div>
        </div>
      </section>

      <!-- El camino: de MVP a tienda que crece (P2) -->
      <section id="camino" class="doc-chapter">
        <p class="eyebrow"><span>02</span>Capítulo</p>
        <h2 class="doc-h2">El camino: de MVP a tienda que crece</h2>
        <p class="mt-2 max-w-2xl leading-relaxed text-muted-foreground">
          Tu tienda arranca básica y funcional, y crece cuando el negocio lo pide —
          sin cambiar de plataforma ni empezar de cero. Este es el recorrido de un
          proyecto tipo. <strong class="text-foreground">No hay fechas prometidas</strong>:
          cada paso se decide contigo, cuando toca.
        </p>
        <ol class="doc-path mt-6">
          {path.map((stage) => (
            <li class="flex flex-col gap-1 sm:flex-row sm:gap-6">
              <p class="page-kicker shrink-0 sm:w-48 sm:pt-0.5">{stage.k}</p>
              <div>
                <h3 class="font-semibold">{stage.title}</h3>
                <p class="mt-1.5 text-sm leading-relaxed text-muted-foreground">{stage.body}</p>
              </div>
            </li>
          ))}
        </ol>
        <p class="mt-4 text-sm leading-relaxed text-muted-foreground">
          Lo que no entra en el primer mes no está «quitado»: está
          <strong class="text-foreground">esperando a que tu tienda lo justifique</strong>.
          Es la diferencia entre pagar por funciones que no usas y construir las que
          te hacen falta.
        </p>
      </section>

      <!-- Qué incluye -->
      <section id="incluye" class="doc-chapter">
        <p class="eyebrow"><span>03</span>Capítulo</p>
        <h2 class="doc-h2">Qué incluye el primer mes, exactamente</h2>
        <p class="mt-2 max-w-2xl leading-relaxed text-muted-foreground">
          El MVP no es una versión recortada: es una tienda completa y operativa
          desde el día que se publica.
        </p>
        <div class="mt-6 space-y-6">
          {included.map((block) => (
            <div class="doc-card">
              <h3 class="font-semibold">{block.area}</h3>
              <ul class="mt-3 grid gap-x-8 gap-y-2 text-sm leading-relaxed text-muted-foreground sm:grid-cols-2">
                {block.items.map((item) => (
                  <li class="flex gap-2"><span aria-hidden="true" class="tick">✓</span> <span>{item}</span></li>
                ))}
              </ul>
            </div>
          ))}
        </div>
        <p class="mt-4 text-sm text-muted-foreground">
          ¿Quieres verlo por dentro? La <a href={MAIN_DEMO_HREF} class="text-link">demo</a> permite
          simular la compra sin enviar nada; el panel y los emails usan ejemplos ficticios independientes.
          En <a href="/arquitectura" class="text-link">/arquitectura</a> está la explicación técnica,
          incluidas las cuentas de hasta dónde escala el catálogo.
        </p>
      </section>

      <!-- Proceso -->
      <section id="proceso" class="doc-chapter">
        <p class="eyebrow"><span>04</span>Capítulo</p>
        <h2 class="doc-h2">Cómo trabajamos</h2>
        <p class="mt-2 max-w-2xl text-muted-foreground">
          De brief a tienda vendiendo en <strong class="text-foreground">3–4 semanas</strong> (orientativo: depende
          sobre todo de lo rápido que tengamos fotos y catálogo).
        </p>
        <ol class="mt-6 grid gap-5 sm:grid-cols-2">
          {process.map((p) => (
            <li class="doc-card">
              <span class="doc-step" aria-hidden="true">{p.step}</span>
              <h3 class="mt-3 font-semibold">{p.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{p.body}</p>
            </li>
          ))}
        </ol>
        <div class="doc-card is-tint mt-6">
          <h3 class="font-semibold">Tu panel es simple a propósito</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
            Pedidos, envíos y productos. Nada más — se aprende en cinco minutos
            porque no hay nada que configurar. Las mil configuraciones que en otras
            plataformas son pantallas de ajustes infinitas (mercados, divisas,
            impuestos, integraciones) <strong class="text-foreground">corren de nuestro
            lado</strong>, invisibles para quien gestiona la tienda. Y lo fuera de lo
            común nos lo pides y lo resolvemos: mejor que ir añadiendo plugins,
            adaptarlos y pagar suscripciones que no aportan gran cosa.
          </p>
        </div>
      </section>

      <!-- Qué necesitamos -->
      <section id="necesitamos" class="doc-chapter">
        <p class="eyebrow"><span>05</span>Capítulo</p>
        <h2 class="doc-h2">Qué necesitamos de ti</h2>
        <dl class="mt-6 space-y-3">
          {needs.map(([what, detail]) => (
            <div class="doc-need flex flex-col gap-1 sm:flex-row sm:gap-4">
              <dt class="shrink-0 font-semibold sm:w-44">{what}</dt>
              <dd class="text-sm leading-relaxed text-muted-foreground sm:text-base">{detail}</dd>
            </div>
          ))}
        </dl>
      </section>

      <!-- Qué compra tu mensualidad (P3 · concepto D7) -->
      <section id="mensualidad" class="doc-chapter">
        <p class="eyebrow"><span>06</span>Capítulo</p>
        <h2 class="doc-h2">Qué compra tu mensualidad</h2>
        <p class="mt-2 max-w-2xl leading-relaxed text-muted-foreground">
          Tu cuota no paga licencias de plataforma ni servidores encendidos sin usar:
          <strong class="text-foreground">paga a las personas que llevan tu tienda</strong> y
          el trabajo de traerle visitas. Empieza en el mínimo y sube por tramos según
          el tráfico — es decir, según lo bien que estemos haciendo esa parte. Esto es
          lo que compra:
        </p>
        <div class="mt-6 grid gap-5 sm:grid-cols-3">
          {monthly.map((item) => (
            <div class="doc-card">
              <h3 class="font-semibold">{item.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{item.body}</p>
            </div>
          ))}
        </div>
        <div class="doc-card is-positive mt-5">
          <p class="font-semibold">Una cuota, no una pila de suscripciones</p>
          <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
