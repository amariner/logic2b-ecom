---
// Dossier comercial del servicio — pensado para enviarlo a un prospecto o
// imprimirlo en PDF (Ctrl/Cmd+P). Indexable, cero JS, mismo lenguaje visual
// que la landing. Los precios son los publicados en la landing.
import Base from '../layouts/Base.astro';
import ProjectDialog from '../components/ProjectDialog.astro';
import { landingNav } from '../lib/nav';

// ── El camino MVP → tienda que crece (P2) ───────────────────────────────────
// Se VENDE, no se construye (§14): sin fechas prometidas y sin dar por
// incluida en la cuota ninguna función de la columna «después».
const path = [
  {
    k: 'Mes 1',
    title: 'La tienda que vende',
    body: 'Se entrega el MVP completo y operativo: catálogo, carrito, pagos con Stripe, envíos, emails y panel. No es una versión recortada — es todo lo que un comercio necesita para vender, sin lo que no necesita todavía.',
  },
  {
    k: 'Los primeros meses',
    title: 'Se afina con datos reales',
    body: 'Con las primeras ventas se ve qué funciona: qué se busca y no se encuentra, dónde se abandona el carrito, qué producto merece mejor foto. Los ajustes entran en el mantenimiento; nadie diseña a ciegas.',
  },
  {
    k: 'Cuando el negocio lo pida',
    title: 'Se añade, no se migra',
    body: 'Cuentas de cliente, promociones y descuentos, multiidioma, transportistas integrados, feeds de catálogo, email marketing… Cada pieza se construye sobre la misma tienda, con presupuesto propio y sin tocar lo que ya funciona.',
  },
  {
    k: 'A cualquier escala',
    title: 'El techo no lo pone la plataforma',
    body: 'La arquitectura sirve un expositor de 10 referencias y un catálogo industrial. Cuando el catálogo crece de verdad, el trabajo está en búsqueda con índice, facetas y sincronización de inventario — no en cambiar de plataforma. Las cuentas, en /arquitectura.',
  },
];

// ── Qué compra la mensualidad (P3 · concepto D7) ────────────────────────────
// Una sola cuota que se sustituye al subir de tramo, nunca se apila. El
// marketing de Logic2B se presenta como continuación natural (P4) y SEPARADO
// de la cuota: mientras D7 no fije lo contrario, no se promete incluido.
const monthly = [
  {
    title: 'Que siga en pie',
    body: 'Copias de seguridad, actualizaciones, vigilancia de que los pagos y los emails salen. El día que algo se rompe —y algún día pasa— hay alguien a quien escribir que ya conoce tu tienda.',
  },
  {
    title: 'Que alguien te atienda',
    body: 'Asistencia personalizada de las personas que la construyeron: dudas del panel, cambios de contenido (hasta 2 h/mes en el Kit), una mano cuando llega la campaña de Navidad. No un ticket en una cola.',
  },
  {
    title: 'Que evolucione contigo',
    body: 'Seguimiento del proyecto: qué está pidiendo tu tienda, qué merece la pena construir después y qué no. Las ampliaciones se presupuestan aparte; el criterio para elegirlas va incluido.',
  },
];

const included = [
  {
    area: 'La tienda que ve tu cliente',
    items: [
      'Catálogo con categorías, buscador y ordenación, del expositor pequeño al catálogo grande.',
      'Ficha de producto con foto optimizada, precio, stock y datos estructurados (schema Product) que Google entiende.',
      'Carrito y checkout como invitado: nadie tiene que crearse una cuenta para comprarte.',
      'Pago en la página segura de Stripe: la tarjeta nunca pasa por tu web (cero papeleo PCI).',
      'Cálculo de envío por zona con umbral de envío gratis configurable.',
      'Página de confirmación y email de pedido con tu marca.',
    ],
  },
  {
    area: 'El panel desde el que gestionas',
    items: [
      'Lista de pedidos con filtros por estado: pendiente, pagado, enviado, entregado.',
      'Detalle de cada pedido: líneas, dirección, NIF si piden factura, y su historial completo.',
      'Marcar «enviado» pegando el número de seguimiento: el cliente recibe el aviso solo.',
      'Exportación CSV compatible con Packlink PRO y SendCloud para imprimir etiquetas.',
      'Edición de productos al momento: nombre, precio, stock, activar/desactivar.',
      'Tarifas de envío editables y copia de seguridad de la base de datos en un clic.',
    ],
  },
  {
    area: 'Lo invisible que marca la diferencia',
    items: [
      'Carga en menos de medio segundo desde cualquier lugar (CDN global de Cloudflare).',
      'Lighthouse 100/100/100/100: rendimiento, accesibilidad, buenas prácticas y SEO.',
      'SEO técnico de serie: sitemap, canonicals, Open Graph, datos estructurados validables.',
      'Emails transaccionales con tu dominio (confirmación de pedido y aviso de envío).',
      'Infraestructura en los planes gratuitos de Cloudflare: 0 €/mes, sin servidores que mantener.',
      'El repositorio de código es tuyo. Si un día te vas, te lo llevas todo.',
    ],
  },
];

const process = [
  {
    step: '1',
    title: 'Brief y materiales',
    body: 'Una reunión (o un email largo) para entender qué vendes y a quién. Nos pasas fotos, lista de productos y textos; te damos una plantilla sencilla para organizarlo.',
  },
  {
    step: '2',
    title: 'Diseño y montaje',
    body: 'Adaptamos el kit a tu marca: colores, tipografía, logo, textos legales. Te enseñamos una versión navegable en un dominio de pruebas para que opines sobre algo real.',
  },
  {
    step: '3',
    title: 'Catálogo, pagos y envíos',
    body: 'Cargamos el catálogo completo, conectamos tu cuenta de Stripe y configuramos zonas y tarifas de envío con sus umbrales de envío gratis.',
  },
  {
    step: '4',
    title: 'Lanzamiento y formación',
    body: 'Publicamos en tu dominio y te enseñamos el panel: son tres pasos por pedido y se aprende en cinco minutos. Manual de una página incluido.',
  },
];

const needs = [
  ['Fotos de producto', 'Las que tengas; si hacen falta mejores, te orientamos sobre cómo hacerlas o con quién.'],
  ['Lista de productos', 'Nombre, precio, descripción corta y stock en una hoja de cálculo que te pasamos.'],
  ['Tu dominio', 'Si ya lo tienes, lo conectamos; si no, te ayudamos a registrarlo (~12 €/año).'],
  ['Cuenta de Stripe', 'Gratis. Te guiamos en el alta: se hace online en una tarde con tus datos fiscales.'],
  ['Textos legales', 'Aviso legal, privacidad y condiciones de venta: te damos las plantillas base para tu gestoría.'],
];

const faqs = [
  {
    q: '¿De verdad el coste de infraestructura es 0 €/mes?',
    a: 'Sí. La tienda corre entera en los planes gratuitos de Cloudflare (hosting, base de datos, CDN global). Los únicos costes variables son el dominio (~12 €/año) y la comisión de Stripe por venta (1,5 % + 0,25 € en tarjetas europeas), que cobra Stripe, no nosotros.',
  },
  {
    q: '¿Es seguro el pago?',
    a: 'El pago ocurre en la página de Stripe, el mismo procesador que usan Amazon o Zara. El número de tarjeta nunca pasa por la tienda: cero superficie de ataque, cero papeleo PCI para ti.',
  },
  {
    q: '¿Podré gestionarlo yo sin saber de informática?',
    a: 'Ese es el diseño. Por cada pedido: llega el email, exportas la dirección a Packlink o SendCloud e imprimes la etiqueta, marcas «enviado» y pegas el seguimiento. Nada más. El panel entero se aprende en cinco minutos y te lo enseñamos en el lanzamiento.',
  },
  {
    q: '¿Emite facturas la tienda?',
    a: 'No, y es deliberado: el software de facturación tiene requisitos legales propios (VeriFactu). La tienda te da todos los datos del pedido —incluido el NIF si el cliente lo pide— para que factures desde tu herramienta o tu gestoría, sin comisiones por factura.',
  },
  {
    q: '¿Y si mi catálogo crece o cambia?',
    a: 'Precios, stock, nombres y productos activos los cambias tú desde el panel al momento. Cambios grandes (fotos nuevas, categorías, secciones) entran en el mantenimiento. Si creces hasta necesitar funciones nuevas, el código es a medida: se amplía, no se tira. Y el tamaño no es el límite: la misma arquitectura sirve 10 referencias o un millón.',
  },
  {
    q: '¿Qué incluye exactamente la mensualidad y qué no?',
    a: 'Incluye mantenimiento (copias, actualizaciones, vigilancia), asistencia personalizada y seguimiento del proyecto; en el Kit, además, hasta 2 h de cambios de contenido al mes. No incluye construir funciones nuevas ni campañas de marketing: eso se presupuesta aparte y se decide contigo. Es una sola cuota: si tu tienda sube de nivel de servicio, se sustituye por la nueva, nunca se apila una suscripción encima de otra.',
  },
  {
    q: '¿Y el marketing? ¿Tenemos que buscar otra agencia?',
    a: 'No hace falta: Logic2B es agencia de desarrollo y SEO, así que el posicionamiento, las campañas y el contenido los puede llevar el mismo equipo que construyó la tienda, con presupuesto propio. Trabajar con quien ya conoce tu tienda por dentro ahorra la mitad de las reuniones.',
  },
  {
    q: '¿Qué pasa si dejo el mantenimiento?',
    a: 'Nada dramático: no hay permanencia y el código y los datos son tuyos. La tienda sigue funcionando; simplemente dejas de tener soporte, actualizaciones y cambios de contenido incluidos.',
  },
  {
    q: '¿Por qué no Shopify o WooCommerce?',
    a: 'Shopify son 36 €/mes de por vida más ~2 % extra por venta si no usas su pasarela, sobre una plantilla compartida. WooCommerce es «gratis» pero vives pendiente de hosting y plugins. Aquí el código es tuyo, a medida, sin cuotas de plataforma y más rápido que ambos. Y la diferencia de fondo: esa cuota paga una plataforma; la nuestra paga a las personas que llevan tu tienda.',
  },
  {
    q: '¿Tienda en varios idiomas?',
    a: 'La versión actual es monoidioma a propósito: cada función que no necesitas es coste y fricción que te ahorras. Si tu negocio lo pide de verdad, se presupuesta como ampliación.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Logic2B Ecommerce',
    description:
      'Tienda online a medida que arranca como MVP y escala de 10 referencias a un millón sin cambiar de plataforma: ultrarrápida, sin cuotas de plataforma, con coste de infraestructura cero y la asistencia continua del equipo de Logic2B.',
    provider: { '@type': 'Organization', name: 'Logic2B', url: 'https://logic2b.com' },
    areaServed: 'ES',
    serviceType: 'Desarrollo de comercio electrónico',
    // Sincronizado con la sección «Cuánto cuesta» y con la landing (D4).
    offers: [
      { '@type': 'Offer', name: 'Kit Lite', price: '590', priceCurrency: 'EUR' },
      { '@type': 'Offer', name: 'Kit', price: '1900', priceCurrency: 'EUR' },
      { '@type': 'Offer', name: 'Kit a medida', price: '3400', priceCurrency: 'EUR' },
    ],
  },
];
---

<Base
  title="Dossier del servicio — Logic2B Ecommerce"
  description="El detalle completo: qué se entrega el primer mes, cómo crece tu tienda sin migrar, qué compra exactamente tu mensualidad y cuánto cuesta. Listo para imprimir y compartir."
  canonicalPath="/dossier"
  preloadDisplayFont
  jsonLd={jsonLd}
>
  <div class="bg-paper text-ink">
    <header class="sticky top-0 z-40 border-b border-black/5 bg-white/85 backdrop-blur-md print:hidden">
      <div class="mx-auto flex h-16 max-w-4xl items-center justify-between px-5">
        <span class="wordmark">
          <a href="https://logic2b.com" class="wm-agency">Logic<span class="wm-2b">2B</span></a>
          <a href="/" class="wm-product">Ecommerce</a>
        </span>
        {/* Mismo menú que el resto del sitio (lib/nav.ts). */}
        <nav class="flex items-center gap-3 text-sm sm:gap-5">
          <a href="/" class="text-stone-600 hover:text-ink">Inicio</a>
          {landingNav
            .filter((link) => link.href !== '/dossier')
            .map((link) => (
              <a href={link.href} class="hidden text-stone-600 hover:text-ink lg:block">{link.label}</a>
            ))}
          <a
            href="/#proyecto"
            data-open-project
            class="rounded-btn bg-ink px-4 py-2 text-sm font-semibold text-white transition hover:bg-black sm:px-5"
          >Iniciar proyecto</a>
        </nav>
      </div>
    </header>

    <main class="mx-auto max-w-4xl px-5 pb-16 pt-12 sm:pt-16">
      <!-- Portada -->
      <p class="text-sm font-medium uppercase tracking-wide text-brand">Dossier del servicio</p>
      <h1 class="mt-3 max-w-3xl font-display text-4xl leading-[1.05] sm:text-5xl">
        Tu tienda a medida: qué se entrega, cómo crece y qué compras cada mes.
      </h1>
      <p class="mt-5 max-w-2xl text-base leading-relaxed text-stone-600 sm:text-lg">
        Este documento explica exactamente qué incluye <strong class="text-ink">Logic2B Ecommerce</strong>,
        cómo evoluciona tu tienda sin cambiar de plataforma, qué compra tu mensualidad, qué
        necesitamos de ti y cuánto cuesta. Sin letra pequeña: es lo mismo que firmarías en el
        presupuesto.
      </p>
      {/* Lo primero que hay que entender del servicio: se empieza sencillo.
          Va antes que cualquier tabla porque es la decisión que ahorra dinero
          al cliente y la que explica todas las demás. */}
      <div class="mt-8 rounded-2xl border border-brand/30 bg-brand/5 p-6 sm:p-7">
        <p class="font-display text-xl text-brand-dark">Todo proyecto empieza igual: sencillo</p>
        <p class="mt-3 max-w-3xl text-sm leading-relaxed text-stone-700">
          No montamos primero la tienda perfecta. Montamos un
          <strong class="text-ink">MVP</strong> —una tienda mínima pero completa
          y en producción— que sirve igual a una bodega con 20 referencias que a
          un distribuidor industrial. A partir de ahí crece sobre lo que tu
          ecommerce pida de verdad, no sobre lo que alguien supuso al principio.
          Ese es nuestro punto fuerte: <strong class="text-ink">hacer las cosas
          sencillas desde el primer día</strong>. Lo barato no es el precio: es
          no construir lo que no vas a usar.
        </p>
      </div>
      <p class="mt-6 text-sm text-stone-500 print:hidden">
        Guárdalo o compártelo: esta página está pensada para imprimirse en PDF (Ctrl/Cmd + P).
      </p>

      <!-- Para quién es -->
      <section class="mt-14">
        <h2 class="font-display text-2xl sm:text-3xl">Para quién es (y para quién no)</h2>
        <div class="mt-6 grid gap-5 sm:grid-cols-2">
          <div class="rounded-2xl border border-brand/30 bg-brand/5 p-6">
            <p class="font-semibold text-brand-dark">Es para ti si…</p>
            <ul class="mt-3 space-y-2 text-sm leading-relaxed text-stone-700">
              <li class="flex gap-2"><span aria-hidden="true" class="text-brand">✓</span> Quieres una tienda seria, tuya y rápida — con 20 referencias o con miles.</li>
              <li class="flex gap-2"><span aria-hidden="true" class="text-brand">✓</span> Estás pagando cuotas y comisiones de plataforma que no entiendes.</li>
              <li class="flex gap-2"><span aria-hidden="true" class="text-brand">✓</span> Quieres gestionar los pedidos tú, sin depender de nadie para el día a día.</li>
              <li class="flex gap-2"><span aria-hidden="true" class="text-brand">✓</span> Prefieres empezar por lo esencial y añadir cuando el negocio lo pida.</li>
            </ul>
          </div>
          <div class="rounded-2xl border border-stone-200 bg-cream p-6">
            <p class="font-semibold text-stone-700">No es para ti si…</p>
            <ul class="mt-3 space-y-2 text-sm leading-relaxed text-stone-600">
              <li class="flex gap-2"><span aria-hidden="true">—</span> <span>Quieres un marketplace con varios vendedores, o vender por suscripción recurrente: eso es otro proyecto (y podemos hablarlo).</span></li>
              <li class="flex gap-2"><span aria-hidden="true">—</span> <span>Tu catálogo cambia a diario y necesita sincronizarse solo con un ERP: se puede construir, pero no es el proyecto que describe este dossier.</span></li>
              <li class="flex gap-2"><span aria-hidden="true">—</span> <span>Buscas la tienda más barata posible sin diseño propio: una plantilla te servirá.</span></li>
              <li class="flex gap-2"><span aria-hidden="true">—</span> <span>Vendes menos de 10 productos: pregunta por el <a href="mailto:hola@logic2b.com?subject=Kit%20Lite%20para%20mi%20negocio" class="font-medium text-brand underline underline-offset-2">Kit Lite</a>, la versión de entrada.</span></li>
            </ul>
          </div>
        </div>
      </section>

      <!-- El camino: de MVP a tienda que crece (P2) -->
      <section class="mt-14">
        <h2 class="font-display text-2xl sm:text-3xl">El camino: de MVP a tienda que crece</h2>
        <p class="mt-2 max-w-2xl leading-relaxed text-stone-600">
          Tu tienda arranca básica y funcional, y crece cuando el negocio lo pide —
          sin cambiar de plataforma ni empezar de cero. Este es el recorrido de un
          proyecto tipo. <strong class="text-ink">No hay fechas prometidas</strong>:
          cada paso se decide contigo, cuando toca.
        </p>
        <ol class="mt-6 space-y-3">
          {path.map((stage) => (
            <li class="flex flex-col gap-1 rounded-2xl border border-black/5 bg-white p-6 shadow-sm sm:flex-row sm:gap-6">
              <p class="shrink-0 font-medium uppercase tracking-wide text-brand sm:w-48 sm:text-sm">{stage.k}</p>
              <div>
                <h3 class="font-semibold">{stage.title}</h3>
                <p class="mt-1.5 text-sm leading-relaxed text-stone-600">{stage.body}</p>
              </div>
            </li>
          ))}
        </ol>
        <p class="mt-4 text-sm leading-relaxed text-stone-600">
          Lo que no entra en el primer mes no está «quitado»: está
          <strong class="text-ink">esperando a que tu tienda lo justifique</strong>.
          Es la diferencia entre pagar por funciones que no usas y construir las que
          te hacen falta.
        </p>
      </section>

      <!-- Qué incluye -->
      <section class="mt-14">
        <h2 class="font-display text-2xl sm:text-3xl">Qué incluye el primer mes, exactamente</h2>
        <p class="mt-2 max-w-2xl leading-relaxed text-stone-600">
          El MVP no es una versión recortada: es una tienda completa y operativa
          desde el día que se publica.
        </p>
        <div class="mt-6 space-y-6">
          {included.map((block) => (
            <div class="rounded-2xl border border-black/5 bg-white p-6 shadow-sm">
              <h3 class="font-semibold">{block.area}</h3>
              <ul class="mt-3 grid gap-x-8 gap-y-2 text-sm leading-relaxed text-stone-600 sm:grid-cols-2">
                {block.items.map((item) => (
                  <li class="flex gap-2"><span aria-hidden="true" class="text-brand">✓</span> <span>{item}</span></li>
                ))}
              </ul>
            </div>
          ))}
        </div>
        <p class="mt-4 text-sm text-stone-500">
          ¿Quieres verlo por dentro? La <a href="/demo/tienda" class="text-brand underline underline-offset-2 hover:text-brand-dark">demo</a> es
          este mismo kit funcionando: compra, gestiona el pedido en el panel y mira los emails que enviaría.
          En <a href="/arquitectura" class="text-brand underline underline-offset-2 hover:text-brand-dark">/arquitectura</a> está la explicación técnica,
          incluidas las cuentas de hasta dónde escala el catálogo.
        </p>
      </section>

      <!-- Proceso -->
      <section class="mt-14">
        <h2 class="font-display text-2xl sm:text-3xl">Cómo trabajamos</h2>
        <p class="mt-2 max-w-2xl text-stone-600">
          De brief a tienda vendiendo en <strong class="text-ink">3–4 semanas</strong> (orientativo: depende
          sobre todo de lo rápido que tengamos fotos y catálogo).
        </p>
        <ol class="mt-6 grid gap-5 sm:grid-cols-2">
          {process.map((p) => (
            <li class="rounded-2xl border border-black/5 bg-white p-6 shadow-sm">
              <span class="flex h-8 w-8 items-center justify-center rounded-full bg-brand font-display text-white" aria-hidden="true">{p.step}</span>
              <h3 class="mt-3 font-semibold">{p.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-stone-600">{p.body}</p>
            </li>
          ))}
        </ol>
        <div class="mt-6 rounded-2xl border border-black/5 bg-cream p-6">
          <h3 class="font-semibold">Tu panel es simple a propósito</h3>
          <p class="mt-2 text-sm leading-relaxed text-stone-600">
            Pedidos, envíos y productos. Nada más — se aprende en cinco minutos
            porque no hay nada que configurar. Las mil configuraciones que en otras
            plataformas son pantallas de ajustes infinitas (mercados, divisas,
            impuestos, integraciones) <strong class="text-ink">corren de nuestro
            lado</strong>, invisibles para quien gestiona la tienda. Y lo fuera de lo
            común nos lo pides y lo resolvemos: mejor que ir añadiendo plugins,
            adaptarlos y pagar suscripciones que no aportan gran cosa.
          </p>
        </div>
      </section>

      <!-- Qué necesitamos -->
      <section class="mt-14">
        <h2 class="font-display text-2xl sm:text-3xl">Qué necesitamos de ti</h2>
        <dl class="mt-6 space-y-3">
          {needs.map(([what, detail]) => (
            <div class="flex flex-col gap-1 rounded-2xl bg-cream px-6 py-4 sm:flex-row sm:gap-4">
              <dt class="shrink-0 font-semibold sm:w-44">{what}</dt>
              <dd class="text-sm leading-relaxed text-stone-600 sm:text-base">{detail}</dd>
            </div>
          ))}
        </dl>
      </section>

      <!-- Qué compra tu mensualidad (P3 · concepto D7) -->
      <section class="mt-14">
        <h2 class="font-display text-2xl sm:text-3xl">Qué compra tu mensualidad</h2>
        <p class="mt-2 max-w-2xl leading-relaxed text-stone-600">
          La infraestructura cuesta 0 €: la tienda corre en los planes gratuitos de
          Cloudflare y eso se puede comprobar. Así que tu cuota no paga servidores ni
          licencias — <strong class="text-ink">paga a las personas que llevan tu
          tienda</strong>. Esto es lo que compra:
        </p>
        <div class="mt-6 grid gap-5 sm:grid-cols-3">
          {monthly.map((item) => (
            <div class="rounded-2xl border border-black/5 bg-white p-6 shadow-sm">
              <h3 class="font-semibold">{item.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-stone-600">{item.body}</p>
            </div>
          ))}
        </div>
        <div class="mt-5 rounded-2xl border border-brand/30 bg-brand/5 p-6">
          <p class="font-semibold text-brand-dark">Una cuota, no una pila de suscripciones</p>
          <p class="mt-2 text-sm leading-relaxed text-stone-700">
            Lo habitual en el mercado es acabar pagando la suscripción de la
            plataforma por un lado, el mantenimiento por otro, el SEO por otro y los
            contenidos por otro. Aquí es <strong class="text-ink">una sola cuota</strong>:
            si tu tienda sube de nivel de servicio, la cuota se sustituye por la
            nueva. Nunca se apila una encima de otra.
          </p>
        </div>
        <p class="mt-4 text-sm leading-relaxed text-stone-600">
          <strong class="text-ink">Lo que no incluye, dicho claro:</strong> construir
          funciones nuevas y las campañas de marketing se presupuestan aparte. La
