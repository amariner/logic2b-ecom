---
import { formatEurCents } from '../../lib/format';
import type { ProposalConfig } from '../types';
import { inlogemCatalog } from './catalog';
import { inlogemDemoEmails, inlogemDemoOrders } from './fixtures';
import ManagerShell from './ManagerShell.astro';
interface Props { proposal: ProposalConfig }
const { proposal } = Astro.props;
const demoRevenue = inlogemDemoOrders.reduce((sum, order) => sum + order.totalCents, 0);
---
<ManagerShell proposal={proposal} title="Resumen" section="dashboard">
  <div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between"><div><p class="text-xs font-semibold uppercase tracking-[.16em] text-[#155EEF]">Gestor contextual</p><h1 class="mt-2 text-3xl font-semibold tracking-[-.04em] sm:text-4xl">Buenos días, equipo.</h1></div><p class="text-sm text-[#65738A]">Datos ficticios · 31 agosto 2026</p></div>
  <dl class="mt-8 grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
    <div class="rounded-2xl border border-[#D8E0EA] bg-white p-5"><dt class="text-xs font-semibold text-[#65738A]">Productos</dt><dd class="mt-2 text-3xl font-semibold">{inlogemCatalog.length}</dd><p class="mt-2 text-xs text-[#65738A]">8 categorías</p></div>
    <div class="rounded-2xl border border-[#D8E0EA] bg-white p-5"><dt class="text-xs font-semibold text-[#65738A]">Pedidos demo</dt><dd class="mt-2 text-3xl font-semibold">{inlogemDemoOrders.length}</dd><p class="mt-2 text-xs text-[#65738A]">4 pendientes</p></div>
    <div class="rounded-2xl border border-[#D8E0EA] bg-white p-5"><dt class="text-xs font-semibold text-[#65738A]">Importe simulado</dt><dd class="mt-2 text-3xl font-semibold">{formatEurCents(demoRevenue)}</dd><p class="mt-2 text-xs text-[#65738A]">IVA incluido · demo</p></div>
    <div class="rounded-2xl border border-[#D8E0EA] bg-white p-5"><dt class="text-xs font-semibold text-[#65738A]">Emails simulados</dt><dd class="mt-2 text-3xl font-semibold">{inlogemDemoEmails.length}</dd><p class="mt-2 text-xs text-[#65738A]">Sin envíos reales</p></div>
  </dl>
  <section class="mt-8 overflow-hidden rounded-2xl border border-[#D8E0EA] bg-white"><div class="flex items-center justify-between border-b border-[#E0E6EE] px-5 py-4"><h2 class="font-semibold">Pedidos recientes</h2><a href={proposal.paths.managerOrders} class="text-sm font-semibold text-[#155EEF]">Ver todos</a></div><div class="overflow-x-auto"><table class="w-full min-w-[42rem] text-left text-sm"><thead class="bg-[#F7F8FA] text-xs text-[#65738A]"><tr><th class="px-5 py-3 font-semibold">Pedido</th><th class="px-5 py-3 font-semibold">Cliente</th><th class="px-5 py-3 font-semibold">Estado</th><th class="px-5 py-3 text-right font-semibold">Total</th></tr></thead><tbody class="divide-y divide-[#E6EBF1]">{inlogemDemoOrders.slice(0, 6).map((order) => <tr><td class="px-5 py-4"><a href={proposal.paths.managerOrder(order.reference)} class="font-semibold text-[#155EEF]">{order.reference}</a></td><td class="px-5 py-4">{order.company}</td><td class="px-5 py-4"><span class="rounded-full bg-[#EEF2F7] px-2.5 py-1 text-xs font-semibold">{order.status}</span></td><td class="px-5 py-4 text-right font-semibold">{formatEurCents(order.totalCents)}</td></tr>)}</tbody></table></div></section>
</ManagerShell>
