---
import type { ProposalConfig } from '../types';
import { inlogemDemoEmails } from './fixtures';
import ManagerShell from './ManagerShell.astro';
interface Props { proposal: ProposalConfig }
const { proposal } = Astro.props;
---
<ManagerShell proposal={proposal} title="Emails" section="emails">
  <div><p class="text-xs font-semibold uppercase tracking-[.16em] text-[#155EEF]">Bandeja simulada</p><h1 class="mt-2 text-3xl font-semibold tracking-[-.04em] sm:text-4xl">Emails de pedido</h1><p class="mt-2 text-sm text-[#65738A]">Previsualización documental: no existe servicio de envío detrás de esta pantalla.</p></div>
  <ul class="mt-7 overflow-hidden rounded-2xl border border-[#D8E0EA] bg-white divide-y divide-[#E6EBF1]">{inlogemDemoEmails.map((email) => <li class="grid gap-3 px-5 py-5 sm:grid-cols-[1fr_auto] sm:items-center"><div><div class="flex items-center gap-2"><span class="rounded-full bg-[#E7EEFF] px-2.5 py-1 text-[10px] font-semibold uppercase tracking-wide text-[#155EEF]">{email.kind}</span><h2 class="font-semibold">{email.subject}</h2></div><p class="mt-2 text-sm text-[#65738A]">Para: {email.recipient}</p></div><div class="text-xs text-[#65738A] sm:text-right"><span>{email.sentAt}</span><span class="mt-1 block font-semibold text-[#11643B]">Simulado</span></div></li>)}</ul>
  <div class="mt-5 min-w-0 break-words rounded-2xl border border-[#BFD0FF] bg-[#EEF3FF] p-5 text-sm leading-6 text-[#27436F]"><strong>Datos seguros por diseño.</strong> Todos los nombres son ficticios y todos los destinatarios usan el dominio reservado <code class="break-all">.example</code>.</div>
</ManagerShell>
