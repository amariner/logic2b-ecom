---
import { formatEurCents } from '../../lib/format';
import type { ProposalConfig } from '../types';
import { inlogemCatalog } from './catalog';
import ManagerShell from './ManagerShell.astro';
interface Props { proposal: ProposalConfig }
const { proposal } = Astro.props;
---
<ManagerShell proposal={proposal} title="Productos" section="products">
  <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between"><div><p class="text-xs font-semibold uppercase tracking-[.16em] text-[#155EEF]">Catálogo de muestra</p><h1 class="mt-2 text-3xl font-semibold tracking-[-.04em] sm:text-4xl">72 productos</h1><p class="mt-2 text-sm text-[#65738A]">Snapshot trazable de fichas públicas · edición desactivada</p></div><span class="w-fit rounded-lg border border-[#7D8CA3] bg-white px-4 py-2 text-sm font-semibold">8 categorías · 9 por categoría</span></div>
  <div class="mt-7 overflow-hidden rounded-2xl border border-[#D8E0EA] bg-white"><div class="overflow-x-auto"><table class="w-full min-w-[64rem] text-left text-sm"><thead class="bg-[#F7F8FA] text-xs text-[#65738A]"><tr><th class="px-5 py-3 font-semibold">Producto</th><th class="px-5 py-3 font-semibold">Referencia</th><th class="px-5 py-3 font-semibold">Familia</th><th class="px-5 py-3 font-semibold">Stock observado</th><th class="px-5 py-3 text-right font-semibold">Precio demo</th></tr></thead><tbody class="divide-y divide-[#E6EBF1]">{inlogemCatalog.map((item) => <tr><td class="px-5 py-3"><div class="flex items-center gap-3"><img src={item.image} alt="" width="48" height="48" loading="lazy" class="h-12 w-12 rounded-lg bg-[#F2F5F9] object-contain p-1" /><div class="max-w-md"><a href={proposal.paths.product(item.slug)} class="line-clamp-2 font-semibold hover:text-[#155EEF]">{item.name}</a><p class="mt-0.5 text-xs text-[#65738A]">{item.brand} · {item.sourceCode}</p></div></div></td><td class="px-5 py-3 font-mono text-xs">{item.sourceReference}</td><td class="px-5 py-3">{item.categoryLabel}</td><td class="px-5 py-3"><span class:list={['rounded-full px-2.5 py-1 text-xs font-semibold', item.stockSnapshot > 0 ? 'bg-[#E7F7EF] text-[#11643B]' : 'bg-[#F1F3F6] text-[#65738A]']}>{item.stockSnapshot > 0 ? `${item.stockSnapshot} uds.` : 'Consultar'}</span></td><td class="px-5 py-3 text-right"><strong>{formatEurCents(item.demoPriceCents)}</strong><span class="block text-[10px] text-[#65738A]">IVA incl. · demo</span></td></tr>)}</tbody></table></div></div>
</ManagerShell>
