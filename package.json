{
  "name": "logic2b-commerce-kit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Logic2B Ecommerce — plantilla de ecommerce ultraligera sobre Astro 5 + Cloudflare (demo: ecom.logic2b.com)",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/assert-customer-account-build.mjs && node scripts/generate-sitemap.mjs",
    "preview": "wrangler dev",
    "deploy": "pnpm build && wrangler deploy",
    "typecheck": "astro check",
    "lint": "astro check",
    "check": "pnpm typecheck && pnpm test && pnpm audit:themes:check && pnpm build",
    "test": "vitest run",
    "test:e2e": "node scripts/e2e.mjs",
    "audit:customer-account": "node scripts/audit-customer-account-local.mjs",
    "audit:lh": "node scripts/lighthouse.mjs",
    "audit:themes": "node scripts/theme-baseline.mjs --write",
    "audit:themes:check": "node scripts/theme-baseline.mjs --check",
    "new:theme": "node scripts/new-theme.mjs",
    "db:migrate": "wrangler d1 migrations apply ecom-demo --local",
    "db:seed": "node seed/generate.ts > .wrangler/seed.sql && wrangler d1 execute ecom-demo --local --file .wrangler/seed.sql",
    "db:reset": "rm -rf .wrangler/state && pnpm db:migrate && pnpm db:seed",
    "db:rehearse:inventory": "node scripts/rehearse-r2-inventory-ledger.mjs",
    "db:rehearse:reservations": "node scripts/rehearse-r2-inventory-reservations.mjs",
    "db:rehearse:payments": "node scripts/rehearse-r2-payment-ledger.mjs",
    "db:rehearse:fulfillment": "node scripts/rehearse-r2-fulfillment-lines.mjs",
    "db:rehearse:partial-refunds": "node scripts/rehearse-r2-partial-refunds.mjs",
    "db:rehearse:order-amendments": "node scripts/rehearse-r3-order-amendments.mjs",
    "db:rehearse:order-holds": "node scripts/rehearse-r3-order-holds.mjs",
    "db:rehearse:order-bulk-actions": "node scripts/rehearse-r3-order-bulk-actions.mjs",
    "db:rehearse:inventory-locations": "node scripts/rehearse-r3-inventory-locations.mjs",
    "db:rehearse:inventory-transfers": "node scripts/rehearse-r3-inventory-transfers.mjs",
    "db:rehearse:inventory-counts": "node scripts/rehearse-r3-inventory-counts.mjs",
    "db:rehearse:inventory-allocation": "node scripts/rehearse-r3-inventory-allocation.mjs",
    "db:rehearse:returns": "node scripts/rehearse-r3-returns.mjs",
    "db:rehearse:documents": "node scripts/rehearse-r3-order-documents.mjs",
    "db:rehearse:price-rules": "node scripts/rehearse-r4-price-rules.mjs",
    "db:rehearse:promotion-codes": "node scripts/rehearse-r4-promotion-codes.mjs",
    "db:rehearse:automatic-discounts": "node scripts/rehearse-r4-automatic-discounts.mjs",
    "db:rehearse:quantity-offers": "node scripts/rehearse-r4-quantity-offers.mjs",
    "db:rehearse:discount-combinations": "node scripts/rehearse-r4-discount-combinations.mjs",
    "db:rehearse:price-lists": "node scripts/rehearse-r4-price-lists.mjs",
    "db:rehearse:bundles": "node scripts/rehearse-r4-bundles.mjs",
    "db:rehearse:stored-value": "node scripts/rehearse-r4-stored-value.mjs",
    "db:rehearse:preorders": "node scripts/rehearse-r4-preorders.mjs",
    "db:rehearse:subscriptions": "node scripts/rehearse-r4-subscriptions.mjs",
    "db:rehearse:preliminary-orders": "node scripts/rehearse-r4-preliminary-orders.mjs",
    "db:rehearse:customer-profiles": "node scripts/rehearse-r5-customer-profiles.mjs",
    "db:rehearse:consent-evidence": "node scripts/rehearse-r5-consent-evidence.mjs",
    "db:rehearse:data-rights-evidence": "node scripts/rehearse-r5-data-rights-evidence.mjs",
    "db:rehearse:passwordless-auth": "node scripts/rehearse-r5-passwordless-auth.mjs",
    "db:rehearse:passwordless-security": "node scripts/rehearse-r5-passwordless-security.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.6.0",
    "@tailwindcss/vite": "^4.1.0",
    "astro": "^5.12.0",
    "stripe": "^18.0.0",
    "tailwindcss": "^4.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@cloudflare/workers-types": "^4.20250620.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.20.0"
  }
}
